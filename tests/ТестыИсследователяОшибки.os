&Тест
Процедура ТестДолжен_РазличитьКореньИПоследнийКадрУсеченнойЦепочки() Экспорт

	// Подготовка
	Цепочка64 = ПомощникТестированияОшибок.ДлиннаяЦепочка(64);
	Цепочка65 = ПомощникТестированияОшибок.ДлиннаяЦепочка(65);

	// Действие
	Исследователь64 = Новый ИсследовательОшибки(Цепочка64.Ошибка);
	Исследователь65 = Новый ИсследовательОшибки(Цепочка65.Ошибка);

	// Проверка
	Ожидаем.Что(Исследователь64.ЦепочкаУсечена()).Равно(Ложь);
	Ожидаем.Что(Исследователь64.КорневаяПричина().ИсходнаяОшибка()).Равно(Цепочка64.Корень);
	Ожидаем.Что(Исследователь65.ЦепочкаУсечена()).Равно(Истина);
	Ожидаем.Что(Исследователь65.КорневаяПричина()).Равно(Неопределено);
	Ожидаем.Что(Исследователь65.ПоследнийКадр() <> Неопределено).Равно(Истина);

