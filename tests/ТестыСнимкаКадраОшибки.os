&Тест
Процедура ТестДолжен_ВернутьМестоСозданияИСтекВызовов() Экспорт

	// Подготовка
	Ошибка = ПомощникТестированияОшибок.ЦепочкаСРазнымиМестамиСоздания().ВнешнийКадр;

	// Действие
	Снимок = Новый СнимокКадраОшибки(Ошибка);
	МестоСоздания = Снимок.МестоСоздания();
	СтекВызовов = Снимок.СтекВызовов();

	// Проверка
	Ожидаем.Что(ТипЗнч(МестоСоздания)).Равно(Тип("ФиксированнаяСтруктура"));
	Ожидаем.Что(МестоСоздания.ИмяМодуля).Равно(Ошибка.ИмяМодуля);
	Ожидаем.Что(МестоСоздания.НомерСтроки).Равно(Ошибка.НомерСтроки);
	Ожидаем.Что(МестоСоздания.ИсходнаяСтрока).Равно(Ошибка.ИсходнаяСтрока);
	Ожидаем.Что(СтекВызовов.Количество()).Равно(Ошибка.ПолучитьСтекВызовов().Количество());

