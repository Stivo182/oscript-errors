// Демонстрирует пошаговое построение ошибки через fluent-интерфейс.
// Сценарий выводит код построенной ошибки, данные, подсказку и URL.

#Использовать errors

Ошибка = Новый КонструкторОшибки("http.proxy_error", "Не удалось подключиться через прокси")
	.Данные("Адрес", "proxy.example.org:3128")
	.Подсказка("Проверьте адрес прокси и сетевое подключение")
	.URL("https://example.org/errors/http-proxy-error")
	.Построить();

Исследователь = ДиагностикаОшибок.Исследовать(Ошибка);
Данные = Исследователь.Данные();

Сообщить("Код: " + Исследователь.КодОшибки());
Сообщить("Прокси: " + Данные.Адрес);
Сообщить("Подсказка: " + Исследователь.Подсказка());
Сообщить("URL: " + Исследователь.URL());
