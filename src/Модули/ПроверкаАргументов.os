#Использовать "../internal"

#Область ПрограммныйИнтерфейс

// Проверяет тип аргумента и выбрасывает ошибку при нарушении контракта.
//
// Параметры:
//  ИмяАргумента - Строка - Имя проверяемого аргумента.
//  Значение - Произвольный - Проверяемое значение.
//  ДопустимыеТипы - Тип, ОписаниеТипов, Строка, Массив, ФиксированныйМассив - Допустимые типы значения.
//     Строки интерпретируются как имена типов, несколько имён можно перечислить через запятую.
//  Сообщение - Строка - Необязательное описание ошибки.
Процедура ПроверитьТип(ИмяАргумента, Значение, ДопустимыеТипы, Сообщение = "") Экспорт

	ПроверитьИмяАргумента(ИмяАргумента);
	ПроверитьДопустимыеТипы(ДопустимыеТипы);
	ПроверитьСообщение(Сообщение);
	ПроверитьТипВНаборе(ИмяАргумента, Значение, ДопустимыеТипы, Сообщение);

КонецПроцедуры

// Проверяет заполненность аргумента и выбрасывает ошибку при нарушении контракта.
//
// Параметры:
//  ИмяАргумента - Строка - Имя проверяемого аргумента.
//  Значение - Произвольный - Проверяемое значение.
//  Сообщение - Строка - Необязательное описание ошибки.
Процедура ПроверитьЗаполненность(ИмяАргумента, Значение, Сообщение = "") Экспорт

	ПроверитьИмяАргумента(ИмяАргумента);
	ПроверитьСообщение(Сообщение);

	Если Не ЗаполненоИлиНеПоддерживается(Значение) Тогда
		ВызватьИсключение ФабрикаОшибок.АргументНеЗаполнен(ИмяАргумента, Сообщение);
	КонецЕсли;

КонецПроцедуры

// Проверяет допустимость аргумента и выбрасывает ошибку при нарушении контракта.
//
// Параметры:
//  ИмяАргумента - Строка - Имя проверяемого аргумента.
//  Условие - Булево - Результат проверки допустимости.
//  Ожидание - Строка - Описание допустимого значения или ограничения.
//  Сообщение - Строка - Необязательное описание ошибки.
Процедура ПроверитьДопустимость(ИмяАргумента, Условие, Ожидание, Сообщение = "") Экспорт

	ПроверитьИмяАргумента(ИмяАргумента);
	ПроверитьТипПараметра("Условие", Условие, Тип("Булево"));
	ПроверитьНепустуюСтроку("Ожидание", Ожидание);
	ПроверитьСообщение(Сообщение);

	Если Не Условие Тогда
		ВызватьИсключение ФабрикаОшибок.НедопустимоеЗначениеАргумента(
			ИмяАргумента,
			Ожидание,
			Сообщение
		);
	КонецЕсли;

КонецПроцедуры

// Проверяет равенство аргумента ожидаемому значению.
//
// Параметры:
//  ИмяАргумента - Строка - Имя проверяемого аргумента.
//  Значение - Произвольный - Проверяемое значение.
//  ОжидаемоеЗначение - Произвольный - Ожидаемое значение аргумента.
//  Сообщение - Строка - Необязательное описание ошибки.
Процедура ПроверитьРавенство(ИмяАргумента, Значение, ОжидаемоеЗначение, Сообщение = "") Экспорт

	ПроверитьИмяАргумента(ИмяАргумента);
	ПроверитьСообщение(Сообщение);

	Если Значение <> ОжидаемоеЗначение Тогда
		ВызватьИсключение ФабрикаОшибок.НедопустимоеЗначениеАргумента(
			ИмяАргумента,
			ПредставлениеЗначения(ОжидаемоеЗначение),
			Сообщение
		);
	КонецЕсли;

КонецПроцедуры

// Проверяет вхождение аргумента в набор допустимых значений.
//
// Параметры:
//  ИмяАргумента - Строка - Имя проверяемого аргумента.
//  Значение - Произвольный - Проверяемое значение.
//  ДопустимыеЗначения - Массив, ФиксированныйМассив - Набор допустимых значений.
//  Сообщение - Строка - Необязательное описание ошибки.
Процедура ПроверитьОдноИз(
	ИмяАргумента,
	Значение,
	ДопустимыеЗначения,
	Сообщение = ""
) Экспорт

	ПроверитьИмяАргумента(ИмяАргумента);
	ПроверитьДопустимыеЗначения(ДопустимыеЗначения);
	ПроверитьСообщение(Сообщение);

	Если ДопустимыеЗначения.Найти(Значение) = Неопределено Тогда
		ВызватьИсключение ФабрикаОшибок.НедопустимоеЗначениеАргумента(
			ИмяАргумента,
			ТекстДопустимыхЗначений(ДопустимыеЗначения),
			Сообщение
		);
	КонецЕсли;

КонецПроцедуры

// Проверяет нахождение аргумента во включительном диапазоне и выбрасывает ошибку при нарушении контракта.
//
// Параметры:
//  ИмяАргумента - Строка - Имя проверяемого аргумента.
//  Значение - Число, Дата - Проверяемое значение.
//  МинимальноеЗначение - Число, Дата - Включительная нижняя граница.
//  МаксимальноеЗначение - Число, Дата - Включительная верхняя граница.
//  Сообщение - Строка - Необязательное описание ошибки.
Процедура ПроверитьДиапазон(
	ИмяАргумента,
	Значение,
	МинимальноеЗначение,
	МаксимальноеЗначение,
	Сообщение = ""
) Экспорт

	ПроверитьИмяАргумента(ИмяАргумента);
	ПроверитьТип("Значение", Значение, ДопустимыеТипыДиапазона());
	ПроверитьТипПараметра("МинимальноеЗначение", МинимальноеЗначение, ТипЗнч(Значение));
	ПроверитьТипПараметра("МаксимальноеЗначение", МаксимальноеЗначение, ТипЗнч(Значение));
	ПроверитьСообщение(Сообщение);
	ПроверитьПорядокГраниц(МинимальноеЗначение, МаксимальноеЗначение);

	Если Значение < МинимальноеЗначение Или Значение > МаксимальноеЗначение Тогда
		ВызватьИсключение ФабрикаОшибок.АргументВнеДиапазона(
			ИмяАргумента,
			ТекстОжидаемогоДиапазона(МинимальноеЗначение, МаксимальноеЗначение),
			Сообщение
		);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьДопустимыеЗначения(Значение)

	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения <> Тип("Массив") И ТипЗначения <> Тип("ФиксированныйМассив") Тогда
		ВызватьИсключение ФабрикаОшибок.НеверныйТипАргумента(
			"ДопустимыеЗначения",
			НСтр("ru = 'Массив или ФиксированныйМассив'; en = 'Array or FixedArray'"),
			Значение
		);
	КонецЕсли;

	Если Значение.Количество() = 0 Тогда
		ВызватьИсключение ФабрикаОшибок.АргументНеЗаполнен("ДопустимыеЗначения");
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьДопустимыеТипы(Значение)

	ТипЗначения = ТипЗнч(Значение);

	ДопустимыеФормыЗначения = Новый Массив;
	ДопустимыеФормыЗначения.Добавить(Тип("Тип"));
	ДопустимыеФормыЗначения.Добавить(Тип("ОписаниеТипов"));
	ДопустимыеФормыЗначения.Добавить(Тип("Строка"));
	ДопустимыеФормыЗначения.Добавить(Тип("Массив"));
	ДопустимыеФормыЗначения.Добавить(Тип("ФиксированныйМассив"));

	ПроверитьТипВНаборе("ДопустимыеТипы", Значение, ДопустимыеФормыЗначения);

	Если ТипЗначения = Тип("Тип") Тогда
		Возврат;
	КонецЕсли;

	Если ТипЗначения = Тип("ОписаниеТипов") Тогда
		ПроверитьЗаполненность("ДопустимыеТипы", Значение.Типы());
		Возврат;
	Иначе
		ПроверитьЗаполненность("ДопустимыеТипы", Значение);
	КонецЕсли;

	Если ТипЗначения = Тип("Строка") Тогда
		МассивТиповИзСтроки(Значение, "ДопустимыеТипы");
	Иначе
		Для Каждого ДопустимыйТип Из Значение Цикл
			ПроверитьТипВНаборе("ДопустимыеТипы", ДопустимыйТип, "Тип, Строка");
			ПреобразоватьВТип("ДопустимыеТипы", ДопустимыйТип);
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

Функция МассивТиповИзСтроки(СтрокаТипов, ИмяПараметра)

	Результат = Новый Массив;
	Для Каждого ИмяТипа Из СтрРазделить(СтрокаТипов, ",", Истина) Цикл
		Результат.Добавить(ПреобразоватьВТип(ИмяПараметра, СокрЛП(ИмяТипа)));
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция МассивДопустимыхТипов(ДопустимыеТипы)

	Если ТипЗнч(ДопустимыеТипы) = Тип("Тип") Тогда
		Результат = Новый Массив;
		Результат.Добавить(ДопустимыеТипы);
		Возврат Результат;
	ИначеЕсли ТипЗнч(ДопустимыеТипы) = Тип("ОписаниеТипов") Тогда
		Возврат ДопустимыеТипы.Типы();
	ИначеЕсли ТипЗнч(ДопустимыеТипы) = Тип("Строка") Тогда
		Возврат МассивТиповИзСтроки(ДопустимыеТипы, "ДопустимыеТипы");
	Иначе
		Результат = Новый Массив;
		Для Каждого ДопустимыйТип Из ДопустимыеТипы Цикл
			Результат.Добавить(ПреобразоватьВТип("ДопустимыеТипы", ДопустимыйТип));
		КонецЦикла;
	КонецЕсли;

	Возврат Результат;

КонецФункции

Процедура ПроверитьТипВНаборе(ИмяАргумента, Значение, ДопустимыеТипы, Сообщение = "")

	ОписаниеТипов = Новый ОписаниеТипов(МассивДопустимыхТипов(ДопустимыеТипы));

	Если Не ОписаниеТипов.СодержитТип(ТипЗнч(Значение)) Тогда
		ВызватьИсключение ФабрикаОшибок.НеверныйТипАргумента(
			ИмяАргумента,
			ТекстДопустимыхТипов(ДопустимыеТипы),
			Значение,
			Сообщение
		);
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьИмяАргумента(Значение)

	ПроверитьНепустуюСтроку("ИмяАргумента", Значение);

КонецПроцедуры

Процедура ПроверитьСообщение(Значение)

	ПроверитьТипПараметра("Сообщение", Значение, Тип("Строка"));

КонецПроцедуры

Процедура ПроверитьНепустуюСтроку(ИмяПараметра, Значение)

	ПроверитьТипПараметра(ИмяПараметра, Значение, Тип("Строка"));

	Если ПустаяСтрока(Значение) Тогда
		ВызватьИсключение ФабрикаОшибок.АргументНеЗаполнен(ИмяПараметра);
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьТипПараметра(ИмяПараметра, Значение, ОжидаемыйТип)

	Если ТипЗнч(Значение) <> ОжидаемыйТип Тогда
		ВызватьИсключение ФабрикаОшибок.НеверныйТипАргумента(
			ИмяПараметра,
			Строка(ОжидаемыйТип),
			Значение
		);
	КонецЕсли;

КонецПроцедуры

Функция ПреобразоватьВТип(ИмяПараметра, Значение)

	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Тип") Тогда
		Возврат Значение;
	ИначеЕсли ТипЗначения = Тип("Строка") Тогда
		Попытка
			Возврат Тип(Значение);
		Исключение
			ВызватьИсключение ФабрикаОшибок.НеверныйТипАргумента(
				ИмяПараметра,
				НСтр(
					"ru = 'Тип или зарегистрированное имя типа';"
					+ "en = 'Type or registered type name'"
				),
				Значение
			);
		КонецПопытки;
	КонецЕсли;

	ВызватьИсключение ФабрикаОшибок.НеверныйТипАргумента(
		ИмяПараметра,
		НСтр("ru = 'Тип или Строка'; en = 'Type or String'"),
		Значение
	);

КонецФункции

Функция ДопустимыеТипыДиапазона()

	Типы = Новый Массив;
	Типы.Добавить(Тип("Число"));
	Типы.Добавить(Тип("Дата"));

	Возврат Типы;

КонецФункции

Процедура ПроверитьПорядокГраниц(МинимальноеЗначение, МаксимальноеЗначение)

	Если МинимальноеЗначение > МаксимальноеЗначение Тогда
		ВызватьИсключение ФабрикаОшибок.НедопустимоеЗначениеАргумента(
			"МинимальноеЗначение",
			НСтр(
				"ru = 'быть не больше МаксимальногоЗначения';"
				+ "en = 'not exceed MaximumValue'"
			)
		);
	КонецЕсли;

КонецПроцедуры

Функция ТекстОжидаемогоДиапазона(МинимальноеЗначение, МаксимальноеЗначение)

	Возврат СтрШаблон(
		НСтр("ru = 'от %1 до %2 включительно'; en = 'from %1 to %2 inclusive'"),
		МинимальноеЗначение,
		МаксимальноеЗначение
	);

КонецФункции

Функция ТекстДопустимыхТипов(ДопустимыеТипы)

	Представления = Новый Массив;
	Для Каждого ДопустимыйТип Из МассивДопустимыхТипов(ДопустимыеТипы) Цикл
		Представления.Добавить(Строка(ДопустимыйТип));
	КонецЦикла;

	Если Представления.Количество() = 1 Тогда
		Возврат Представления[0];
	КонецЕсли;

	ПоследнееПредставление = Представления[Представления.ВГраница()];
	ВсеКромеПоследнего = Новый Массив;
	Для Индекс = 0 По Представления.ВГраница() - 1 Цикл
		ВсеКромеПоследнего.Добавить(Представления[Индекс]);
	КонецЦикла;

	Возврат СтрШаблон(
		НСтр("ru = '%1 или %2'; en = '%1 or %2'"),
		СтрСоединить(ВсеКромеПоследнего, ", "),
		ПоследнееПредставление
	);

КонецФункции

Функция ПредставлениеЗначения(Значение)

	Если Значение = Неопределено Тогда
		Возврат НСтр("ru = 'Неопределено'; en = 'Undefined'");
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Строка") И Значение = "" Тогда
		Возврат НСтр("ru = 'пустая строка'; en = 'empty string'");
	КонецЕсли;

	Попытка
		Возврат Строка(Значение);
	Исключение
		Возврат СтрШаблон("<%1>", Строка(ТипЗнч(Значение)));
	КонецПопытки;

КонецФункции

Функция ТекстДопустимыхЗначений(ДопустимыеЗначения)

	Представления = Новый Массив;
	Для Каждого ДопустимоеЗначение Из ДопустимыеЗначения Цикл
		Представления.Добавить(ПредставлениеЗначения(ДопустимоеЗначение));
	КонецЦикла;

	Возврат СтрШаблон(
		НСтр("ru = 'одно из значений: %1'; en = 'one of the values: %1'"),
		СтрСоединить(Представления, ", ")
	);

КонецФункции

Функция ЗаполненоИлиНеПоддерживается(Значение)

	Попытка
		Возврат ЗначениеЗаполнено(Значение);
	Исключение
		Возврат Истина;
	КонецПопытки;

КонецФункции

#КонецОбласти
