&Тест
Процедура ТестДолжен_ОдинРазЗагрузитьПоставщикаПоТипу() Экспорт

	// Подготовка
	УстановитьПеременнуюСреды("OSCRIPT_ERRORS_TEST_PROVIDER_CONSTRUCTORS", "0");
	УстановитьПеременнуюСреды("OSCRIPT_ERRORS_TEST_PROVIDER_CALLS", "0");

	Классификатор = Новый КлассификаторОшибок;
	Классификатор.ДобавитьПоставщикаПравил(Тип("ТестовыйПоставщикПравил"));

	// Действие
	ПервыйРезультат = Классификатор.Классифицировать(ОшибкаССообщением("Сообщение поставщика"));
	ВторойРезультат = Классификатор.Классифицировать(ОшибкаССообщением("Сообщение поставщика"));

	// Проверка
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(ПервыйРезультат)).Равно("test.provider");
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(ВторойРезультат)).Равно("test.provider");
	Ожидаем.Что(ПолучитьПеременнуюСреды("OSCRIPT_ERRORS_TEST_PROVIDER_CONSTRUCTORS")).Равно("1");
	Ожидаем.Что(ПолучитьПеременнуюСреды("OSCRIPT_ERRORS_TEST_PROVIDER_CALLS")).Равно("1");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьПорядокПравилПередПоставщиком() Экспорт

	// Подготовка
	Поставщик = Новый ТестовыйПоставщикПравил(
		ПравилаДляСообщенияСОписанием("Общее сообщение", "test.same", "Второе описание")
	);

	Классификатор = Новый КлассификаторОшибок;
	Классификатор.ДобавитьПравила(
		ПравилаДляСообщенияСОписанием("Общее сообщение", "test.same", "Первое описание")
	);
	Классификатор.ДобавитьПоставщикаПравил(Поставщик);

	// Действие
	Результат = Классификатор.Классифицировать(ОшибкаССообщением("Общее сообщение"));

	// Проверка
	Ожидаем.Что(Новый СнимокКадраОшибки(Результат).Сообщение()).Равно("Первое описание");

КонецПроцедуры

