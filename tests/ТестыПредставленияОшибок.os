&Тест
Процедура ТестДолжен_ПредставитьКлассифицированнуюПричинуСПараметрами() Экспорт

	// Подготовка
	Причина = КонструкторыОшибок.Создать(
		"db.timeout",
		"Превышено время ожидания",
		Новый Структура("Секунды", 30)
	)
		.Подсказка("Повторите запрос")
		.Построить();
	Ошибка = ФабрикаОшибок.Обернуть(
		Причина,
		"profile.load_failed",
		"Не удалось загрузить профиль",
		Новый Структура("Пользователь", 42)
	);

	// Действие
	Представление = ДиагностикаОшибок.Исследовать(Ошибка).ДиагностическоеПредставление();

	// Проверка
	Ожидаем.Что(Представление).Равно("profile.load_failed: Не удалось загрузить профиль
	|
	|Данные:
	|  Пользователь: 42
	|
	|Причина:
	|  db.timeout: Превышено время ожидания
	|    Данные:
	|      Секунды: 30
	|
	|Подсказка:
	|  Повторите запрос");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВывестиМестоИсходнуюСтрокуИСтекРеальнойОшибки() Экспорт

	// Подготовка
	Цепочка = ПомощникТестированияОшибок.ЦепочкаСРазнымиМестамиСоздания();
	ВнешнийКадр = Новый СнимокКадраОшибки(Цепочка.ВнешнийКадр);
	ВнутреннийКадр = Новый СнимокКадраОшибки(Цепочка.ВнутреннийКадр);

	// Действие
	Представление = ДиагностикаОшибок.Исследовать(Цепочка.Ошибка).ДиагностическоеПредставление();

	// Проверка
	ОжидаемоеПредставление = ПредставлениеРеальнойОшибки(ВнешнийКадр, ВнутреннийКадр);
	Ожидаем.Что(Представление).Равно(ОжидаемоеПредставление);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьТолькоСообщениеТекущегоВнешнегоКадра() Экспорт

	// Подготовка
	Цепочка = ПомощникТестированияОшибок.ЦепочкаСРазнымиМестамиСоздания();

	// Действие
	Представление = ДиагностикаОшибок.Исследовать(Цепочка.Ошибка).ПользовательскоеПредставление();

	// Проверка
	Ожидаем.Что(Представление).Равно("Не удалось загрузить настройки приложения");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьТолькоТекущийКонтекстУсеченнойЦепочки() Экспорт

	// Подготовка
	Ошибка = ФабрикаОшибок.Создать("core.failed", "Непросмотренная причина");
	Для Номер = 1 По 64 Цикл
		Ошибка = ФабрикаОшибок.СКонтекстом(Ошибка, "Контекст " + Строка(Номер));
	КонецЦикла;

	// Действие
	Представление = ДиагностикаОшибок.Исследовать(Ошибка).ПользовательскоеПредставление();

	// Проверка
	Ожидаем.Что(Представление).Равно("Контекст 64");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьПользовательскоеПредставлениеТекущегоКадра() Экспорт

	// Подготовка
	Цепочка = СмешаннаяЦепочка();

	// Действие
	Представление = ДиагностикаОшибок.Исследовать(Цепочка.Ошибка).ПользовательскоеПредставление();

	// Проверка
	Ожидаем.Что(Представление).Равно(
		"config.load_failed: Загрузка конфигурации -> Не удалось загрузить конфигурацию"
	);
	Ожидаем.Что(Представление).ЭтоНе().Содержит("Данные:");
	Ожидаем.Что(Представление).ЭтоНе().Содержит("Стек вызовов:");
	Ожидаем.Что(Представление).ЭтоНе().Содержит("В файле конфигурации обнаружен некорректный JSON");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьПользовательскоеПредставлениеСПодсказкойИURL() Экспорт

	// Подготовка
	Ошибка = КонструкторыОшибок.Создать("config.invalid", "Ошибка конфигурации")
		.Подсказка("Проверьте формат файла")
		.URL("https://example.org/errors/config-invalid")
		.Построить();

	// Действие
	Представление = ДиагностикаОшибок.Исследовать(Ошибка).ПользовательскоеПредставление();

	// Проверка
	ОжидаемоеПредставление = "config.invalid: Ошибка конфигурации
	|
	|Подсказка:
	|  Проверьте формат файла
	|
	|URL:
	|  https://example.org/errors/config-invalid";
	Ожидаем.Что(Представление).Равно(ОжидаемоеПредставление);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьКонтекстЧерезВнешнююОбертку() Экспорт

	// Подготовка
	Причина = ФабрикаОшибок.Создать("service.unavailable", "Сервис недоступен");
	Обертка = ПомощникТестированияОшибок.ВнешняяОшибка("Служебная обёртка", Причина);
	Ошибка = ФабрикаОшибок.СКонтекстом(Обертка, "Вызов сервиса");

	// Действие
	Представление = ДиагностикаОшибок.Исследовать(Ошибка).ПользовательскоеПредставление();

	// Проверка
	Ожидаем.Что(Представление).Содержит("Вызов сервиса");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОпуститьПричинуПодробногоПредставленияПриУсечении() Экспорт

	// Подготовка
	Цепочка = ДлиннаяЦепочка(65);

	// Действие
	Представление = ДиагностикаОшибок.Исследовать(Цепочка.Ошибка).ПользовательскоеПредставление();

	// Проверка
	Ожидаем.Что(Представление).Равно("Внешний кадр 65");
	Ожидаем.Что(Представление).ЭтоНе().Содержит("Причина:");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СмешаннаяЦепочка()

	ДанныеВнутреннейОшибки = Новый Структура("Путь", "config.json");
	ВнутренняяОшибка = ФабрикаОшибок.Создать("fs.file_not_found", "Файл не найден", ДанныеВнутреннейОшибки);
	ВнешняяОшибка = ПомощникТестированияОшибок.ВнешняяОшибка(
		"В файле конфигурации обнаружен некорректный JSON",
		ВнутренняяОшибка
	);
	ЭффективнаяОшибка = ФабрикаОшибок.Обернуть(
		ВнешняяОшибка,
		"config.load_failed",
		"Не удалось загрузить конфигурацию",
		Новый Структура("Формат", "JSON")
	);
	Контекст = ФабрикаОшибок.СКонтекстом(
		ЭффективнаяОшибка,
		"Загрузка конфигурации",
		Новый Структура("Операция", "Загрузка")
	);

	Возврат Новый Структура("Ошибка", Контекст);

КонецФункции

Функция ДлиннаяЦепочка(Длина)

	Ошибка = ПомощникТестированияОшибок.ВнешняяОшибка("Внешний кадр 1");

	Для НомерКадра = 2 По Длина Цикл
		Ошибка = ПомощникТестированияОшибок.ВнешняяОшибка(
			СтрШаблон("Внешний кадр %1", НомерКадра),
			Ошибка
		);
	КонецЦикла;

	Возврат Новый Структура("Ошибка", Ошибка);

КонецФункции

Функция ПредставлениеУсеченнойЦепочки(Длина)

	Причины = Новый Массив;
	Для НомерПричины = 1 По 63 Цикл
		НомерВнешнегоКадра = Длина - НомерПричины;
		Причины.Добавить(
			"  " + Строка(НомерПричины) + ": Внешний кадр " + Строка(НомерВнешнегоКадра)
		);
	КонецЦикла;

	Возврат "Внешний кадр " + Строка(Длина) + Символы.ПС + Символы.ПС
		+ "Причина:" + Символы.ПС
		+ СоединитьСтроки(Причины, Символы.ПС) + Символы.ПС + Символы.ПС
		+ "Цепочка причин усечена";

КонецФункции

Функция ПредставлениеПолнойЦепочки(Длина)

	Причины = Новый Массив;
	Для НомерПричины = 1 По Длина - 1 Цикл
		НомерВнешнегоКадра = Длина - НомерПричины;
		Причины.Добавить(
			"  " + Строка(НомерПричины) + ": Внешний кадр " + Строка(НомерВнешнегоКадра)
		);
	КонецЦикла;

	Возврат "Внешний кадр " + Строка(Длина) + Символы.ПС + Символы.ПС
		+ "Причина:" + Символы.ПС
		+ СоединитьСтроки(Причины, Символы.ПС);

КонецФункции

Функция ПредставлениеРеальнойОшибки(ВнешнийКадр, ВнутреннийКадр)

	СтрокиСтека = Новый Массив;
	Нумеровать = ВнешнийКадр.Стек().Количество() > 1;
	Для Номер = 0 По ВнешнийКадр.Стек().ВГраница() Цикл
		Маркер = ?(Нумеровать, Строка(Номер + 1) + ": ", "");
		СтрокиСтека.Добавить("  " + Маркер + Строка(ВнешнийКадр.Стек()[Номер]));
	КонецЦикла;

	Возврат "Не удалось загрузить настройки приложения" + Символы.ПС
		+ "Место: " + МестоКадра(ВнешнийКадр) + Символы.ПС
		+ "Исходная строка: " + СокрЛП(ВнешнийКадр.ИсходнаяСтрока()) + Символы.ПС + Символы.ПС
		+ "Причина:" + Символы.ПС
		+ "  Файл settings.json не найден" + Символы.ПС
		+ "    Место: " + МестоКадра(ВнутреннийКадр) + Символы.ПС
		+ "    Исходная строка: " + СокрЛП(ВнутреннийКадр.ИсходнаяСтрока()) + Символы.ПС + Символы.ПС
		+ "Стек вызовов:" + Символы.ПС
		+ СоединитьСтроки(СтрокиСтека, Символы.ПС);

КонецФункции

Функция ПредставлениеКонтекстовБезПричины()

	Строки = Новый Массив;
	Строки.Добавить("Контекст без просмотренной причины:");
	Номер = 64;
	Пока Номер >= 1 Цикл
		Строки.Добавить("  - Контекст " + Строка(Номер));
		Номер = Номер - 1;
	КонецЦикла;
	Строки.Добавить("");
	Строки.Добавить("Цепочка причин усечена");

	Возврат СоединитьСтроки(Строки, Символы.ПС);

КонецФункции

Функция МестоКадра(Снимок)

	Возврат Снимок.ИмяМодуля() + ":" + Строка(Снимок.НомерСтроки());

КонецФункции

Функция СоединитьСтроки(Строки, Разделитель)

	Результат = "";
	Для Каждого ТекущаяСтрока Из Строки Цикл
		Если Не ПустаяСтрока(Результат) Тогда
			Результат = Результат + Разделитель;
		КонецЕсли;
		Результат = Результат + ТекущаяСтрока;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция Пробелы(Количество)

	Результат = "";
	Для Номер = 1 По Количество Цикл
		Результат = Результат + " ";
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти
