// Демонстрирует проверки значений и прямой вызов стандартных ошибок.
// Все ожидаемые ошибки перехватываются и не прерывают выполнение сценария.

#Использовать errors

Процедура СообщитьКодОшибки(Ошибка)

	Снимок = Новый СнимокКадраОшибки(Ошибка);
	Сообщить(Снимок.КодОшибки() + ": " + Снимок.Сообщение());

КонецПроцедуры

Попытка
	ПроверкаАргументов.ПроверитьДиапазон("Порт", 70000, 1, 65535);
Исключение
	СообщитьКодОшибки(ИнформацияОбОшибке());
КонецПопытки;

Попытка
	ВызватьИсключение ФабрикаОшибок.ОперацияВНедопустимомСостоянии("Публикация");
Исключение
	СообщитьКодОшибки(ИнформацияОбОшибке());
КонецПопытки;

Попытка
	ВызватьИсключение ФабрикаОшибок.РесурсНеНайден("Настройки приложения");
Исключение
	СообщитьКодОшибки(ИнформацияОбОшибке());
КонецПопытки;

Попытка
	ВызватьИсключение ФабрикаОшибок.КодировкаНеПоддерживается("UTF-7");
Исключение
	СообщитьКодОшибки(ИнформацияОбОшибке());
КонецПопытки;

Попытка
	ВызватьИсключение ФабрикаОшибок.НарушенВнутреннийИнвариант("Состояние задачи согласовано");
Исключение
	СообщитьКодОшибки(ИнформацияОбОшибке());
КонецПопытки;
