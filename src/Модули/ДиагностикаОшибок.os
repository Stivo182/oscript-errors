#Использовать "../internal"

#Область ПрограммныйИнтерфейс

// Возвращает тип первой распознанной ошибки в физической цепочке.
//
// Параметры:
//  Ошибка - ИнформацияОбОшибке - Исследуемая ошибка.
//
// Возвращаемое значение:
//  Строка, Неопределено - Эффективный тип ошибки.
Функция ПолучитьТипОшибки(Ошибка) Экспорт

	Просмотр = ВнутреннееУстройствоОшибок.ПросмотретьЦепочку(Ошибка);

	Для Каждого Кадр Из Просмотр.Кадры Цикл
		СнимокКадра = Новый СнимокКадраОшибки(Кадр);
		Если СнимокКадра.Вид() = ВидыКадровОшибок.Ошибка Тогда
			Возврат СнимокКадра.ТипОшибки();
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Проверяет наличие ошибки указанного типа во всей просмотренной цепочке.
//
// Параметры:
//  Ошибка - ИнформацияОбОшибке - Исследуемая ошибка.
//  ТипОшибки - Строка - Искомый машинный тип ошибки.
//
// Возвращаемое значение:
//  Булево - Истина, если ошибка указанного типа найдена.
Функция ЭтоОшибка(Ошибка, ТипОшибки) Экспорт

	Возврат НайтиОшибку(Ошибка, ТипОшибки) <> Неопределено;

КонецФункции

// Находит первый кадр ошибки указанного типа.
//
// Параметры:
//  Ошибка - ИнформацияОбОшибке - Исследуемая ошибка.
//  ТипОшибки - Строка - Искомый машинный тип ошибки.
//
// Возвращаемое значение:
//  ИнформацияОбОшибке, Неопределено - Найденный исходный кадр ошибки.
Функция НайтиОшибку(Ошибка, ТипОшибки) Экспорт

	ПроверкаКадровОшибок.ПроверитьТипОшибки(ТипОшибки);

	Просмотр = ВнутреннееУстройствоОшибок.ПросмотретьЦепочку(Ошибка);

	Для Каждого Кадр Из Просмотр.Кадры Цикл
		СнимокКадра = Новый СнимокКадраОшибки(Кадр);
		Если СнимокКадра.Вид() = ВидыКадровОшибок.Ошибка
			И НРег(СнимокКадра.ТипОшибки()) = НРег(ТипОшибки) Тогда
			Возврат Кадр;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Возвращает пользовательские данные эффективной ошибки без преобразования.
//
// Параметры:
//  Ошибка - ИнформацияОбОшибке - Исследуемая ошибка.
//
// Возвращаемое значение:
//  Произвольный, Неопределено - Данные эффективной ошибки.
Функция Данные(Ошибка) Экспорт

	Просмотр = ВнутреннееУстройствоОшибок.ПросмотретьЦепочку(Ошибка);

	Для Каждого Кадр Из Просмотр.Кадры Цикл
		СнимокКадра = Новый СнимокКадраОшибки(Кадр);
		Если СнимокКадра.Вид() = ВидыКадровОшибок.Ошибка Тогда
			Возврат СнимокКадра.Данные();
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Возвращает первую непустую подсказку распознанной ошибки в физической цепочке.
//
// Параметры:
//  Ошибка - ИнформацияОбОшибке - Исследуемая ошибка.
//
// Возвращаемое значение:
//  Строка - Подсказка по исправлению или пустая строка, если она отсутствует.
Функция Подсказка(Ошибка) Экспорт

	Просмотр = ВнутреннееУстройствоОшибок.ПросмотретьЦепочку(Ошибка);

	Для Каждого Кадр Из Просмотр.Кадры Цикл
		СнимокКадра = Новый СнимокКадраОшибки(Кадр);
		Если СнимокКадра.Вид() = ВидыКадровОшибок.Ошибка
			И Не ПустаяСтрока(СнимокКадра.Подсказка()) Тогда
			Возврат СнимокКадра.Подсказка();
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// Возвращает распознанные контекстные кадры в физическом порядке.
//
// Параметры:
//  Ошибка - ИнформацияОбОшибке - Исследуемая ошибка.
//
// Возвращаемое значение:
//  Массив из ИнформацияОбОшибке - Новый массив исходных кадров контекста.
Функция Контексты(Ошибка) Экспорт

	Просмотр = ВнутреннееУстройствоОшибок.ПросмотретьЦепочку(Ошибка);
	Результат = Новый Массив;

	Для Каждого Кадр Из Просмотр.Кадры Цикл
		СнимокКадра = Новый СнимокКадраОшибки(Кадр);
		Если СнимокКадра.Вид() = ВидыКадровОшибок.Контекст Тогда
			Результат.Добавить(Кадр);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Возвращает все просмотренные физические кадры от внешнего к корневому.
//
// Параметры:
//  Ошибка - ИнформацияОбОшибке - Исследуемая ошибка.
//
// Возвращаемое значение:
//  Массив из ИнформацияОбОшибке - Новый массив исходных физических кадров.
Функция Цепочка(Ошибка) Экспорт

	Просмотр = ВнутреннееУстройствоОшибок.ПросмотретьЦепочку(Ошибка);
	Возврат Просмотр.Кадры;

КонецФункции

// Возвращает последний просмотренный физический кадр.
//
// Параметры:
//  Ошибка - ИнформацияОбОшибке - Исследуемая ошибка.
//
// Возвращаемое значение:
//  ИнформацияОбОшибке - Фактический корень или последний кадр усечённой цепочки.
Функция КорневаяПричина(Ошибка) Экспорт

	Кадры = Цепочка(Ошибка);

	Возврат Кадры[Кадры.ВГраница()];

КонецФункции

// Возвращает краткое человекочитаемое представление ошибки.
//
// Параметры:
//  Ошибка - ИнформацияОбОшибке - Представляемая ошибка.
//
// Возвращаемое значение:
//  Строка - Краткое представление эффективной ошибки и предшествующих контекстов.
Функция КраткоеПредставление(Ошибка) Экспорт

	Просмотр = ВнутреннееУстройствоОшибок.ПросмотретьЦепочку(Ошибка);
	Сообщения = Новый Массив;
	ПервоеСообщение = "";
	ПервыйКадрОбработан = Ложь;

	Для Каждого Кадр Из Просмотр.Кадры Цикл
		СнимокКадра = Новый СнимокКадраОшибки(Кадр);

		Если Не ПервыйКадрОбработан Тогда
			ПервоеСообщение = СнимокКадра.Сообщение();
			ПервыйКадрОбработан = Истина;
		КонецЕсли;

		Если СнимокКадра.Вид() = ВидыКадровОшибок.Контекст Тогда
			Сообщения.Добавить(СнимокКадра.Сообщение());
		ИначеЕсли СнимокКадра.Вид() = ВидыКадровОшибок.Ошибка Тогда
			Сообщения.Добавить(СнимокКадра.Сообщение());
			Возврат СтрШаблон(
				"%1: %2",
				СнимокКадра.ТипОшибки(),
				СоединитьСтроки(Сообщения, ": ")
			);
		КонецЕсли;
	КонецЦикла;

	Возврат ПервоеСообщение;

КонецФункции

// Возвращает подробный диагностический отчёт по всей просмотренной цепочке ошибки.
//
// Отчёт раскрывает поле Данные без маскирования и не ограничивает длину строк.
//
// Параметры:
//  Ошибка - ИнформацияОбОшибке - Представляемая ошибка.
//
// Возвращаемое значение:
//  Строка - Семантические группы ошибки, контекстов и причин.
Функция ПодробноеПредставление(Ошибка) Экспорт

	Просмотр = ВнутреннееУстройствоОшибок.ПросмотретьЦепочку(Ошибка);
	Снимки = Новый Массив;
	Для Каждого Кадр Из Просмотр.Кадры Цикл
		Снимки.Добавить(Новый СнимокКадраОшибки(Кадр));
	КонецЦикла;

	Возврат ФорматированиеПредставленияОшибок.ПодробноеПредставление(Снимки, Просмотр.Усечена);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоединитьСтроки(Строки, Разделитель)

	Результат = "";

	Для Каждого ТекущаяСтрока Из Строки Цикл
		Если Результат <> "" Тогда
			Результат = Результат + Разделитель;
		КонецЕсли;
		Результат = Результат + ТекущаяСтрока;
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти
