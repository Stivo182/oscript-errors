&Тест
Процедура ТестДолжен_ПредставитьНесколькоКонтекстовВФизическомПорядке() Экспорт

	// Подготовка
	Ошибка = ФабрикаОшибок.Создать("core.failed", "Операция завершилась ошибкой");
	Ошибка = ФабрикаОшибок.СКонтекстом(
		Ошибка,
		"Чтение файла",
		Новый Структура("Путь", "settings.json")
	);
	Ошибка = ФабрикаОшибок.СКонтекстом(
		Ошибка,
		"Загрузка настроек",
		Новый Структура("Попытка", 2)
	);

	// Действие
	Краткое = ДиагностикаОшибок.Исследовать(Ошибка).КраткоеПредставление();
	Диагностическое = ДиагностикаОшибок.Исследовать(Ошибка).ДиагностическоеПредставление();

	// Проверка
	Ожидаем.Что(Краткое).Равно("core.failed: Загрузка настроек -> Операция завершилась ошибкой");
	Ожидаем.Что(Диагностическое).Равно("core.failed: Операция завершилась ошибкой
	|
	|Контекст:
	|  - Загрузка настроек
	|    Данные:
	|      Попытка: 2
	|  - Чтение файла
	|    Данные:
	|      Путь: settings.json");

КонецПроцедуры

