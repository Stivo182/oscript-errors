#Использовать "../internal"

Перем _КодОшибки; // Строка
Перем _Сообщение; // Строка
Перем _Вид; // Строка
Перем _Данные; // Произвольный, Неопределено
Перем _РежимДанных; // Строка
Перем _Подсказка; // Строка
Перем _URL; // Строка
Перем _Причина; // ИнформацияОбОшибке, Неопределено

#Область ОбработчикиСобытий

// Создаёт fluent-построитель кадра ошибки.
//
// Параметры:
//  КодОшибки - Строка, Неопределено - Стабильный машинный код ошибки;
//      для кадра контекста должен быть равен Неопределено.
//  Сообщение - Строка - Человекочитаемое описание ошибки.
//  Вид - Строка, Неопределено - Вид создаваемого кадра: ВидыКадровОшибок.Ошибка()
//      или ВидыКадровОшибок.Контекст(). По умолчанию ВидыКадровОшибок.Ошибка().
Процедура ПриСозданииОбъекта(КодОшибки = Неопределено, Сообщение = "", Вид = Неопределено)

	_КодОшибки = КодОшибки;
	_Сообщение = Сообщение;
	_Вид = Вид;
	_Данные = Неопределено;
	_РежимДанных = "";
	_Подсказка = "";
	_URL = "";
	_Причина = Неопределено;

	Если _Вид = Неопределено Тогда
		_Вид = ВидыКадровОшибок.Ошибка();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Устанавливает стабильный машинный код ошибки.
//
// Параметры:
//  Значение - Строка, Неопределено - Стабильный машинный код ошибки.
//
// Возвращаемое значение:
//  ПостроительОшибки - Этот построитель.
Функция КодОшибки(Значение) Экспорт

	_КодОшибки = Значение;
	Возврат ЭтотОбъект;

КонецФункции

// Устанавливает человекочитаемое описание ошибки.
//
// Параметры:
//  Значение - Строка - Человекочитаемое описание ошибки.
//
// Возвращаемое значение:
//  ПостроительОшибки - Этот построитель.
Функция Сообщение(Значение) Экспорт

	_Сообщение = Значение;
	Возврат ЭтотОбъект;

КонецФункции

// Добавляет поле структурированных пользовательских данных ошибки.
// Повторный ключ заменяет ранее установленное значение.
// Нельзя использовать вместе с ПроизвольныеДанные.
//
// Параметры:
//  Ключ - Строка - Имя поля данных.
//  Значение - Произвольный - Значение поля данных.
//
// Возвращаемое значение:
//  ПостроительОшибки - Этот построитель.
Функция Данные(Ключ, Значение) Экспорт

	ПроверитьКлючДанных(Ключ);
	ПроверитьРежимДанных("Структурированные");

	_РежимДанных = "Структурированные";

	Если _Данные = Неопределено Тогда
		_Данные = Новый Структура;
	КонецЕсли;

	_Данные.Вставить(Ключ, Значение);
	Возврат ЭтотОбъект;

КонецФункции

// Устанавливает произвольные пользовательские данные ошибки.
// Повторный вызов заменяет ранее установленное значение.
// Значение передаётся в кадр по ссылке. Нельзя использовать вместе с Данные.
//
// Параметры:
//  Значение - Произвольный - Связанные с ошибкой данные.
//
// Возвращаемое значение:
//  ПостроительОшибки - Этот построитель.
Функция ПроизвольныеДанные(Значение) Экспорт

	ПроверитьРежимДанных("Произвольные");

	_РежимДанных = "Произвольные";
	_Данные = Значение;
	Возврат ЭтотОбъект;

КонецФункции

// Устанавливает подсказку по исправлению ошибки.
//
// Параметры:
//  Значение - Строка - Подсказка по исправлению ошибки.
//
// Возвращаемое значение:
//  ПостроительОшибки - Этот построитель.
Функция Подсказка(Значение) Экспорт

	_Подсказка = Значение;
	Возврат ЭтотОбъект;

КонецФункции

// Устанавливает адрес страницы с дополнительной информацией об ошибке.
//
// Параметры:
//  Значение - Строка - URL документации ошибки.
//
// Возвращаемое значение:
//  ПостроительОшибки - Этот построитель.
Функция URL(Значение) Экспорт

	_URL = Значение;
	Возврат ЭтотОбъект;

КонецФункции

// Устанавливает непосредственную причину ошибки.
//
// Параметры:
//  Значение - ИнформацияОбОшибке, Неопределено - Непосредственная причина.
//
// Возвращаемое значение:
//  ПостроительОшибки - Этот построитель.
Функция Причина(Значение) Экспорт

	_Причина = Значение;
	Возврат ЭтотОбъект;

КонецФункции

// Создаёт настроенный кадр ошибки.
// В Описание кадра записывается пользовательское представление только этого кадра.
//
// Возвращаемое значение:
//  ИнформацияОбОшибке - Новый кадр ошибки.
Функция Построить() Экспорт

	СервисыБиблиотекиОшибок.ПроверяющийКадрыОшибок().ПроверитьКадр(
		_Вид,
		_КодОшибки,
		_Сообщение,
		_Причина,
		_Подсказка,
		_URL
	);

	ДанныеКадра = ДанныеДляПостроения();

	Если _Вид = ВидыКадровОшибок.Ошибка() Тогда
		Создатель = СервисыБиблиотекиОшибок.СоздательКонвертаОшибки();
		Возврат Создатель.СоздатьОшибкуПоПолям(
			_КодОшибки,
			_Сообщение,
			ДанныеКадра,
			_Подсказка,
			_URL,
			_Причина
		);
	КонецЕсли;

	КодЭффективнойОшибки = Неопределено;
	СообщениеЭффективнойОшибки = "";

	ЗаполнитьЭффективнуюОшибку(КодЭффективнойОшибки, СообщениеЭффективнойОшибки);

	Описание = СервисыБиблиотекиОшибок.ФорматировщикПредставленияОшибок().ПользовательскоеПредставлениеКадра(
		_Вид,
		_КодОшибки,
		_Сообщение,
		_Подсказка,
		_URL,
		КодЭффективнойОшибки,
		СообщениеЭффективнойОшибки
	);

	Возврат СоздатьКонтекст(
		Описание,
		ДанныеКадра,
		КодЭффективнойОшибки,
		СообщениеЭффективнойОшибки
	);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьКонтекст(Описание, Данные, КодЭффективнойОшибки, СообщениеЭффективнойОшибки)

	Создатель = СервисыБиблиотекиОшибок.СоздательКонвертаОшибки();

	Возврат Создатель.СоздатьКонтекст(
		Описание,
		_Сообщение,
		_Причина,
		Данные,
		КодЭффективнойОшибки,
		СообщениеЭффективнойОшибки
	);

КонецФункции

Процедура ЗаполнитьЭффективнуюОшибку(КодОшибки, Сообщение)

	ПроверяющийКадрыОшибок = СервисыБиблиотекиОшибок.ПроверяющийКадрыОшибок();

	Попытка
		ПараметрыПричины = _Причина.Параметры;
		Если ТипЗнч(ПараметрыПричины) <> Тип("ФиксированнаяСтруктура")
			Или Не ЭтоМетаданныеНашегоКадра(ПараметрыПричины) Тогда
			Возврат;
		КонецЕсли;

		Если ПараметрыПричины.Свойство("КодЭффективнойОшибки", КодОшибки)
			И ПараметрыПричины.Свойство("СообщениеЭффективнойОшибки", Сообщение)
			И ПроверяющийКадрыОшибок.КорректныйКодОшибки(КодОшибки)
			И ПроверяющийКадрыОшибок.КорректноеСообщение(Сообщение) Тогда
			Возврат;
		КонецЕсли;

		КодОшибки = Неопределено;
		Сообщение = "";
		Если ПараметрыПричины.Вид = ВидыКадровОшибок.Ошибка()
			И ПроверяющийКадрыОшибок.КорректныйКодОшибки(ПараметрыПричины.КодОшибки)
			И ПроверяющийКадрыОшибок.КорректноеСообщение(ПараметрыПричины.Сообщение) Тогда
			КодОшибки = ПараметрыПричины.КодОшибки;
			Сообщение = ПараметрыПричины.Сообщение;
		КонецЕсли;
	Исключение
		СервисыБиблиотекиОшибок.РегистраторСбоевБиблиотекиОшибок().ЗаписатьПодавленныйСбой(
			"builder.read_effective_error",
			_Причина,
			ИнформацияОбОшибке()
		);
		КодОшибки = Неопределено;
		Сообщение = "";
	КонецПопытки;

КонецПроцедуры

Функция ЭтоМетаданныеНашегоКадра(Параметры)

	Маркер = Неопределено;
	ВерсияФормата = Неопределено;
	Вид = Неопределено;
	КодОшибки = Неопределено;
	Сообщение = Неопределено;

	ОписаниеФорматаКадраОшибки = СервисыБиблиотекиОшибок.ОписаниеФорматаКадраОшибки();

	Возврат Параметры.Свойство("Маркер", Маркер)
		И Маркер = ОписаниеФорматаКадраОшибки.МаркерМетаданных()
		И Параметры.Свойство("ВерсияФормата", ВерсияФормата)
		И ВерсияФормата = ОписаниеФорматаКадраОшибки.ВерсияФормата()
		И Параметры.Свойство("Вид", Вид)
		И Параметры.Свойство("КодОшибки", КодОшибки)
		И Параметры.Свойство("Сообщение", Сообщение);

КонецФункции

Процедура ПроверитьКлючДанных(Ключ)

	ПроверкаАргументов.ПроверитьТип("Ключ", Ключ, Тип("Строка"));
	ПроверкаАргументов.ПроверитьЗаполненность("Ключ", Ключ);

	Попытка
		ПроверочныеДанные = Новый Структура;
		ПроверочныеДанные.Вставить(Ключ, Неопределено);
	Исключение
		ПроверкаАргументов.ПроверитьДопустимость(
			"Ключ",
			Ложь,
			НСтр(
				"ru = 'быть допустимым именем поля структуры';"
					+ "en = 'be a valid structure field name'"
			)
		);
	КонецПопытки;

КонецПроцедуры

Процедура ПроверитьРежимДанных(ОжидаемыйРежим)

	Если _РежимДанных = "" Или _РежимДанных = ОжидаемыйРежим Тогда
		Возврат;
	КонецЕсли;

	ВызватьИсключение ОшибкаСмешиванияРежимовДанных();

КонецПроцедуры

Функция ОшибкаСмешиванияРежимовДанных()

	КодОшибки = "operation.invalid_state";
	Сообщение = НСтр(
		"ru = 'Нельзя смешивать структурированные и произвольные данные ошибки';"
			+ "en = 'Structured and arbitrary error data cannot be mixed'"
	);
	Данные = Новый Структура(
		"ИмяОперации",
		НСтр("ru = 'Настройка данных ошибки'; en = 'Configuring error data'")
	);
	Вид = ВидыКадровОшибок.Ошибка();

	Описание = СервисыБиблиотекиОшибок.ФорматировщикПредставленияОшибок().КраткоеПредставлениеКадра(
		Вид,
		КодОшибки,
		Сообщение,
		КодОшибки,
		Сообщение
	);

	Создатель = СервисыБиблиотекиОшибок.СоздательКонвертаОшибки();
	Возврат Создатель.СоздатьОшибку(
		Описание,
		КодОшибки,
		Сообщение,
		Данные
	);

КонецФункции

Функция ДанныеДляПостроения()

	Если _РежимДанных <> "Структурированные" Тогда
		Возврат _Данные;
	КонецЕсли;

	Результат = Новый Структура;
	Для Каждого Элемент Из _Данные Цикл
		Результат.Вставить(Элемент.Ключ, Элемент.Значение);
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти
