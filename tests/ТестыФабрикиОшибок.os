&ПараметризованныйТест
&ИсточникЗначение("a.b")
&ИсточникЗначение("a.b.c")
&ИсточникЗначение("a1_b2.c3_d4")
&ИсточникЗначение("A.B")
&ИсточникЗначение("Ошибка.Сети")
&ИсточникЗначение("съёмка.Ёлка_2")
&ИсточникЗначение("error.Ошибка")
&ИсточникЗначение("database.postgres.connection_failed")
Процедура ТестДолжен_ПринятьКорректныйКодОшибки(ПроверяемыйКодОшибки) Экспорт

	// Действие
	Ошибка = ФабрикаОшибок.Создать(ПроверяемыйКодОшибки, "Сообщение");

	// Проверка
	Ожидаем.Что(ТипЗнч(Ошибка)).Равно(Тип("ИнформацияОбОшибке"));

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("")
&ИсточникЗначение("a")
&ИсточникЗначение(".b")
&ИсточникЗначение("a.")
&ИсточникЗначение("1a.b")
&ИсточникЗначение("_a.b")
&ИсточникЗначение("a.1b")
&ИсточникЗначение("a._b")
&ИсточникЗначение("a-b.c")
&ИсточникЗначение("a.b-c")
&ИсточникЗначение("a b.c")
Процедура ТестДолжен_ОтклонитьНекорректныйФорматКодаОшибки(ПроверяемыйКодОшибки) Экспорт

	// Подготовка
	Параметры = Новый Массив;
	Параметры.Добавить(ПроверяемыйКодОшибки);
	Параметры.Добавить("Сообщение");

	// Действие и Проверка
	ПроверитьИсключениеМетода(
		"Создать",
		Параметры,
		НСтр("ru = 'Код ошибки имеет неверный формат'; en = 'Error code has an invalid format'")
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьНестроковыйКодОшибки() Экспорт

	// Подготовка
	Параметры = Новый Массив;
	Параметры.Добавить(42);
	Параметры.Добавить("Сообщение");

	// Действие и Проверка
	ПроверитьИсключениеМетода(
		"Создать",
		Параметры,
		СтрШаблон(
			НСтр("ru = 'Аргумент ''%1'' должен иметь тип %2'; en = 'Argument ''%1'' must be of type %2'"),
			"КодОшибки",
			Строка(Тип("Строка"))
		)
	);

КонецПроцедуры

