	Ошибка = Новый ИнформацияОбОшибке(
		"http.proxy_error: Ошибка прокси",
		Новый ФиксированнаяСтруктура(Поля)
	);

	// Действие
	Снимок = Новый СнимокКадраОшибки(Ошибка);

	// Проверка
	Ожидаем.Что(Снимок.Вид()).Равно(ВидыКадровОшибок.Ошибка());
	Ожидаем.Что(Снимок.Сообщение()).Равно("Ошибка прокси");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьСнимок(Ошибка) Экспорт

	Возврат Новый СнимокКадраОшибки(Ошибка);

КонецФункции

Процедура ПроверитьКонтрактноеИсключениеГруппы(
	Ошибка,
	ОжидаемыйКодОшибки,
	ИмяПоля,
	ОжидаемоеЗначение
)

	Если Ошибка = Неопределено Тогда
		ВызватьИсключение "Ожидалось контрактное исключение";
	КонецЕсли;

	Снимок = Новый СнимокКадраОшибки(Ошибка);
	Ожидаем.Что(Снимок.КодОшибки()).Равно(ОжидаемыйКодОшибки);
	Ожидаем.Что(Снимок.Данные().ИмяАргумента).Равно("ГруппаОшибок");
	Ожидаем.Что(Снимок.Данные()[ИмяПоля]).Равно(ОжидаемоеЗначение);

КонецПроцедуры

#КонецОбласти
