#Область Тесты

&Тест
Процедура ТестДолжен_СоздатьСнимокСобственногоКадра() Экспорт

	// Подготовка
	Данные = Новый Структура("Путь", "config.json");
	Ошибка = ФабрикаОшибок.Создать("fs.file_not_found", "Файл не найден", Данные);
	Ошибка = ПомощникТестированияОшибок.ПовторноВыброшеннаяОшибка(Ошибка);

	// Действие
	Снимок = Новый СнимокКадраОшибки(Ошибка);

	// Проверка
	Ожидаем.Что(ТипЗнч(Снимок)).Равно(Тип("СнимокКадраОшибки"));
	Ожидаем.Что(Снимок.Вид()).Равно("Ошибка");
	Ожидаем.Что(Снимок.ТипОшибки()).Равно("fs.file_not_found");
	Ожидаем.Что(Снимок.Сообщение()).Равно("Файл не найден");
	Ожидаем.Что(Снимок.Данные()).Равно(Данные);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьИсходнуюОшибкуИзСнимка() Экспорт

	// Подготовка
	Ошибка = ФабрикаОшибок.Создать("core.failed", "Ошибка");

	// Действие
	Снимок = Новый СнимокКадраОшибки(Ошибка);

	// Проверка
	Ожидаем.Что(Снимок.ИсходнаяОшибка()).Равно(Ошибка);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьИсходныеКадрыПриПросмотреЦепочки() Экспорт

	// Подготовка
	Ошибка = ФабрикаОшибок.Создать("core.failed", "Ошибка");
	Ошибка = ПомощникТестированияОшибок.ПовторноВыброшеннаяОшибка(Ошибка);

	// Действие
	Просмотр = ОбходЦепочкиОшибки.Просмотреть(Ошибка);

	// Проверка
	Ожидаем.Что(Просмотр.Кадры[0]).Равно(Ошибка);

КонецПроцедуры

&Тест
Процедура ТестДолжен_УказатьУсечениеФизическойЦепочки() Экспорт

	// Подготовка
	ЦепочкаИз64Кадров = ПомощникТестированияОшибок.ДлиннаяЦепочка(64);
	ЦепочкаИз65Кадров = ПомощникТестированияОшибок.ДлиннаяЦепочка(65);

	// Действие
	Просмотр64 = ОбходЦепочкиОшибки.Просмотреть(ЦепочкаИз64Кадров.Ошибка);
	Просмотр65 = ОбходЦепочкиОшибки.Просмотреть(ЦепочкаИз65Кадров.Ошибка);

	// Проверка
	Ожидаем.Что(Просмотр64.Кадры.Количество()).Равно(64);
	Ожидаем.Что(Просмотр64.Усечена).Равно(Ложь);
	Ожидаем.Что(Просмотр65.Кадры.Количество()).Равно(64);
	Ожидаем.Что(Просмотр65.Усечена).Равно(Истина);

КонецПроцедуры

&Тест
Процедура ТестДолжен_БезопасноСоздатьСнимокНевыброшенногоКадра() Экспорт

	// Подготовка
	Ошибка = Новый ИнформацияОбОшибке("Не выброшенный кадр", Новый Структура("Источник", "Тест"));

	// Действие
	Снимок = Новый СнимокКадраОшибки(Ошибка);

	// Проверка
	Ожидаем.Что(Снимок.Сообщение()).Равно("Не выброшенный кадр");
	Ожидаем.Что(Снимок.ИмяМодуля()).Равно("");
	Ожидаем.Что(Снимок.НомерСтроки()).Равно(0);
	Ожидаем.Что(Снимок.ИсходнаяСтрока()).Равно("");
	Ожидаем.Что(Снимок.Стек().Количество()).Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьСнимокКонтекстногоКадра() Экспорт

	// Подготовка
	Причина = ФабрикаОшибок.Создать("fs.file_not_found", "Файл не найден");
	Ошибка = ФабрикаОшибок.СКонтекстом(Причина, "Загрузка конфигурации");
	Ошибка = ПомощникТестированияОшибок.ПовторноВыброшеннаяОшибка(Ошибка);

	// Действие
	Снимок = Новый СнимокКадраОшибки(Ошибка);

	// Проверка
	Ожидаем.Что(Снимок.Вид()).Равно("Контекст");
	Ожидаем.Что(Снимок.ТипОшибки()).Равно("");
	Ожидаем.Что(Снимок.Сообщение()).Равно("Загрузка конфигурации");
	Ожидаем.Что(Снимок.Данные()).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьСнимокВнешнегоКадра() Экспорт

	// Подготовка
	Ошибка = ПомощникТестированияОшибок.ВнешняяОшибка(
		"В файле конфигурации обнаружен некорректный JSON"
	);
	Ошибка = ПомощникТестированияОшибок.ПовторноВыброшеннаяОшибка(Ошибка);

	// Действие
	Снимок = Новый СнимокКадраОшибки(Ошибка);

	// Проверка
	Ожидаем.Что(Снимок.Вид()).Равно("ВнешняяОшибка");
	Ожидаем.Что(Снимок.ТипОшибки()).Равно("");
	Ожидаем.Что(Снимок.Сообщение()).Равно(
		"В файле конфигурации обнаружен некорректный JSON"
	);
	Ожидаем.Что(Снимок.Данные()).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СчитатьПоврежденныеМетаданныеВнешнимКадром() Экспорт

