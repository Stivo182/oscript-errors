#Область СлужебныйПрограммныйИнтерфейс

// Безопасно читает метаданные физического кадра без повторной проверки типа.
//
// Параметры:
//  Ошибка - ИнформацияОбОшибке - Читаемый физический кадр.
//
// Возвращаемое значение:
//  ФиксированнаяСтруктура, Неопределено - Поддерживаемые исходные метаданные или Неопределено.
Функция ПрочитатьМетаданные(Ошибка) Экспорт

	Попытка
		Параметры = Ошибка.Параметры;
		Если ТипЗнч(Параметры) <> Тип("ФиксированнаяСтруктура")
			Или Не ЭтоПоддерживаемыеМетаданные(Параметры) Тогда
			Возврат Неопределено;
		КонецЕсли;

		Возврат Параметры;
	Исключение
		ЛогированиеБиблиотекиОшибок.ЗаписатьПодавленныйСбой(
			"snapshot.read_metadata",
			Ошибка,
			ИнформацияОбОшибке()
		);
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЭтоПоддерживаемыеМетаданные(Параметры)

	Попытка
		Маркер = Параметры.Маркер;
		ВерсияФормата = Параметры.ВерсияФормата;
		Вид = Параметры.Вид;
		КодОшибки = Параметры.КодОшибки;
		Сообщение = Параметры.Сообщение;
		Данные = Параметры.Данные;
	Исключение
		Возврат Ложь;
	КонецПопытки;

	Подсказка = "";
	URL = "";

	Если Не ПроверкаКадровОшибок.КорректноеСообщение(Сообщение) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Параметры.Свойство("Подсказка", Подсказка)
		И Не ПроверкаКадровОшибок.КорректнаяПодсказка(Подсказка) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Параметры.Свойство("URL", URL)
		И Не ПроверкаКадровОшибок.КорректныйURL(URL) Тогда
		Возврат Ложь;
	КонецЕсли;

	КорректныйМаркер = ТипЗнч(Маркер) = Тип("Строка")
		И Маркер = ФорматКадраОшибки.МаркерМетаданных();
	КорректнаяВерсия = ТипЗнч(ВерсияФормата) = Тип("Число")
		И ВерсияФормата = ФорматКадраОшибки.ВерсияФормата();

	Если Не КорректныйМаркер Или Не КорректнаяВерсия Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Вид = ВидыКадровОшибок.Ошибка() Тогда
		Возврат ПроверкаКадровОшибок.КорректныйКодОшибки(КодОшибки);
	КонецЕсли;

	Если Вид = ВидыКадровОшибок.Контекст() Тогда
		Возврат КодОшибки = Неопределено;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

#КонецОбласти
