#Использовать "../src"

&Параметры(1, 10, 50)
Перем ГлубинаЦепочки Экспорт; // Число

Перем _Ошибка; // ИнформацияОбОшибке
Перем _Результат; // Произвольный

#Область ОбработчикиСобытий

// Создаёт бенчмарк материализации разбора ошибки.
&МониторингПамяти
&КоличествоИтераций(5)
&КоличествоПрогревочныхИтераций(3)
&МинимальноеВремяИтерации(100)
Процедура ПриСозданииОбъекта()
КонецПроцедуры

// Подготавливает цепочку ошибок заданной глубины.
//
// Параметры:
//  Контекст - Структура - Контекст выполняемого кейса бенчмарка.
&ПередКаждымКейсом
Процедура ПодготовитьЦепочку(Контекст) Экспорт

	_Ошибка = СоздатьЦепочку(ГлубинаЦепочки);

КонецПроцедуры

#КонецОбласти

#Область Бенчмарки

// Измеряет создание разбора и материализацию всех его снимков.
&Бенчмарк
Процедура МатериализоватьСнимки() Экспорт

	Разбор = ДиагностикаОшибок.Разобрать(_Ошибка);
	_Результат = Разбор.Снимки();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьЦепочку(Глубина)

	Ошибка = ФабрикаОшибок.Создать(КодУровня(1), "Ошибка уровня 1");

	Для НомерУровня = 2 По Глубина Цикл
		Ошибка = ФабрикаОшибок.Обернуть(
			Ошибка,
			КодУровня(НомерУровня),
			"Ошибка уровня " + НомерУровня
		);
	КонецЦикла;

	Возврат Ошибка;

КонецФункции

Функция КодУровня(НомерУровня)

	Возврат "benchmark.level_" + НомерУровня;

КонецФункции

#КонецОбласти
