&Тест
Процедура ТестДолжен_ПроверитьНаличиеКодаОшибки() Экспорт

	// Подготовка
	Снимки = Новый Массив;
	Снимки.Добавить(СнимокОшибки("database.timeout", "Таймаут"));
	Выборка = Новый ВыборкаОшибок(Снимки);

