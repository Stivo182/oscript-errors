#Использовать asserts
#Использовать "fixtures"
#Использовать "../src"

#Область Тесты

&Тест
Процедура ТестДолжен_СоздатьСнимокСобственногоКадра() Экспорт

	// Подготовка
	Данные = Новый Структура("Путь", "config.json");
	Ошибка = ФабрикаОшибок.Создать("fs.file_not_found", "Файл не найден", Данные);

	// Действие
	Снимок = Новый СнимокКадраОшибки(Ошибка);

	// Проверка
	Ожидаем.Что(ТипЗнч(Снимок)).Равно(Тип("СнимокКадраОшибки"));
	Ожидаем.Что(Снимок.Вид()).Равно("Ошибка");
	Ожидаем.Что(Снимок.ТипОшибки()).Равно("fs.file_not_found");
	Ожидаем.Что(Снимок.Сообщение()).Равно("Файл не найден");
	Ожидаем.Что(Снимок.Данные()).Равно(Данные);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьСнимокКонтекстногоКадра() Экспорт

	// Подготовка
	Причина = ФабрикаОшибок.Создать("fs.file_not_found", "Файл не найден");
	Ошибка = ФабрикаОшибок.СКонтекстом(Причина, "Загрузка конфигурации");

	// Действие
	Снимок = Новый СнимокКадраОшибки(Ошибка);

	// Проверка
	Ожидаем.Что(Снимок.Вид()).Равно("Контекст");
	Ожидаем.Что(Снимок.ТипОшибки()).Равно(Неопределено);
	Ожидаем.Что(Снимок.Сообщение()).Равно("Загрузка конфигурации");
	Ожидаем.Что(Снимок.Данные()).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьСнимокВнешнегоКадра() Экспорт

	// Подготовка
	Ошибка = ПомощникТестированияОшибок.ВнешняяОшибка("Ошибка JSON-парсера");

	// Действие
	Снимок = Новый СнимокКадраОшибки(Ошибка);

	// Проверка
	Ожидаем.Что(Снимок.Вид()).Равно("ВнешняяОшибка");
	Ожидаем.Что(Снимок.ТипОшибки()).Равно(Неопределено);
	Ожидаем.Что(Снимок.Сообщение()).Равно("Ошибка JSON-парсера");
	Ожидаем.Что(Снимок.Данные()).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СчитатьПоврежденныеМетаданныеВнешнимКадром() Экспорт

	// Подготовка
	Образец = ФабрикаОшибок.Создать("sample.error", "Образец");
	Ошибка = ПомощникТестированияОшибок.ОшибкаСПоврежденнымКонвертом(Образец, Неопределено);

	// Действие
	Снимок = Новый СнимокКадраОшибки(Ошибка);

	// Проверка
	Ожидаем.Что(Снимок.Вид()).Равно("ВнешняяОшибка");
	Ожидаем.Что(Снимок.ТипОшибки()).Равно(Неопределено);
	Ожидаем.Что(Снимок.Данные()).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьНеопределеноПриНедоступномИмениМодуля() Экспорт

	// Подготовка
	Ошибка = Новый ИнформацияОбОшибке("Ошибка без места создания", Новый Структура);

	// Действие
	Снимок = Новый СнимокКадраОшибки(Ошибка);

	// Проверка
	Ожидаем.Что(Снимок.ИмяМодуля()).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьСвойстваМестаСозданияКадра() Экспорт

	// Подготовка
	Ошибка = ПомощникТестированияОшибок.ЦепочкаСРазнымиМестамиСоздания().ВнешнийКадр;

	// Действие
	Снимок = Новый СнимокКадраОшибки(Ошибка);

	// Проверка
	Ожидаем.Что(Снимок.ИмяМодуля()).Равно(Ошибка.ИмяМодуля);
	Ожидаем.Что(Снимок.НомерСтроки()).Равно(Ошибка.НомерСтроки);
	Ожидаем.Что(Снимок.ИсходнаяСтрока()).Равно(Ошибка.ИсходнаяСтрока);
	Ожидаем.Что(Снимок.Стек().Количество()).Равно(Ошибка.ПолучитьСтекВызовов().Количество());

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьНезависимыеМассивыСтека() Экспорт

	// Подготовка
	Ошибка = ФабрикаОшибок.Создать("core.failed", "Ошибка");
	Снимок = Новый СнимокКадраОшибки(Ошибка);
	ПервыйСтек = Снимок.Стек();
	ИсходныйРазмер = ПервыйСтек.Количество();

	// Действие
	ПервыйСтек.Добавить("Проверочный элемент");

	// Проверка
	Ожидаем.Что(Снимок.Стек().Количество()).Равно(ИсходныйРазмер);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьНеверныйТипАргументаКонструктора() Экспорт

	// Подготовка
	Параметры = Новый Массив;
	Параметры.Добавить("не ошибка");

	// Действие и Проверка
	Ожидаем.Что(ЭтотОбъект)
		.Метод("СоздатьСнимок", Параметры)
		.ВыбрасываетИсключение("Ошибка должна иметь тип ИнформацияОбОшибке");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОткрыватьТолькоМетодыЧтения() Экспорт

	// Подготовка
	Ошибка = ФабрикаОшибок.Создать("core.failed", "Ошибка");
	Снимок = Новый СнимокКадраОшибки(Ошибка);
	Параметры = Новый Массив;
	Параметры.Добавить(Снимок);

	// Действие и Проверка
	Ожидаем.Что(ЭтотОбъект).Метод("ПрочитатьВидНапрямую", Параметры).ВыбрасываетИсключение();
	Ожидаем.Что(ЭтотОбъект).Метод("ПрочитатьСообщениеНапрямую", Параметры).ВыбрасываетИсключение();
	Ожидаем.Что(Снимок.Вид()).Равно("Ошибка");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьСнимок(Ошибка) Экспорт

	Возврат Новый СнимокКадраОшибки(Ошибка);

КонецФункции

Функция ПрочитатьВидНапрямую(Снимок) Экспорт

	Возврат Снимок.Вид;

КонецФункции

Функция ПрочитатьСообщениеНапрямую(Снимок) Экспорт

	Возврат Снимок.Сообщение;

КонецФункции

#КонецОбласти
