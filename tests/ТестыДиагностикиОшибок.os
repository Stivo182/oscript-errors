	Ожидаем.Что(Снимок.ИсходнаяОшибка()).Равно(Причина);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьВнешнююКорневуюПричину() Экспорт

	// Подготовка
	Корень = ПомощникТестированияОшибок.ВнешняяОшибка("Сетевой сбой");
	Ошибка = ФабрикаОшибок.Обернуть(Корень, "service.unavailable", "Сервис недоступен");

	// Действие
	Снимок = ДиагностикаОшибок.КорневаяПричина(Ошибка);

	// Проверка
	Ожидаем.Что(Снимок.ИсходнаяОшибка()).Равно(Корень);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьПустыеРезультатыДляВнешнейОшибки() Экспорт

	// Подготовка
	Ошибка = ПомощникТестированияОшибок.ВнешняяОшибка("Внешняя ошибка");

	// Действие
	Данные = ДиагностикаОшибок.ДанныеОшибки(Ошибка);
	Эффективная = ДиагностикаОшибок.ЭффективнаяОшибка(Ошибка);
	Корневая = ДиагностикаОшибок.КорневаяПричина(Ошибка);

	// Проверка
	Ожидаем.Что(Данные).Равно(Неопределено);
	Ожидаем.Что(Эффективная).Равно(Неопределено);
	Ожидаем.Что(Корневая.ИсходнаяОшибка()).Равно(Ошибка);

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазличитьКореньИУсеченнуюЦепочку() Экспорт

	// Подготовка
	Цепочка64 = ПомощникТестированияОшибок.ДлиннаяЦепочка(64);
	Цепочка65 = ПомощникТестированияОшибок.ДлиннаяЦепочка(65);

	// Действие
	Корень64 = ДиагностикаОшибок.КорневаяПричина(Цепочка64.Ошибка);
	Корень65 = ДиагностикаОшибок.КорневаяПричина(Цепочка65.Ошибка);

	// Проверка
	Ожидаем.Что(Корень64.ИсходнаяОшибка()).Равно(Цепочка64.Корень);
	Ожидаем.Что(Корень65).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОграничитьПоискЭффективнойОшибкиШестьюдесятьюЧетырьмяКадрами() Экспорт

	// Подготовка
	Данные = Новый Структура("Граница", 64);
	ОшибкаНаГранице = ФабрикаОшибок.Создать("core.failed", "Ошибка на границе", Данные);
	Для НомерКадра = 1 По 63 Цикл
		ОшибкаНаГранице = ПомощникТестированияОшибок.ВнешняяОшибка(
			"Внешний кадр",
			ОшибкаНаГранице
		);
	КонецЦикла;
	ОшибкаЗаГраницей = ПомощникТестированияОшибок.ВнешняяОшибка(
		"Лишний кадр",
		ОшибкаНаГранице
	);

	// Действие
	СнимокНаГранице = ДиагностикаОшибок.ЭффективнаяОшибка(ОшибкаНаГранице);
	СнимокЗаГраницей = ДиагностикаОшибок.ЭффективнаяОшибка(ОшибкаЗаГраницей);
	ДанныеНаГранице = ДиагностикаОшибок.ДанныеОшибки(ОшибкаНаГранице);
	ДанныеЗаГраницей = ДиагностикаОшибок.ДанныеОшибки(ОшибкаЗаГраницей);

	// Проверка
	Ожидаем.Что(СнимокНаГранице.КодОшибки()).Равно("core.failed");
	Ожидаем.Что(СнимокЗаГраницей).Равно(Неопределено);
	Ожидаем.Что(ДанныеНаГранице).Равно(Данные);
	Ожидаем.Что(ДанныеЗаГраницей).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОграничитьЧтениеКодаШестьюдесятьюЧетырьмяКадрами() Экспорт

	// Подготовка
	ОшибкаНаГранице = ФабрикаОшибок.Создать("core.failed", "Ошибка на границе");
	Для НомерКадра = 1 По 63 Цикл
		ОшибкаНаГранице = ПомощникТестированияОшибок.ВнешняяОшибка("Внешний кадр", ОшибкаНаГранице);
	КонецЦикла;
	ОшибкаЗаГраницей = ПомощникТестированияОшибок.ВнешняяОшибка("Лишний кадр", ОшибкаНаГранице);

	// Действие
	КодНаГранице = ДиагностикаОшибок.КодОшибки(ОшибкаНаГранице);
	КодЗаГраницей = ДиагностикаОшибок.КодОшибки(ОшибкаЗаГраницей);

	// Проверка
	Ожидаем.Что(КодНаГранице).Равно("core.failed");
	Ожидаем.Что(КодЗаГраницей).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПропуститьЧужойИПоврежденныйКонвертыПриДиагностике() Экспорт

	// Подготовка
	ДанныеОшибки = Новый Структура("Источник", "Тест");
	ВнутренняяОшибка = ФабрикаОшибок.Создать("core.failed", "Корневая ошибка", ДанныеОшибки);
	Образец = ФабрикаОшибок.Создать("sample.error", "Образец");
	ЧужойМаркер = ПомощникТестированияОшибок.ОшибкаСЧужимМаркером(Образец, ВнутренняяОшибка);
	Ошибка = ПомощникТестированияОшибок.ОшибкаСПоврежденнымКонвертом(Образец, ЧужойМаркер);

	// Действие
	КодОшибки = ДиагностикаОшибок.КодОшибки(Ошибка);
	Снимок = ДиагностикаОшибок.ЭффективнаяОшибка(Ошибка);
	Данные = ДиагностикаОшибок.ДанныеОшибки(Ошибка);
	Корень = ДиагностикаОшибок.КорневаяПричина(Ошибка);

	// Проверка
	Ожидаем.Что(КодОшибки).Равно("core.failed");
	Ожидаем.Что(Снимок.ИсходнаяОшибка()).Равно(ВнутренняяОшибка);
	Ожидаем.Что(Данные).Равно(ДанныеОшибки);
	Ожидаем.Что(Корень.ИсходнаяОшибка()).Равно(ВнутренняяОшибка);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПрочитатьКодПослеПовторногоВыброса() Экспорт

