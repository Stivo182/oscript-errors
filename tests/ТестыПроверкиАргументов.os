&Тест
Процедура ТестДолжен_ПропуститьКорректныеАргументы() Экспорт

	// Действие
	ПроверкаАргументов.ПроверитьТип("Имя", "Значение", Тип("Строка"));
	ПроверкаАргументов.ПроверитьТип("Имя", "Значение", "Строка");
	ПроверкаАргументов.ПроверитьЗаполненность("Имя", "Значение");
	ПроверкаАргументов.ПроверитьДопустимость("Количество", 2 > 1, "быть больше единицы");
	ПроверкаАргументов.ПроверитьДиапазон("Порт", 1, 1, 65535);
	ПроверкаАргументов.ПроверитьДиапазон("Порт", 65535, 1, 65535);
	ПроверкаАргументов.ПроверитьДиапазон("ДатаЗапуска", '20260818', '20260818', '20260819');

	// Проверка
	Ожидаем.Что(Истина).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_СформироватьОжиданиеРавенства() Экспорт

	// Подготовка
	ОшибкаНеопределенного = ОшибкаПриПроверкеРавенства("КодОшибки", "http.error", Неопределено);
	ОшибкаПустойСтроки = ОшибкаПриПроверкеРавенства("Подсказка", "Совет", "");

	// Действие
	СнимокНеопределенного = Новый СнимокКадраОшибки(ОшибкаНеопределенного);
	СнимокПустойСтроки = Новый СнимокКадраОшибки(ОшибкаПустойСтроки);

	// Проверка
	Ожидаем.Что(СнимокНеопределенного.Данные().Ожидание).Равно("Неопределено");
	Ожидаем.Что(СнимокПустойСтроки.Данные().Ожидание).Равно("пустая строка");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПроверитьКонтрактДопустимыхЗначений() Экспорт

	// Подготовка
	ОшибкаТипа = ОшибкаПриПроверкеДопустимогоЗначения("Вид", "Ошибка", "Ошибка, Контекст");
	ОшибкаЗаполненности = ОшибкаПриПроверкеДопустимогоЗначения("Вид", "Ошибка", Новый Массив);

	// Действие
	СнимокТипа = Новый СнимокКадраОшибки(ОшибкаТипа);
	СнимокЗаполненности = Новый СнимокКадраОшибки(ОшибкаЗаполненности);

	// Проверка
	Ожидаем.Что(СнимокТипа.КодОшибки()).Равно("argument.invalid_type");
	Ожидаем.Что(СнимокТипа.Данные().ИмяАргумента).Равно("ДопустимыеЗначения");
	Ожидаем.Что(СнимокЗаполненности.КодОшибки()).Равно("argument.required");
	Ожидаем.Что(СнимокЗаполненности.Данные().ИмяАргумента).Равно("ДопустимыеЗначения");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПроверитьВхождениеАргументаВДопустимыеЗначения() Экспорт

	// Подготовка
	ДопустимыеЗначения = Новый Массив;
	ДопустимыеЗначения.Добавить("Ошибка");
	ДопустимыеЗначения.Добавить("Контекст");

	// Действие
	Ошибка = ОшибкаПриПроверкеДопустимогоЗначения("Вид", "ВнешняяОшибка", ДопустимыеЗначения);
	Снимок = Новый СнимокКадраОшибки(Ошибка);

	// Проверка
	Ожидаем.Что(Снимок.КодОшибки()).Равно("argument.invalid_value");
	Ожидаем.Что(Снимок.Данные().ИмяАргумента).Равно("Вид");
	Ожидаем.Что(Снимок.Данные().Ожидание).Равно("одно из значений: Ошибка, Контекст");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьОшибкуАргументаВнеДиапазона() Экспорт

	// Подготовка
	ОшибкаПоУмолчанию = ОшибкаПриПроверкеДиапазона("Порт", 65536, 1, 65535);
	ОшибкаССообщением = ОшибкаПриПроверкеДиапазона(
		"Порт",
		0,
		1,
		65535,
		"Порт находится вне допустимого диапазона"
	);

	// Действие
	Снимок = Новый СнимокКадраОшибки(ОшибкаПоУмолчанию);
	СнимокССообщением = Новый СнимокКадраОшибки(ОшибкаССообщением);

	// Проверка
	Ожидаем.Что(Снимок.КодОшибки()).Равно("argument.out_of_range");
	Ожидаем.Что(Снимок.Данные().ИмяАргумента).Равно("Порт");
	ОжидаемыйДиапазон = ТекстОжидаемогоДиапазона(1, 65535);
	Ожидаем.Что(Снимок.Данные().ОжидаемыйДиапазон).Равно(ОжидаемыйДиапазон);
	Ожидаем.Что(Снимок.Данные().Количество()).Равно(2);
	Ожидаем.Что(Снимок.Сообщение()).Равно(
		СтандартноеСообщениеАргументаВнеДиапазона("Порт", ОжидаемыйДиапазон)
	);
	Ожидаем.Что(СнимокССообщением.Сообщение()).Равно("Порт находится вне допустимого диапазона");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПроверитьКонтрактПроверкиДиапазона() Экспорт

	// Подготовка
	ОшибкаИмени = ОшибкаПриПроверкеДиапазона(42, 5, 1, 10);
	ОшибкаЗначения = ОшибкаПриПроверкеДиапазона("Количество", "5", "1", "10");
	ОшибкаМинимума = ОшибкаПриПроверкеДиапазона("Количество", 5, '20260818', 10);
	ОшибкаМаксимума = ОшибкаПриПроверкеДиапазона("Количество", 5, 1, '20260818');
	ОшибкаГраниц = ОшибкаПриПроверкеДиапазона("Количество", 5, 10, 1);
	ОшибкаСообщения = ОшибкаПриПроверкеДиапазона("Количество", 5, 1, 10, 42);

	// Действие и Проверка
	ПроверитьОшибкуКонтрактаДиапазона(ОшибкаИмени, "argument.invalid_type", "ИмяАргумента");
	ПроверитьОшибкуКонтрактаДиапазона(ОшибкаЗначения, "argument.invalid_type", "Значение");
	ПроверитьОшибкуКонтрактаДиапазона(ОшибкаМинимума, "argument.invalid_type", "МинимальноеЗначение");
	ПроверитьОшибкуКонтрактаДиапазона(ОшибкаМаксимума, "argument.invalid_type", "МаксимальноеЗначение");
	ПроверитьОшибкуКонтрактаДиапазона(ОшибкаГраниц, "argument.invalid_value", "МинимальноеЗначение");
	ПроверитьОшибкуКонтрактаДиапазона(ОшибкаСообщения, "argument.invalid_type", "Сообщение");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьОшибкуНеверногоТипаСоСтандартнымСообщением() Экспорт

	// Подготовка
	Ошибка = ОшибкаПриПроверкеТипа("Имя", 42, Тип("Строка"));

	// Действие
	Снимок = Новый СнимокКадраОшибки(Ошибка);

	// Проверка
	Ожидаем.Что(Снимок.КодОшибки()).Равно("argument.invalid_type");
	Ожидаем.Что(Снимок.Данные().ИмяАргумента).Равно("Имя");
	Ожидаем.Что(Снимок.Данные().ОжидаемыйТип).Равно(Строка(Тип("Строка")));
	Ожидаем.Что(Снимок.Данные().ФактическийТип).Равно(Строка(Тип("Число")));
	Ожидаем.Что(Снимок.Данные().Свойство("ФактическоеЗначение")).ЭтоЛожь();
	Ожидаем.Что(Снимок.Сообщение()).Равно(
		СтандартноеСообщениеНеверногоТипа("Имя", Строка(Тип("Строка")))
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьОшибкуНезаполненногоАргументаСоСтандартнымСообщением() Экспорт

	// Подготовка
	Ошибка = ОшибкаПриПроверкеЗаполненности("Имя", "");

	// Действие
	Снимок = Новый СнимокКадраОшибки(Ошибка);

	// Проверка
	Ожидаем.Что(Снимок.КодОшибки()).Равно("argument.required");
	Ожидаем.Что(Снимок.Данные().ИмяАргумента).Равно("Имя");
	Ожидаем.Что(Снимок.Данные().Количество()).Равно(1);
	Ожидаем.Что(Снимок.Сообщение()).Равно(СтандартноеСообщениеНезаполненногоАргумента("Имя"));

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьОшибкуНедопустимогоЗначенияИСохранитьСообщение() Экспорт

	// Подготовка
	ОшибкаПоУмолчанию = ОшибкаПриПроверкеДопустимости("Количество", Ложь, "быть больше нуля");
	ОшибкаСПользовательскимСообщением = ОшибкаПриПроверкеДопустимости(
		"Количество",
		Ложь,
		"быть больше нуля",
		"Количество должно быть положительным"
	);

	// Действие
	СнимокПоУмолчанию = Новый СнимокКадраОшибки(ОшибкаПоУмолчанию);
	СнимокСПользовательскимСообщением = Новый СнимокКадраОшибки(ОшибкаСПользовательскимСообщением);

	// Проверка
	Ожидаем.Что(СнимокПоУмолчанию.КодОшибки()).Равно("argument.invalid_value");
	Ожидаем.Что(СнимокПоУмолчанию.Данные().ИмяАргумента).Равно("Количество");
	Ожидаем.Что(СнимокПоУмолчанию.Данные().Ожидание).Равно("быть больше нуля");
	Ожидаем.Что(СнимокПоУмолчанию.Данные().Количество()).Равно(2);
	Ожидаем.Что(СнимокПоУмолчанию.Сообщение()).Равно(
		СтандартноеСообщениеНедопустимогоЗначения("Количество", "быть больше нуля")
	);
	Ожидаем.Что(СнимокСПользовательскимСообщением.Сообщение()).Равно(
		"Количество должно быть положительным"
	);

КонецПроцедуры

