#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПостроитьСПодсказкой(Подсказка) Экспорт

	Возврат Новый КонструкторОшибки("http.proxy_error", "Ошибка прокси")
		.Подсказка(Подсказка)
		.Построить();

КонецФункции

Функция ПостроитьСURL(URL) Экспорт

	Возврат Новый КонструкторОшибки("http.proxy_error", "Ошибка прокси")
		.URL(URL)
		.Построить();

КонецФункции

Процедура ПроверитьКонтрактноеИсключение(Ошибка, ОжидаемыйКодОшибки, ИмяАргумента, Ожидание)

	Если Ошибка = Неопределено Тогда
		ВызватьИсключение "Ожидалось контрактное исключение конструктора";
	КонецЕсли;

	Снимок = Новый СнимокКадраОшибки(Ошибка);
	Ожидаем.Что(Снимок.КодОшибки()).Равно(ОжидаемыйКодОшибки);
	Ожидаем.Что(Снимок.Данные().ИмяАргумента).Равно(ИмяАргумента);

	Если Ожидание <> "" Тогда
		Ожидаем.Что(Снимок.Данные().Ожидание).Равно(Ожидание);
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьОшибкуСмешиванияДанных(Ошибка)

	Если Ошибка = Неопределено Тогда
		ВызватьИсключение "Ожидалась ошибка смешивания режимов данных";
	КонецЕсли;

	Снимок = Новый СнимокКадраОшибки(Ошибка);
	Ожидаем.Что(Снимок.КодОшибки()).Равно("operation.invalid_state");
	Ожидаем.Что(Снимок.Данные().ИмяОперации).Равно("Настройка данных ошибки");
	Ожидаем.Что(Снимок.Сообщение()).Равно("Нельзя смешивать структурированные и произвольные данные ошибки");

КонецПроцедуры

Функция ПостроитьСКодомОшибки(КодОшибки) Экспорт

	Возврат Новый КонструкторОшибки(КодОшибки, "Ошибка прокси").Построить();

КонецФункции

Функция ПостроитьССообщением(Сообщение) Экспорт

	Возврат Новый КонструкторОшибки("http.proxy_error", Сообщение).Построить();

КонецФункции

Функция ПостроитьСПричиной(Причина) Экспорт

	Возврат Новый КонструкторОшибки("http.proxy_error", "Ошибка прокси")
		.Причина(Причина)
		.Построить();

КонецФункции

Функция ПостроитьСВидом(Вид) Экспорт

	Возврат Новый КонструкторОшибки("http.proxy_error", "Ошибка прокси", Вид).Построить();

КонецФункции

Функция ПостроитьКонтекстСТипом() Экспорт

	Причина = ФабрикаОшибок.Создать("network.unavailable", "Сеть недоступна");
	Возврат Новый КонструкторОшибки("http.proxy_error", "Ошибка прокси", ВидыКадровОшибок.Контекст())
		.Причина(Причина)
		.Построить();

КонецФункции

Функция ПостроитьКонтекстБезПричины() Экспорт

	Возврат Новый КонструкторОшибки(Неопределено, "Ошибка прокси", ВидыКадровОшибок.Контекст())
		.Построить();

КонецФункции

Функция ПостроитьКонтекстСПодсказкой() Экспорт

	Причина = ФабрикаОшибок.Создать("network.unavailable", "Сеть недоступна");
	Возврат Новый КонструкторОшибки(Неопределено, "Ошибка прокси", ВидыКадровОшибок.Контекст())
		.Подсказка("Проверьте настройки")
		.Причина(Причина)
		.Построить();

КонецФункции

Функция ПостроитьКонтекстСURL() Экспорт

	Причина = ФабрикаОшибок.Создать("network.unavailable", "Сеть недоступна");
	Возврат Новый КонструкторОшибки(Неопределено, "Ошибка прокси", ВидыКадровОшибок.Контекст())
		.URL("https://example.org/errors/context")
		.Причина(Причина)
		.Построить();

КонецФункции

Функция ОшибкаПриПроверкеКадра(КодОшибки, Причина, Подсказка, URL)

	Попытка
		ПроверкаКадровОшибок.ПроверитьКадр(
			ВидыКадровОшибок.Контекст(),
			КодОшибки,
			"Контекст",
			Причина,
			Подсказка,
			URL
		);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидалось исключение проверки вида кадра";

КонецФункции

Функция СтандартноеСообщениеНеверногоТипа(ИмяАргумента, ОжидаемыйТип)

	Возврат СтрШаблон(
		НСтр("ru = 'Аргумент ''%1'' должен иметь тип %2'; en = 'Argument ''%1'' must be of type %2'"),
		ИмяАргумента,
		Строка(ОжидаемыйТип)
	);

КонецФункции

Функция СтандартноеСообщениеНезаполненногоАргумента(ИмяАргумента)

	Возврат СтрШаблон(
		НСтр("ru = 'Аргумент ''%1'' должен быть заполнен'; en = 'Argument ''%1'' is required'"),
		ИмяАргумента
	);

КонецФункции

Функция СтандартноеСообщениеНедопустимогоЗначения(ИмяАргумента, Ожидание)

	Возврат СтрШаблон(
		НСтр(
			"ru = 'Аргумент ''%1'' имеет недопустимое значение: ожидается %2';"
			+ "en = 'Argument ''%1'' has an invalid value: expected %2'"
		),
		ИмяАргумента,
		Ожидание
	);

КонецФункции

#КонецОбласти
