#Использовать asserts
#Использовать "../src"

#Область Тесты

&Тест
Процедура ТестДолжен_ВернутьГотовуюСтандартнуюОшибку() Экспорт

	// Действие
	Ошибка = СтандартныеОшибки.РесурсНеНайден("config.json");

	// Проверка
	Ожидаем.Что(ТипЗнч(Ошибка)).Равно(Тип("ИнформацияОбОшибке"));
	Снимок = Новый СнимокКадраОшибки(Ошибка);
	Ожидаем.Что(Снимок.КодОшибки()).Равно("resource.not_found");
	Ожидаем.Что(Снимок.Данные().ИмяРесурса).Равно("config.json");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОбогатитьКонструкторСтандартнойОшибки() Экспорт

	// Действие
	Ошибка = КонструкторыСтандартныхОшибок.РесурсНеНайден("config.json")
		.Данные("Каталог", "settings")
		.Подсказка("Проверьте путь к файлу")
		.URL("https://example.org/errors/resource.not_found")
		.Построить();

	// Проверка
	Снимок = Новый СнимокКадраОшибки(Ошибка);
	Ожидаем.Что(Снимок.Данные().ИмяРесурса).Равно("config.json");
	Ожидаем.Что(Снимок.Данные().Каталог).Равно("settings");
	Ожидаем.Что(Снимок.Подсказка()).Равно("Проверьте путь к файлу");
	Ожидаем.Что(Снимок.URL()).Равно("https://example.org/errors/resource.not_found");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПредоставитьПолныйКаталогСтандартныхОшибок() Экспорт

	// Действие
	Конструкторы = Новый Массив;
	Конструкторы.Добавить(КонструкторыСтандартныхОшибок.НеверныйТипАргумента("Порт", "Число", "80"));
	Конструкторы.Добавить(КонструкторыСтандартныхОшибок.АргументНеЗаполнен("Адрес"));
	Конструкторы.Добавить(
		КонструкторыСтандартныхОшибок.НедопустимоеЗначениеАргумента("Порт", "быть положительным")
	);
	Конструкторы.Добавить(КонструкторыСтандартныхОшибок.АргументВнеДиапазона("Порт", "от 1 до 65535"));
	Конструкторы.Добавить(КонструкторыСтандартныхОшибок.ОперацияОтменена("Загрузка"));
	Конструкторы.Добавить(КонструкторыСтандартныхОшибок.ОперацияВНедопустимомСостоянии("Загрузка"));
	Конструкторы.Добавить(КонструкторыСтандартныхОшибок.ОперацияНеРеализована("Загрузка"));
	Конструкторы.Добавить(КонструкторыСтандартныхОшибок.ОперацияНеПоддерживается("Загрузка"));
	Конструкторы.Добавить(КонструкторыСтандартныхОшибок.ИстеклоВремяОжиданияОперации("Загрузка"));
	Конструкторы.Добавить(КонструкторыСтандартныхОшибок.ОперацияНедоступна("Загрузка"));
	Конструкторы.Добавить(КонструкторыСтандартныхОшибок.ДоступЗапрещен("application.json"));
	Конструкторы.Добавить(КонструкторыСтандартныхОшибок.РесурсНеНайден("application.json"));
	Конструкторы.Добавить(КонструкторыСтандартныхОшибок.РесурсУжеСуществует("application.json"));
	Конструкторы.Добавить(КонструкторыСтандартныхОшибок.РесурсУжеИспользуется("application.json"));
	Конструкторы.Добавить(КонструкторыСтандартныхОшибок.РесурсЗакрыт("application.json"));
	Конструкторы.Добавить(КонструкторыСтандартныхОшибок.РесурсИсчерпан("пул"));
	Конструкторы.Добавить(КонструкторыСтандартныхОшибок.РесурсНеПуст("каталог"));
	Конструкторы.Добавить(КонструкторыСтандартныхОшибок.ВозможностьНедоступна("TLS"));
	Конструкторы.Добавить(КонструкторыСтандартныхОшибок.СоединениеОтклонено("db.example.org"));
	Конструкторы.Добавить(КонструкторыСтандартныхОшибок.СоединениеСброшено("db.example.org"));
	Конструкторы.Добавить(КонструкторыСтандартныхОшибок.СоединениеЗакрыто("db.example.org"));
	Конструкторы.Добавить(КонструкторыСтандартныхОшибок.ИстеклоВремяОжиданияСоединения("db.example.org"));
	Конструкторы.Добавить(КонструкторыСтандартныхОшибок.СетевоеИмяНеНайдено("db.example.org"));
	Конструкторы.Добавить(КонструкторыСтандартныхОшибок.НекорректныеДанные("Конфигурация"));
	Конструкторы.Добавить(КонструкторыСтандартныхОшибок.ДанныеСлишкомБольшие("Пакет", "10 МБ"));
	Конструкторы.Добавить(КонструкторыСтандартныхОшибок.ДанныеПовреждены("Архив"));
	Конструкторы.Добавить(КонструкторыСтандартныхОшибок.НевернаяКодировкаДанных("Файл", "UTF-8"));
	Конструкторы.Добавить(КонструкторыСтандартныхОшибок.КодировкаНеПоддерживается("UTF-32"));
	Конструкторы.Добавить(КонструкторыСтандартныхОшибок.НеизвестнаяКодировка("X-UNKNOWN"));
	Конструкторы.Добавить(
		КонструкторыСтандартныхОшибок.НарушенВнутреннийИнвариант("Счётчик неотрицателен")
	);

	Ошибки = Новый Массив;
	Ошибки.Добавить(СтандартныеОшибки.НеверныйТипАргумента("Порт", "Число", "80"));
	Ошибки.Добавить(СтандартныеОшибки.АргументНеЗаполнен("Адрес"));
	Ошибки.Добавить(СтандартныеОшибки.НедопустимоеЗначениеАргумента("Порт", "быть положительным"));
	Ошибки.Добавить(СтандартныеОшибки.АргументВнеДиапазона("Порт", "от 1 до 65535"));
	Ошибки.Добавить(СтандартныеОшибки.ОперацияОтменена("Загрузка"));
	Ошибки.Добавить(СтандартныеОшибки.ОперацияВНедопустимомСостоянии("Загрузка"));
	Ошибки.Добавить(СтандартныеОшибки.ОперацияНеРеализована("Загрузка"));
	Ошибки.Добавить(СтандартныеОшибки.ОперацияНеПоддерживается("Загрузка"));
	Ошибки.Добавить(СтандартныеОшибки.ИстеклоВремяОжиданияОперации("Загрузка"));
	Ошибки.Добавить(СтандартныеОшибки.ОперацияНедоступна("Загрузка"));
	Ошибки.Добавить(СтандартныеОшибки.ДоступЗапрещен("application.json"));
	Ошибки.Добавить(СтандартныеОшибки.РесурсНеНайден("application.json"));
	Ошибки.Добавить(СтандартныеОшибки.РесурсУжеСуществует("application.json"));
	Ошибки.Добавить(СтандартныеОшибки.РесурсУжеИспользуется("application.json"));
	Ошибки.Добавить(СтандартныеОшибки.РесурсЗакрыт("application.json"));
	Ошибки.Добавить(СтандартныеОшибки.РесурсИсчерпан("пул"));
	Ошибки.Добавить(СтандартныеОшибки.РесурсНеПуст("каталог"));
	Ошибки.Добавить(СтандартныеОшибки.ВозможностьНедоступна("TLS"));
	Ошибки.Добавить(СтандартныеОшибки.СоединениеОтклонено("db.example.org"));
	Ошибки.Добавить(СтандартныеОшибки.СоединениеСброшено("db.example.org"));
	Ошибки.Добавить(СтандартныеОшибки.СоединениеЗакрыто("db.example.org"));
	Ошибки.Добавить(СтандартныеОшибки.ИстеклоВремяОжиданияСоединения("db.example.org"));
	Ошибки.Добавить(СтандартныеОшибки.СетевоеИмяНеНайдено("db.example.org"));
	Ошибки.Добавить(СтандартныеОшибки.НекорректныеДанные("Конфигурация"));
	Ошибки.Добавить(СтандартныеОшибки.ДанныеСлишкомБольшие("Пакет", "10 МБ"));
	Ошибки.Добавить(СтандартныеОшибки.ДанныеПовреждены("Архив"));
	Ошибки.Добавить(СтандартныеОшибки.НевернаяКодировкаДанных("Файл", "UTF-8"));
	Ошибки.Добавить(СтандартныеОшибки.КодировкаНеПоддерживается("UTF-32"));
	Ошибки.Добавить(СтандартныеОшибки.НеизвестнаяКодировка("X-UNKNOWN"));
	Ошибки.Добавить(СтандартныеОшибки.НарушенВнутреннийИнвариант("Счётчик неотрицателен"));

	// Проверка
	Ожидаем.Что(Конструкторы.Количество()).Равно(30);
	Ожидаем.Что(Ошибки.Количество()).Равно(Конструкторы.Количество());
	Для Индекс = 0 По Конструкторы.ВГраница() Цикл
		ПроверитьРавенствоСтандартныхОшибок(Конструкторы[Индекс], Ошибки[Индекс]);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьРавенствоСтандартныхОшибок(Конструктор, Ошибка)

	Ожидаем.Что(ТипЗнч(Конструктор)).Равно(Тип("КонструкторОшибки"));
	СнимокКонструктора = Новый СнимокКадраОшибки(Конструктор.Построить());
	СнимокОшибки = Новый СнимокКадраОшибки(Ошибка);

	Ожидаем.Что(СнимокКонструктора.Вид()).Равно(СнимокОшибки.Вид());
	Ожидаем.Что(СнимокКонструктора.КодОшибки()).Равно(СнимокОшибки.КодОшибки());
	Ожидаем.Что(СнимокКонструктора.Сообщение()).Равно(СнимокОшибки.Сообщение());
	Ожидаем.Что(СнимокКонструктора.Подсказка()).Равно(СнимокОшибки.Подсказка());
	Ожидаем.Что(СнимокКонструктора.URL()).Равно(СнимокОшибки.URL());

	ДанныеКонструктора = СнимокКонструктора.Данные();
	ДанныеОшибки = СнимокОшибки.Данные();
	Ожидаем.Что(ДанныеКонструктора.Количество()).Равно(ДанныеОшибки.Количество());
	Для Каждого Элемент Из ДанныеКонструктора Цикл
		Ожидаем.Что(ДанныеОшибки[Элемент.Ключ]).Равно(Элемент.Значение);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
