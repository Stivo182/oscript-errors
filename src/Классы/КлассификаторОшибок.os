#Использовать "../internal"

Перем _РегистрацииПравил; // Массив из Структура
Перем _ИндексыПравил; // Массив из ИндексПравилКлассификацииОшибок
Перем _СледующийНомерПравила; // Число
Перем _ТребуетсяПодготовкаПоставщиков; // Булево
Перем _БлокировкаПодготовкиПоставщиков; // БлокировкаРесурса
Перем _КодыПравил; // Соответствие из КлючИЗначение:
                   //  * Ключ - Строка - Код из добавленных правил.
                   //  * Значение - Булево - Всегда Истина.
Перем _СообщенияКодов; // Соответствие из КлючИЗначение:
                       //  * Ключ - Строка - Код из добавленных правил.
                       //  * Значение - Строка - Сообщение ошибки.

#Область ОбработчикиСобытий

// Создаёт пустой классификатор ошибок.
// До добавления правил или поставщика экземпляр не классифицирует ошибки и не считает собственным ни один код.
Процедура ПриСозданииОбъекта()

	_РегистрацииПравил = Новый Массив;
	_ИндексыПравил = Новый Массив;
	_СледующийНомерПравила = 1;
	_ТребуетсяПодготовкаПоставщиков = Ложь;
	_БлокировкаПодготовкиПоставщиков = Новый БлокировкаРесурса();
	_КодыПравил = Новый Соответствие;
	_СообщенияКодов = Новый Соответствие;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Добавляет правила классификации.
// Все добавленные правила участвуют в общем выборе по силе совпадения и приоритету.
// Правила применяются после структурированных кодов.
//
// Параметры:
//  Правила - Массив, ФиксированныйМассив из ПравилоКлассификацииОшибок - Правила классификации.
//
// Возвращаемое значение:
//  КлассификаторОшибок - Этот классификатор.
Функция ДобавитьПравила(Правила) Экспорт

	ИндексПравил = Новый ИндексПравилКлассификацииОшибок(
		Правила,
		"ПравилаКлассификации",
		_СледующийНомерПравила
	);
	СведенияПравил = СнимокСведенийПравил(Правила);
	_РегистрацииПравил.Добавить(НоваяРегистрацияПравил(ИндексПравил, СведенияПравил));
	_ИндексыПравил.Добавить(ИндексПравил);

	Для Каждого СведенияПравила Из СведенияПравил Цикл
		ЗарегистрироватьКодПравила(СведенияПравила, _КодыПравил, _СообщенияКодов);
		_СледующийНомерПравила = _СледующийНомерПравила + 1;
	КонецЦикла;

	Возврат ЭтотОбъект;

КонецФункции

// Добавляет поставщика правил для ленивой загрузки.
// Поставщик может быть типом с конструктором без параметров или готовым объектом с методом Все().
// Поставщик загружается перед обработкой собственных кодов и правил.
// Результат успешной загрузки кешируется, регистрации применяются в порядке добавления.
//
// Параметры:
//  Поставщик - Тип, Произвольный - Тип или объект поставщика правил.
//
// Возвращаемое значение:
//  КлассификаторОшибок - Этот классификатор.
Функция ДобавитьПоставщикаПравил(Поставщик) Экспорт

	_РегистрацииПравил.Добавить(НоваяРегистрацияПоставщика(Поставщик));
	_ТребуетсяПодготовкаПоставщиков = Истина;

	Возврат ЭтотОбъект;

КонецФункции

// Классифицирует ошибку по структурированным кодам и правилам.
//
// Параметры:
//  Ошибка - ИнформацияОбОшибке - Исходная или уже структурированная ошибка.
//
// Возвращаемое значение:
//  ИнформацияОбОшибке, Неопределено - Нормализованная ошибка либо Неопределено,
//      если ошибка не распознана.
//
// Исключения:
//  Если конструктор поставщика, его метод Все() или подготовка возвращенных правил завершились ошибкой.
Функция Классифицировать(Ошибка) Экспорт

	КорневойСнимок = Новый СнимокКадраОшибки(Ошибка);
	Возврат КлассифицироватьНеНормализованнуюОшибку(Ошибка, КорневойСнимок);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция КлассифицироватьНеНормализованнуюОшибку(Ошибка, КорневойСнимок)

	ЦепочкаКадров = Новый ЦепочкаКадровОшибки(КорневойСнимок);
	Кадры = ЦепочкаКадров.Кадры();

	ПодготовитьПоставщиковПравил();

	Если ЭтоКодПравила(КорневойСнимок.КодОшибки()) Тогда
		Возврат Ошибка;
	КонецЕсли;

	Результат = Неопределено;
	Если ПопробоватьКлассифицироватьСтруктурированнымиКодами(Ошибка, Кадры, Результат) Тогда
		Возврат Результат;
	КонецЕсли;

	Возврат КлассифицироватьПравилами(Ошибка, Кадры);

КонецФункции

Функция ЭтоКодПравила(Код)

	Возврат Не ПустаяСтрока(Код) И _КодыПравил.Получить(Код) = Истина;

КонецФункции

Процедура ЗарегистрироватьКодПравила(Правило, КодыПравил, СообщенияКодов)

	КодыПравил.Вставить(Правило.КодОшибки, Истина);

	Если СообщенияКодов.Получить(Правило.КодОшибки) = Неопределено
		И Не ПустаяСтрока(Правило.ОписаниеОшибки) Тогда
		СообщенияКодов.Вставить(
			Правило.КодОшибки,
			ЛокализоватьОписаниеОшибкиПравила(Правило.ОписаниеОшибки)
		);
	КонецЕсли;

КонецПроцедуры

Процедура ПодготовитьПоставщиковПравил()

	Если Не _ТребуетсяПодготовкаПоставщиков Тогда
		Возврат;
	КонецЕсли;

	_БлокировкаПодготовкиПоставщиков.Заблокировать();

	Попытка
		Если _ТребуетсяПодготовкаПоставщиков Тогда
			ПересобратьПравилаИзРегистраций();
		КонецЕсли;
	Исключение
		_БлокировкаПодготовкиПоставщиков.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	_БлокировкаПодготовкиПоставщиков.Разблокировать();

КонецПроцедуры

Процедура ПересобратьПравилаИзРегистраций()

	НовыеИндексыПравил = Новый Массив;
	НовыеКодыПравил = Новый Соответствие;
	НовыеСообщенияКодов = Новый Соответствие;

	Для Каждого Регистрация Из _РегистрацииПравил Цикл
		Если Регистрация.Индекс = Неопределено Тогда
			ПодготовитьРегистрациюПоставщика(Регистрация, _СледующийНомерПравила);
			_СледующийНомерПравила = _СледующийНомерПравила + Регистрация.СведенияПравил.Количество();
		КонецЕсли;

		НовыеИндексыПравил.Добавить(Регистрация.Индекс);
		Для Каждого СведенияПравила Из Регистрация.СведенияПравил Цикл
			ЗарегистрироватьКодПравила(СведенияПравила, НовыеКодыПравил, НовыеСообщенияКодов);
		КонецЦикла;
	КонецЦикла;

	_ИндексыПравил = НовыеИндексыПравил;
	_КодыПравил = НовыеКодыПравил;
	_СообщенияКодов = НовыеСообщенияКодов;
	_ТребуетсяПодготовкаПоставщиков = Ложь;

КонецПроцедуры

Процедура ПодготовитьРегистрациюПоставщика(Регистрация, СледующийНомерПравила)

	Поставщик = Регистрация.Поставщик;
	Если ТипЗнч(Поставщик) = Тип("Тип") Тогда
		Поставщик = Новый(Поставщик);
	КонецЕсли;

	Правила = Поставщик.Все();
	ИндексПравил = Новый ИндексПравилКлассификацииОшибок(
		Правила,
		"ПравилаКлассификации",
		СледующийНомерПравила
	);
	СведенияПравил = СнимокСведенийПравил(Правила);

	Регистрация.Индекс = ИндексПравил;
	Регистрация.СведенияПравил = СведенияПравил;

КонецПроцедуры

Функция НоваяРегистрацияПравил(ИндексПравил, СведенияПравил)

	Возврат Новый Структура(
		"Поставщик, Индекс, СведенияПравил",
		Неопределено,
		ИндексПравил,
		СведенияПравил
	);

КонецФункции

Функция НоваяРегистрацияПоставщика(Поставщик)

	Возврат Новый Структура(
		"Поставщик, Индекс, СведенияПравил",
		Поставщик,
		Неопределено,
		Неопределено
	);

КонецФункции

Функция СнимокСведенийПравил(Правила)

	СведенияПравил = Новый Массив;
	Для Каждого Правило Из Правила Цикл
		СведенияПравил.Добавить(Новый ФиксированнаяСтруктура(
			Новый Структура(
				"КодОшибки, ОписаниеОшибки",
				Правило.КодОшибки(),
				Правило.ОписаниеРезультата()
			)
		));
	КонецЦикла;

	Возврат Новый ФиксированныйМассив(СведенияПравил);

КонецФункции

Функция ПопробоватьКлассифицироватьСтруктурированнымиКодами(Ошибка, Кадры, Результат)

	Кандидаты = СобратьСтруктурированныеКандидаты(Кадры);
	Если Кандидаты.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Кандидат = ВыбратьКандидата(Кандидаты);
	Если Кандидат <> Неопределено Тогда
		Если ДиагностикаОшибок.КодОшибки(Ошибка) = Кандидат.Код Тогда
			Результат = Ошибка;
		Иначе
			Результат = СоздатьНормализованнуюОшибку(
				Ошибка,
				Кандидат,
				ПолучитьСообщениеСтруктурированногоКода(Кандидат.Код)
			);
		КонецЕсли;
	КонецЕсли;

	Возврат Истина;

КонецФункции

Функция КлассифицироватьПравилами(Ошибка, Кадры)

	Кандидат = ВыбратьКандидата(СобратьКандидатыПравил(Кадры));
	Если Кандидат = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат СоздатьНормализованнуюОшибку(Ошибка, Кандидат);

КонецФункции

Функция СобратьСтруктурированныеКандидаты(Кадры)

	Кандидаты = Новый Массив;

	Для Каждого Кадр Из Кадры Цикл
		Если ПустаяСтрока(Кадр.КодОшибки) Тогда
			Продолжить;
		КонецЕсли;

		Если Не ЭтоКодПравила(Кадр.КодОшибки) Тогда
			Продолжить;
		КонецЕсли;

		Источник = ЗначениеСвойства(Кадр.Данные, "Источник", "СтруктурированнаяОшибка");
		Правило = ЗначениеСвойства(Кадр.Данные, "Правило", Кадр.КодОшибки);

		Кандидаты.Добавить(НовыйКандидат(
			Кадр.КодОшибки,
			Кадр,
			300,
			0,
			Правило,
			Источник,
			Кадр.Описание
		));
	КонецЦикла;

	Возврат Кандидаты;

КонецФункции

Функция ПолучитьСообщениеСтруктурированногоКода(КодОшибки)

	Сообщение = _СообщенияКодов.Получить(КодОшибки);
	Если Сообщение <> Неопределено Тогда
		Возврат Сообщение;
	КонецЕсли;

	ВызватьИсключение ФабрикаОшибок.Создать(
		КодыСтандартныхОшибок.НарушенВнутреннийИнвариант(),
		СтрШаблон(
			НСтр("ru = 'Для кода %1 не найдено сообщение правила'; "
				+ "en = 'No rule message was found for code %1'"),
			КодОшибки
		),
		Новый Структура("Инвариант, КодОшибки", "Сообщение правила найдено", КодОшибки)
	);

КонецФункции

Функция ЛокализоватьОписаниеОшибкиПравила(ОписаниеОшибки)

	НормализованноеОписаниеОшибки = СтрЗаменить(НРег(СокрЛП(ОписаниеОшибки)), " ", "");
	Если СтрНайти(НормализованноеОписаниеОшибки, "ru=") > 0
		Или СтрНайти(НормализованноеОписаниеОшибки, "en=") > 0 Тогда
		Возврат НСтр(ОписаниеОшибки);
	КонецЕсли;

	Возврат ОписаниеОшибки;

КонецФункции

Функция СобратьКандидатыПравил(Кадры)

	Кандидаты = Новый Массив;

	Для Каждого Кадр Из Кадры Цикл
		Если ЭтоЧужойСтруктурированныйКод(Кадр) Тогда
			Продолжить;
		КонецЕсли;

		ПервыйИндексКандидата = Кандидаты.Количество();
		Для Каждого ИндексПравил Из _ИндексыПравил Цикл
			ИндексПравил.СобратьКандидаты(Кадр, Кандидаты);
		КонецЦикла;

		ОформитьКандидатыПравил(Кандидаты, ПервыйИндексКандидата, Кадр, 100);
	КонецЦикла;

	Возврат Кандидаты;

КонецФункции

Функция ЭтоЧужойСтруктурированныйКод(Кадр)

	Возврат Не ПустаяСтрока(Кадр.КодОшибки)
		И Не ЭтоКодПравила(Кадр.КодОшибки);

КонецФункции

Процедура ОформитьКандидатыПравил(Кандидаты, ПервыйИндексКандидата, Кадр, СилаТекста)

	Для ИндексКандидата = ПервыйИндексКандидата По Кандидаты.ВГраница() Цикл
		Результат = Кандидаты[ИндексКандидата];
		Код = Результат.Код;
		Данные = Результат.Данные;
		Источник = ЗначениеСвойства(Данные, "Источник", "ПравилаКлассификации");
		Правило = ЗначениеСвойства(Данные, "Правило", Код);
		Сила = СилаТекста;
		ИспользованныйНативныйТип = ЗначениеСвойства(Данные, "НативныйТип", Неопределено);

		Если Не ПустаяСтрока(ИспользованныйНативныйТип) И Кадр.Восстановлен Тогда
			Сила = СилаТекста + 90;
		ИначеЕсли Не ПустаяСтрока(ИспользованныйНативныйТип) Тогда
			Сила = СилаТекста + 100;
		КонецЕсли;

		Кандидаты[ИндексКандидата] = НовыйКандидат(
			Код,
			Кадр,
			Сила,
			Результат.Приоритет,
			Правило,
			Источник,
			Результат.Сообщение
		);
	КонецЦикла;

КонецПроцедуры

Функция НовыйКандидат(
	Код,
	Кадр,
	Сила,
	Приоритет,
	Правило,
	Источник,
	Сообщение)

	Поля = Новый Структура(
		"Код, Кадр, Сила, Приоритет, Правило, Источник, Сообщение",
		Код,
		Кадр,
		Сила,
		Приоритет,
		Правило,
		Источник,
		Сообщение
	);

	Возврат Новый ФиксированнаяСтруктура(Поля);

КонецФункции

Функция ВыбратьКандидата(Кандидаты)

	Если Кандидаты.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	МаксимальнаяСила = Кандидаты[0].Сила;
	Для Каждого Кандидат Из Кандидаты Цикл
		Если Кандидат.Сила > МаксимальнаяСила Тогда
			МаксимальнаяСила = Кандидат.Сила;
		КонецЕсли;
	КонецЦикла;

	МаксимальныйПриоритет = Неопределено;
	Для Каждого Кандидат Из Кандидаты Цикл
		Если Кандидат.Сила = МаксимальнаяСила
			И (МаксимальныйПриоритет = Неопределено
				Или Кандидат.Приоритет > МаксимальныйПриоритет) Тогда
			МаксимальныйПриоритет = Кандидат.Приоритет;
		КонецЕсли;
	КонецЦикла;

	ЛучшиеПоКодам = Новый Соответствие;
	Для Каждого Кандидат Из Кандидаты Цикл
		Если Кандидат.Сила = МаксимальнаяСила
			И Кандидат.Приоритет = МаксимальныйПриоритет
			И ЛучшиеПоКодам.Получить(Кандидат.Код) = Неопределено Тогда
			ЛучшиеПоКодам.Вставить(Кандидат.Код, Кандидат);
		КонецЕсли;
	КонецЦикла;

	Если ЛучшиеПоКодам.Количество() = 1 Тогда
		Для Каждого Пара Из ЛучшиеПоКодам Цикл
			Возврат Пара.Значение;
		КонецЦикла;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция СоздатьНормализованнуюОшибку(Ошибка, Кандидат, Сообщение = Неопределено)

	Данные = Новый Структура;
	Данные.Вставить("Источник", Кандидат.Источник);
	Данные.Вставить("Правило", Кандидат.Правило);

	НативныйТип = ЗначениеСвойства(
		Кандидат.Кадр.Данные,
		"НативныйТип",
		Кандидат.Кадр.НативныйТип
	);

	Если Не ПустаяСтрока(НативныйТип) Тогда
		Данные.Вставить("НативныйТип", НативныйТип);
	КонецЕсли;

	Если Сообщение = Неопределено Тогда
		Сообщение = Кандидат.Сообщение;
	КонецЕсли;

	Возврат ФабрикаОшибок.Обернуть(
		Ошибка,
		Кандидат.Код,
		Сообщение,
		Данные
	);

КонецФункции

Функция ЗначениеСвойства(Данные, Имя, ЗначениеПоУмолчанию)

	Если ТипЗнч(Данные) <> Тип("Структура")
		И ТипЗнч(Данные) <> Тип("ФиксированнаяСтруктура") Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;

	Значение = Неопределено;
	Если Данные.Свойство(Имя, Значение) Тогда
