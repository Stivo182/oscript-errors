// Демонстрирует создание классифицированной ошибки с данными и подсказкой.
// Сценарий выводит тип ошибки, переданные данные и рекомендацию.

#Использовать errors

Ошибка = ФабрикаОшибок.Создать(
	"storage.quota_exceeded",
	"Недостаточно места в хранилище",
	Новый Структура("ТребуетсяМБ,ДоступноМБ", 800, 250),
	"Освободите место или увеличьте квоту"
);

Данные = ДиагностикаОшибок.Данные(Ошибка);

Сообщить("Тип: " + ДиагностикаОшибок.ТипОшибки(Ошибка));
Сообщить(СтрШаблон("Требуется %1 МБ, доступно %2 МБ", Данные.ТребуетсяМБ, Данные.ДоступноМБ));
Сообщить("Подсказка: " + ДиагностикаОшибок.Подсказка(Ошибка));
