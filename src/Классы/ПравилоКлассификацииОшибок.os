Перем _НативныйТип; // Строка
Перем _ИсходноеСообщение; // Строка
Перем _Префикс; // Строка
Перем _Фрагмент; // Строка
Перем _Окончание; // Строка
Перем _КодОшибки; // Строка
Перем _ОписаниеОшибки; // Строка
Перем _Идентификатор; // Строка
Перем _Приоритет; // Число

#Область ОбработчикиСобытий

// Создает пустое правило классификации ошибки.
Процедура ПриСозданииОбъекта()

	_НативныйТип = "";
	_ИсходноеСообщение = "";
	_Префикс = "";
	_Фрагмент = "";
	_Окончание = "";
	_КодОшибки = "";
	_ОписаниеОшибки = "";
	_Идентификатор = "";
	_Приоритет = 0;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Устанавливает полное имя нативного типа .NET.
// При наличии нативного типа все текстовые условия сопоставляются с внутренним
// сообщением без служебной обёртки типа.
//
// Параметры:
//  НативныйТип - Строка - Полное имя типа .NET.
//
// Возвращаемое значение:
//  ПравилоКлассификацииОшибок - Это правило.
Функция СНативнымТипом(НативныйТип) Экспорт

	_НативныйТип = НативныйТип;
	Возврат ЭтотОбъект;

КонецФункции

// Устанавливает точное сообщение ошибки.
// Для нативной ошибки сопоставляется внутреннее сообщение, а СНативнымТипом()
// дополнительно ограничивает тип.
//
// Параметры:
//  ИсходноеСообщение - Строка - Полное сообщение или шаблон НСтр.
//
// Возвращаемое значение:
//  ПравилоКлассификацииОшибок - Это правило.
Функция СовпадаетС(ИсходноеСообщение) Экспорт

	_ИсходноеСообщение = ИсходноеСообщение;
	Возврат ЭтотОбъект;

КонецФункции

// Устанавливает префикс исходного сообщения.
//
// Параметры:
//  Префикс - Строка - Начало сообщения или шаблон НСтр.
//
// Возвращаемое значение:
//  ПравилоКлассификацииОшибок - Это правило.
Функция НачинаетсяС(Префикс) Экспорт

	_Префикс = Префикс;
	Возврат ЭтотОбъект;

КонецФункции

// Устанавливает обязательный фрагмент исходного сообщения.
//
// Параметры:
//  Фрагмент - Строка - Фрагмент сообщения или шаблон НСтр.
//
// Возвращаемое значение:
//  ПравилоКлассификацииОшибок - Это правило.
Функция Содержит(Фрагмент) Экспорт

	_Фрагмент = Фрагмент;
	Возврат ЭтотОбъект;

КонецФункции

// Устанавливает окончание исходного сообщения.
//
// Параметры:
//  Окончание - Строка - Окончание сообщения или шаблон НСтр.
//
// Возвращаемое значение:
//  ПравилоКлассификацииОшибок - Это правило.
Функция ОканчиваетсяНа(Окончание) Экспорт

	_Окончание = Окончание;
	Возврат ЭтотОбъект;

КонецФункции

// Устанавливает приоритет правила.
//
// Параметры:
//  Приоритет - Число - Приоритет среди равносильных совпадений.
//
// Возвращаемое значение:
//  ПравилоКлассификацииОшибок - Это правило.
Функция СПриоритетом(Приоритет) Экспорт

	_Приоритет = Приоритет;
	Возврат ЭтотОбъект;

КонецФункции

// Устанавливает стабильный идентификатор правила.
//
// Параметры:
//  Идентификатор - Строка - Идентификатор для диагностических данных.
//
// Возвращаемое значение:
//  ПравилоКлассификацииОшибок - Это правило.
Функция СИдентификатором(Идентификатор) Экспорт

	_Идентификатор = Идентификатор;
	Возврат ЭтотОбъект;

КонецФункции

// Устанавливает результат классификации.
//
// Параметры:
//  КодОшибки - Строка - Код классифицированной ошибки.
//  ОписаниеОшибки - Строка - Нормализованное описание ошибки или шаблон НСтр.
//
// Возвращаемое значение:
//  ПравилоКлассификацииОшибок - Это правило.
Функция КлассифицируетКак(КодОшибки, ОписаниеОшибки) Экспорт

	_КодОшибки = КодОшибки;
	_ОписаниеОшибки = ОписаниеОшибки;
	Возврат ЭтотОбъект;

КонецФункции

// Возвращает полное имя нативного типа .NET.
//
// Возвращаемое значение:
//  Строка - Полное имя типа или пустая строка.
Функция НативныйТип() Экспорт

	Возврат _НативныйТип;

КонецФункции

// Возвращает точное исходное сообщение.
//
// Возвращаемое значение:
//  Строка - Сообщение или шаблон НСтр.
Функция ИсходноеСообщение() Экспорт

	Возврат _ИсходноеСообщение;

КонецФункции

// Возвращает префикс исходного сообщения.
//
// Возвращаемое значение:
//  Строка - Префикс или шаблон НСтр.
Функция Префикс() Экспорт

	Возврат _Префикс;

КонецФункции

// Возвращает обязательный фрагмент исходного сообщения.
//
// Возвращаемое значение:
//  Строка - Фрагмент или шаблон НСтр.
Функция Фрагмент() Экспорт

	Возврат _Фрагмент;

КонецФункции

// Возвращает окончание исходного сообщения.
//
// Возвращаемое значение:
//  Строка - Окончание или шаблон НСтр.
Функция Окончание() Экспорт

	Возврат _Окончание;

КонецФункции

// Возвращает код классифицированной ошибки.
//
// Возвращаемое значение:
//  Строка - Код ошибки.
Функция КодОшибки() Экспорт

	Возврат _КодОшибки;

КонецФункции

// Возвращает нормализованное описание результата классификации.
//
// Возвращаемое значение:
//  Строка - Описание или шаблон НСтр.
Функция ОписаниеРезультата() Экспорт

	Возврат _ОписаниеОшибки;

КонецФункции

// Возвращает идентификатор правила.
//
// Возвращаемое значение:
//  Строка - Идентификатор или пустая строка.
Функция Идентификатор() Экспорт

	Возврат _Идентификатор;

КонецФункции

// Возвращает приоритет правила.
//
// Возвращаемое значение:
//  Число - Приоритет среди равносильных совпадений.
Функция Приоритет() Экспорт

	Возврат _Приоритет;

КонецФункции

#КонецОбласти
