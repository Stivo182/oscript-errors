// Сравнивает краткое, пользовательское и диагностическое представления.
// Все форматы строятся для одной цепочки с контекстом, данными и подсказкой.

#Использовать errors

Причина = Новый ПостроительОшибки("network.timeout", "Сервис пользователей не ответил")
	.Данные("ТаймаутСек", 10)
	.Подсказка("Повторите операцию")
	.Построить();

Причина = ФабрикаОшибок.ОбернутьКонтекстом(Причина, "Запрос пользователя 42");
Ошибка = ФабрикаОшибок.Обернуть(Причина, "profile.load_failed", "Не удалось загрузить профиль");
Разбор = ДиагностикаОшибок.Разобрать(Ошибка);

Сообщить("Краткое представление:");
Сообщить(Разбор.КраткоеПредставление());
Сообщить("");
Сообщить("Пользовательское представление:");
Сообщить(Разбор.ПользовательскоеПредставление());
Сообщить("");
Сообщить("Диагностическое представление:");
Сообщить(Разбор.ДиагностическоеПредставление());
