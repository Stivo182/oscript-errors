#Использовать "../internal"

#Область ПрограммныйИнтерфейс

// Создаёт классифицированную ошибку без причины.
//
// Параметры:
//  ТипОшибки - Строка - Стабильный машинный тип ошибки.
//  Сообщение - Строка - Человекочитаемое описание ошибки.
//  Данные - Произвольный - Связанные с ошибкой данные.
//  Подсказка - Строка - Подсказка по исправлению ошибки.
//
// Возвращаемое значение:
//  ИнформацияОбОшибке - Новый кадр ошибки.
Функция Создать(ТипОшибки, Сообщение, Данные = Неопределено, Подсказка = "") Экспорт

	Возврат Новый КонструкторОшибки(ТипОшибки, Сообщение)
		.Данные(Данные)
		.Подсказка(Подсказка)
		.Построить();

КонецФункции

// Добавляет контекст, не изменяя машинную классификацию причины.
//
// Параметры:
//  Причина - ИнформацияОбОшибке - Непосредственная причина нового кадра.
//  Сообщение - Строка - Описание выполнявшейся операции.
//  Данные - Произвольный - Связанные с контекстом данные.
//
// Возвращаемое значение:
//  ИнформацияОбОшибке - Новый кадр контекста.
Функция СКонтекстом(Причина, Сообщение, Данные = Неопределено) Экспорт

	Возврат Новый КонструкторОшибки(Неопределено, Сообщение, ВидыКадровОшибок.Контекст)
		.Данные(Данные)
		.Причина(Причина)
		.Построить();

КонецФункции

// Оборачивает причину новой машинной классификацией.
//
// Параметры:
//  Причина - ИнформацияОбОшибке - Непосредственная причина нового кадра.
//  ТипОшибки - Строка - Новый стабильный машинный тип ошибки.
//  Сообщение - Строка - Человекочитаемое описание ошибки.
//  Данные - Произвольный - Связанные с ошибкой данные.
//  Подсказка - Строка - Подсказка по исправлению ошибки.
//
// Возвращаемое значение:
//  ИнформацияОбОшибке - Новый классифицированный кадр.
Функция Обернуть(Причина, ТипОшибки, Сообщение, Данные = Неопределено, Подсказка = "") Экспорт

	Возврат Новый КонструкторОшибки(ТипОшибки, Сообщение)
		.Данные(Данные)
		.Причина(Причина)
		.Подсказка(Подсказка)
		.Построить();

КонецФункции

// Возвращает fluent-конструктор классифицированной ошибки.
//
// Параметры:
//  ТипОшибки - Строка - Стабильный машинный тип ошибки.
//  Сообщение - Строка - Человекочитаемое описание ошибки.
//
// Возвращаемое значение:
//  КонструкторОшибки - Новый конструктор ошибки.
Функция Конструктор(ТипОшибки, Сообщение) Экспорт

	Возврат Новый КонструкторОшибки(ТипОшибки, Сообщение);

КонецФункции

#КонецОбласти
