// Демонстрирует проверку и поиск кода во вложенной цепочке ошибок.
// Сценарий извлекает данные и подсказку найденной причины.

#Использовать errors

Причина = Новый ПостроительОшибки("database.timeout", "База данных не ответила вовремя")
	.Данные("ТаймаутСек", 30)
	.Подсказка("Повторите запрос позднее")
	.Построить();

Причина = ФабрикаОшибок.ОбернутьКонтекстом(Причина, "Чтение списка заказов");
Ошибка = ФабрикаОшибок.Обернуть(Причина, "orders.load_failed", "Не удалось получить список заказов");

Разбор = ДиагностикаОшибок.Разобрать(Ошибка);
НайденнаяПричина = Разбор.Ошибки().Отобрать("database.timeout").Первая();
ДанныеПричины = НайденнаяПричина.Данные();

Сообщить("Эффективный код: " + Разбор.КодОшибки());
Сообщить("Есть database.timeout: " + Строка(Разбор.Ошибки().Содержит("database.timeout")));
Сообщить(СтрШаблон("Таймаут: %1 сек", ДанныеПричины.ТаймаутСек));
Сообщить("Подсказка: " + НайденнаяПричина.Подсказка());
