&Тест
Процедура ТестДолжен_ПредставитьМассивКонтейнеровВДанныхОшибки() Экспорт

	// Подготовка
	Данные = Новый Массив;
	Данные.Добавить(Новый Структура("Идентификатор", 1));
	Данные.Добавить(Новый Массив);
	Ошибка = ФабрикаОшибок.Создать("batch.failed", "Ошибка пакета", Данные);

	// Действие
	Представление = ДиагностикаОшибок.Исследовать(Ошибка).ДиагностическоеПредставление();

	// Проверка
	Ожидаем.Что(Представление).Равно("batch.failed: Ошибка пакета
	|
	|Данные:
	|  -
	|    Идентификатор: 1
	|  - []");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПредставитьПустыеКорневыеКонтейнерыВДанныхОшибки() Экспорт

	// Подготовка
	ПустоеСоответствие = Новый Соответствие;
	Ошибки = Новый Массив;
	Ошибки.Добавить(ФабрикаОшибок.Создать("data.empty", "Пустая структура", Новый Структура));
	Ошибки.Добавить(ФабрикаОшибок.Создать("data.empty", "Пустой массив", Новый Массив));
	Ошибки.Добавить(ФабрикаОшибок.Создать("data.empty", "Пустое соответствие", ПустоеСоответствие));

	// Действие
	Представления = Новый Массив;
	Для Каждого Ошибка Из Ошибки Цикл
		Представления.Добавить(ДиагностикаОшибок.Исследовать(Ошибка).ДиагностическоеПредставление());
	КонецЦикла;

	// Проверка
	Ожидаем.Что(Представления[0]).Равно(
		"data.empty: Пустая структура" + Символы.ПС + Символы.ПС + "Данные: {}"
	);
	Ожидаем.Что(Представления[1]).Равно(
		"data.empty: Пустой массив" + Символы.ПС + Символы.ПС + "Данные: []"
	);
	Ожидаем.Что(Представления[2]).Равно(
		"data.empty: Пустое соответствие" + Символы.ПС + Символы.ПС + "Данные: {}"
	);

КонецПроцедуры

