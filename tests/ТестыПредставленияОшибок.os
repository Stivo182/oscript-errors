#Использовать "../src"

#Область Тесты

&Тест
Процедура ТестДолжен_ВернутьСтруктурныйСнимокСмешаннойЦепочки() Экспорт

	// Подготовка
	Цепочка = СмешаннаяЦепочка();

	// Действие
	Снимок = ДиагностикаОшибок.ВСтруктуру(Цепочка.Ошибка);

	// Проверка
	ПроверитьПоляСнимка(Снимок);
	Ожидаем.Что(Снимок.ТипОшибки).Равно("config.load_failed");
	Ожидаем.Что(Снимок.Усечена).Равно(Ложь);
	Ожидаем.Что(Снимок.Кадры.Количество()).Равно(4);
	ПроверитьПоляКадра(Снимок.Кадры[0]);
	ПроверитьПоляКадра(Снимок.Кадры[1]);
	ПроверитьПоляКадра(Снимок.Кадры[2]);
	ПроверитьПоляКадра(Снимок.Кадры[3]);
	Ожидаем.Что(Снимок.Кадры[0].Вид).Равно("Контекст");
	Ожидаем.Что(Снимок.Кадры[1].Вид).Равно("Ошибка");
	Ожидаем.Что(Снимок.Кадры[2].Вид).Равно("ВнешняяОшибка");
	Ожидаем.Что(Снимок.Кадры[3].Вид).Равно("Ошибка");
	Ожидаем.Что(Снимок.Кадры[0].ТипОшибки).Равно(Неопределено);
	Ожидаем.Что(Снимок.Кадры[1].ТипОшибки).Равно("config.load_failed");
	Ожидаем.Что(Снимок.Кадры[2].ТипОшибки).Равно(Неопределено);
	Ожидаем.Что(Снимок.Кадры[3].ТипОшибки).Равно("fs.file_not_found");
	Ожидаем.Что(Снимок.Кадры[0].Данные).Равно(Цепочка.ДанныеКонтекста);
	Ожидаем.Что(Снимок.Кадры[1].Данные).Равно(Цепочка.ДанныеЭффективнойОшибки);
	Ожидаем.Что(Снимок.Кадры[2].Данные).Равно(Неопределено);
	Ожидаем.Что(Снимок.Кадры[3].Данные).Равно(Цепочка.ДанныеВнутреннейОшибки);
	Ожидаем.Что(Снимок.Кадры[2].Сообщение).Равно("Ошибка JSON-парсера");

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеПереноситьЧужиеПараметрыВДанные() Экспорт

	// Подготовка
	ВнешняяОшибка = ПомощникТестированияОшибок.ВнешняяОшибка("Внешняя ошибка");

	// Действие
	Снимок = ДиагностикаОшибок.ВСтруктуру(ВнешняяОшибка);

	// Проверка
	Ожидаем.Что(Снимок.ТипОшибки).Равно(Неопределено);
	Ожидаем.Что(Снимок.Кадры[0].Вид).Равно("ВнешняяОшибка");
	Ожидаем.Что(Снимок.Кадры[0].Данные).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СчитатьПоврежденныеИЧужиеМетаданныеВнешними() Экспорт

	// Подготовка
	ВнутренняяОшибка = ФабрикаОшибок.Создать("core.failed", "Корневая ошибка");
	Образец = ФабрикаОшибок.Создать("sample.error", "Образец");
	ЧужойМаркер = ПомощникТестированияОшибок.ОшибкаСЧужимМаркером(Образец, ВнутренняяОшибка);
	ПоврежденныйКонверт = ПомощникТестированияОшибок.ОшибкаСПоврежденнымКонвертом(Образец, ЧужойМаркер);

	// Действие
	Снимок = ДиагностикаОшибок.ВСтруктуру(ПоврежденныйКонверт);

	// Проверка
	Ожидаем.Что(Снимок.Кадры.Количество()).Равно(3);
	Ожидаем.Что(Снимок.Кадры[0].Вид).Равно("ВнешняяОшибка");
	Ожидаем.Что(Снимок.Кадры[1].Вид).Равно("ВнешняяОшибка");
	Ожидаем.Что(Снимок.Кадры[0].Данные).Равно(Неопределено);
	Ожидаем.Что(Снимок.Кадры[1].Данные).Равно(Неопределено);
	Ожидаем.Что(Снимок.Кадры[2].ТипОшибки).Равно("core.failed");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьНовыеМассивыКадровИСтеков() Экспорт

	// Подготовка
	Ошибка = ФабрикаОшибок.Создать("core.failed", "Ошибка");
	ПервыйСнимок = ДиагностикаОшибок.ВСтруктуру(Ошибка);
	ВторойСнимок = ДиагностикаОшибок.ВСтруктуру(Ошибка);
	ИсходныйРазмерСтека = ПервыйСнимок.Кадры[0].Стек.Количество();

	// Действие
	ПервыйСнимок.Кадры.Добавить(Новый Структура);
	ПервыйСнимок.Кадры[0].Стек.Добавить("Проверочный элемент");

	// Проверка
	Ожидаем.Что(ВторойСнимок.Кадры.Количество()).Равно(1);
	Ожидаем.Что(ВторойСнимок.Кадры[0].Стек.Количество()).Равно(ИсходныйРазмерСтека);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СвязатьПоложениеИСтекСКаждымФизическимКадром() Экспорт

	// Подготовка
	Цепочка = ПомощникТестированияОшибок.ЦепочкаСРазнымиМестамиСоздания();

	// Действие
	Снимок = ДиагностикаОшибок.ВСтруктуру(Цепочка.Ошибка);

	// Проверка
	ПроверитьМестоположениеКадра(Снимок.Кадры[0], Цепочка.ВнешнийКадр);
	ПроверитьМестоположениеКадра(Снимок.Кадры[1], Цепочка.ВнутреннийКадр);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОграничитьСнимокШестьюдесятьюЧетырьмяКадрами() Экспорт

	// Подготовка
	ЦепочкаИз64Кадров = ПомощникТестированияОшибок.ДлиннаяЦепочка(64);
	ЦепочкаИз65Кадров = ПомощникТестированияОшибок.ДлиннаяЦепочка(65);

	// Действие
	Снимок64 = ДиагностикаОшибок.ВСтруктуру(ЦепочкаИз64Кадров.Ошибка);
	Снимок65 = ДиагностикаОшибок.ВСтруктуру(ЦепочкаИз65Кадров.Ошибка);

	// Проверка
	Ожидаем.Что(Снимок64.Кадры.Количество()).Равно(64);
	Ожидаем.Что(Снимок64.Усечена).Равно(Ложь);
	Ожидаем.Что(Снимок65.Кадры.Количество()).Равно(64);
	Ожидаем.Что(Снимок65.Усечена).Равно(Истина);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьНеверныйТипАргументаСнимка() Экспорт

	// Подготовка
	Параметры = Новый Массив;
	Параметры.Добавить("не ошибка");

	// Действие и Проверка
	Ожидаем.Что(ДиагностикаОшибок)
		.Метод("ВСтруктуру", Параметры)
		.ВыбрасываетИсключение("Ошибка должна иметь тип ИнформацияОбОшибке");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьСнимокПриНедоступномИмениМодуляКадра() Экспорт

	// Подготовка
	Цепочка = ПомощникТестированияОшибок.ЦепочкаСРазнымиМестамиСоздания();
	ВнешнийКадр = Новый ИнформацияОбОшибке(
		"Не выброшенный внешний кадр",
		Новый Структура("Источник", "Тест"),
		Цепочка.ВнутреннийКадр
	);

	// Действие
	Снимок = ДиагностикаОшибок.ВСтруктуру(ВнешнийКадр);

	// Проверка
	Ожидаем.Что(ИмяМодуляНедоступно(ВнешнийКадр)).Равно(Истина);
	Ожидаем.Что(Снимок.Кадры.Количество()).Равно(2);
	Ожидаем.Что(Снимок.Кадры[0].Сообщение).Равно("Не выброшенный внешний кадр");
	Ожидаем.Что(Снимок.Кадры[0].ИмяМодуля).Равно(Неопределено);
	Ожидаем.Что(Снимок.Кадры[0].Данные).Равно(Неопределено);
	Ожидаем.Что(Снимок.Кадры[0].Стек.Количество()).Равно(0);
	Ожидаем.Что(Снимок.Кадры[1].Сообщение).Равно("Внутренний кадр");
	Ожидаем.Что(Снимок.Кадры[1].ИмяМодуля).Равно(Цепочка.ВнутреннийКадр.ИмяМодуля);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СмешаннаяЦепочка()

	ДанныеВнутреннейОшибки = Новый Структура("Путь", "config.json");
	ВнутренняяОшибка = ФабрикаОшибок.Создать("fs.file_not_found", "Файл не найден", ДанныеВнутреннейОшибки);
	ВнешняяОшибка = ПомощникТестированияОшибок.ВнешняяОшибка("Ошибка JSON-парсера", ВнутренняяОшибка);
	ДанныеЭффективнойОшибки = Новый Структура("Формат", "JSON");
	ЭффективнаяОшибка = ФабрикаОшибок.Обернуть(
		ВнешняяОшибка,
		"config.load_failed",
		"Не удалось загрузить конфигурацию",
		ДанныеЭффективнойОшибки
	);
	ДанныеКонтекста = Новый Структура("Операция", "Загрузка");
	Контекст = ФабрикаОшибок.СКонтекстом(ЭффективнаяОшибка, "Загрузка конфигурации", ДанныеКонтекста);

	Возврат Новый Структура(
		"Ошибка, ДанныеКонтекста, ДанныеЭффективнойОшибки, ДанныеВнутреннейОшибки",
		Контекст,
		ДанныеКонтекста,
		ДанныеЭффективнойОшибки,
		ДанныеВнутреннейОшибки
	);

КонецФункции

Процедура ПроверитьПоляСнимка(Снимок)

	Ожидаем.Что(Снимок.Количество()).Равно(3);
	Ожидаем.Что(Снимок.Свойство("ТипОшибки")).Равно(Истина);
	Ожидаем.Что(Снимок.Свойство("Усечена")).Равно(Истина);
	Ожидаем.Что(Снимок.Свойство("Кадры")).Равно(Истина);
	Ожидаем.Что(Снимок.Свойство("Версия")).Равно(Ложь);

КонецПроцедуры

Процедура ПроверитьПоляКадра(Кадр)

	Ожидаем.Что(Кадр.Количество()).Равно(8);
	Ожидаем.Что(Кадр.Свойство("Вид")).Равно(Истина);
	Ожидаем.Что(Кадр.Свойство("ТипОшибки")).Равно(Истина);
	Ожидаем.Что(Кадр.Свойство("Сообщение")).Равно(Истина);
	Ожидаем.Что(Кадр.Свойство("Данные")).Равно(Истина);
	Ожидаем.Что(Кадр.Свойство("ИмяМодуля")).Равно(Истина);
	Ожидаем.Что(Кадр.Свойство("НомерСтроки")).Равно(Истина);
	Ожидаем.Что(Кадр.Свойство("ИсходнаяСтрока")).Равно(Истина);
	Ожидаем.Что(Кадр.Свойство("Стек")).Равно(Истина);
	Ожидаем.Что(Кадр.Свойство("Кадр")).Равно(Ложь);

КонецПроцедуры

Процедура ПроверитьМестоположениеКадра(СнимокКадра, ИсходныйКадр)

	Ожидаем.Что(СнимокКадра.ИмяМодуля).Равно(ИсходныйКадр.ИмяМодуля);
	Ожидаем.Что(СнимокКадра.НомерСтроки).Равно(ИсходныйКадр.НомерСтроки);
	Ожидаем.Что(СнимокКадра.ИсходнаяСтрока).Равно(ИсходныйКадр.ИсходнаяСтрока);
	Ожидаем.Что(СнимокКадра.Стек.Количество()).Равно(ИсходныйКадр.ПолучитьСтекВызовов().Количество());

КонецПроцедуры

Функция ИмяМодуляНедоступно(Кадр)

	Попытка
		ИмяМодуля = Кадр.ИмяМодуля;
	Исключение
		Возврат Истина;
	КонецПопытки;

	Возврат Ложь;

КонецФункции

#КонецОбласти
