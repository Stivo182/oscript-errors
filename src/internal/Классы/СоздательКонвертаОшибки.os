Перем _ФорматировщикПредставления; // ФорматировщикПредставленияОшибок
Перем _ОписаниеФорматаКадраОшибки; // ОписаниеФорматаКадраОшибки
Перем _РегистраторСбоев; // РегистраторСбоевБиблиотекиОшибок

#Область ОбработчикиСобытий

// Создает создатель конвертов ошибок.
//
// Параметры:
//  ФорматировщикПредставления - ФорматировщикПредставленияОшибок - Форматировщик описания конверта.
//  ОписаниеФорматаКадраОшибки - ОписаниеФорматаКадраОшибки - Описание формата метаданных.
//  РегистраторСбоев - РегистраторСбоевБиблиотекиОшибок - Регистратор подавленных сбоев.
Процедура ПриСозданииОбъекта(
	ФорматировщикПредставления,
	ОписаниеФорматаКадраОшибки,
	РегистраторСбоев
)

	_ФорматировщикПредставления = ФорматировщикПредставления;
	_ОписаниеФорматаКадраОшибки = ОписаниеФорматаКадраОшибки;
	_РегистраторСбоев = РегистраторСбоев;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Создаёт классифицированную ошибку из предварительно проверенных полей.
//
// Параметры:
//  КодОшибки - Строка - Стабильный машинный код ошибки.
//  Сообщение - Строка - Человекочитаемое описание ошибки.
//  Данные - Произвольный, Неопределено - Связанные с ошибкой данные.
//  Подсказка - Строка - Подсказка по исправлению ошибки.
//  URL - Строка - Адрес страницы с дополнительной информацией.
//  Причина - ИнформацияОбОшибке, Неопределено - Непосредственная причина.
//
// Возвращаемое значение:
//  ИнформацияОбОшибке - Новый кадр классифицированной ошибки.
Функция СоздатьОшибкуПоПолям(
	КодОшибки,
	Сообщение,
	Данные = Неопределено,
	Подсказка = "",
	URL = "",
	Причина = Неопределено
) Экспорт

	Описание = _ФорматировщикПредставления.ПользовательскоеПредставлениеКадра(
		ВидыКадровОшибок.Ошибка(),
		КодОшибки,
		Сообщение,
		Подсказка,
		URL,
		КодОшибки,
		Сообщение
	);

	Возврат СоздатьОшибку(
		Описание,
		КодОшибки,
		Сообщение,
		Данные,
		Подсказка,
		URL,
		Причина
	);

КонецФункции

// Создаёт конверт классифицированной ошибки из предварительно подготовленных полей.
// Вызывающая сторона отвечает за корректность переданных значений.
//
// Параметры:
//  Описание - Строка - Итоговое представление ошибки.
//  КодОшибки - Строка - Стабильный машинный код ошибки.
//  Сообщение - Строка - Человекочитаемое описание ошибки.
//  Данные - Произвольный, Неопределено - Связанные с ошибкой данные.
//  Подсказка - Строка - Подсказка по исправлению ошибки.
//  URL - Строка - Адрес страницы с дополнительной информацией.
//  Причина - ИнформацияОбОшибке, Неопределено - Непосредственная причина ошибки.
//
// Возвращаемое значение:
//  ИнформацияОбОшибке - Новый кадр классифицированной ошибки.
Функция СоздатьОшибку(
	Описание,
	КодОшибки,
	Сообщение,
	Данные = Неопределено,
	Подсказка = "",
	URL = "",
	Причина = Неопределено
) Экспорт

	Поля = НовыеПоляКадра();
	Поля.Вид = ВидыКадровОшибок.Ошибка();
	Поля.КодОшибки = КодОшибки;
	Поля.Сообщение = Сообщение;
	Поля.Данные = Данные;
	Поля.Подсказка = Подсказка;
	Поля.URL = URL;
	Поля.КодЭффективнойОшибки = КодОшибки;
	Поля.СообщениеЭффективнойОшибки = Сообщение;

	МетаданныеКадра = Новый ФиксированнаяСтруктура(Поля);

	Конверт = СоздатьИзМетаданных(Описание, МетаданныеКадра, Причина);

	Возврат ПрименитьФормат(Конверт);

КонецФункции

// Создаёт конверт контекста ошибки из предварительно подготовленных полей.
// Вызывающая сторона отвечает за корректность переданных значений.
//
// Параметры:
//  Описание - Строка - Итоговое представление контекста.
//  Сообщение - Строка - Человекочитаемое описание контекста.
//  Причина - ИнформацияОбОшибке - Непосредственная причина ошибки.
//  Данные - Произвольный, Неопределено - Связанные с контекстом данные.
//  КодЭффективнойОшибки - Строка, Неопределено - Эффективный код цепочки ошибок.
//  СообщениеЭффективнойОшибки - Строка - Эффективное сообщение цепочки ошибок.
//
// Возвращаемое значение:
//  ИнформацияОбОшибке - Новый контекстный кадр ошибки.
Функция СоздатьКонтекст(
	Описание,
	Сообщение,
	Причина,
	Данные = Неопределено,
	КодЭффективнойОшибки = Неопределено,
	СообщениеЭффективнойОшибки = ""
) Экспорт

	Поля = НовыеПоляКадра();
	Поля.Вид = ВидыКадровОшибок.Контекст();
	Поля.КодОшибки = Неопределено;
	Поля.Сообщение = Сообщение;
	Поля.Данные = Данные;
	Поля.Подсказка = "";
	Поля.URL = "";
	Поля.КодЭффективнойОшибки = КодЭффективнойОшибки;
	Поля.СообщениеЭффективнойОшибки = СообщениеЭффективнойОшибки;

	МетаданныеКадра = Новый ФиксированнаяСтруктура(Поля);

	Конверт = СоздатьИзМетаданных(Описание, МетаданныеКадра, Причина);

	Возврат ПрименитьФормат(Конверт);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НовыеПоляКадра()

	Поля = Новый Структура;
	Поля.Вставить("Маркер", _ОписаниеФорматаКадраОшибки.МаркерМетаданных());
	Поля.Вставить("ВерсияФормата", _ОписаниеФорматаКадраОшибки.ВерсияФормата());
	Поля.Вставить("Вид", Неопределено);
	Поля.Вставить("КодОшибки", Неопределено);
	Поля.Вставить("Сообщение", "");
	Поля.Вставить("Данные", Неопределено);
	Поля.Вставить("Подсказка", "");
	Поля.Вставить("URL", "");
	Поля.Вставить("КодЭффективнойОшибки", Неопределено);
	Поля.Вставить("СообщениеЭффективнойОшибки", "");

	Возврат Поля;

КонецФункции

Функция СоздатьИзМетаданных(Описание, МетаданныеКадра, Причина = Неопределено)

	Если Причина = Неопределено Тогда
		Возврат Новый ИнформацияОбОшибке(Описание, МетаданныеКадра);
	КонецЕсли;

	Возврат Новый ИнформацияОбОшибке(Описание, МетаданныеКадра, Причина);

КонецФункции

Функция ПрименитьФормат(Конверт)

	Попытка
		Возврат ПрименитьНастроенныйФормат(Конверт);
	Исключение
		_РегистраторСбоев.ЗаписатьПодавленныйСбой(
			"envelope.render_configured_description",
			Конверт,
			ИнформацияОбОшибке()
		);
		Возврат Конверт;
	КонецПопытки;

КонецФункции

Функция ПрименитьНастроенныйФормат(Конверт)

	ИсходныйФормат = ПолучитьПеременнуюСреды("ONESCRIPT_ERRORS_FORMAT");
	Формат = НРег(СокрЛП(ИсходныйФормат));

	Если ПустаяСтрока(Формат) Или Формат = "user" Тогда
		Возврат Конверт;
	КонецЕсли;

	Если Формат <> "diagnostic" И Формат <> "sections" Тогда
		_РегистраторСбоев.ЗаписатьНекорректнуюНастройку("ONESCRIPT_ERRORS_FORMAT", ИсходныйФормат);
		Возврат Конверт;
	КонецЕсли;

	Разбор = Новый РазборОшибки(Конверт);
	Если Формат = "diagnostic" Тогда
		ДиагностическоеОписание = Разбор.ДиагностическоеПредставление();
	Иначе
		ИсходныеРазделы = ПолучитьПеременнуюСреды("ONESCRIPT_ERRORS_SECTIONS");
		Разделы = РазобратьРазделы(ИсходныеРазделы);

		Если Разделы = Неопределено Тогда
			_РегистраторСбоев.ЗаписатьНекорректнуюНастройку("ONESCRIPT_ERRORS_SECTIONS", ИсходныеРазделы);
			Возврат Конверт;
		КонецЕсли;

		ДиагностическоеОписание = _ФорматировщикПредставления.СформироватьИзРазделов(
			Разбор.Снимки(),
			Разбор.ЦепочкаУсечена(),
			Разделы
		);
	КонецЕсли;

	Возврат СоздатьИзМетаданных(
		ДиагностическоеОписание,
		Конверт.Параметры,
		Конверт.Причина
	);

КонецФункции

Функция РазобратьРазделы(ИсходныеРазделы)

	Результат = Новый Массив;
	ДопустимыеРазделы = _ФорматировщикПредставления.ПоддерживаемыеРазделы();

	Для Каждого Раздел Из СтрРазделить(ИсходныеРазделы, ",", Ложь) Цикл
		Раздел = НРег(СокрЛП(Раздел));
		Если ПустаяСтрока(Раздел) Тогда
			Продолжить;
		КонецЕсли;

		Если ДопустимыеРазделы.Найти(Раздел) = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;

		Если Результат.Найти(Раздел) = Неопределено Тогда
			Результат.Добавить(Раздел);
		КонецЕсли;
	КонецЦикла;

	Если Результат.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Результат;

КонецФункции

#КонецОбласти
