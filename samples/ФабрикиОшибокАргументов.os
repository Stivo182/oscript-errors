// Демонстрирует ручное создание трёх стандартных ошибок аргументов через фабрику.
// Одна созданная ошибка выбрасывается и исследуется после перехвата, сценарий завершается успешно.

#Использовать errors

ОшибкаТипа = СтандартныеОшибки.НеверныйТипАргумента("Порт", Строка(Тип("Число")), "8080");
ОшибкаЗаполнения = СтандартныеОшибки.АргументНеЗаполнен("Адрес");
ОшибкаЗначения = СтандартныеОшибки.НедопустимоеЗначениеАргумента(
	"Порт",
	"число от 1 до 65535",
	"Порт находится вне допустимого диапазона"
);

Ошибки = Новый Массив;
Ошибки.Добавить(ОшибкаТипа);
Ошибки.Добавить(ОшибкаЗаполнения);
Ошибки.Добавить(ОшибкаЗначения);

Для Каждого Ошибка Из Ошибки Цикл
	Снимок = Новый СнимокКадраОшибки(Ошибка);
	Сообщить(Снимок.КодОшибки() + ": " + Снимок.Сообщение());
КонецЦикла;

Попытка
	ВызватьИсключение ОшибкаЗначения;
Исключение
	Снимок = Новый СнимокКадраОшибки(ИнформацияОбОшибке());
	Сообщить("Перехвачено ожидание: " + Снимок.Данные().Ожидание);
КонецПопытки;
