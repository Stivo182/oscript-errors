#Использовать asserts
#Использовать "../src"
#Использовать "../src/internal"

Перем _ИсходныйФормат;

#Область ОбработчикиСобытий

&ПередКаждым
Процедура СохранитьФорматИсключений() Экспорт

	_ИсходныйФормат = ПолучитьПеременнуюСреды("ONESCRIPT_ERRORS_FORMAT");

КонецПроцедуры

&ПослеКаждого
Процедура ВосстановитьФорматИсключений() Экспорт

	УстановитьПеременнуюСреды("ONESCRIPT_ERRORS_FORMAT", _ИсходныйФормат);

КонецПроцедуры

#КонецОбласти

#Область Тесты

&Тест
Процедура ТестДолжен_СоздатьОшибкуПоПолям() Экспорт

	// Подготовка
	Причина = ФабрикаОшибок.Создать("source.failed", "Исходная ошибка");
	Данные = Новый Структура("Ресурс", "config.json");
	Создатель = Новый СоздательКонвертаОшибки();

	// Действие
	Ошибка = Создатель.СоздатьОшибкуПоПолям(
		"config.invalid",
		"Ошибка конфигурации",
		Данные,
		"Исправьте файл",
		"https://example.org/errors/config.invalid",
		Причина
	);

	// Проверка
	Ожидаем.Что(Ошибка.Описание)
		.Содержит("config.invalid: Ошибка конфигурации");
	Ожидаем.Что(Ошибка.Причина).Равно(Причина);
	Ожидаем.Что(Ошибка.Параметры.Данные).Равно(Данные);
	Ожидаем.Что(Ошибка.Параметры.Подсказка).Равно("Исправьте файл");
	Ожидаем.Что(Ошибка.Параметры.URL).Равно("https://example.org/errors/config.invalid");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПрименитьНастроенныйФорматПриСозданииКонверта() Экспорт

	// Подготовка
	УстановитьПеременнуюСреды("ONESCRIPT_ERRORS_FORMAT", "diagnostic");
	Данные = Новый Структура("Формат", "JSON");
	Создатель = Новый СоздательКонвертаОшибки();

	// Действие
	Ошибка = Создатель.СоздатьОшибку(
		"config.invalid: Ошибка конфигурации",
		"config.invalid",
		"Ошибка конфигурации",
		Данные
	);

	// Проверка
	Ожидаем.Что(Ошибка.Описание).Содержит("Данные:");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьКонвертОшибки() Экспорт

	// Подготовка
	Причина = Новый ИнформацияОбОшибке("Исходная ошибка", Новый Структура("Источник", "Тест"));
	Данные = Новый Структура("ИмяРесурса", "Настройки");
	Создатель = Новый СоздательКонвертаОшибки();

	// Действие
	Ошибка = Создатель.СоздатьОшибку(
		"storage.read_failed: Не удалось прочитать настройки",
		"storage.read_failed",
		"Не удалось прочитать настройки",
		Данные,
		"Проверить доступ к файлу",
		"https://example.com/errors/storage.read_failed",
		Причина
	);
	Снимок = Новый СнимокКадраОшибки(Ошибка);

	// Проверка
	Ожидаем.Что(ТипЗнч(Ошибка)).Равно(Тип("ИнформацияОбОшибке"));
	Ожидаем.Что(Ошибка.Описание).Равно("storage.read_failed: Не удалось прочитать настройки");
	Ожидаем.Что(Ошибка.Причина).Равно(Причина);
	Ожидаем.Что(Снимок.Вид()).Равно(ВидыКадровОшибок.Ошибка());
	Ожидаем.Что(Снимок.КодОшибки()).Равно("storage.read_failed");
	Ожидаем.Что(Снимок.Сообщение()).Равно("Не удалось прочитать настройки");
	Ожидаем.Что(Снимок.Данные()).Равно(Данные);
	Ожидаем.Что(Снимок.Подсказка()).Равно("Проверить доступ к файлу");
	Ожидаем.Что(Снимок.URL()).Равно("https://example.com/errors/storage.read_failed");
	Ожидаем.Что(Ошибка.Параметры.КодЭффективнойОшибки).Равно("storage.read_failed");
	Ожидаем.Что(Ошибка.Параметры.СообщениеЭффективнойОшибки).Равно("Не удалось прочитать настройки");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьКонвертКонтекста() Экспорт

	// Подготовка
	Причина = Новый ИнформацияОбОшибке("Исходная ошибка", Новый Структура("Источник", "Тест"));
	Данные = Новый Структура("ИмяОперации", "Чтение настроек");
	Создатель = Новый СоздательКонвертаОшибки();

	// Действие
	Ошибка = Создатель.СоздатьКонтекст(
		"Не удалось загрузить приложение",
		"Не удалось загрузить приложение",
		Причина,
		Данные,
		"storage.read_failed",
		"Не удалось прочитать настройки"
	);
	Снимок = Новый СнимокКадраОшибки(Ошибка);

	// Проверка
	Ожидаем.Что(Ошибка.Причина).Равно(Причина);
	Ожидаем.Что(Снимок.Вид()).Равно(ВидыКадровОшибок.Контекст());
	Ожидаем.Что(Ошибка.Параметры.КодОшибки).Равно(Неопределено);
	Ожидаем.Что(Снимок.Сообщение()).Равно("Не удалось загрузить приложение");
	Ожидаем.Что(Снимок.Данные()).Равно(Данные);
	Ожидаем.Что(Снимок.Подсказка()).Равно("");
	Ожидаем.Что(Снимок.URL()).Равно("");
	Ожидаем.Что(Ошибка.Параметры.КодЭффективнойОшибки).Равно("storage.read_failed");
	Ожидаем.Что(Ошибка.Параметры.СообщениеЭффективнойОшибки).Равно("Не удалось прочитать настройки");

КонецПроцедуры

#КонецОбласти
