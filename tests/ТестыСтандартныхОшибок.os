	Ошибки.Добавить(СтандартныеОшибки.УзелНедоступен("db.example.org"));
	Ошибки.Добавить(СтандартныеОшибки.СетьНедоступна("Корпоративная сеть"));
	Ошибки.Добавить(СтандартныеОшибки.НекорректныеДанные("Конфигурация"));
