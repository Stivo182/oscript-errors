Перем _ПравилаПоТипу; // ФиксированноеСоответствие из КлючИЗначение:
                      //  * Ключ - Строка - Полное имя нативного типа исключения.
                      //  * Значение - ФиксированныйМассив из ФиксированнаяСтруктура - Правила этого типа.
Перем _ПравилаПоСообщению; // ФиксированноеСоответствие из КлючИЗначение:
                           //  * Ключ - Строка - Точное сообщение ошибки.
                           //  * Значение - ФиксированныйМассив из ФиксированнаяСтруктура - Правила сообщения.
Перем _ПравилаПрефиксов; // ФиксированныйМассив из ФиксированнаяСтруктура
Перем _Источник; // Строка - Источник набора правил.
Перем _РегулярноеВыражениеЛокализованногоШаблона; // РегулярноеВыражение
Перем _РегулярныеВыраженияЯзыковыхВариантов; // Структура из КлючИЗначение:
                                             //  * ru - РегулярноеВыражение - Регулярное выражение русского варианта.
                                             //  * en - РегулярноеВыражение - Регулярное выражение английского варианта.

#Область ОбработчикиСобытий

// Создает неизменяемый индекс правил классификации.
// Локализованные шаблоны разбираются один раз при создании индекса.
//
// Параметры:
//  Правила - Массив из ПравилоКлассификацииОшибок - Правила классификации.
//  Источник - Строка - Источник набора правил.
//  НачальныйНомерПравила - Число - Номер первого правила для автоматического идентификатора.
//
// Исключения:
//  Если приоритет правила имеет тип, отличный от Число.
Процедура ПриСозданииОбъекта(Правила, Источник, НачальныйНомерПравила = 1)

	_Источник = Источник;
	ИнициализироватьРегулярныеВыраженияЛокализации();

	ПоТипу = Новый Соответствие;
	ПоСообщению = Новый Соответствие;
	Префиксы = Новый Массив;

	НомерПравила = НачальныйНомерПравила;
	Для Каждого Правило Из Правила Цикл
		ПроверитьПравило(Правило);
		ПодготовленноеПравило = ПодготовитьПравило(Правило, НомерПравила);

		Если Не ПустаяСтрока(Правило.ИсходноеСообщение())
			И ПустаяСтрока(Правило.НативныйТип()) Тогда

			Если ПодготовленноеПравило.ЕстьРусскийВариант Тогда
				ДобавитьВИндекс(
					ПоСообщению,
					ПодготовленноеПравило.ИсходноеСообщение,
					ПодготовленноеПравило
				);
			КонецЕсли;

			Если ПодготовленноеПравило.ЕстьАнглийскийВариант
				И (Не ПодготовленноеПравило.ЕстьРусскийВариант
					Или ПодготовленноеПравило.ИсходноеСообщениеEN
						<> ПодготовленноеПравило.ИсходноеСообщение) Тогда
				ДобавитьВИндекс(
					ПоСообщению,
					ПодготовленноеПравило.ИсходноеСообщениеEN,
					ПодготовленноеПравило
				);
			КонецЕсли;

		ИначеЕсли Не ПустаяСтрока(Правило.НативныйТип()) Тогда

			ДобавитьВИндекс(ПоТипу, Правило.НативныйТип(), ПодготовленноеПравило);

		Иначе
			Префиксы.Добавить(ПодготовленноеПравило);
		КонецЕсли;

		НомерПравила = НомерПравила + 1;
	КонецЦикла;

	_ПравилаПоТипу = ЗафиксироватьИндекс(ПоТипу);
	_ПравилаПоСообщению = ЗафиксироватьИндекс(ПоСообщению);
	_ПравилаПрефиксов = Новый ФиксированныйМассив(Префиксы);

КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Добавляет совпавшие коды одного кадра в массив кандидатов.
// Одинаковые коды с одинаковым приоритетом объединяются с сохранением подтвержденного нативного типа.
// Индекс и данные кандидатов не изменяются между вызовами.
//
// Параметры:
//  Кадр - ФиксированнаяСтруктура - Кадр ошибки:
//    * Описание - Строка - Сообщение кадра.
//    * НативныйТип - Строка, Неопределено - Полное имя нативного типа исключения.
//    * ВнутреннееСообщение - Строка - Текст нативной ошибки без служебной обёртки типа.
//    * РазрешенДляПоиска - Булево - Признак доступности кадра для сопоставления.
//  Кандидаты - Массив из ФиксированнаяСтруктура - Пополняемые кандидаты:
//    * Код - Строка - Код классифицированной ошибки.
//    * Сообщение - Строка - Нормализованное описание ошибки.
//    * Приоритет - Число - Приоритет совпавшего правила.
//    * Данные - ФиксированнаяСтруктура - Диагностические данные:
//      * Источник - Строка - Источник набора правил.
//      * Правило - Строка - Код совпавшего правила.
//      * НативныйТип - Строка - Проверенный правилом нативный тип, если использовался.
Процедура СобратьКандидаты(Кадр, Кандидаты) Экспорт

	Если Не Кадр.РазрешенДляПоиска Тогда
		Возврат;
	КонецЕсли;

	ДобавленныеКоды = Новый Соответствие;
	ТекстСообщения = Кадр.ВнутреннееСообщение;

	// Типовые правила проверяются первыми, чтобы текстовый дубль не ослабил кандидат.
	Если Не ПустаяСтрока(Кадр.НативныйТип) Тогда
		ПравилаТипа = _ПравилаПоТипу.Получить(Кадр.НативныйТип);
		Если ПравилаТипа <> Неопределено Тогда
			СобратьСовпадения(
				ПравилаТипа,
				ТекстСообщения,
				ТекстСообщения,
				Кандидаты,
				ДобавленныеКоды
			);
		КонецЕсли;
	КонецЕсли;

	ТочныеПравила = _ПравилаПоСообщению.Получить(ТекстСообщения);
	Если ТочныеПравила <> Неопределено Тогда
		Для Каждого Правило Из ТочныеПравила Цикл
			ДобавитьКандидат(Правило.Кандидат, Кандидаты, ДобавленныеКоды);
		КонецЦикла;
	КонецЕсли;

	СобратьСовпадения(
		_ПравилаПрефиксов,
		ТекстСообщения,
		ТекстСообщения,
		Кандидаты,
		ДобавленныеКоды
	);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьВИндекс(Индекс, Ключ, Правило)

	ПравилаКлюча = Индекс.Получить(Ключ);
	Если ПравилаКлюча = Неопределено Тогда
		ПравилаКлюча = Новый Массив;
		Индекс.Вставить(Ключ, ПравилаКлюча);
	КонецЕсли;

	ПравилаКлюча.Добавить(Правило);

КонецПроцедуры

Функция ЗафиксироватьИндекс(Индекс)

	Результат = Новый Соответствие;
	Для Каждого Пара Из Индекс Цикл
		Результат.Вставить(Пара.Ключ, Новый ФиксированныйМассив(Пара.Значение));
	КонецЦикла;

	Возврат Новый ФиксированноеСоответствие(Результат);

КонецФункции

Функция ПодготовитьПравило(Правило, НомерПравила)

	ИсходноеСообщение = ЛокализоватьШаблон(Правило.ИсходноеСообщение(), "ru");
	Префикс = ЛокализоватьШаблон(Правило.Префикс(), "ru");
	Фрагмент = ЛокализоватьШаблон(Правило.Фрагмент(), "ru");
	Окончание = ЛокализоватьШаблон(Правило.Окончание(), "ru");
	ИсходноеСообщениеEN = ЛокализоватьШаблон(Правило.ИсходноеСообщение(), "en");
	ПрефиксEN = ЛокализоватьШаблон(Правило.Префикс(), "en");
	ФрагментEN = ЛокализоватьШаблон(Правило.Фрагмент(), "en");
	ОкончаниеEN = ЛокализоватьШаблон(Правило.Окончание(), "en");
	ЕстьРусскийВариант = ДоступенВариант(Правило, "ru");
	ЕстьАнглийскийВариант = ДоступенВариант(Правило, "en");

	Возврат Новый ФиксированнаяСтруктура(
		Новый Структура(
			"ИсходноеСообщение, Префикс, Фрагмент, Окончание, "
				+ "ИсходноеСообщениеEN, ПрефиксEN, "
				+ "ФрагментEN, ОкончаниеEN, "
				+ "ЕстьРусскийВариант, ЕстьАнглийскийВариант, Кандидат",
			ИсходноеСообщение,
			Префикс,
			Фрагмент,
			Окончание,
			ИсходноеСообщениеEN,
			ПрефиксEN,
			ФрагментEN,
			ОкончаниеEN,
			ЕстьРусскийВариант,
			ЕстьАнглийскийВариант,
			ПодготовитьКандидат(Правило, НомерПравила)
		)
	);

КонецФункции

Функция ПодготовитьКандидат(Правило, НомерПравила)

	Данные = Новый Структура(
		"Источник, Правило",
		_Источник,
		ИдентификаторПравила(Правило, НомерПравила)
	);
	Если Не ПустаяСтрока(Правило.НативныйТип()) Тогда
		Данные.Вставить("НативныйТип", Правило.НативныйТип());
	КонецЕсли;

	ОписаниеОшибки = Правило.ОписаниеРезультата();
	Если ЭтоЛокализованныйШаблон(ОписаниеОшибки) Тогда
		ОписаниеОшибки = НСтр(ОписаниеОшибки);
	КонецЕсли;

	Возврат Новый ФиксированнаяСтруктура(
		Новый Структура(
			"Код, Сообщение, Приоритет, Данные",
			Правило.КодОшибки(),
			ОписаниеОшибки,
			Правило.Приоритет(),
			Новый ФиксированнаяСтруктура(Данные)
		)
	);

КонецФункции

Функция ИдентификаторПравила(Правило, НомерПравила)

	Идентификатор = "";
	Попытка
		Идентификатор = Правило.Идентификатор();
	Исключение
		Идентификатор = "";
	КонецПопытки;

	Если Не ПустаяСтрока(Идентификатор) Тогда
		Возврат Идентификатор;
	КонецЕсли;

	Возврат СтрШаблон("%1.%2", _Источник, НомерПравила);

КонецФункции

Процедура ПроверитьПравило(Правило)

	ПроверитьНепустоеПоле(Правило.КодОшибки(), "КодОшибки");
	СервисыБиблиотекиОшибок.ПроверяющийКадрыОшибок().ПроверитьКодОшибки(Правило.КодОшибки());
	ПроверитьНепустоеПоле(Правило.ОписаниеРезультата(), "ОписаниеОшибки");

	Если ТипЗнч(Правило.Приоритет()) <> Тип("Число") Тогда
		ВызватьИсключение ФабрикаОшибок.Создать(
			КодыСтандартныхОшибок.НеверныйТипАргумента(),
			НСтр(
				"ru = 'Поле правила Приоритет должно иметь тип Число'; "
					+ "en = 'Rule field Priority must have the Number type'"
			),
			Новый Структура("ИмяПоля", "Приоритет")
		);
	КонецЕсли;

	Если Не ПустаяСтрока(Правило.ИсходноеСообщение()) Тогда
		Если Не ПустаяСтрока(Правило.Префикс())
			Или Не ПустаяСтрока(Правило.Фрагмент())
			Или Не ПустаяСтрока(Правило.Окончание()) Тогда
			ВызватьИсключение ФабрикаОшибок.Создать(
				КодыСтандартныхОшибок.НедопустимоеЗначениеАргумента(),
				НСтр(
				"ru = 'Точное сообщение нельзя сочетать с префиксом, фрагментом или окончанием'; "
					+ "en = 'Exact message cannot be combined with prefix, fragment, or suffix'"
				),
				Новый Структура("ИмяПоля", "ИсходноеСообщение")
			);
		КонецЕсли;
	ИначеЕсли ПустаяСтрока(Правило.НативныйТип()) Тогда
		ПроверитьЛокализованныеПрефиксы(Правило);
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьЛокализованныеПрефиксы(Правило)

	Если ДоступенВариант(Правило, "ru") Тогда
		ПроверитьНепустоеПоле(ЛокализоватьШаблон(Правило.Префикс(), "ru"), "Префикс");
	КонецЕсли;

	Если ДоступенВариант(Правило, "en") Тогда
		ПроверитьНепустоеПоле(ЛокализоватьШаблон(Правило.Префикс(), "en"), "Префикс");
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьНепустоеПоле(Значение, ИмяПоля)

	Если ПустаяСтрока(Значение) Тогда
		ВызватьИсключение ФабрикаОшибок.Создать(
			КодыСтандартныхОшибок.НедопустимоеЗначениеАргумента(),
			СтрШаблон(
				НСтр("ru = 'Не заполнено обязательное поле правила: %1'; "
					+ "en = 'Required rule field is not specified: %1'"),
				ИмяПоля
			),
			Новый Структура("ИмяПоля", ИмяПоля)
		);
	КонецЕсли;

КонецПроцедуры

Процедура СобратьСовпадения(Правила, Описание, ТочноеСообщение, Кандидаты, ДобавленныеКоды)

	Для Каждого Правило Из Правила Цикл
		Если Правило.ЕстьРусскийВариант
			И Соответствует(
			Описание,
			ТочноеСообщение,
			Правило.ИсходноеСообщение,
			Правило.Префикс,
			Правило.Фрагмент,
			Правило.Окончание
		)
			Или Правило.ЕстьАнглийскийВариант
				И Соответствует(
					Описание,
					ТочноеСообщение,
					Правило.ИсходноеСообщениеEN,
					Правило.ПрефиксEN,
					Правило.ФрагментEN,
					Правило.ОкончаниеEN
				) Тогда
			ДобавитьКандидат(Правило.Кандидат, Кандидаты, ДобавленныеКоды);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьКандидат(Кандидат, Кандидаты, ДобавленныеКоды)

	КлючКандидата = Кандидат.Код + Символы.ПС + Строка(Кандидат.Приоритет);
	Если ДобавленныеКоды.Получить(КлючКандидата) = Истина Тогда
		Возврат;
	КонецЕсли;

	Кандидаты.Добавить(Кандидат);
	ДобавленныеКоды.Вставить(КлючКандидата, Истина);

КонецПроцедуры

Функция Соответствует(Описание, ТочноеСообщение, ИсходноеСообщение, Префикс, Фрагмент, Окончание)

	Если Не ПустаяСтрока(ИсходноеСообщение) Тогда
		Возврат ТочноеСообщение = ИсходноеСообщение;
	КонецЕсли;

	Если Не ПустаяСтрока(Префикс)
		И Не СтрНачинаетсяС(Описание, Префикс) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Не ПустаяСтрока(Фрагмент)
		И СтрНайти(Описание, Фрагмент) = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Не ПустаяСтрока(Окончание)
		И Не СтрЗаканчиваетсяНа(Описание, Окончание) Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

Функция ЛокализоватьШаблон(Шаблон, Язык)

	Если Не ЭтоЛокализованныйШаблон(Шаблон) Тогда
		Возврат Шаблон;
	КонецЕсли;

	Если Не СодержитЯзыковойВариант(Шаблон, Язык) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат НСтр(Шаблон, Язык);

КонецФункции

Функция ДоступенВариант(Правило, Язык)

	Возврат ДоступенШаблон(Правило.ИсходноеСообщение(), Язык)
		И ДоступенШаблон(Правило.Префикс(), Язык)
		И ДоступенШаблон(Правило.Фрагмент(), Язык)
		И ДоступенШаблон(Правило.Окончание(), Язык);

КонецФункции

Функция ДоступенШаблон(Шаблон, Язык)

	Возврат Не ЭтоЛокализованныйШаблон(Шаблон)
		Или СодержитЯзыковойВариант(Шаблон, Язык);

КонецФункции

Функция ЭтоЛокализованныйШаблон(Шаблон)

	Возврат _РегулярноеВыражениеЛокализованногоШаблона.Совпадает(Шаблон);

КонецФункции

Функция СодержитЯзыковойВариант(Шаблон, Язык)

	РегулярноеВыражение = Неопределено;
	Если Не _РегулярныеВыраженияЯзыковыхВариантов.Свойство(НРег(Язык), РегулярноеВыражение) Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат РегулярноеВыражение.Совпадает(Шаблон);

КонецФункции

Процедура ИнициализироватьРегулярныеВыраженияЛокализации()

	ШаблонЯзыковогоВарианта = ВыражениеЯзыковогоВарианта();

	// Допускает только последовательность полных вариантов ru/en.
	_РегулярноеВыражениеЛокализованногоШаблона = СоздатьРегулярноеВыражение(
		"\A\s*" + ШаблонЯзыковогоВарианта
			+ "(\s*;\s*" + ШаблонЯзыковогоВарианта + ")*\s*\z"
	);

	_РегулярныеВыраженияЯзыковыхВариантов = Новый Структура(
		"ru, en",
		// Перед ru могут быть только полные языковые варианты, поэтому ru/en внутри значения игнорируются.
		СоздатьРегулярноеВыражение(
			"\A\s*(" + ШаблонЯзыковогоВарианта + "\s*;\s*)*ru\s*="
		),
		// Перед en могут быть только полные языковые варианты, поэтому ru/en внутри значения игнорируются.
		СоздатьРегулярноеВыражение(
			"\A\s*(" + ШаблонЯзыковогоВарианта + "\s*;\s*)*en\s*="
		)
	);

КонецПроцедуры

Функция СоздатьРегулярноеВыражение(Шаблон)

	РегулярноеВыражение = Новый РегулярноеВыражение(Шаблон);
	РегулярноеВыражение.ИгнорироватьРегистр = Истина;
	РегулярноеВыражение.Многострочный = Ложь;

	Возврат РегулярноеВыражение;

КонецФункции

Функция ВыражениеЯзыковогоВарианта()

	// Значение допускает одинарные или двойные кавычки с удвоенным экранированием одноимённой кавычки.
	Возврат "(ru|en)\s*=\s*('([^']|'')*'|\x22([^\x22]|\x22\x22)*\x22)";

КонецФункции

#КонецОбласти
