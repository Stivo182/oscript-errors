	Параметры = ПараметрыНекорректногоВызоваФабрики(ИмяФабрики, ИмяПараметра, НекорректноеЗначение);

	// Действие
	Ошибка = ОшибкаСтандартнойФабрики(ИмяФабрики, Параметры);
	Снимок = Новый СнимокКадраОшибки(Ошибка);

	// Проверка
	Ожидаем.Что(Снимок.КодОшибки()).Равно(ОжидаемыйКодОшибки);
	Ожидаем.Что(Снимок.Данные().ИмяАргумента).Равно(ИмяПараметра);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("НестроковыйКодОшибки", "argument.invalid_type", "КодОшибки", "ОжидаемыйТип", "Строка")
&ИсточникЗначение("НекорректныйФорматКодаОшибки", "argument.invalid_value", "КодОшибки", "Ожидание", "формату кода")
&ИсточникЗначение("НестроковоеСообщение", "argument.invalid_type", "Сообщение", "ОжидаемыйТип", "Строка")
&ИсточникЗначение("ПустоеСообщение", "argument.required", "Сообщение", "ИмяАргумента", "Сообщение")
&ИсточникЗначение("НекорректнаяПричина", "argument.invalid_type", "Причина", "ОжидаемыйТип", "ИнформацияОбОшибке")
Процедура ТестДолжен_КлассифицироватьКонтрактыФабрики(
	ИмяПроверки,
	ОжидаемыйКодОшибки,
	ИмяАргумента,
	ИмяПоля,
	ОжидаемоеЗначение
) Экспорт

	// Действие
	Ошибка = ОшибкаКонтрактаФабрики(ИмяПроверки);
	Если ИмяПоля = "ОжидаемыйТип" Тогда
		Если ИмяПроверки = "НекорректнаяПричина" Тогда
			ОжидаемоеЗначение = Строка(Тип("ИнформацияОбОшибке"));
		Иначе
			ОжидаемоеЗначение = Строка(Тип("Строка"));
		КонецЕсли;
	КонецЕсли;

	// Проверка
	Снимок = Новый СнимокКадраОшибки(Ошибка);
	Ожидаем.Что(Снимок.КодОшибки()).Равно(ОжидаемыйКодОшибки);
	Ожидаем.Что(Снимок.Данные().ИмяАргумента).Равно(ИмяАргумента);
	Ожидаем.Что(Снимок.Данные()[ИмяПоля]).Равно(ОжидаемоеЗначение);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ВнешняяОшибка(Сообщение)

	Попытка
		ВызватьИсключение Сообщение;
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

КонецФункции

Функция ОшибкаКонтрактаФабрики(ИмяПроверки)

	Попытка
		Если ИмяПроверки = "НестроковыйКодОшибки" Тогда
			ФабрикаОшибок.Создать(42, "Сообщение");
		ИначеЕсли ИмяПроверки = "НекорректныйФорматКодаОшибки" Тогда
			ФабрикаОшибок.Создать("core.not-failed", "Сообщение");
		ИначеЕсли ИмяПроверки = "НестроковоеСообщение" Тогда
			ФабрикаОшибок.Создать("core.failed", 42);
		ИначеЕсли ИмяПроверки = "ПустоеСообщение" Тогда
			ФабрикаОшибок.Создать("core.failed", "");
		Иначе
			ФабрикаОшибок.ОбернутьКонтекстом("не ошибка", "Контекст");
		КонецЕсли;
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидалось контрактное исключение фабрики";

КонецФункции

Функция ОшибкаНеверногоТипаАргумента(ИмяАргумента, ОжидаемыйТип, ФактическоеЗначение, Сообщение = "")

	Попытка
		СтандартныеОшибки.НеверныйТипАргумента(
			ИмяАргумента,
			ОжидаемыйТип,
			ФактическоеЗначение,
			Сообщение
		);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидалось исключение фабрики ошибки неверного типа аргумента";

КонецФункции

Функция ОшибкаАргументаНеЗаполнен(ИмяАргумента, Сообщение = "")

	Попытка
		СтандартныеОшибки.АргументНеЗаполнен(ИмяАргумента, Сообщение);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидалось исключение фабрики ошибки незаполненного аргумента";

КонецФункции

Функция ОшибкаНедопустимогоЗначенияАргумента(ИмяАргумента, Ожидание, Сообщение = "")

	Попытка
		СтандартныеОшибки.НедопустимоеЗначениеАргумента(ИмяАргумента, Ожидание, Сообщение);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидалось исключение фабрики ошибки недопустимого значения аргумента";

КонецФункции

Функция ОшибкаСтандартнойФабрики(ИмяФабрики, Параметры)

	Попытка
		Если ИмяФабрики = "НеверныйТипАргумента" Тогда
			СтандартныеОшибки.НеверныйТипАргумента(
				Параметры[0],
				Параметры[1],
				Параметры[2],
				Параметры[3]
			);
		ИначеЕсли ИмяФабрики = "АргументНеЗаполнен" Тогда
			СтандартныеОшибки.АргументНеЗаполнен(Параметры[0], Параметры[1]);
		Иначе
			СтандартныеОшибки.НедопустимоеЗначениеАргумента(Параметры[0], Параметры[1], Параметры[2]);
		КонецЕсли;
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидалось исключение стандартной фабрики";

КонецФункции

Функция ПараметрыНекорректногоВызоваФабрики(ИмяФабрики, ИмяПараметра, НекорректноеЗначение)

	Параметры = Новый Массив;

	Если ИмяФабрики = "НеверныйТипАргумента" Тогда
		Параметры.Добавить("Имя");
		Параметры.Добавить("Строка");
		Параметры.Добавить("Значение");
		Параметры.Добавить("");
		ИндексПараметра = ИндексПараметраНеверногоТипа(ИмяПараметра);
	ИначеЕсли ИмяФабрики = "АргументНеЗаполнен" Тогда
		Параметры.Добавить("Имя");
		Параметры.Добавить("");
		ИндексПараметра = ИндексПараметраНезаполненногоАргумента(ИмяПараметра);
	Иначе
		Параметры.Добавить("Имя");
		Параметры.Добавить("быть заполненным");
		Параметры.Добавить("");
		ИндексПараметра = ИндексПараметраНедопустимогоЗначения(ИмяПараметра);
	КонецЕсли;

	Параметры[ИндексПараметра] = НекорректноеЗначение;

	Возврат Параметры;

КонецФункции

Функция ИндексПараметраНеверногоТипа(ИмяПараметра)

	Если ИмяПараметра = "ИмяАргумента" Тогда
		Возврат 0;
	ИначеЕсли ИмяПараметра = "ОжидаемыйТип" Тогда
		Возврат 1;
	Иначе
		Возврат 3;
	КонецЕсли;

КонецФункции

Функция ИндексПараметраНезаполненногоАргумента(ИмяПараметра)

	Если ИмяПараметра = "ИмяАргумента" Тогда
		Возврат 0;
	КонецЕсли;

	Возврат 1;

КонецФункции

Функция ИндексПараметраНедопустимогоЗначения(ИмяПараметра)

	Если ИмяПараметра = "ИмяАргумента" Тогда
		Возврат 0;
	ИначеЕсли ИмяПараметра = "Ожидание" Тогда
		Возврат 1;
	КонецЕсли;

	Возврат 2;

КонецФункции

Функция СтандартноеСообщениеНеверногоТипа(ИмяАргумента, ОжидаемыйТип)

	Возврат СтрШаблон(
		НСтр("ru = 'Аргумент ''%1'' должен иметь тип %2'; en = 'Argument ''%1'' must be of type %2'"),
		ИмяАргумента,
		ОжидаемыйТип
	);

КонецФункции

Функция СтандартноеСообщениеНезаполненногоАргумента(ИмяАргумента)

	Возврат СтрШаблон(
		НСтр("ru = 'Аргумент ''%1'' должен быть заполнен'; en = 'Argument ''%1'' is required'"),
		ИмяАргумента
	);

КонецФункции

Функция СтандартноеСообщениеНедопустимогоЗначения(ИмяАргумента, Ожидание)

	Возврат СтрШаблон(
		НСтр(
			"ru = 'Аргумент ''%1'' имеет недопустимое значение: ожидается %2';"
			+ "en = 'Argument ''%1'' has an invalid value: expected %2'"
		),
		ИмяАргумента,
		Ожидание
	);

КонецФункции

Функция СтандартноеСообщениеАргументаВнеДиапазона(ИмяАргумента, ОжидаемыйДиапазон)

	Возврат СтрШаблон(
		НСтр(
			"ru = 'Аргумент ''%1'' находится вне допустимого диапазона: ожидается %2';"
			+ "en = 'Argument ''%1'' is out of range: expected %2'"
		),
		ИмяАргумента,
		ОжидаемыйДиапазон
	);

КонецФункции

Функция СоздатьИнфраструктурнуюОшибку(ИмяФабрики, Значение1, Значение2 = "", Сообщение = "")

	Если ИмяФабрики = "АргументВнеДиапазона" Тогда
		Возврат СтандартныеОшибки.АргументВнеДиапазона(Значение1, Значение2, Сообщение);
	ИначеЕсли ИмяФабрики = "ОперацияОтменена" Тогда
		Возврат СтандартныеОшибки.ОперацияОтменена(Значение1, Сообщение);
	ИначеЕсли ИмяФабрики = "ОперацияВНедопустимомСостоянии" Тогда
		Возврат СтандартныеОшибки.ОперацияВНедопустимомСостоянии(Значение1, Сообщение);
	ИначеЕсли ИмяФабрики = "ОперацияНеРеализована" Тогда
		Возврат СтандартныеОшибки.ОперацияНеРеализована(Значение1, Сообщение);
	ИначеЕсли ИмяФабрики = "ОперацияНеПоддерживается" Тогда
		Возврат СтандартныеОшибки.ОперацияНеПоддерживается(Значение1, Сообщение);
	ИначеЕсли ИмяФабрики = "ИстеклоВремяОжиданияОперации" Тогда
		Возврат СтандартныеОшибки.ИстеклоВремяОжиданияОперации(Значение1, Сообщение);
	ИначеЕсли ИмяФабрики = "ОперацияНедоступна" Тогда
		Возврат СтандартныеОшибки.ОперацияНедоступна(Значение1, Сообщение);
	ИначеЕсли ИмяФабрики = "ДоступЗапрещен" Тогда
		Возврат СтандартныеОшибки.ДоступЗапрещен(Значение1, Сообщение);
	ИначеЕсли ИмяФабрики = "РесурсНеНайден" Тогда
		Возврат СтандартныеОшибки.РесурсНеНайден(Значение1, Сообщение);
	ИначеЕсли ИмяФабрики = "РесурсУжеСуществует" Тогда
		Возврат СтандартныеОшибки.РесурсУжеСуществует(Значение1, Сообщение);
	ИначеЕсли ИмяФабрики = "РесурсУжеИспользуется" Тогда
		Возврат СтандартныеОшибки.РесурсУжеИспользуется(Значение1, Сообщение);
	ИначеЕсли ИмяФабрики = "РесурсЗакрыт" Тогда
		Возврат СтандартныеОшибки.РесурсЗакрыт(Значение1, Сообщение);
	ИначеЕсли ИмяФабрики = "РесурсИсчерпан" Тогда
		Возврат СтандартныеОшибки.РесурсИсчерпан(Значение1, Сообщение);
	ИначеЕсли ИмяФабрики = "РесурсНеПуст" Тогда
		Возврат СтандартныеОшибки.РесурсНеПуст(Значение1, Сообщение);
	ИначеЕсли ИмяФабрики = "ВозможностьНедоступна" Тогда
		Возврат СтандартныеОшибки.ВозможностьНедоступна(Значение1, Сообщение);
	ИначеЕсли ИмяФабрики = "СоединениеОтклонено" Тогда
		Возврат СтандартныеОшибки.СоединениеОтклонено(Значение1, Сообщение);
	ИначеЕсли ИмяФабрики = "СоединениеСброшено" Тогда
		Возврат СтандартныеОшибки.СоединениеСброшено(Значение1, Сообщение);
	ИначеЕсли ИмяФабрики = "СоединениеЗакрыто" Тогда
		Возврат СтандартныеОшибки.СоединениеЗакрыто(Значение1, Сообщение);
	ИначеЕсли ИмяФабрики = "ИстеклоВремяОжиданияСоединения" Тогда
		Возврат СтандартныеОшибки.ИстеклоВремяОжиданияСоединения(Значение1, Сообщение);
	ИначеЕсли ИмяФабрики = "СетевоеИмяНеНайдено" Тогда
		Возврат СтандартныеОшибки.СетевоеИмяНеНайдено(Значение1, Сообщение);
	ИначеЕсли ИмяФабрики = "НекорректныеДанные" Тогда
		Возврат СтандартныеОшибки.НекорректныеДанные(Значение1, Сообщение);
	ИначеЕсли ИмяФабрики = "ДанныеСлишкомБольшие" Тогда
		Возврат СтандартныеОшибки.ДанныеСлишкомБольшие(Значение1, Значение2, Сообщение);
	ИначеЕсли ИмяФабрики = "ДанныеПовреждены" Тогда
		Возврат СтандартныеОшибки.ДанныеПовреждены(Значение1, Сообщение);
	ИначеЕсли ИмяФабрики = "ДанныеНеСоответствуютКодировке" Тогда
		Возврат СтандартныеОшибки.ДанныеНеСоответствуютКодировке(Значение1, Значение2, Сообщение);
	ИначеЕсли ИмяФабрики = "КодировкаНеПоддерживается" Тогда
		Возврат СтандартныеОшибки.КодировкаНеПоддерживается(Значение1, Сообщение);
	ИначеЕсли ИмяФабрики = "НеизвестнаяКодировка" Тогда
		Возврат СтандартныеОшибки.НеизвестнаяКодировка(Значение1, Сообщение);
	ИначеЕсли ИмяФабрики = "НарушенВнутреннийИнвариант" Тогда
		Возврат СтандартныеОшибки.НарушенВнутреннийИнвариант(Значение1, Сообщение);
	КонецЕсли;

	ВызватьИсключение "Неизвестная фабрика инфраструктурной ошибки";

КонецФункции

Функция СтандартноеСообщениеИнфраструктурнойОшибки(ИмяФабрики, Значение1, Значение2 = "")

	Если ИмяФабрики = "ОперацияОтменена" Тогда
		Шаблон = НСтр("ru = 'Операция ''%1'' отменена'; en = 'Operation ''%1'' was cancelled'");
	ИначеЕсли ИмяФабрики = "ОперацияВНедопустимомСостоянии" Тогда
		Шаблон = НСтр(
			"ru = 'Операция ''%1'' недопустима в текущем состоянии';"
			+ "en = 'Operation ''%1'' is invalid in the current state'"
		);
	ИначеЕсли ИмяФабрики = "ОперацияНеРеализована" Тогда
		Шаблон = НСтр("ru = 'Операция ''%1'' не реализована'; en = 'Operation ''%1'' is not implemented'");
	ИначеЕсли ИмяФабрики = "ОперацияНеПоддерживается" Тогда
		Шаблон = НСтр("ru = 'Операция ''%1'' не поддерживается'; en = 'Operation ''%1'' is not supported'");
	ИначеЕсли ИмяФабрики = "ИстеклоВремяОжиданияОперации" Тогда
		Шаблон = НСтр("ru = 'Истекло время ожидания операции ''%1'''; en = 'Operation ''%1'' timed out'");
	ИначеЕсли ИмяФабрики = "ОперацияНедоступна" Тогда
		Шаблон = НСтр("ru = 'Операция ''%1'' недоступна'; en = 'Operation ''%1'' is unavailable'");
	ИначеЕсли ИмяФабрики = "ДоступЗапрещен" Тогда
		Шаблон = НСтр("ru = 'Доступ к ресурсу ''%1'' запрещен'; en = 'Access to resource ''%1'' is denied'");
	ИначеЕсли ИмяФабрики = "РесурсНеНайден" Тогда
		Шаблон = НСтр("ru = 'Ресурс ''%1'' не найден'; en = 'Resource ''%1'' was not found'");
	ИначеЕсли ИмяФабрики = "РесурсУжеСуществует" Тогда
		Шаблон = НСтр("ru = 'Ресурс ''%1'' уже существует'; en = 'Resource ''%1'' already exists'");
	ИначеЕсли ИмяФабрики = "РесурсУжеИспользуется" Тогда
		Шаблон = НСтр("ru = 'Ресурс ''%1'' уже используется'; en = 'Resource ''%1'' is already in use'");
	ИначеЕсли ИмяФабрики = "РесурсЗакрыт" Тогда
		Шаблон = НСтр("ru = 'Ресурс ''%1'' закрыт'; en = 'Resource ''%1'' is closed'");
	ИначеЕсли ИмяФабрики = "РесурсИсчерпан" Тогда
		Шаблон = НСтр("ru = 'Ресурс ''%1'' исчерпан'; en = 'Resource ''%1'' is exhausted'");
	ИначеЕсли ИмяФабрики = "РесурсНеПуст" Тогда
		Шаблон = НСтр("ru = 'Ресурс ''%1'' должен быть пустым'; en = 'Resource ''%1'' must be empty'");
	ИначеЕсли ИмяФабрики = "ВозможностьНедоступна" Тогда
		Шаблон = НСтр("ru = 'Возможность ''%1'' недоступна'; en = 'Feature ''%1'' is unavailable'");
	ИначеЕсли ИмяФабрики = "СоединениеОтклонено" Тогда
		Шаблон = НСтр(
			"ru = 'Удаленная сторона отказала в соединении с узлом ''%1''';"
			+ "en = 'Connection to host ''%1'' was refused'"
		);
	ИначеЕсли ИмяФабрики = "СоединениеСброшено" Тогда
		Шаблон = НСтр(
			"ru = 'Соединение с узлом ''%1'' было сброшено'; en = 'Connection to host ''%1'' was reset'"
		);
	ИначеЕсли ИмяФабрики = "СоединениеЗакрыто" Тогда
		Шаблон = НСтр(
			"ru = 'Соединение с узлом ''%1'' было закрыто'; en = 'Connection to host ''%1'' was closed'"
		);
	ИначеЕсли ИмяФабрики = "ИстеклоВремяОжиданияСоединения" Тогда
		Шаблон = НСтр(
			"ru = 'Истекло время ожидания соединения с узлом ''%1''';"
			+ "en = 'Connection to host ''%1'' timed out'"
		);
	ИначеЕсли ИмяФабрики = "СетевоеИмяНеНайдено" Тогда
		Шаблон = НСтр("ru = 'Сетевое имя ''%1'' не найдено'; en = 'Network name ''%1'' was not found'");
	ИначеЕсли ИмяФабрики = "НекорректныеДанные" Тогда
		Шаблон = НСтр(
			"ru = 'Данные ''%1'' имеют недопустимый формат или содержимое';"
			+ "en = 'Data ''%1'' has an invalid format or content'"
		);
	ИначеЕсли ИмяФабрики = "ДанныеСлишкомБольшие" Тогда
		Шаблон = НСтр(
			"ru = 'Размер данных ''%1'' превышает допустимый предел: %2';"
			+ "en = 'Data ''%1'' exceeds the allowed size: %2'"
		);
	ИначеЕсли ИмяФабрики = "ДанныеПовреждены" Тогда
		Шаблон = НСтр("ru = 'Данные ''%1'' повреждены'; en = 'Data ''%1'' is corrupt'");
	ИначеЕсли ИмяФабрики = "ДанныеНеСоответствуютКодировке" Тогда
		Шаблон = НСтр(
			"ru = 'Данные ''%1'' не соответствуют кодировке ''%2''';"
			+ "en = 'Data ''%1'' does not match encoding ''%2'''"
		);
	ИначеЕсли ИмяФабрики = "КодировкаНеПоддерживается" Тогда
		Шаблон = НСтр("ru = 'Кодировка ''%1'' не поддерживается'; en = 'Encoding ''%1'' is not supported'");
	ИначеЕсли ИмяФабрики = "НеизвестнаяКодировка" Тогда
		Шаблон = НСтр("ru = 'Кодировка ''%1'' неизвестна'; en = 'Encoding ''%1'' is unknown'");
	ИначеЕсли ИмяФабрики = "НарушенВнутреннийИнвариант" Тогда
		Шаблон = НСтр("ru = 'Нарушен внутренний инвариант: %1'; en = 'Internal invariant violated: %1'");
	Иначе
		ВызватьИсключение "Неизвестная фабрика инфраструктурной ошибки";
	КонецЕсли;

	Если ПустаяСтрока(Значение2) Тогда
		Возврат СтрШаблон(Шаблон, Значение1);
	КонецЕсли;

	Возврат СтрШаблон(Шаблон, Значение1, Значение2);

КонецФункции

Функция ОшибкаИнфраструктурнойФабрики(ИмяФабрики, Значение1, Значение2 = "", Сообщение = "")

	Попытка
		СоздатьИнфраструктурнуюОшибку(ИмяФабрики, Значение1, Значение2, Сообщение);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидалось исключение инфраструктурной фабрики";

КонецФункции

Процедура ПроверитьОшибкуКонтракта(Ошибка, КодОшибки, ИмяПараметра)

	Снимок = Новый СнимокКадраОшибки(Ошибка);
	Ожидаем.Что(Снимок.КодОшибки()).Равно(КодОшибки);
	Ожидаем.Что(Снимок.Данные().ИмяАргумента).Равно(ИмяПараметра);

КонецПроцедуры

Процедура ПроверитьОднопараметрическуюИнфраструктурнуюОшибку(
	ИмяФабрики,
	КодОшибки,
	ИмяПоля,
	Значение
)

	ПользовательскоеСообщение = "Пользовательское сообщение";
	Ошибка = СоздатьИнфраструктурнуюОшибку(ИмяФабрики, Значение);
	ОшибкаССообщением = СоздатьИнфраструктурнуюОшибку(
		ИмяФабрики,
		Значение,
		"",
		ПользовательскоеСообщение
	);
	Снимок = Новый СнимокКадраОшибки(Ошибка);
	СнимокССообщением = Новый СнимокКадраОшибки(ОшибкаССообщением);

	Ожидаем.Что(Снимок.КодОшибки()).Равно(КодОшибки);
	Ожидаем.Что(Снимок.Данные()[ИмяПоля]).Равно(Значение);
	Ожидаем.Что(Снимок.Данные().Количество()).Равно(1);
	Ожидаем.Что(Снимок.Сообщение()).Равно(
		СтандартноеСообщениеИнфраструктурнойОшибки(ИмяФабрики, Значение)
	);
	Ожидаем.Что(СнимокССообщением.Сообщение()).Равно(ПользовательскоеСообщение);

КонецПроцедуры

Функция ТестовоеЗначениеПоля(ИмяПоля)

	Если ИмяПоля = "" Тогда
		Возврат "";
	ИначеЕсли ИмяПоля = "ИмяАргумента" Тогда
		Возврат "Индекс";
	ИначеЕсли ИмяПоля = "ИмяОперации" Тогда
		Возврат "Синхронизация";
	ИначеЕсли ИмяПоля = "ИмяРесурса" Тогда
		Возврат "Файл конфигурации";
	ИначеЕсли ИмяПоля = "ИмяВозможности" Тогда
		Возврат "Сжатие";
	ИначеЕсли ИмяПоля = "Узел" Тогда
		Возврат "api.example.test";
	ИначеЕсли ИмяПоля = "СетевоеИмя" Тогда
		Возврат "example.test";
	ИначеЕсли ИмяПоля = "ИмяДанных" Тогда
		Возврат "Пакет";
	ИначеЕсли ИмяПоля = "Ограничение" Тогда
		Возврат "не более 1 МБ";
	ИначеЕсли ИмяПоля = "Кодировка" Тогда
		Возврат "UTF-8";
	ИначеЕсли ИмяПоля = "Инвариант" Тогда
		Возврат "счётчик неотрицателен";
	КонецЕсли;

	ВызватьИсключение "Неизвестное поле тестовых данных";

КонецФункции

Функция ТестовыйПервыйПараметрФабрики(ИмяФабрики)

	Если ИмяФабрики = "АргументВнеДиапазона" Тогда
		Возврат "Индекс";
	КонецЕсли;

	Возврат "Пакет";

КонецФункции

Функция ТестовыйВторойПараметрФабрики(ИмяФабрики)

	Если ИмяФабрики = "АргументВнеДиапазона" Тогда
		Возврат "от 0 до 9";
	ИначеЕсли ИмяФабрики = "ДанныеСлишкомБольшие" Тогда
		Возврат "не более 1 МБ";
	ИначеЕсли ИмяФабрики = "ДанныеНеСоответствуютКодировке" Тогда
		Возврат "UTF-8";
	КонецЕсли;

	Возврат "";

КонецФункции

Процедура ПроверитьИсключениеМетода(ИмяМетода, Параметры, ОжидаемоеСообщение)

	Ожидаем.Что(ФабрикаОшибок)
		.Метод(ИмяМетода, Параметры)
		.ВыбрасываетИсключение(ОжидаемоеСообщение);

КонецПроцедуры

#КонецОбласти
