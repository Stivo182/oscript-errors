#Использовать asserts
#Использовать "../src"


#Область Тесты

&ПараметризованныйТест
&ИсточникЗначение("ОперацияОтменена", "operation.cancelled")
&ИсточникЗначение("ОперацияВНедопустимомСостоянии", "operation.invalid_state")
&ИсточникЗначение("ОперацияНеРеализована", "operation.not_implemented")
&ИсточникЗначение("ОперацияНеПоддерживается", "operation.not_supported")
&ИсточникЗначение("ИстеклоВремяОжиданияОперации", "operation.timeout")
&ИсточникЗначение("ОперацияНедоступна", "operation.unavailable")
&ИсточникЗначение("КонфликтОперации", "operation.conflict")
&ИсточникЗначение("ПревышенаЧастотаОперации", "operation.rate_limited")
Процедура ТестДолжен_СоздатьСтандартнуюОшибкуОперации(ИмяФабрики, КодОшибки) Экспорт

	// Подготовка
	ИмяОперации = "Синхронизация";
	ПользовательскоеСообщение = "Пользовательское сообщение";

	// Действие
	Ошибка = СоздатьИнфраструктурнуюОшибку(ИмяФабрики, ИмяОперации);
	ОшибкаССообщением = СоздатьИнфраструктурнуюОшибку(
		ИмяФабрики,
		ИмяОперации,
		"",
		ПользовательскоеСообщение
	);
	Снимок = Новый СнимокКадраОшибки(Ошибка);
	СнимокССообщением = Новый СнимокКадраОшибки(ОшибкаССообщением);

	// Проверка
	Ожидаем.Что(Снимок.КодОшибки()).Равно(КодОшибки);
	Ожидаем.Что(Снимок.Данные().ИмяОперации).Равно(ИмяОперации);
	Ожидаем.Что(Снимок.Данные().Количество()).Равно(1);
	Ожидаем.Что(Снимок.Сообщение()).Равно(
		СтандартноеСообщениеИнфраструктурнойОшибки(ИмяФабрики, ИмяОперации)
	);
	Ожидаем.Что(СнимокССообщением.Сообщение()).Равно(ПользовательскоеСообщение);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("ТребуетсяАутентификация", "access.unauthenticated", "ИмяРесурса")
&ИсточникЗначение("ДоступЗапрещен", "access.denied", "ИмяРесурса")
&ИсточникЗначение("РесурсНеНайден", "resource.not_found", "ИмяРесурса")
&ИсточникЗначение("РесурсУжеСуществует", "resource.already_exists", "ИмяРесурса")
&ИсточникЗначение("РесурсУжеИспользуется", "resource.already_in_use", "ИмяРесурса")
&ИсточникЗначение("РесурсЗакрыт", "resource.closed", "ИмяРесурса")
&ИсточникЗначение("РесурсИсчерпан", "resource.exhausted", "ИмяРесурса")
&ИсточникЗначение("КвотаРесурсаПревышена", "resource.quota_exceeded", "ИмяРесурса")
&ИсточникЗначение("РесурсНеПуст", "resource.not_empty", "ИмяРесурса")
&ИсточникЗначение("ЗависимостьНедоступна", "dependency.unavailable", "ИмяЗависимости")
Процедура ТестДолжен_СоздатьСтандартнуюОшибкуРесурса(ИмяФабрики, КодОшибки, ИмяПоля) Экспорт

	// Подготовка
	Значение = ТестовоеЗначениеПоля(ИмяПоля);

	// Действие и Проверка
	ПроверитьОднопараметрическуюИнфраструктурнуюОшибку(
		ИмяФабрики,
		КодОшибки,
		ИмяПоля,
		Значение
	);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("СоединениеОтклонено", "connection.refused", "Узел")
&ИсточникЗначение("СоединениеСброшено", "connection.reset", "Узел")
&ИсточникЗначение("СоединениеПрервано", "connection.aborted", "Узел")
&ИсточникЗначение("СоединениеНеУстановлено", "connection.not_connected", "Узел")
&ИсточникЗначение("ИстеклоВремяОжиданияСоединения", "connection.timeout", "Узел")
&ИсточникЗначение("СетевоеИмяНеНайдено", "network.name_not_found", "СетевоеИмя")
&ИсточникЗначение("УзелНедоступен", "network.host_unreachable", "Узел")
&ИсточникЗначение("СетьНедоступна", "network.unreachable", "ИмяСети")
Процедура ТестДолжен_СоздатьСтандартнуюОшибкуСоединения(ИмяФабрики, КодОшибки, ИмяПоля) Экспорт

	// Подготовка
	Значение = ?(ИмяПоля = "Узел", "api.example.test", "example.test");

	// Действие и Проверка
	ПроверитьОднопараметрическуюИнфраструктурнуюОшибку(
		ИмяФабрики,
		КодОшибки,
		ИмяПоля,
		Значение
	);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("НекорректныеДанные", "data.invalid", "ИмяДанных", "")
&ИсточникЗначение("ДанныеСлишкомБольшие", "data.too_large", "ИмяДанных", "Ограничение")
&ИсточникЗначение("ДанныеПовреждены", "data.corrupt", "ИмяДанных", "")
&ИсточникЗначение("ДанныеНеСоответствуютКодировке", "encoding.invalid", "ИмяДанных", "Кодировка")
&ИсточникЗначение("КодировкаНеПоддерживается", "encoding.not_supported", "Кодировка", "")
&ИсточникЗначение("НеизвестнаяКодировка", "encoding.unknown", "Кодировка", "")
&ИсточникЗначение("НарушенВнутреннийИнвариант", "internal.invariant_violation", "Инвариант", "")
Процедура ТестДолжен_СоздатьСтандартнуюОшибкуДанных(
	ИмяФабрики,
	КодОшибки,
	ИмяПоля1,
	ИмяПоля2
) Экспорт

	// Подготовка
	Значение1 = ТестовоеЗначениеПоля(ИмяПоля1);
	Значение2 = ТестовоеЗначениеПоля(ИмяПоля2);
	ПользовательскоеСообщение = "Пользовательское сообщение";

	// Действие
	Ошибка = СоздатьИнфраструктурнуюОшибку(ИмяФабрики, Значение1, Значение2);
	ОшибкаССообщением = СоздатьИнфраструктурнуюОшибку(
		ИмяФабрики,
		Значение1,
		Значение2,
		ПользовательскоеСообщение
	);
	Снимок = Новый СнимокКадраОшибки(Ошибка);
	СнимокССообщением = Новый СнимокКадраОшибки(ОшибкаССообщением);

	// Проверка
	Ожидаем.Что(Снимок.КодОшибки()).Равно(КодОшибки);
	Ожидаем.Что(Снимок.Данные()[ИмяПоля1]).Равно(Значение1);
	Если Не ПустаяСтрока(ИмяПоля2) Тогда
		Ожидаем.Что(Снимок.Данные()[ИмяПоля2]).Равно(Значение2);
	КонецЕсли;
	Ожидаем.Что(Снимок.Данные().Количество()).Равно(?(ПустаяСтрока(ИмяПоля2), 1, 2));
	Ожидаем.Что(Снимок.Сообщение()).Равно(
		СтандартноеСообщениеИнфраструктурнойОшибки(ИмяФабрики, Значение1, Значение2)
	);
	Ожидаем.Что(СнимокССообщением.Сообщение()).Равно(ПользовательскоеСообщение);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("АргументВнеДиапазона", "ИмяАргумента")
&ИсточникЗначение("ОперацияОтменена", "ИмяОперации")
&ИсточникЗначение("ОперацияВНедопустимомСостоянии", "ИмяОперации")
