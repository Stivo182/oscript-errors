// Сравнивает краткое, пользовательское и диагностическое представления.
// Все форматы строятся для одной цепочки с контекстом, данными и подсказкой.

#Использовать errors

Причина = КонструкторыОшибок.Создать("network.timeout", "Сервис пользователей не ответил")
	.Данные("ТаймаутСек", 10)
	.Подсказка("Повторите операцию")
	.Построить();

Причина = ФабрикаОшибок.СКонтекстом(Причина, "Запрос пользователя 42");
Ошибка = ФабрикаОшибок.Обернуть(Причина, "profile.load_failed", "Не удалось загрузить профиль");
Исследователь = ДиагностикаОшибок.Исследовать(Ошибка);

Сообщить("Краткое представление:");
Сообщить(Исследователь.КраткоеПредставление());
Сообщить("");
Сообщить("Пользовательское представление:");
Сообщить(Исследователь.ПользовательскоеПредставление());
Сообщить("");
Сообщить("Диагностическое представление:");
Сообщить(Исследователь.ДиагностическоеПредставление());
