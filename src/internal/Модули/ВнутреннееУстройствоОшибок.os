Перем _РегулярноеВыражениеТипаОшибки; // РегулярноеВыражение
Перем _МаксимальноеКоличествоКадровЦепочки; // Число

#Область СлужебныйПрограммныйИнтерфейс

// Проверяет машинный тип ошибки на соответствие публичному контракту.
//
// Параметры:
//  ТипОшибки - Строка - Проверяемый машинный тип ошибки.
Процедура ПроверитьТипОшибки(ТипОшибки) Экспорт

	Если ТипЗнч(ТипОшибки) <> Тип("Строка") Тогда
		ВызватьИсключение "Тип ошибки должен быть строкой";
	КонецЕсли;

	Если Не КорректныйФорматТипаОшибки(ТипОшибки) Тогда
		ВызватьИсключение "Тип ошибки имеет неверный формат";
	КонецЕсли;

КонецПроцедуры

// Проверяет входной аргумент публичного метода диагностики.
//
// Параметры:
//  Ошибка - ИнформацияОбОшибке - Проверяемая ошибка.
Процедура ПроверитьОшибку(Ошибка) Экспорт

	Если ТипЗнч(Ошибка) <> Тип("ИнформацияОбОшибке") Тогда
		ВызватьИсключение "Ошибка должна иметь тип ИнформацияОбОшибке";
	КонецЕсли;

КонецПроцедуры

// Просматривает физическую цепочку ошибки от внешнего кадра к корневому.
// Просмотр ограничен 64 кадрами и терпим к повреждённым метаданным.
//
// Параметры:
//  Ошибка - ИнформацияОбОшибке - Внешний кадр просматриваемой цепочки.
//
// Возвращаемое значение:
//  Структура:
//   * Кадры - Массив из ИнформацияОбОшибке - Просмотренные физические кадры;
//   * Усечена - Булево - Признак наличия непросмотренной причины.
Функция ПросмотретьЦепочку(Ошибка) Экспорт

	ПроверитьОшибку(Ошибка);

	Результат = Новый Структура("Кадры, Усечена", Новый Массив, Ложь);
	ТекущийКадр = Ошибка;

	Для НомерКадра = 1 По _МаксимальноеКоличествоКадровЦепочки Цикл
		Результат.Кадры.Добавить(ТекущийКадр);
		Причина = БезопасноПолучитьПричину(ТекущийКадр);

		Если Причина = Неопределено Тогда
			Возврат Результат;
		КонецЕсли;

		Если НомерКадра = _МаксимальноеКоличествоКадровЦепочки Тогда
			Результат.Усечена = Истина;
			Возврат Результат;
		КонецЕсли;

		ТекущийКадр = Причина;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Проверяет метаданные собственного кадра на соответствие внутреннему формату.
//
// Параметры:
//  Параметры - ФиксированнаяСтруктура - Проверяемые метаданные кадра.
//
// Возвращаемое значение:
//  Булево - Истина, если метаданные поддерживаются библиотекой.
Функция ЭтоПоддерживаемыеМетаданныеКадра(Параметры) Экспорт

	Маркер = Неопределено;
	Вид = Неопределено;
	ТипОшибки = Неопределено;
	Данные = Неопределено;
	Подсказка = "";

	ВсеПоляПрисутствуют = Параметры.Свойство("Маркер", Маркер)
		И Параметры.Свойство("Вид", Вид)
		И Параметры.Свойство("ТипОшибки", ТипОшибки)
		И Параметры.Свойство("Данные", Данные);

	Если Не ВсеПоляПрисутствуют Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Параметры.Свойство("Подсказка", Подсказка)
		И ТипЗнч(Подсказка) <> Тип("Строка") Тогда
		Возврат Ложь;
	КонецЕсли;

	КорректныйМаркер = ТипЗнч(Маркер) = Тип("Строка") И Маркер = МаркерМетаданныхКадра();

	Если Не КорректныйМаркер Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Вид = ВидыКадровОшибок.Ошибка Тогда
		Возврат ТипЗнч(ТипОшибки) = Тип("Строка") И КорректныйФорматТипаОшибки(ТипОшибки);
	КонецЕсли;

	Если Вид = ВидыКадровОшибок.Контекст Тогда
		Возврат ТипОшибки = Неопределено;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

// Возвращает маркер внутренних метаданных кадра ошибки.
//
// Возвращаемое значение:
//  Строка - Стабильный маркер метаданных.
Функция МаркерМетаданныхКадра() Экспорт

	Возврат "onescript.exception.envelope";

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция КорректныйФорматТипаОшибки(ТипОшибки)

	Возврат РегулярноеВыражениеТипаОшибки().Совпадает(ТипОшибки);

КонецФункции

Функция РегулярноеВыражениеТипаОшибки()

	Если _РегулярноеВыражениеТипаОшибки = Неопределено Тогда
		_РегулярноеВыражениеТипаОшибки = Новый РегулярноеВыражение("\A[a-z][a-z0-9_]*\.[a-z][a-z0-9_]*\z");
		_РегулярноеВыражениеТипаОшибки.ИгнорироватьРегистр = Ложь;
		_РегулярноеВыражениеТипаОшибки.Многострочный = Ложь;
	КонецЕсли;

	Возврат _РегулярноеВыражениеТипаОшибки;

КонецФункции

Функция БезопасноПолучитьПричину(Кадр)

	Попытка
		Причина = Кадр.Причина;
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Если ТипЗнч(Причина) = Тип("ИнформацияОбОшибке") Тогда
		Возврат Причина;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

#КонецОбласти

_МаксимальноеКоличествоКадровЦепочки = 64;
