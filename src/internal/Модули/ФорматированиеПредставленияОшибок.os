#Область СлужебныйПрограммныйИнтерфейс

// Формирует строки ограниченного представления произвольного значения.
//
// Параметры:
//  Значение - Произвольный - Представляемое значение.
//  Отступ - Число - Количество пробелов перед каждой строкой.
//
// Возвращаемое значение:
//  Массив из Строка - Новые строки представления.
Функция СтрокиДанных(Значение, Отступ = 0) Экспорт

	Возврат ОграниченноеПредставлениеДанныхОшибок.Строки(Значение, Отступ);

КонецФункции

// Формирует строки общего стека вызовов и нумерует их, если строк больше одной.
//
// Параметры:
//  Стек - Массив - Представляемый стек вызовов.
//  Отступ - Число - Количество пробелов перед каждой строкой.
//
// Возвращаемое значение:
//  Массив из Строка - Новые строки представления стека вызовов.
Функция СтрокиСтекаВызовов(Стек, Отступ = 0) Экспорт

	ЭлементыСтека = ПредставленияЭлементовСтека(Стек);
	Результат = Новый Массив;
	Нумеровать = ЭлементыСтека.Количество() > 1;

	Для Номер = 0 По ЭлементыСтека.ВГраница() Цикл
		МаркерНомера = "";
		Если Нумеровать Тогда
			МаркерНомера = Строка(Номер + 1) + ": ";
		КонецЕсли;
		ДобавитьЗначениеСМаркером(Результат, Отступ, МаркерНомера, ЭлементыСтека[Номер]);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Формирует краткое представление эффективной ошибки и предшествующих контекстов.
//
// Параметры:
//  Снимки - Массив из СнимокКадраОшибки - Снимки от внешнего кадра к корневому.
//
// Возвращаемое значение:
//  Строка - Краткое представление или сообщение первого кадра для внешней цепочки.
Функция КраткоеПредставление(Снимки) Экспорт

	Сообщения = Новый Массив;
	ПервоеСообщение = "";
	ПервыйКадрОбработан = Ложь;

	Для Каждого Снимок Из Снимки Цикл
		Если Не ПервыйКадрОбработан Тогда
			ПервоеСообщение = Снимок.Сообщение();
			ПервыйКадрОбработан = Истина;
		КонецЕсли;

		Если Снимок.Вид() = ВидыКадровОшибок.Контекст() Тогда
			Сообщения.Добавить(Снимок.Сообщение());
		ИначеЕсли Снимок.Вид() = ВидыКадровОшибок.Ошибка() Тогда
			Сообщения.Добавить(Снимок.Сообщение());
			Возврат СтрШаблон(
				"%1: %2",
				Снимок.КодОшибки(),
				СтрСоединить(Сообщения, " -> ")
			);
		КонецЕсли;
	КонецЦикла;

	Возврат ПервоеСообщение;

КонецФункции

// Формирует полный диагностический отчёт по просмотренным физическим кадрам.
//
// Параметры:
//  Снимки - Массив из СнимокКадраОшибки - Снимки от внешнего кадра к корневому.
//  Усечена - Булево - Признак наличия непросмотренного продолжения цепочки.
//
// Возвращаемое значение:
//  Строка - Полное диагностическое представление.
Функция ДиагностическоеПредставление(Снимки, Усечена) Экспорт

	Блоки = Новый Массив;
	Разбор = РазобратьСнимки(Снимки);
	Группы = Разбор.Группы;
	Контексты = Разбор.Контексты;
	Подсказки = Разбор.Подсказки;
	Ссылки = Разбор.Ссылки;

	Если Группы.Количество() > 0 Тогда
		Блоки.Добавить(БлокГруппы(Группы[0], 0, "", 0, Ложь));
	КонецЕсли;

	Если Группы.Количество() > 1 Тогда
		Блоки.Добавить(БлокПричин(Группы));
	КонецЕсли;

	Если Подсказки.Количество() > 0 Тогда
		Блоки.Добавить(БлокИменованногоСписка("Подсказка:", Подсказки));
	КонецЕсли;

	Если Ссылки.Количество() > 0 Тогда
		Блоки.Добавить(БлокИменованногоСписка("URL:", Ссылки));
	КонецЕсли;

	Если Усечена И Контексты.Количество() > 0 Тогда
		Блоки.Добавить(БлокКонтекстов("Контекст без просмотренной причины:", Контексты, Истина));
	КонецЕсли;

	Если Усечена Тогда
		Блоки.Добавить("Цепочка причин усечена");
	КонецЕсли;

	Если Снимки.Количество() > 0 Тогда
		БлокСтека = БлокСтекаВызовов(Снимки[0].Стек());
		Если БлокСтека <> "" Тогда
			Блоки.Добавить(БлокСтека);
		КонецЕсли;
	КонецЕсли;

	Возврат СтрСоединить(Блоки, Символы.ПС + Символы.ПС);

КонецФункции

// Формирует подробное пользовательское представление просмотренной цепочки.
//
// Параметры:
//  Снимки - Массив из СнимокКадраОшибки - Снимки от внешнего кадра к корневому.
//  Усечена - Булево - Признак наличия непросмотренного продолжения цепочки.
//
// Возвращаемое значение:
//  Строка - Подробное представление без данных, стека вызовов и исходной строки.
Функция ПользовательскоеПредставление(Снимки, Усечена) Экспорт

	Блоки = Новый Массив;
	Разбор = РазобратьСнимки(Снимки);
	Группы = Разбор.Группы;

	Если Группы.Количество() > 0 Тогда
		НомерОсновнойГруппы = НомерГруппыСЭффективнойОшибкой(Группы);
		Если НомерОсновнойГруппы = -1 Тогда
			НомерОсновнойГруппы = 0;
		КонецЕсли;

		ОсновнаяГруппа = ГруппаСПредшествующимиКонтекстами(Группы, НомерОсновнойГруппы);
		Блоки.Добавить(БлокГруппы(ОсновнаяГруппа, 0, "", 0, Ложь, Ложь));

		НомерКорневойГруппы = Группы.ВГраница();
		Если Не Усечена И НомерКорневойГруппы > НомерОсновнойГруппы Тогда
			Блоки.Добавить(БлокОсновнойПричиныБезДанных(Группы[НомерКорневойГруппы]));
		КонецЕсли;

	ИначеЕсли Разбор.Контексты.Количество() > 0 Тогда
		Блоки.Добавить(БлокКонтекстов("Контекст:", Разбор.Контексты, Ложь));
	КонецЕсли;

	Если Усечена И Группы.Количество() > 0 И Разбор.Контексты.Количество() > 0 Тогда
		Блоки.Добавить(БлокКонтекстов("Контекст:", Разбор.Контексты, Ложь));
	КонецЕсли;

	Если Разбор.Подсказки.Количество() > 0 Тогда
		Блоки.Добавить(БлокИменованногоСписка("Подсказка:", Разбор.Подсказки));
	КонецЕсли;

	Если Разбор.Ссылки.Количество() > 0 Тогда
		Блоки.Добавить(БлокИменованногоСписка("URL:", Разбор.Ссылки));
	КонецЕсли;

	Возврат СтрСоединить(Блоки, Символы.ПС + Символы.ПС);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция РазобратьСнимки(Снимки)

	Результат = Новый Структура(
		"Группы, Контексты, Подсказки, Ссылки",
		Новый Массив,
		Новый Массив,
		Новый Массив,
		Новый Массив
	);
	Контексты = Новый Массив;

	Для Каждого Снимок Из Снимки Цикл

		Если Не ПустаяСтрока(Снимок.Подсказка()) Тогда
			Результат.Подсказки.Добавить(Снимок.Подсказка());
		КонецЕсли;
		Если Не ПустаяСтрока(Снимок.URL()) Тогда
			Результат.Ссылки.Добавить(Снимок.URL());
		КонецЕсли;

		Если Снимок.Вид() = ВидыКадровОшибок.Контекст() Тогда
			Контексты.Добавить(Снимок);
		Иначе
			Результат.Группы.Добавить(Новый Структура("Снимок, Контексты", Снимок, Контексты));
			Контексты = Новый Массив;
		КонецЕсли;

	КонецЦикла;

	Результат.Контексты = Контексты;

	Возврат Результат;

КонецФункции

Функция ГруппаСПредшествующимиКонтекстами(Группы, НомерГруппы)

	Контексты = Новый Массив;

	Для Номер = 0 По НомерГруппы Цикл
		Для Каждого Контекст Из Группы[Номер].Контексты Цикл
			Контексты.Добавить(Контекст);
		КонецЦикла;
	КонецЦикла;

	Возврат Новый Структура("Снимок, Контексты", Группы[НомерГруппы].Снимок, Контексты);

КонецФункции

Функция НомерГруппыСЭффективнойОшибкой(Группы)

	Для Номер = 0 По Группы.ВГраница() Цикл
		Если Группы[Номер].Снимок.Вид() = ВидыКадровОшибок.Ошибка() Тогда
			Возврат Номер;
		КонецЕсли;
	КонецЦикла;

	Возврат -1;

КонецФункции

Функция БлокГруппы(
	Группа,
	ОтступЗаголовка,
	МаркерНомера,
	ОтступПолей,
	ЭтоПричина,
	ВключатьДанные = Истина
)

	Строки = Новый Массив;
	Снимок = Группа.Снимок;

	ДобавитьЗначениеСМаркером(
		Строки,
		ОтступЗаголовка,
		МаркерНомера + МаркерЗаголовкаГруппы(Снимок),
		Снимок.Сообщение()
	);

	Если Группа.Контексты.Количество() > 0 Тогда

		Если Не ЭтоПричина Тогда
			Строки.Добавить("");
		КонецЕсли;

		Строки.Добавить(Пробелы(ОтступПолей) + "Контекст:");

		МаркерКонтекста = "";
		Если Группа.Контексты.Количество() > 1 Тогда
			МаркерКонтекста = "- ";
		КонецЕсли;

		Для Каждого Контекст Из Группа.Контексты Цикл
			ДобавитьКонтекст(
				Строки,
				Контекст,
				ОтступПолей + 2,
				МаркерКонтекста,
				ВключатьДанные
			);
		КонецЦикла;

	КонецЕсли;

	Если ВключатьДанные И Не ЭтоПричина И Снимок.Данные() <> Неопределено Тогда
		Строки.Добавить("");
	КонецЕсли;

	ДобавитьДополнительныеПоля(Строки, Снимок, ОтступПолей, ВключатьДанные);

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

Функция БлокПричин(Группы)

	Строки = Новый Массив;
	Строки.Добавить("Причина:");
	КоличествоПричин = Группы.Количество() - 1;

	Для НомерПричины = 1 По Группы.ВГраница() Цикл

		МаркерНомера = "";
		ОтступПолей = 4;
		Если КоличествоПричин > 1 Тогда
			МаркерНомера = Строка(НомерПричины) + ": ";
			ОтступПолей = 2 + СтрДлина(МаркерНомера);
		КонецЕсли;

		Строки.Добавить(БлокГруппы(Группы[НомерПричины], 2, МаркерНомера, ОтступПолей, Истина));

	КонецЦикла;

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

Функция БлокИменованногоСписка(Заголовок, Значения)

	Строки = Новый Массив;
	Строки.Добавить(Заголовок);
	Нумеровать = Значения.Количество() > 1;

	Для Номер = 0 По Значения.ВГраница() Цикл
		МаркерНомера = "";
		Если Нумеровать Тогда
			МаркерНомера = Строка(Номер + 1) + ": ";
		КонецЕсли;
		ДобавитьЗначениеСМаркером(Строки, 2, МаркерНомера, Значения[Номер]);
	КонецЦикла;

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

Функция БлокСтекаВызовов(Стек)

	СтрокиОбщегоСтека = СтрокиСтекаВызовов(Стек, 2);
	Если СтрокиОбщегоСтека.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Строки = Новый Массив;
	Строки.Добавить("Стек вызовов:");
	ДобавитьСтроки(Строки, СтрокиОбщегоСтека);

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

Функция МаркерЗаголовкаГруппы(Снимок)

	Если Снимок.Вид() = ВидыКадровОшибок.Ошибка() Тогда
		Возврат Снимок.КодОшибки() + ": ";
	КонецЕсли;

	Возврат "";

КонецФункции

Процедура ДобавитьКонтекст(Строки, Снимок, Отступ, Маркер, ВключатьДанные)

	ДобавитьЗначениеСМаркером(Строки, Отступ, Маркер, Снимок.Сообщение());
	ДобавитьДополнительныеПоля(
		Строки,
		Снимок,
		Отступ + СтрДлина(Маркер),
		ВключатьДанные
	);

КонецПроцедуры

Процедура ДобавитьДополнительныеПоля(Строки, Снимок, Отступ, ВключатьДанные)

	Данные = Снимок.Данные();
	Если ВключатьДанные И Данные <> Неопределено Тогда
		Если ОграниченноеПредставлениеДанныхОшибок.ЭтоПустойКонтейнер(Данные) Тогда
			Маркер = ОграниченноеПредставлениеДанныхОшибок.МаркерПустогоКонтейнера(Данные);
			ДобавитьПоле(Строки, Отступ, "Данные", Маркер);
		Иначе
			Строки.Добавить(Пробелы(Отступ) + "Данные:");
			ДобавитьСтроки(Строки, СтрокиДанных(Данные, Отступ + 2));
		КонецЕсли;
	КонецЕсли;

	ДобавитьМесто(Строки, Снимок, Отступ);

	Если ВключатьДанные
		И Снимок.Вид() = ВидыКадровОшибок.ВнешняяОшибка()
		И Снимок.ИсходнаяСтрока() <> "" Тогда
		ДобавитьПоле(Строки, Отступ, "Исходная строка", СокрЛП(Снимок.ИсходнаяСтрока()));
	КонецЕсли;

КонецПроцедуры

Функция БлокОсновнойПричиныБезДанных(Группа)

	Строки = Новый Массив;
	Строки.Добавить("Причина:");
	Строки.Добавить(БлокГруппы(Группа, 2, "", 4, Истина, Ложь));

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

Функция БлокКонтекстов(Заголовок, Контексты, ВключатьДанные)

	Строки = Новый Массив;
	Строки.Добавить(Заголовок);

	МаркерКонтекста = "";
	Если Контексты.Количество() > 1 Тогда
		МаркерКонтекста = "- ";
	КонецЕсли;

	Для Каждого Контекст Из Контексты Цикл
		ДобавитьКонтекст(Строки, Контекст, 2, МаркерКонтекста, ВключатьДанные);
	КонецЦикла;

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

Процедура ДобавитьМесто(Строки, Снимок, Отступ)

	ИмяМодуля = Снимок.ИмяМодуля();
	НомерСтроки = Снимок.НомерСтроки();

	Если ИмяМодуля <> "" И НомерСтроки > 0 Тогда
		ДобавитьПоле(Строки, Отступ, "Место", СтрШаблон("%1:%2", ИмяМодуля, НомерСтроки));
	ИначеЕсли ИмяМодуля <> "" Тогда
		ДобавитьПоле(Строки, Отступ, "Место", ИмяМодуля);
	ИначеЕсли НомерСтроки > 0 Тогда
		ДобавитьПоле(Строки, Отступ, "Строка", Строка(НомерСтроки));
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьПоле(Строки, Отступ, Имя, Значение)

	ДобавитьЗначениеСМаркером(Строки, Отступ, Имя + ": ", Значение);

КонецПроцедуры

Процедура ДобавитьЗначениеСМаркером(Строки, Отступ, Маркер, Значение)

	Префикс = Пробелы(Отступ) + Маркер;
	СтрокиЗначения = СтрокиТекста(Значение);

	Если СтрокиЗначения.Количество() = 0 Тогда
		Строки.Добавить(Префикс + Символ(34) + Символ(34));
		Возврат;
	КонецЕсли;

	Строки.Добавить(Префикс + СтрокиЗначения[0]);

	ОтступПродолжения = Пробелы(СтрДлина(Префикс));
	Для НомерСтроки = 1 По СтрокиЗначения.ВГраница() Цикл
		Строки.Добавить(ОтступПродолжения + СтрокиЗначения[НомерСтроки]);
	КонецЦикла;

КонецПроцедуры

Функция СтрокиТекста(Значение)

	Текст = Строка(Значение);
	Текст = СтрЗаменить(Текст, Символы.ВК + Символы.ПС, Символы.ПС);
	Текст = СтрЗаменить(Текст, Символы.ВК, Символы.ПС);

	Если Текст = "" Тогда
		Возврат Новый Массив;
	КонецЕсли;

	Возврат СтрРазделить(Текст, Символы.ПС, Истина);

КонецФункции

Процедура ДобавитьСтроки(Приемник, Источник)

	Для Каждого Строка Из Источник Цикл
		Приемник.Добавить(Строка);
	КонецЦикла;

КонецПроцедуры

Функция ПредставленияЭлементовСтека(Стек)

	Результат = Новый Массив;
	Для Каждого Элемент Из Стек Цикл
		Результат.Добавить(БезопасноеПредставление(Элемент));
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция БезопасноеПредставление(Значение)

	Попытка
		Возврат Строка(Значение);
	Исключение
		Возврат "<недоступно>";
	КонецПопытки;

КонецФункции


Функция Пробелы(Количество)

	Результат = "";
	Для Счетчик = 1 По Количество Цикл
		Результат = Результат + " ";
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти
