#Область Тесты

&Тест
Процедура ТестДолжен_ВернутьСостояниеПустойВыборки() Экспорт

	// Подготовка
	Выборка = Новый ВыборкаОшибок(Новый Массив);

	// Действие и Проверка
	Ожидаем.Что(Выборка.Снимки().Количество()).Равно(0);
	Ожидаем.Что(Выборка.Первая()).Равно(Неопределено);
	Ожидаем.Что(Выборка.Последняя()).Равно(Неопределено);
	Ожидаем.Что(Выборка.Количество()).Равно(0);
	Ожидаем.Что(Выборка.ЕстьОшибки()).Равно(Ложь);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьПорядокИПроекцииОшибок() Экспорт

	// Подготовка
	ДанныеПервой = Новый Структура("Попытка", 1);
	ПерваяОшибка = Новый ПостроительОшибки("database.timeout", "Первый таймаут")
		.ПроизвольныеДанные(ДанныеПервой)
		.Подсказка("Повторите")
		.Построить();
	ВтораяОшибка = ФабрикаОшибок.Создать("database.timeout", "Второй таймаут");
	Снимки = Новый Массив;
	Снимки.Добавить(Новый СнимокКадраОшибки(ПерваяОшибка));
	Снимки.Добавить(Новый СнимокКадраОшибки(ВтораяОшибка));

	// Действие
	Выборка = Новый ВыборкаОшибок(Снимки);

	// Проверка
	Ожидаем.Что(Выборка.Первая()).Равно(Снимки[0]);
	Ожидаем.Что(Выборка.Последняя()).Равно(Снимки[1]);
	Ожидаем.Что(Выборка.Количество()).Равно(2);
	Ожидаем.Что(Выборка.ЕстьОшибки()).Равно(Истина);
	Ожидаем.Что(Выборка.Коды()[0]).Равно("database.timeout");
	Ожидаем.Что(Выборка.URL()[0]).Равно("");
	Ожидаем.Что(Выборка.Коды()[1]).Равно("database.timeout");
	Ожидаем.Что(Выборка.Данные()[0]).Равно(ДанныеПервой);
	Ожидаем.Что(Выборка.Данные()[1]).Равно(Неопределено);
	Ожидаем.Что(Выборка.Подсказки()[0]).Равно("Повторите");
	Ожидаем.Что(Выборка.Подсказки()[1]).Равно("");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗащититьМассивСнимковОтИзменения() Экспорт

	// Подготовка
	Ошибка = ФабрикаОшибок.Создать("core.failed", "Ошибка");
	Снимки = Новый Массив;
	Снимки.Добавить(Новый СнимокКадраОшибки(Ошибка));
	Выборка = Новый ВыборкаОшибок(Снимки);

	// Действие
	Снимки.Очистить();
	ВозвращённыеСнимки = Выборка.Снимки();
	ВозвращённыеСнимки.Очистить();

	// Проверка
	Ожидаем.Что(Выборка.Количество()).Равно(1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СгруппироватьОшибкиПоНормализованномуКоду() Экспорт

	// Подготовка
	Снимки = Новый Массив;
	Снимки.Добавить(СнимокОшибки("Database.Timeout", "Первый таймаут"));
	Снимки.Добавить(СнимокОшибки("network.timeout", "Сетевой таймаут"));
	Снимки.Добавить(СнимокОшибки("database.timeout", "Второй таймаут"));
	Выборка = Новый ВыборкаОшибок(Снимки);

	// Действие
	Группы = Выборка.ГруппыПоКоду();

	// Проверка
	Ожидаем.Что(Группы.Количество()).Равно(2);
	Ожидаем.Что(Группы.Получить("database.timeout").Количество()).Равно(2);
	Ожидаем.Что(Группы.Получить("network.timeout").Количество()).Равно(1);
	Ожидаем.Что(Группы.Получить("database.timeout").Первая()).Равно(Снимки[0]);
	Ожидаем.Что(Группы.Получить("database.timeout").Последняя()).Равно(Снимки[2]);

КонецПроцедуры

