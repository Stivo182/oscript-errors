#Область Тесты

&Тест
Процедура ТестДолжен_РазобратьСмешаннуюЦепочку() Экспорт

	// Подготовка
	Цепочка = СмешаннаяЦепочка();

	// Действие
	Разбор = ДиагностикаОшибок.Разобрать(Цепочка.Ошибка);

	// Проверка
	Ожидаем.Что(ТипЗнч(Разбор)).Равно(Тип("РазборОшибки"));
	Ожидаем.Что(Разбор.Снимки().Количество()).Равно(4);
	Ожидаем.Что(Разбор.Ошибки().Количество()).Равно(2);
	Ожидаем.Что(Разбор.Контексты().Количество()).Равно(1);
	Ожидаем.Что(Разбор.ЭффективнаяОшибка().ИсходнаяОшибка()).Равно(Цепочка.ЭффективнаяОшибка);
	Ожидаем.Что(Разбор.КодОшибки()).Равно("config.load_failed");
	Ожидаем.Что(Разбор.Данные()).Равно(Цепочка.ДанныеЭффективнойОшибки);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВозвращатьОднуВыборкуОшибокИзРазбора() Экспорт

	// Подготовка
	Разбор = ДиагностикаОшибок.Разобрать(СмешаннаяЦепочка().Ошибка);

	// Действие
	ПерваяВыборка = Разбор.Ошибки();
	ВтораяВыборка = Разбор.Ошибки();

	// Проверка
	Ожидаем.Что(ПерваяВыборка).Равно(ВтораяВыборка);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПройтиВнешниеКадрыДоМеждуИПослеСобственных() Экспорт

	// Подготовка
	ВнешнийКорень = ПомощникТестированияОшибок.ВнешняяОшибка("Внешний корень");
	СобственнаяОшибка = ФабрикаОшибок.Обернуть(
		ВнешнийКорень,
		"service.unavailable",
		"Сервис недоступен"
	);
	ВнешняяСередина = ПомощникТестированияОшибок.ВнешняяОшибка("Служебная обёртка", СобственнаяОшибка);
	Контекст = ФабрикаОшибок.ОбернутьКонтекстом(ВнешняяСередина, "Вызов сервиса");
	ВнешняяОшибка = ПомощникТестированияОшибок.ВнешняяОшибка("Async", Контекст);

	// Действие
	Разбор = Новый РазборОшибки(ВнешняяОшибка);

	// Проверка
	Ожидаем.Что(Разбор.Снимки().Количество()).Равно(5);
	Ожидаем.Что(Разбор.КодОшибки()).Равно("service.unavailable");
	Ожидаем.Что(Разбор.Контексты()[0].ИсходнаяОшибка()).Равно(Контекст);
	Ожидаем.Что(Разбор.КорневаяПричина().ИсходнаяОшибка()).Равно(ВнешнийКорень);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НайтиСобственныйКадрПослеПовторногоВыброса() Экспорт

	// Подготовка
	ИсходнаяОшибка = ФабрикаОшибок.Создать("storage.read_failed", "Ошибка чтения");
	ПовторноВыброшеннаяОшибка = ПомощникТестированияОшибок.ПовторноВыброшеннаяОшибка(ИсходнаяОшибка);

	// Действие
	Разбор = Новый РазборОшибки(ПовторноВыброшеннаяОшибка);

	// Проверка
	Ожидаем.Что(Разбор.Ошибки().Содержит("storage.read_failed")).Равно(Истина);
	Ожидаем.Что(Разбор.Ошибки().Отобрать(
		"storage.read_failed"
	).Первая().ИсходнаяОшибка()).Равно(ПовторноВыброшеннаяОшибка);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПройтиЧужойИПоврежденныйКонвертыДоСобственнойОшибки() Экспорт

	// Подготовка
	ВнутренняяОшибка = ФабрикаОшибок.Создать("core.failed", "Корневая ошибка");
	Образец = ФабрикаОшибок.Создать("sample.error", "Образец");
	ЧужойМаркер = ПомощникТестированияОшибок.ОшибкаСЧужимМаркером(Образец, ВнутренняяОшибка);
	ПоврежденныйКонверт = ПомощникТестированияОшибок.ОшибкаСПоврежденнымКонвертом(Образец, ЧужойМаркер);

	// Действие
	Разбор = Новый РазборОшибки(ПоврежденныйКонверт);

	// Проверка
	Ожидаем.Что(Разбор.Снимки().Количество()).Равно(3);
	Ожидаем.Что(Разбор.КодОшибки()).Равно("core.failed");
	Ожидаем.Что(Разбор.Ошибки().Содержит("foreign.hidden_error")).Равно(Ложь);
	Ожидаем.Что(Разбор.Контексты().Количество()).Равно(0);
	Ожидаем.Что(Разбор.КорневаяПричина().ИсходнаяОшибка()).Равно(ВнутренняяОшибка);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьПервуюПодсказкуВЦепочке() Экспорт

	// Подготовка
	Причина = Новый ПостроительОшибки("network.timeout", "Таймаут")
		.Подсказка("Повторите позднее")
		.Построить();
	Ошибка = ФабрикаОшибок.Обернуть(Причина, "service.failed", "Сервис недоступен");

	// Действие
	Разбор = Новый РазборОшибки(Ошибка);

	// Проверка
	Ожидаем.Что(Разбор.Подсказка()).Равно("Повторите позднее");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьПервыйURLВЦепочке() Экспорт

	// Подготовка
	Причина = Новый ПостроительОшибки("network.timeout", "Таймаут")
		.URL("https://example.org/errors/network-timeout")
		.Построить();
	Ошибка = Новый ПостроительОшибки("service.failed", "Сервис недоступен")
		.Причина(Причина)
		.URL("https://example.org/errors/service-failed")
		.Построить();

	// Действие
	URL = (Новый РазборОшибки(Ошибка)).URL();

	// Проверка
	Ожидаем.Что(URL).Равно("https://example.org/errors/service-failed");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьПустыеСвойстваДляВнешнейОшибки() Экспорт

	// Подготовка
	Ошибка = ПомощникТестированияОшибок.ВнешняяОшибка("Внешняя ошибка");

	// Действие
	Разбор = Новый РазборОшибки(Ошибка);

	// Проверка
	Ожидаем.Что(Разбор.ЭффективнаяОшибка()).Равно(Неопределено);
	Ожидаем.Что(Разбор.КодОшибки()).Равно(Неопределено);
	Ожидаем.Что(Разбор.Данные()).Равно(Неопределено);
	Ожидаем.Что(Разбор.Подсказка()).Равно("");
	Ожидаем.Что(Разбор.Ошибки().ЕстьОшибки()).Равно(Ложь);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗащититьМассивыРазбораОтИзменения() Экспорт

	// Подготовка
	Причина = ФабрикаОшибок.Создать("core.failed", "Ошибка");
	Ошибка = ФабрикаОшибок.ОбернутьКонтекстом(Причина, "Контекст");
	Разбор = Новый РазборОшибки(Ошибка);

	// Действие
	Разбор.Снимки().Очистить();
	Разбор.Контексты().Очистить();

	// Проверка
	Ожидаем.Что(Разбор.Снимки().Количество()).Равно(2);
	Ожидаем.Что(Разбор.Контексты().Количество()).Равно(1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазличитьКореньИПоследнийКадрУсеченнойЦепочки() Экспорт

	// Подготовка
	Цепочка64 = ПомощникТестированияОшибок.ДлиннаяЦепочка(64);
	Цепочка65 = ПомощникТестированияОшибок.ДлиннаяЦепочка(65);

	// Действие
	Разбор64 = Новый РазборОшибки(Цепочка64.Ошибка);
	Разбор65 = Новый РазборОшибки(Цепочка65.Ошибка);

	// Проверка
	Ожидаем.Что(Разбор64.ЦепочкаУсечена()).Равно(Ложь);
	Ожидаем.Что(Разбор64.КорневаяПричина().ИсходнаяОшибка()).Равно(Цепочка64.Корень);
	Ожидаем.Что(Разбор65.ЦепочкаУсечена()).Равно(Истина);
	Ожидаем.Что(Разбор65.КорневаяПричина()).Равно(Неопределено);
	Ожидаем.Что(Разбор65.ПоследнийКадр() <> Неопределено).Равно(Истина);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьТриПредставленияДляТекущегоКонтекста() Экспорт

	// Подготовка
	Цепочка = СмешаннаяЦепочка();
	Разбор = Новый РазборОшибки(Цепочка.Ошибка);

	// Действие
	Краткое = Разбор.КраткоеПредставление();
	Пользовательское = Разбор.ПользовательскоеПредставление();
	Диагностическое = Разбор.ДиагностическоеПредставление();

	// Проверка
	Ожидаем.Что(Краткое).Равно(
		"config.load_failed: Загрузка конфигурации -> Не удалось загрузить конфигурацию"
	);
	Ожидаем.Что(Пользовательское).Равно(
		"config.load_failed: Загрузка конфигурации -> Не удалось загрузить конфигурацию"
	);
	Ожидаем.Что(Диагностическое).Равно("config.load_failed: Не удалось загрузить конфигурацию
	|
	|Контекст:
	|  Загрузка конфигурации
	|
	|Данные:
	|  Формат: JSON
	|
	|Причина:
	|  1: Некорректный JSON
	|  2: fs.file_not_found: Файл не найден
	|     Данные:
	|       Путь: config.json");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СмешаннаяЦепочка()

	ДанныеПричины = Новый Структура("Путь", "config.json");
	Причина = ФабрикаОшибок.Создать("fs.file_not_found", "Файл не найден", ДанныеПричины);
	ВнешняяОшибка = ПомощникТестированияОшибок.ВнешняяОшибка("Некорректный JSON", Причина);
	ДанныеЭффективнойОшибки = Новый Структура("Формат", "JSON");
	ЭффективнаяОшибка = ФабрикаОшибок.Обернуть(
		ВнешняяОшибка,
		"config.load_failed",
		"Не удалось загрузить конфигурацию",
		ДанныеЭффективнойОшибки
	);
	Контекст = ФабрикаОшибок.ОбернутьКонтекстом(ЭффективнаяОшибка, "Загрузка конфигурации");

	Возврат Новый Структура(
		"Ошибка, ЭффективнаяОшибка, ДанныеЭффективнойОшибки",
		Контекст,
		ЭффективнаяОшибка,
		ДанныеЭффективнойОшибки
	);

КонецФункции

#КонецОбласти
