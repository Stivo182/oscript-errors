// Демонстрирует успешные guard-проверки и три стандартные ошибки аргументов.
// Все ожидаемые ошибки перехватываются, исследуются и не прерывают выполнение сценария.

#Использовать errors

ПроверкаАргументов.ПроверитьТип("Порт", 8080, Тип("Число"));
ПроверкаАргументов.ПроверитьТип("Порт", 8080, "Число");
ПроверкаАргументов.ПроверитьТип("Значение", '20260818', "Число, Дата");
ПроверкаАргументов.ПроверитьЗаполненность("Адрес", "127.0.0.1");
ПроверкаАргументов.ПроверитьДопустимость("Порт", Истина, "число от 1 до 65535");
Сообщить("Корректные аргументы прошли проверку");

Попытка
	ПроверкаАргументов.ПроверитьТип("Порт", "8080", Тип("Число"));
Исключение
	Снимок = Новый СнимокКадраОшибки(ИнформацияОбОшибке());
	Данные = Снимок.Данные();
	Сообщить(СтрШаблон(
		"%1: ожидался %2, получен %3",
		Снимок.КодОшибки(),
		Данные.ОжидаемыйТип,
		Данные.ФактическийТип
	));
	Сообщить("Фактическое значение сохранено: " + Строка(Данные.Свойство("ФактическоеЗначение")));
КонецПопытки;

Попытка
	ПроверкаАргументов.ПроверитьЗаполненность("Адрес", "");
Исключение
	Снимок = Новый СнимокКадраОшибки(ИнформацияОбОшибке());
	Сообщить(СтрШаблон("%1: %2", Снимок.КодОшибки(), Снимок.Данные().ИмяАргумента));
КонецПопытки;

Попытка
	ПроверкаАргументов.ПроверитьДопустимость("Порт", Ложь, "число от 1 до 65535");
Исключение
	Снимок = Новый СнимокКадраОшибки(ИнформацияОбОшибке());
	Сообщить(СтрШаблон("%1: %2", Снимок.КодОшибки(), Снимок.Данные().Ожидание));
КонецПопытки;
