#Область Тесты

&Тест
Процедура ТестДолжен_ПредставитьСтруктурыИСоответствияОдинаковымиПарами() Экспорт

	// Подготовка
	СтруктураДанных = Новый Структура("Попытки, Формат", 3, "JSON");
	СоответствиеДанных = Новый Соответствие;
	СоответствиеДанных.Вставить("Формат", "JSON");
	СоответствиеДанных.Вставить("Попытки", 3);
	ОжидаемыйТекст = "  Попытки: 3" + Символы.ПС + "  Формат: JSON";

	// Действие
	СтрокиСтруктуры = ФорматированиеПредставленияОшибок.СтрокиДанных(СтруктураДанных, 2);
	СтрокиФиксированнойСтруктуры = ФорматированиеПредставленияОшибок.СтрокиДанных(
		Новый ФиксированнаяСтруктура(СтруктураДанных),
		2
	);
	СтрокиСоответствия = ФорматированиеПредставленияОшибок.СтрокиДанных(СоответствиеДанных, 2);
	СтрокиФиксированногоСоответствия = ФорматированиеПредставленияОшибок.СтрокиДанных(
		Новый ФиксированноеСоответствие(СоответствиеДанных),
		2
	);

	// Проверка
	Ожидаем.Что(Соединить(СтрокиСтруктуры)).Равно(ОжидаемыйТекст);
	Ожидаем.Что(Соединить(СтрокиФиксированнойСтруктуры)).Равно(ОжидаемыйТекст);
	Ожидаем.Что(Соединить(СтрокиСоответствия)).Равно(ОжидаемыйТекст);
	Ожидаем.Что(Соединить(СтрокиФиксированногоСоответствия)).Равно(ОжидаемыйТекст);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПредставитьВложенныеКонтейнерыИПустыеЗначения() Экспорт

	// Подготовка
	Элементы = Новый Массив;
	Элементы.Добавить("первый");
	Элементы.Добавить(Неопределено);
	Данные = Новый Структура;
	Данные.Вставить("Элементы", Элементы);
	Данные.Вставить("ПустаяСтруктура", Новый Структура);
	Данные.Вставить("ПустойМассив", Новый Массив);
	Данные.Вставить("ПустаяСтрока", "");
	ОжидаемыйТекст = "Элементы:" + Символы.ПС
		+ "  - первый" + Символы.ПС
		+ "  - Неопределено" + Символы.ПС
		+ "ПустаяСтруктура: {}" + Символы.ПС
		+ "ПустойМассив: []" + Символы.ПС
		+ "ПустаяСтрока: " + Символ(34) + Символ(34);

	// Действие
	Строки = ФорматированиеПредставленияОшибок.СтрокиДанных(Данные);

	// Проверка
	Ожидаем.Что(Соединить(Строки)).Равно(ОжидаемыйТекст);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОграничитьГлубинуИКоличествоЭлементов() Экспорт

	// Подготовка
	МногоЭлементов = Новый Массив;
	Для Номер = 1 По 21 Цикл
		МногоЭлементов.Добавить(Номер);
	КонецЦикла;
	ГлубинаТри = Новый Структура("Скрыто", Истина);
	ГлубинаДва = Новый Структура("ГлубинаТри", ГлубинаТри);
	ГлубинаОдин = Новый Структура("ГлубинаДва", ГлубинаДва);
	Данные = Новый Структура("ГлубинаОдин, Много", ГлубинаОдин, МногоЭлементов);

	// Действие
	Текст = Соединить(ФорматированиеПредставленияОшибок.СтрокиДанных(Данные));

	// Проверка
	Ожидаем.Что(Текст).Содержит("    ГлубинаТри: <максимальная глубина>");
	Ожидаем.Что(Текст).Содержит("  - 20" + Символы.ПС + "  - ... ещё 1 элемент");
	Ожидаем.Что(СтрЧислоВхождений(Текст, "  - 21")).Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтличитьЦиклОтПовторногоИспользования() Экспорт

	// Подготовка
	ОбщийПотомок = Новый Структура("Значение", 1);
	ЦиклическийМассив = Новый Массив;
	ЦиклическийМассив.Добавить(ЦиклическийМассив);
	Данные = Новый Структура;
	Данные.Вставить("Первый", ОбщийПотомок);
	Данные.Вставить("Второй", ОбщийПотомок);
	Данные.Вставить("Цикл", ЦиклическийМассив);

	// Действие
	Текст = Соединить(ФорматированиеПредставленияОшибок.СтрокиДанных(Данные));

	// Проверка
	Ожидаем.Что(СтрЧислоВхождений(Текст, "  Значение: 1")).Равно(2);
	Ожидаем.Что(Текст).Содержит("Цикл:" + Символы.ПС + "  - <циклическая ссылка>");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЭкранироватьКлючиСоответствияИНеОграничиватьСтроки() Экспорт

	// Подготовка
	ДлиннаяСтрока = "";
	Для Номер = 1 По 300 Цикл
		ДлиннаяСтрока = ДлиннаяСтрока + "я";
	КонецЦикла;
	Данные = Новый Соответствие;
	Данные.Вставить("", ДлиннаяСтрока);
	Данные.Вставить("а\б" + Символы.ПС + Символы.Таб + "в:г", 1);

	// Действие
	Текст = Соединить(ФорматированиеПредставленияОшибок.СтрокиДанных(Данные));

	// Проверка
	Ожидаем.Что(Текст).Содержит(Символ(34) + Символ(34) + ": " + ДлиннаяСтрока);
	Ожидаем.Что(Текст).Содержит("а\\б\n\tв:г: 1");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("Массив")
&ИсточникЗначение("Структура")
&ИсточникЗначение("Соответствие")
Процедура ТестДолжен_ОграничитьКаждыйВидКоллекцииПослеДвадцатиЭлементов(ВидКоллекции) Экспорт

	// Подготовка
	ДвадцатьЭлементов = СоздатьКоллекцию(ВидКоллекции, 20);
	ДвадцатьОдинЭлемент = СоздатьКоллекцию(ВидКоллекции, 21);
	ОжидаемыйМаркер = НСтр("ru = '... ещё 1 элемент'; en = '... 1 more item'");
	Если ВидКоллекции = "Массив" Тогда
		ОжидаемыйМаркер = "- " + ОжидаемыйМаркер;
	КонецЕсли;

	// Действие
	СтрокиДвадцати = ФорматированиеПредставленияОшибок.СтрокиДанных(ДвадцатьЭлементов);
	СтрокиДвадцатиОдного = ФорматированиеПредставленияОшибок.СтрокиДанных(ДвадцатьОдинЭлемент);

	// Проверка
	Ожидаем.Что(СтрокиДвадцати.Количество()).Равно(20);
	Ожидаем.Что(СтрокиДвадцатиОдного.Количество()).Равно(21);
	Ожидаем.Что(СтрокиДвадцатиОдного[20]).Равно(ОжидаемыйМаркер);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение(21, "ru = '... ещё 1 элемент'; en = '... 1 more item'")
&ИсточникЗначение(22, "ru = '... ещё 2 элемента'; en = '... 2 more items'")
&ИсточникЗначение(25, "ru = '... ещё 5 элементов'; en = '... 5 more items'")
&ИсточникЗначение(31, "ru = '... ещё 11 элементов'; en = '... 11 more items'")
&ИсточникЗначение(41, "ru = '... ещё 21 элемент'; en = '... 21 more items'")
Процедура ТестДолжен_СогласоватьМаркерЛимитаСКоличествомЭлементов(Количество, ЛокализованныйМаркер) Экспорт

	// Подготовка
	Массив = СоздатьКоллекцию("Массив", Количество);
	ОжидаемыйМаркер = НСтр(ЛокализованныйМаркер);

	// Действие
	Строки = ФорматированиеПредставленияОшибок.СтрокиДанных(Массив);

	// Проверка
	Ожидаем.Что(Строки[Строки.ВГраница()]).Равно("- " + ОжидаемыйМаркер);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеИзменитьКонтейнерыДанныхПриФорматировании() Экспорт

	// Подготовка
	ВложенныйМассив = Новый Массив;
	ВложенныйМассив.Добавить("первый");
	ВложенныйМассив.Добавить("второй");
	Соответствие = Новый Соответствие;
	Соответствие.Вставить("Б", 2);
	Соответствие.Вставить("А", 1);
	Данные = Новый Структура("Массив, Соответствие", ВложенныйМассив, Соответствие);

	// Действие
	ПервоеПредставление = Соединить(ФорматированиеПредставленияОшибок.СтрокиДанных(Данные));
	ВтороеПредставление = Соединить(ФорматированиеПредставленияОшибок.СтрокиДанных(Данные));

	// Проверка
	Ожидаем.Что(ПервоеПредставление).Равно(ВтороеПредставление);
	Ожидаем.Что(ВложенныйМассив.Количество()).Равно(2);
	Ожидаем.Что(ВложенныйМассив[0]).Равно("первый");
	Ожидаем.Что(ВложенныйМассив[1]).Равно("второй");
	Ожидаем.Что(Соответствие.Количество()).Равно(2);
	Ожидаем.Что(Соответствие["А"]).Равно(1);
	Ожидаем.Что(Соответствие["Б"]).Равно(2);

КонецПроцедуры

