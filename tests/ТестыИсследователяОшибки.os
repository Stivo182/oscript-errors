&Тест
Процедура ТестДолжен_ОтклонитьПустойМассивКодов() Экспорт

	// Подготовка
	Исследователь = Новый ИсследовательОшибки(ФабрикаОшибок.Создать("core.failed", "Ошибка"));
	Параметры = Новый Массив;
	Параметры.Добавить(Новый Массив);

	// Действие и Проверка
	Ожидаем.Что(Исследователь)
		.Метод("НайтиОшибки", Параметры)
		.ВыбрасываетИсключение(
			НСтр("ru = 'Аргумент ''КодыОшибок'' должен быть заполнен'; en = 'Argument ''КодыОшибок'' is required'")
		);
	Ожидаем.Что(Исследователь)
		.Метод("ЕстьОднаИзОшибок", Параметры)
		.ВыбрасываетИсключение(
			НСтр("ru = 'Аргумент ''КодыОшибок'' должен быть заполнен'; en = 'Argument ''КодыОшибок'' is required'")
		);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьНекорректныйФильтрОшибок() Экспорт

	// Подготовка
	Исследователь = Новый ИсследовательОшибки(ФабрикаОшибок.Создать("core.failed", "Ошибка"));
	НекорректныеФильтры = Новый Массив;
	НекорректныеФильтры.Добавить("");
	НекорректныеФильтры.Добавить("database.timeout,");
	НекорректныеФильтры.Добавить(",database.timeout");
	НекорректныеФильтры.Добавить("database.timeout, ,network.timeout");
	НекорректныеФильтры.Добавить("Core.Not-Failed");

	// Действие и Проверка
	Для Каждого Фильтр Из НекорректныеФильтры Цикл
		Параметры = Новый Массив;
		Параметры.Добавить(Фильтр);
		Ожидаем.Что(Исследователь)
			.Метод("НайтиОшибки", Параметры)
			.ВыбрасываетИсключение(
				НСтр("ru = 'Код ошибки имеет неверный формат'; en = 'Error code has an invalid format'")
			);
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ТестДолжен_КлассифицироватьНекорректныйФорматФильтраОшибок() Экспорт

	// Подготовка
	Исследователь = Новый ИсследовательОшибки(ФабрикаОшибок.Создать("core.failed", "Ошибка"));
	Ошибка = Неопределено;

	// Действие
	Попытка
		Исследователь.НайтиОшибки("core.not-failed");
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;

	// Проверка
	Если Ошибка = Неопределено Тогда
		ВызватьИсключение "Ожидалось контрактное исключение исследователя";
	КонецЕсли;

	Снимок = Новый СнимокКадраОшибки(Ошибка);
	Ожидаем.Что(Снимок.КодОшибки()).Равно("argument.invalid_value");
	Ожидаем.Что(Снимок.Данные().ИмяАргумента).Равно("КодОшибки");
	Ожидаем.Что(Снимок.Данные().Ожидание).Равно("формату кода");

КонецПроцедуры

