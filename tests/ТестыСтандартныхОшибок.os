Процедура ТестДолжен_ВернутьРавныеГотовуюОшибкуИПостроитель(ИмяФабрики) Экспорт

	// Действие
	ПараОшибок = СоздатьПаруСтандартныхОшибок(ИмяФабрики);

	// Проверка
	ПроверитьРавенствоСтандартныхОшибок(ПараОшибок.Построитель, ПараОшибок.Ошибка);

КонецПроцедуры

#КонецОбласти
#Область СлужебныеПроцедурыИФункции

Функция СоздатьПаруСтандартныхОшибок(ИмяФабрики)

	Если ИмяФабрики = "НеверныйТипАргумента" Тогда
		Построитель = ПостроителиСтандартныхОшибок.НеверныйТипАргумента("Порт", "Число", "80");
		Ошибка = СтандартныеОшибки.НеверныйТипАргумента("Порт", "Число", "80");
	ИначеЕсли ИмяФабрики = "АргументНеЗаполнен" Тогда
		Построитель = ПостроителиСтандартныхОшибок.АргументНеЗаполнен("Адрес");
		Ошибка = СтандартныеОшибки.АргументНеЗаполнен("Адрес");
	ИначеЕсли ИмяФабрики = "НедопустимоеЗначениеАргумента" Тогда
		Построитель = ПостроителиСтандартныхОшибок.НедопустимоеЗначениеАргумента("Порт", "быть положительным");
		Ошибка = СтандартныеОшибки.НедопустимоеЗначениеАргумента("Порт", "быть положительным");
	ИначеЕсли ИмяФабрики = "АргументВнеДиапазона" Тогда
		Построитель = ПостроителиСтандартныхОшибок.АргументВнеДиапазона("Порт", "от 1 до 65535");
		Ошибка = СтандартныеОшибки.АргументВнеДиапазона("Порт", "от 1 до 65535");
	ИначеЕсли ИмяФабрики = "ОперацияОтменена" Тогда
		Построитель = ПостроителиСтандартныхОшибок.ОперацияОтменена("Загрузка");
		Ошибка = СтандартныеОшибки.ОперацияОтменена("Загрузка");
	ИначеЕсли ИмяФабрики = "ОперацияВНедопустимомСостоянии" Тогда
		Построитель = ПостроителиСтандартныхОшибок.ОперацияВНедопустимомСостоянии("Загрузка");
		Ошибка = СтандартныеОшибки.ОперацияВНедопустимомСостоянии("Загрузка");
	ИначеЕсли ИмяФабрики = "ОперацияНеРеализована" Тогда
		Построитель = ПостроителиСтандартныхОшибок.ОперацияНеРеализована("Загрузка");
		Ошибка = СтандартныеОшибки.ОперацияНеРеализована("Загрузка");
	ИначеЕсли ИмяФабрики = "ОперацияНеПоддерживается" Тогда
		Построитель = ПостроителиСтандартныхОшибок.ОперацияНеПоддерживается("Загрузка");
		Ошибка = СтандартныеОшибки.ОперацияНеПоддерживается("Загрузка");
	ИначеЕсли ИмяФабрики = "ИстеклоВремяОжиданияОперации" Тогда
		Построитель = ПостроителиСтандартныхОшибок.ИстеклоВремяОжиданияОперации("Загрузка");
		Ошибка = СтандартныеОшибки.ИстеклоВремяОжиданияОперации("Загрузка");
	ИначеЕсли ИмяФабрики = "ОперацияНедоступна" Тогда
		Построитель = ПостроителиСтандартныхОшибок.ОперацияНедоступна("Загрузка");
		Ошибка = СтандартныеОшибки.ОперацияНедоступна("Загрузка");
	ИначеЕсли ИмяФабрики = "КонфликтОперации" Тогда
		Построитель = ПостроителиСтандартныхОшибок.КонфликтОперации("Загрузка");
		Ошибка = СтандартныеОшибки.КонфликтОперации("Загрузка");
	ИначеЕсли ИмяФабрики = "ПревышенаЧастотаОперации" Тогда
		Построитель = ПостроителиСтандартныхОшибок.ПревышенаЧастотаОперации("Загрузка");
		Ошибка = СтандартныеОшибки.ПревышенаЧастотаОперации("Загрузка");
	ИначеЕсли ИмяФабрики = "ТребуетсяАутентификация" Тогда
		Построитель = ПостроителиСтандартныхОшибок.ТребуетсяАутентификация("application.json");
		Ошибка = СтандартныеОшибки.ТребуетсяАутентификация("application.json");
	ИначеЕсли ИмяФабрики = "ДоступЗапрещен" Тогда
		Построитель = ПостроителиСтандартныхОшибок.ДоступЗапрещен("application.json");
		Ошибка = СтандартныеОшибки.ДоступЗапрещен("application.json");
	ИначеЕсли ИмяФабрики = "РесурсНеНайден" Тогда
		Построитель = ПостроителиСтандартныхОшибок.РесурсНеНайден("application.json");
		Ошибка = СтандартныеОшибки.РесурсНеНайден("application.json");
	ИначеЕсли ИмяФабрики = "РесурсУжеСуществует" Тогда
		Построитель = ПостроителиСтандартныхОшибок.РесурсУжеСуществует("application.json");
		Ошибка = СтандартныеОшибки.РесурсУжеСуществует("application.json");
	ИначеЕсли ИмяФабрики = "РесурсУжеИспользуется" Тогда
		Построитель = ПостроителиСтандартныхОшибок.РесурсУжеИспользуется("application.json");
		Ошибка = СтандартныеОшибки.РесурсУжеИспользуется("application.json");
	ИначеЕсли ИмяФабрики = "РесурсЗакрыт" Тогда
		Построитель = ПостроителиСтандартныхОшибок.РесурсЗакрыт("application.json");
		Ошибка = СтандартныеОшибки.РесурсЗакрыт("application.json");
	ИначеЕсли ИмяФабрики = "РесурсИсчерпан" Тогда
		Построитель = ПостроителиСтандартныхОшибок.РесурсИсчерпан("пул");
		Ошибка = СтандартныеОшибки.РесурсИсчерпан("пул");
	ИначеЕсли ИмяФабрики = "КвотаРесурсаПревышена" Тогда
		Построитель = ПостроителиСтандартныхОшибок.КвотаРесурсаПревышена("хранилище");
		Ошибка = СтандартныеОшибки.КвотаРесурсаПревышена("хранилище");
	ИначеЕсли ИмяФабрики = "РесурсНеПуст" Тогда
		Построитель = ПостроителиСтандартныхОшибок.РесурсНеПуст("каталог");
		Ошибка = СтандартныеОшибки.РесурсНеПуст("каталог");
	ИначеЕсли ИмяФабрики = "ЗависимостьНедоступна" Тогда
		Построитель = ПостроителиСтандартныхОшибок.ЗависимостьНедоступна("Сервис оплаты");
		Ошибка = СтандартныеОшибки.ЗависимостьНедоступна("Сервис оплаты");
	ИначеЕсли ИмяФабрики = "СоединениеОтклонено" Тогда
		Построитель = ПостроителиСтандартныхОшибок.СоединениеОтклонено("db.example.org");
		Ошибка = СтандартныеОшибки.СоединениеОтклонено("db.example.org");
	ИначеЕсли ИмяФабрики = "СоединениеСброшено" Тогда
		Построитель = ПостроителиСтандартныхОшибок.СоединениеСброшено("db.example.org");
		Ошибка = СтандартныеОшибки.СоединениеСброшено("db.example.org");
	ИначеЕсли ИмяФабрики = "СоединениеПрервано" Тогда
		Построитель = ПостроителиСтандартныхОшибок.СоединениеПрервано("db.example.org");
		Ошибка = СтандартныеОшибки.СоединениеПрервано("db.example.org");
	ИначеЕсли ИмяФабрики = "СоединениеНеУстановлено" Тогда
		Построитель = ПостроителиСтандартныхОшибок.СоединениеНеУстановлено("db.example.org");
		Ошибка = СтандартныеОшибки.СоединениеНеУстановлено("db.example.org");
	ИначеЕсли ИмяФабрики = "ИстеклоВремяОжиданияСоединения" Тогда
		Построитель = ПостроителиСтандартныхОшибок.ИстеклоВремяОжиданияСоединения("db.example.org");
		Ошибка = СтандартныеОшибки.ИстеклоВремяОжиданияСоединения("db.example.org");
	ИначеЕсли ИмяФабрики = "СетевоеИмяНеНайдено" Тогда
		Построитель = ПостроителиСтандартныхОшибок.СетевоеИмяНеНайдено("db.example.org");
		Ошибка = СтандартныеОшибки.СетевоеИмяНеНайдено("db.example.org");
	ИначеЕсли ИмяФабрики = "УзелНедоступен" Тогда
		Построитель = ПостроителиСтандартныхОшибок.УзелНедоступен("db.example.org");
		Ошибка = СтандартныеОшибки.УзелНедоступен("db.example.org");
	ИначеЕсли ИмяФабрики = "СетьНедоступна" Тогда
		Построитель = ПостроителиСтандартныхОшибок.СетьНедоступна("Корпоративная сеть");
		Ошибка = СтандартныеОшибки.СетьНедоступна("Корпоративная сеть");
	ИначеЕсли ИмяФабрики = "НекорректныеДанные" Тогда
		Построитель = ПостроителиСтандартныхОшибок.НекорректныеДанные("Конфигурация");
		Ошибка = СтандартныеОшибки.НекорректныеДанные("Конфигурация");
	ИначеЕсли ИмяФабрики = "ДанныеСлишкомБольшие" Тогда
		Построитель = ПостроителиСтандартныхОшибок.ДанныеСлишкомБольшие("Пакет", "10 МБ");
		Ошибка = СтандартныеОшибки.ДанныеСлишкомБольшие("Пакет", "10 МБ");
	ИначеЕсли ИмяФабрики = "ДанныеПовреждены" Тогда
		Построитель = ПостроителиСтандартныхОшибок.ДанныеПовреждены("Архив");
		Ошибка = СтандартныеОшибки.ДанныеПовреждены("Архив");
	ИначеЕсли ИмяФабрики = "ДанныеНеСоответствуютКодировке" Тогда
		Построитель = ПостроителиСтандартныхОшибок.ДанныеНеСоответствуютКодировке("Файл", "UTF-8");
		Ошибка = СтандартныеОшибки.ДанныеНеСоответствуютКодировке("Файл", "UTF-8");
	ИначеЕсли ИмяФабрики = "КодировкаНеПоддерживается" Тогда
		Построитель = ПостроителиСтандартныхОшибок.КодировкаНеПоддерживается("UTF-32");
		Ошибка = СтандартныеОшибки.КодировкаНеПоддерживается("UTF-32");
	ИначеЕсли ИмяФабрики = "НеизвестнаяКодировка" Тогда
		Построитель = ПостроителиСтандартныхОшибок.НеизвестнаяКодировка("X-UNKNOWN");
		Ошибка = СтандартныеОшибки.НеизвестнаяКодировка("X-UNKNOWN");
	ИначеЕсли ИмяФабрики = "НарушенВнутреннийИнвариант" Тогда
		Построитель = ПостроителиСтандартныхОшибок.НарушенВнутреннийИнвариант("Счётчик неотрицателен");
		Ошибка = СтандартныеОшибки.НарушенВнутреннийИнвариант("Счётчик неотрицателен");
	Иначе
		ВызватьИсключение "Неизвестная стандартная ошибка";
	КонецЕсли;

	Возврат Новый Структура("Построитель,Ошибка", Построитель, Ошибка);

КонецФункции

Процедура ПроверитьРавенствоСтандартныхОшибок(Построитель, Ошибка)

	Ожидаем.Что(ТипЗнч(Построитель)).Равно(Тип("ПостроительОшибки"));
	СнимокПостроителя = Новый СнимокКадраОшибки(Построитель.Построить());
	СнимокОшибки = Новый СнимокКадраОшибки(Ошибка);

	Ожидаем.Что(СнимокПостроителя.Вид()).Равно(СнимокОшибки.Вид());
	Ожидаем.Что(СнимокПостроителя.КодОшибки()).Равно(СнимокОшибки.КодОшибки());
	Ожидаем.Что(СнимокПостроителя.Сообщение()).Равно(СнимокОшибки.Сообщение());
	Ожидаем.Что(СнимокПостроителя.Подсказка()).Равно(СнимокОшибки.Подсказка());
	Ожидаем.Что(СнимокПостроителя.URL()).Равно(СнимокОшибки.URL());

	ДанныеПостроителя = СнимокПостроителя.Данные();
	ДанныеОшибки = СнимокОшибки.Данные();
	Ожидаем.Что(ДанныеПостроителя.Количество()).Равно(ДанныеОшибки.Количество());
	Для Каждого Элемент Из ДанныеПостроителя Цикл
		Ожидаем.Что(ДанныеОшибки[Элемент.Ключ]).Равно(Элемент.Значение);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
