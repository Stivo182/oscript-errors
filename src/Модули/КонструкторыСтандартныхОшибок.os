		Сообщение
	);

КонецФункции

// Возвращает конструктор для ошибки несоответствия данных заявленной кодировке.
//
// Параметры:
//  ИмяДанных - Строка - Безопасное диагностическое имя данных.
//  Кодировка - Строка - Имя заявленной кодировки.
//  Сообщение - Строка - Человекочитаемое описание ошибки.
//
// Возвращаемое значение:
//  КонструкторОшибки - Настроенный конструктор ошибки.
Функция НевернаяКодировкаДанных(ИмяДанных, Кодировка, Сообщение = "") Экспорт

	ПроверитьДваСтандартныхПараметра(
		"ИмяДанных",
		ИмяДанных,
		"Кодировка",
		Кодировка,
		Сообщение
	);

	Возврат СоздатьДвухпараметрическуюОшибку(
		"encoding.invalid",
		"ИмяДанных",
		ИмяДанных,
		"Кодировка",
		Кодировка,
		НСтр(
			"ru = 'Данные ''%1'' не соответствуют кодировке ''%2''';"
			+ "en = 'Data ''%1'' does not match encoding ''%2'''"
		),
		Сообщение
	);

КонецФункции

// Возвращает конструктор для ошибки неподдерживаемой кодировки.
