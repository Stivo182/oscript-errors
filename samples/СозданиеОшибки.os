// Демонстрирует создание, выбрасывание и разбор классифицированной ошибки.
// Fluent-построитель позволяет задать подсказку до построения ошибки.

#Использовать errors

Ошибка = Новый ПостроительОшибки(
	"storage.quota_exceeded",
	"Недостаточно места в хранилище"
)
	.Данные("ТребуетсяМБ", 800)
	.Данные("ДоступноМБ", 250)
	.Подсказка("Освободите место или увеличьте квоту")
	.Построить();

Попытка
	ВызватьИсключение Ошибка;
Исключение
	Разбор = ДиагностикаОшибок.Разобрать(ИнформацияОбОшибке());
	Данные = Разбор.Данные();

	Сообщить("Код: " + Разбор.КодОшибки());
	Сообщить(СтрШаблон("Требуется %1 МБ, доступно %2 МБ", Данные.ТребуетсяМБ, Данные.ДоступноМБ));
	Сообщить("Подсказка: " + Разбор.Подсказка());
КонецПопытки;
