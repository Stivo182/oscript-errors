#Использовать "../src"

&Параметры(1, 10, 50)
Перем ГлубинаЦепочки Экспорт; // Число

Перем _Ошибка;    // ИнформацияОбОшибке
Перем _Разбор;    // РазборОшибки
Перем _Результат; // Строка

#Область ОбработчикиСобытий

// Создаёт бенчмарк представлений цепочки ошибок.
&КоличествоИтераций(20)
&КоличествоПрогревочныхИтераций(6)
&МинимальноеВремяИтерации(250)
&МониторингПамяти
Процедура ПриСозданииОбъекта()
КонецПроцедуры

// Подготавливает цепочку ошибок заданной глубины.
//
// Параметры:
//  Контекст - Структура - Контекст выполняемого кейса бенчмарка.
&ПередКаждымКейсом
Процедура ПодготовитьЦепочку(Контекст) Экспорт

	_Ошибка = СоздатьЦепочку(ГлубинаЦепочки);
	_Разбор = ДиагностикаОшибок.Разобрать(_Ошибка);

КонецПроцедуры

#КонецОбласти

#Область Бенчмарки

// Измеряет формирование пользовательского представления цепочки.
&Бенчмарк
Процедура СформироватьПользовательскоеПредставление() Экспорт
	_Результат = ДиагностикаОшибок.ПользовательскоеПредставление(_Ошибка);
КонецПроцедуры

// Измеряет формирование диагностического представления цепочки.
&Бенчмарк
Процедура СформироватьДиагностическоеПредставление() Экспорт
	_Результат = ДиагностикаОшибок.ДиагностическоеПредставление(_Ошибка);
КонецПроцедуры

// Измеряет только форматирование пользовательского текста подготовленного разбора.
&Бенчмарк
Процедура ФорматироватьПользовательскоеПредставление() Экспорт
	_Результат = _Разбор.ПользовательскоеПредставление();
КонецПроцедуры

// Измеряет только форматирование диагностического текста подготовленного разбора.
&Бенчмарк
Процедура ФорматироватьДиагностическоеПредставление() Экспорт
	_Результат = _Разбор.ДиагностическоеПредставление();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьЦепочку(Глубина)

	Ошибка = ФабрикаОшибок.Создать(КодУровня(1), "Ошибка уровня 1", ДанныеУровня(1));

	Для НомерУровня = 2 По Глубина Цикл
		Ошибка = ФабрикаОшибок.Обернуть(
			Ошибка,
			КодУровня(НомерУровня),
			"Ошибка уровня " + НомерУровня,
			ДанныеУровня(НомерУровня)
		);
	КонецЦикла;

	Возврат Ошибка;

КонецФункции

Функция КодУровня(НомерУровня)
	Возврат "benchmark.level_" + НомерУровня;
КонецФункции

Функция ДанныеУровня(НомерУровня)
	Возврат Новый Структура("Уровень, Операция", НомерУровня, "Обработка");
КонецФункции

#КонецОбласти
