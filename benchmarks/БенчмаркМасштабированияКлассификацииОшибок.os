#Использовать "../src"

&Параметры(1, 10, 100, 1000)
Перем КоличествоПравил Экспорт; // Число

Перем _Классификатор; // КлассификаторОшибок
Перем _Ошибка; // ИнформацияОбОшибке
Перем _Результат; // ИнформацияОбОшибке, Неопределено

#Область ОбработчикиСобытий

// Создаёт бенчмарк классификации последним правилом набора.
&МониторингПамяти
&КоличествоИтераций(20)
&КоличествоПрогревочныхИтераций(10)
&КолонкаМакс
Процедура ПриСозданииОбъекта()
КонецПроцедуры

// Подготавливает набор правил, в котором целевое правило добавлено последним.
//
// Параметры:
//  Контекст - Структура - Контекст выполняемого кейса бенчмарка.
&ПередКаждымКейсом
Процедура ПодготовитьДанные(Контекст) Экспорт

	_Классификатор = СоздатьКлассификатор();
	_Ошибка = НоваяОшибка(
		"External exception (System.IO.IOException): " + ТекстПравила(КоличествоПравил)
	);

КонецПроцедуры

#КонецОбласти

#Область Бенчмарки

// Измеряет классификацию, когда подходящее правило добавлено в набор последним.
&Бенчмарк(Наименование = "Последнее правило набора")
Процедура КлассифицироватьПоследнимПравилом() Экспорт

	_Результат = _Классификатор.Классифицировать(_Ошибка);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьКлассификатор()

	Правила = Новый Массив;
	Для НомерПравила = 1 По КоличествоПравил Цикл
		Правила.Добавить(
			Новый ПравилоКлассификацииОшибок()
				.СНативнымТипом("System.IO.IOException")
				.СовпадаетС(ТекстПравила(НомерПравила))
				.КлассифицируетКак(
					"benchmark.rules.rule_" + НомерПравила,
					"Правило бенчмарка " + НомерПравила
				)
		);
	КонецЦикла;

	Классификатор = Новый КлассификаторОшибок;
	Классификатор.ДобавитьПравила(Новый ФиксированныйМассив(Правила));

	Возврат Классификатор;

КонецФункции

Функция ТекстПравила(НомерПравила)

	Возврат "Ошибка правила " + НомерПравила;

КонецФункции

Функция НоваяОшибка(Описание)

	Возврат Новый ИнформацияОбОшибке(Описание, Новый Структура("Источник", "Бенчмарк"));

КонецФункции

#КонецОбласти
