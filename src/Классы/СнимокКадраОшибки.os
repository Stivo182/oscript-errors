#Использовать "../internal"

Перем _ИсходнаяОшибка; // ИнформацияОбОшибке
Перем _Вид; // Строка
Перем _КодОшибки; // Строка
Перем _Сообщение; // Строка
Перем _Данные; // Произвольный, Неопределено
Перем _Подсказка; // Строка
Перем _URL; // Строка
Перем _МестоСоздания; // ФиксированнаяСтруктура
Перем _МестоСозданияЗагружено; // Булево
Перем _СтекВызовов; // Массив из КадрСтекаВызовов
Перем _СтекЗагружен; // Булево
Перем _НормализоватьСтек; // Булево
Перем _КореньИсходников; // Строка

#Область ОбработчикиСобытий

// Создаёт снимок физического кадра ошибки.
//
// Параметры:
//  Ошибка - ИнформацияОбОшибке - Физический кадр для создания снимка.
Процедура ПриСозданииОбъекта(Ошибка)

	УстановитьНачальноеСостояние(Ошибка);

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Возвращает по ссылке исходный физический кадр.
//
// Возвращаемое значение:
//  ИнформацияОбОшибке - Кадр, из которого создан снимок.
Функция ИсходнаяОшибка() Экспорт

	Возврат _ИсходнаяОшибка;

КонецФункции

// Возвращает распознанный вид кадра.
//
// Возвращаемое значение:
//  Строка - Распознанный вид кадра.
Функция Вид() Экспорт

	Возврат _Вид;

КонецФункции

// Возвращает машинный код собственного кадра.
//
// Возвращаемое значение:
//  Строка - Машинный код собственного кадра или пустая строка, если код отсутствует.
Функция КодОшибки() Экспорт

	Возврат _КодОшибки;

КонецФункции

// Проверяет принадлежность машинного кода кадра группе ошибок.
//
// Параметры:
//  ГруппаОшибок - Строка - Один или несколько начальных сегментов машинного кода.
//
// Возвращаемое значение:
//  Булево - Истина, если машинный код кадра принадлежит группе.
Функция ПринадлежитГруппе(ГруппаОшибок) Экспорт

	СервисыБиблиотекиОшибок.ПроверяющийКадрыОшибок().ПроверитьГруппуОшибок(ГруппаОшибок);

	НормализованныйКод = НРег(_КодОшибки);
	НормализованнаяГруппа = НРег(ГруппаОшибок);

	Возврат НормализованныйКод = НормализованнаяГруппа
		Или СтрНайти(НормализованныйКод, НормализованнаяГруппа + ".") = 1;

КонецФункции

// Возвращает описание физического кадра.
//
// Возвращаемое значение:
//  Строка - Описание физического кадра.
Функция Сообщение() Экспорт

	Возврат _Сообщение;

КонецФункции

// Возвращает по ссылке пользовательские данные собственного кадра.
//
// Возвращаемое значение:
//  Произвольный, Неопределено - Пользовательские данные собственного кадра.
Функция Данные() Экспорт

	Возврат _Данные;

КонецФункции

// Возвращает подсказку по исправлению собственного кадра.
//
// Возвращаемое значение:
//  Строка - Подсказка или пустая строка, если она отсутствует.
Функция Подсказка() Экспорт

	Возврат _Подсказка;

КонецФункции

// Возвращает адрес страницы с дополнительной информацией о собственном кадре.
//
// Возвращаемое значение:
//  Строка - URL документации или пустая строка, если он отсутствует.
Функция URL() Экспорт

	Возврат _URL;

КонецФункции

// Возвращает место создания кадра.
//
// Возвращаемое значение:
//  ФиксированнаяСтруктура:
//   * ИмяМодуля - Строка - Имя модуля или пустая строка;
//   * НомерСтроки - Число - Номер строки или 0;
//   * ИсходнаяСтрока - Строка - Исходная строка или пустая строка.
Функция МестоСоздания() Экспорт

	Если Не _МестоСозданияЗагружено Тогда
		ЗаполнитьМестоСоздания();
	КонецЕсли;

	Возврат _МестоСоздания;

КонецФункции

// Возвращает независимую копию стека вызовов кадра.
//
// Возвращаемое значение:
//  Массив из КадрСтекаВызовов - Независимая копия стека вызовов кадра.
Функция СтекВызовов() Экспорт

	Если Не _МестоСозданияЗагружено Тогда
		ЗаполнитьМестоСоздания();
	КонецЕсли;

	Если Не _СтекЗагружен Тогда
		ЗагрузитьСтекВызовов();
	КонецЕсли;

	Результат = Новый Массив;
	Для Каждого Кадр Из _СтекВызовов Цикл
		Результат.Добавить(Кадр);
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура УстановитьНачальноеСостояние(Ошибка)

	СервисыБиблиотекиОшибок.ПроверяющийКадрыОшибок().ПроверитьОшибку(Ошибка);

	_ИсходнаяОшибка = Ошибка;
	_Вид = ВидыКадровОшибок.ВнешняяОшибка();
	_КодОшибки = "";
	_Сообщение = Ошибка.Описание;
	_Данные = Неопределено;
	_Подсказка = "";
	_URL = "";

	Метаданные = СервисыБиблиотекиОшибок.ЧитательКадраОшибки().ПрочитатьМетаданные(Ошибка);
	Если Метаданные <> Неопределено Тогда
		_Вид = Метаданные.Вид;
		_Сообщение = Метаданные.Сообщение;
		_Данные = Метаданные.Данные;

		Если Метаданные.КодОшибки <> Неопределено Тогда
			_КодОшибки = Метаданные.КодОшибки;
		КонецЕсли;

		Метаданные.Свойство("Подсказка", _Подсказка);
		Метаданные.Свойство("URL", _URL);
	КонецЕсли;

	_МестоСоздания = Неопределено;
	_МестоСозданияЗагружено = Ложь;
	_СтекВызовов = Неопределено;
	_СтекЗагружен = Ложь;
	_НормализоватьСтек = Ложь;
	_КореньИсходников = "";

КонецПроцедуры

Процедура ЗаполнитьМестоСоздания()

	_МестоСозданияЗагружено = Истина;

	Попытка
		ИмяМодуля = _ИсходнаяОшибка.ИмяМодуля;
		НомерСтроки = _ИсходнаяОшибка.НомерСтроки;
		ИсходнаяСтрока = _ИсходнаяОшибка.ИсходнаяСтрока;
		СуффиксПроверки = СуффиксМодуляСтандартнойПроверки(ИмяМодуля);

		_НормализоватьСтек = Не ПустаяСтрока(СуффиксПроверки);
		Если _НормализоватьСтек Тогда
			_КореньИсходников = КореньИсходниковБиблиотеки(ИмяМодуля, СуффиксПроверки);
			ЗагрузитьСтекВызовов();
		Иначе
			_МестоСоздания = НовоеМестоСоздания(ИмяМодуля, НомерСтроки, ИсходнаяСтрока);
		КонецЕсли;
	Исключение
		_МестоСоздания = НовоеМестоСоздания();
		_СтекВызовов = Новый Массив;
		_СтекЗагружен = Истина;
		ЗаписатьСбойЧтенияСтека();
	КонецПопытки;

КонецПроцедуры

Процедура ЗагрузитьСтекВызовов()

	_СтекЗагружен = Истина;
	_СтекВызовов = Новый Массив;

	Попытка
		СтекКадра = _ИсходнаяОшибка.ПолучитьСтекВызовов();
		ПервыйВнешнийКадр = Неопределено;

		Для Каждого Кадр Из СтекКадра Цикл
			Если _НормализоватьСтек
				И ПервыйВнешнийКадр = Неопределено
				И ЭтоМодульБиблиотеки(Кадр.ИмяМодуля, _КореньИсходников) Тогда
				Продолжить;
			КонецЕсли;

			Если _НормализоватьСтек И ПервыйВнешнийКадр = Неопределено Тогда
				ПервыйВнешнийКадр = Кадр;
			КонецЕсли;

			_СтекВызовов.Добавить(Кадр);
		КонецЦикла;

		Если _НормализоватьСтек Тогда
			_МестоСоздания = МестоСозданияВнешнегоКадра(ПервыйВнешнийКадр);
		КонецЕсли;
	Исключение
		Если _МестоСоздания = Неопределено Тогда
			_МестоСоздания = НовоеМестоСоздания();
		КонецЕсли;
		_СтекВызовов = Новый Массив;
		ЗаписатьСбойЧтенияСтека();
	КонецПопытки;

КонецПроцедуры

Процедура ЗаписатьСбойЧтенияСтека()

	СервисыБиблиотекиОшибок.РегистраторСбоевБиблиотекиОшибок().ЗаписатьПодавленныйСбой(
		"snapshot.read_stack",
		_ИсходнаяОшибка,
		ИнформацияОбОшибке()
	);

КонецПроцедуры

Функция МестоСозданияВнешнегоКадра(Кадр)

	Если Кадр = Неопределено Тогда
		Возврат НовоеМестоСоздания();
	КонецЕсли;

	Возврат НовоеМестоСоздания(Кадр.ИмяМодуля, Кадр.НомерСтроки);

КонецФункции

Функция НовоеМестоСоздания(ИмяМодуля = "", НомерСтроки = 0, ИсходнаяСтрока = "")

	Поля = Новый Структура(
		"ИмяМодуля, НомерСтроки, ИсходнаяСтрока",
		ИмяМодуля,
		НомерСтроки,
		ИсходнаяСтрока
	);

	Возврат Новый ФиксированнаяСтруктура(Поля);

КонецФункции

Функция КореньИсходниковБиблиотеки(ИмяМодуля, Суффикс)

	Путь = НормализованныйПуть(ИмяМодуля);

	Возврат Лев(Путь, СтрДлина(Путь) - СтрДлина(Суффикс));

КонецФункции

Функция СуффиксМодуляСтандартнойПроверки(ИмяМодуля)

	Путь = НормализованныйПуть(ИмяМодуля);
	Суффикс = "модули/проверкааргументов.os";

	Если Прав(Путь, СтрДлина(Суффикс)) = Суффикс Тогда
		Возврат Суффикс;
	КонецЕсли;

	Возврат "";

КонецФункции

Функция ЭтоМодульБиблиотеки(ИмяМодуля, КореньИсходников)

	Путь = НормализованныйПуть(ИмяМодуля);

	Возврат Лев(Путь, СтрДлина(КореньИсходников)) = КореньИсходников;

КонецФункции

Функция НормализованныйПуть(Путь)

	Возврат НРег(СтрЗаменить(Путь, "\", "/"));

КонецФункции

#КонецОбласти
