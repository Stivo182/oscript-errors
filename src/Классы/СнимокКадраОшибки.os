#Использовать "../internal"

Перем _ИсходнаяОшибка; // ИнформацияОбОшибке
Перем _Вид; // Строка
Перем _КодОшибки; // Строка
Перем _Сообщение; // Строка
Перем _Данные; // Произвольный, Неопределено
Перем _Подсказка; // Строка
Перем _URL; // Строка
Перем _МестоСоздания; // ФиксированнаяСтруктура
Перем _СтекВызовов; // Массив из КадрСтекаВызовов

#Область ОбработчикиСобытий

// Создаёт снимок физического кадра ошибки.
//
// Параметры:
//  Ошибка - ИнформацияОбОшибке - Физический кадр для создания снимка.
Процедура ПриСозданииОбъекта(Ошибка)

	ПроверкаКадровОшибок.ПроверитьОшибку(Ошибка);

	УстановитьНачальноеСостояние(Ошибка);
	РаспознатьКадр(Ошибка);
	ЗаполнитьМестоСозданияИСтекВызовов(Ошибка);

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Возвращает по ссылке исходный физический кадр.
//
// Возвращаемое значение:
//  ИнформацияОбОшибке - Кадр, из которого создан снимок.
Функция ИсходнаяОшибка() Экспорт

	Возврат _ИсходнаяОшибка;

КонецФункции

// Возвращает распознанный вид кадра.
//
// Возвращаемое значение:
//  Строка - Распознанный вид кадра.
Функция Вид() Экспорт

	Возврат _Вид;

КонецФункции

// Возвращает машинный код собственного кадра.
//
// Возвращаемое значение:
//  Строка - Машинный код собственного кадра или пустая строка, если код отсутствует.
Функция КодОшибки() Экспорт

	Возврат _КодОшибки;

КонецФункции

// Возвращает описание физического кадра.
//
// Возвращаемое значение:
//  Строка - Описание физического кадра.
Функция Сообщение() Экспорт

	Возврат _Сообщение;

КонецФункции

// Возвращает по ссылке пользовательские данные собственного кадра.
//
// Возвращаемое значение:
//  Произвольный, Неопределено - Пользовательские данные собственного кадра.
Функция Данные() Экспорт

	Возврат _Данные;

КонецФункции

// Возвращает подсказку по исправлению собственного кадра.
//
// Возвращаемое значение:
//  Строка - Подсказка или пустая строка, если она отсутствует.
Функция Подсказка() Экспорт

	Возврат _Подсказка;

КонецФункции

// Возвращает адрес страницы с дополнительной информацией о собственном кадре.
//
// Возвращаемое значение:
//  Строка - URL документации или пустая строка, если он отсутствует.
Функция URL() Экспорт

	Возврат _URL;

КонецФункции

// Возвращает место создания кадра.
//
// Возвращаемое значение:
//  ФиксированнаяСтруктура:
//   * ИмяМодуля - Строка - Имя модуля или пустая строка;
//   * НомерСтроки - Число - Номер строки или 0;
//   * ИсходнаяСтрока - Строка - Исходная строка или пустая строка.
Функция МестоСоздания() Экспорт

	Возврат _МестоСоздания;

КонецФункции

// Возвращает независимую копию стека вызовов кадра.
//
// Возвращаемое значение:
//  Массив из КадрСтекаВызовов - Независимая копия стека вызовов кадра.
Функция СтекВызовов() Экспорт

	Результат = Новый Массив;
	Для Каждого Кадр Из _СтекВызовов Цикл
		Результат.Добавить(Кадр);
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура УстановитьНачальноеСостояние(Ошибка)

	_ИсходнаяОшибка = Ошибка;
	_Вид = ВидыКадровОшибок.ВнешняяОшибка();
	_КодОшибки = "";
	_Данные = Неопределено;
	_Подсказка = "";
	_URL = "";
	_Сообщение = Ошибка.Описание;
	_МестоСоздания = НовоеМестоСоздания();
	_СтекВызовов = Новый Массив;

КонецПроцедуры

Процедура РаспознатьКадр(Кадр)

	Попытка
		Параметры = Кадр.Параметры;
		Если ТипЗнч(Параметры) <> Тип("ФиксированнаяСтруктура") Тогда
			Возврат;
		КонецЕсли;

		Если Не ЭтоПоддерживаемыеМетаданныеКадра(Параметры) Тогда
			Возврат;
		КонецЕсли;

		ПрименитьМетаданныеКадра(Параметры);
	Исключение
		ЛогированиеОшибок.ЗаписатьПодавленныйСбой(
			"snapshot.read_metadata",
			Кадр,
			ИнформацияОбОшибке()
		);
	КонецПопытки;

КонецПроцедуры

Процедура ПрименитьМетаданныеКадра(Параметры)

	Подсказка = "";
	URL = "";

	_Вид = Параметры.Вид;
	_Сообщение = Параметры.Сообщение;
	_Данные = Параметры.Данные;

	Если Параметры.КодОшибки <> Неопределено Тогда
		_КодОшибки = Параметры.КодОшибки;
	КонецЕсли;

	Если Параметры.Свойство("Подсказка", Подсказка) Тогда
		_Подсказка = Подсказка;
	КонецЕсли;

	Если Параметры.Свойство("URL", URL) Тогда
		_URL = URL;
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьМестоСозданияИСтекВызовов(Ошибка)

	Попытка
		СтекКадра = Ошибка.ПолучитьСтекВызовов();
		ИмяМодуля = Ошибка.ИмяМодуля;
		НомерСтроки = Ошибка.НомерСтроки;
		ИсходнаяСтрока = Ошибка.ИсходнаяСтрока;

		СуффиксПроверки = СуффиксМодуляСтандартнойПроверки(ИмяМодуля);
		НормализоватьСтек = Не ПустаяСтрока(СуффиксПроверки);
		ПервыйВнешнийКадр = Неопределено;
		НовыйСтекВызовов = Новый Массив;

		КореньИсходников = "";
		Если НормализоватьСтек Тогда
			КореньИсходников = КореньИсходниковБиблиотеки(ИмяМодуля, СуффиксПроверки);
		КонецЕсли;

		Для Каждого Кадр Из СтекКадра Цикл
			Если НормализоватьСтек
				И ПервыйВнешнийКадр = Неопределено
				И ЭтоМодульБиблиотеки(Кадр.ИмяМодуля, КореньИсходников) Тогда
				Продолжить;
			КонецЕсли;

			Если НормализоватьСтек И ПервыйВнешнийКадр = Неопределено Тогда
				ПервыйВнешнийКадр = Кадр;
			КонецЕсли;

			НовыйСтекВызовов.Добавить(Кадр);
		КонецЦикла;

		Если НормализоватьСтек Тогда
			НовоеМесто = МестоСозданияВнешнегоКадра(ПервыйВнешнийКадр);
		Иначе
			НовоеМесто = НовоеМестоСоздания(ИмяМодуля, НомерСтроки, ИсходнаяСтрока);
		КонецЕсли;

		_МестоСоздания = НовоеМесто;
		_СтекВызовов = НовыйСтекВызовов;
	Исключение
		ЛогированиеОшибок.ЗаписатьПодавленныйСбой(
			"snapshot.read_stack",
			Ошибка,
			ИнформацияОбОшибке()
		);
	КонецПопытки;

КонецПроцедуры

Функция МестоСозданияВнешнегоКадра(Кадр)

	Если Кадр = Неопределено Тогда
		Возврат НовоеМестоСоздания();
	КонецЕсли;

	Возврат НовоеМестоСоздания(Кадр.ИмяМодуля, Кадр.НомерСтроки);

КонецФункции

Функция НовоеМестоСоздания(ИмяМодуля = "", НомерСтроки = 0, ИсходнаяСтрока = "")

	Поля = Новый Структура(
		"ИмяМодуля, НомерСтроки, ИсходнаяСтрока",
		ИмяМодуля,
		НомерСтроки,
		ИсходнаяСтрока
	);

	Возврат Новый ФиксированнаяСтруктура(Поля);

КонецФункции

Функция КореньИсходниковБиблиотеки(ИмяМодуля, Суффикс)

	Путь = НормализованныйПуть(ИмяМодуля);

	Возврат Лев(Путь, СтрДлина(Путь) - СтрДлина(Суффикс));

КонецФункции

Функция СуффиксМодуляСтандартнойПроверки(ИмяМодуля)

	Путь = НормализованныйПуть(ИмяМодуля);

	Суффиксы = Новый Массив;
	Суффиксы.Добавить("модули/проверкааргументов.os");

	Для Каждого Суффикс Из Суффиксы Цикл
		Если Прав(Путь, СтрДлина(Суффикс)) = Суффикс Тогда
			Возврат Суффикс;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

Функция ЭтоМодульБиблиотеки(ИмяМодуля, КореньИсходников)

	Путь = НормализованныйПуть(ИмяМодуля);

	Возврат Лев(Путь, СтрДлина(КореньИсходников)) = КореньИсходников;

КонецФункции

Функция НормализованныйПуть(Путь)

	Возврат НРег(СтрЗаменить(Путь, "\", "/"));

КонецФункции

// Проверяет метаданные собственного кадра на соответствие внутреннему формату.
//
// Параметры:
//  Параметры - ФиксированнаяСтруктура - Проверяемые метаданные кадра.
//
// Возвращаемое значение:
//  Булево - Истина, если метаданные поддерживаются библиотекой.
Функция ЭтоПоддерживаемыеМетаданныеКадра(Параметры)

	Маркер = Неопределено;
	ВерсияФормата = Неопределено;
	Вид = Неопределено;
	КодОшибки = Неопределено;
	Сообщение = "";
	Данные = Неопределено;
	Подсказка = "";
	URL = "";

	ВсеПоляПрисутствуют = Параметры.Свойство("Маркер", Маркер)
		И Параметры.Свойство("ВерсияФормата", ВерсияФормата)
		И Параметры.Свойство("Вид", Вид)
		И Параметры.Свойство("КодОшибки", КодОшибки)
		И Параметры.Свойство("Данные", Данные)
		И Параметры.Свойство("Сообщение", Сообщение);

	Если Не ВсеПоляПрисутствуют
		Или Не ПроверкаКадровОшибок.КорректноеСообщение(Сообщение) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Параметры.Свойство("Подсказка", Подсказка)
		И Не ПроверкаКадровОшибок.КорректнаяПодсказка(Подсказка) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Параметры.Свойство("URL", URL)
		И Не ПроверкаКадровОшибок.КорректныйURL(URL) Тогда
		Возврат Ложь;
	КонецЕсли;

	КорректныйМаркер = ТипЗнч(Маркер) = Тип("Строка")
		И Маркер = ФорматКадраОшибки.МаркерМетаданных();

	Если Не КорректныйМаркер Тогда
		Возврат Ложь;
	КонецЕсли;

	КорректнаяВерсия = ТипЗнч(ВерсияФормата) = Тип("Число")
		И ВерсияФормата = ФорматКадраОшибки.ВерсияФормата();

	Если Не КорректнаяВерсия Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Вид = ВидыКадровОшибок.Ошибка() Тогда
		Возврат ПроверкаКадровОшибок.КорректныйКодОшибки(КодОшибки);
	КонецЕсли;

	Если Вид = ВидыКадровОшибок.Контекст() Тогда
		Возврат КодОшибки = Неопределено;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

#КонецОбласти
