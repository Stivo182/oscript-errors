	ПовторноВыброшеннаяОшибка = ПомощникТестированияОшибок.ПовторноВыброшеннаяОшибка(ИсходнаяОшибка);

	// Действие и Проверка
	Ожидаем.Что(ДиагностикаОшибок.ЭтоОшибка(ПовторноВыброшеннаяОшибка,"storage.read_failed")).Равно(Истина);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СчитатьНеподдерживаемыеКонвертыВнешними() Экспорт

	// Подготовка
	ВнутренняяОшибка = ФабрикаОшибок.Создать("core.failed", "Корневая ошибка");
	Образец = ФабрикаОшибок.Создать("sample.error", "Образец");
	ЧужойМаркер = ПомощникТестированияОшибок.ОшибкаСЧужимМаркером(Образец, ВнутренняяОшибка);
	ПоврежденныйКонверт = ПомощникТестированияОшибок.ОшибкаСПоврежденнымКонвертом(Образец, ЧужойМаркер);

	// Действие и Проверка
	Ожидаем.Что(ДиагностикаОшибок.ПолучитьТипОшибки(ПоврежденныйКонверт)).Равно("core.failed");
	Ожидаем.Что(ДиагностикаОшибок.ЭтоОшибка(ПоврежденныйКонверт, "foreign.hidden_error")).Равно(Ложь);
	Ожидаем.Что(ДиагностикаОшибок.Контексты(ПоврежденныйКонверт).Количество()).Равно(0);
	Ожидаем.Что(ДиагностикаОшибок.Цепочка(ПоврежденныйКонверт).Количество()).Равно(3);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОграничитьПросмотрШестьюдесятьюЧетырьмяКадрами() Экспорт

	// Подготовка
	ЦепочкаИз64Кадров = ПомощникТестированияОшибок.ДлиннаяЦепочка(64);
	ЦепочкаИз65Кадров = ПомощникТестированияОшибок.ДлиннаяЦепочка(65);

	// Действие
	Кадры64 = ДиагностикаОшибок.Цепочка(ЦепочкаИз64Кадров.Ошибка);
	Кадры65 = ДиагностикаОшибок.Цепочка(ЦепочкаИз65Кадров.Ошибка);

	// Проверка
	Ожидаем.Что(Кадры64.Количество()).Равно(64);
	Ожидаем.Что(Кадры64[63]).Равно(ЦепочкаИз64Кадров.Корень);
	Ожидаем.Что(Кадры65.Количество()).Равно(64);
	Ожидаем.Что(Кадры65[63] = ЦепочкаИз65Кадров.Корень).Равно(Ложь);
	Ожидаем.Что(ДиагностикаОшибок.КорневаяПричина(
		ЦепочкаИз65Кадров.Ошибка
	)).Равно(Кадры65[63]);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьНеверныйТипВходногоАргумента() Экспорт

	// Подготовка
	ПараметрыБезТипа = Новый Массив;
	ПараметрыБезТипа.Добавить("не ошибка");
	ПараметрыСТипом = Новый Массив;
	ПараметрыСТипом.Добавить("не ошибка");
	ПараметрыСТипом.Добавить("core.failed");

	// Действие и Проверка
	ПроверитьНеверныйТипВходногоАргумента("ПолучитьТипОшибки", ПараметрыБезТипа);
	ПроверитьНеверныйТипВходногоАргумента("ЭтоОшибка", ПараметрыСТипом);
	ПроверитьНеверныйТипВходногоАргумента("НайтиОшибку", ПараметрыСТипом);
	ПроверитьНеверныйТипВходногоАргумента("Данные", ПараметрыБезТипа);
	ПроверитьНеверныйТипВходногоАргумента("Контексты", ПараметрыБезТипа);
	ПроверитьНеверныйТипВходногоАргумента("Цепочка", ПараметрыБезТипа);
	ПроверитьНеверныйТипВходногоАргумента("КорневаяПричина", ПараметрыБезТипа);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьНекорректныйИскомыйТипОшибки() Экспорт

	// Подготовка
	Ошибка = ФабрикаОшибок.Создать("core.failed", "Ошибка");
	Параметры = Новый Массив;
	Параметры.Добавить(Ошибка);
	Параметры.Добавить("Core.Not-Failed");

	// Действие и Проверка
	Ожидаем.Что(ДиагностикаОшибок)
		.Метод("ЭтоОшибка", Параметры)
		.ВыбрасываетИсключение("Тип ошибки имеет неверный формат");
	Ожидаем.Что(ДиагностикаОшибок)
		.Метод("НайтиОшибку", Параметры)
		.ВыбрасываетИсключение("Тип ошибки имеет неверный формат");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьПервуюПодсказкуПоЦепочке() Экспорт

	// Подготовка
	ВнутренняяОшибка = ФабрикаОшибок.Создать(
		"network.unavailable",
		"Сеть недоступна",
		Неопределено,
		"Проверьте подключение"
	);
	ВнешняяОшибка = ФабрикаОшибок.Обернуть(
		ВнутренняяОшибка,
		"http.proxy_error",
		"Ошибка прокси",
		Неопределено,
		"Проверьте настройки прокси"
	);

	// Действие
	Подсказка = ДиагностикаОшибок.Подсказка(ВнешняяОшибка);

	// Проверка
	Ожидаем.Что(Подсказка).Равно("Проверьте настройки прокси");

КонецПроцедуры

