#Использовать asserts
#Использовать "../src"

#Область Тесты

&Тест
Процедура ТестДолжен_ВернутьУниверсальныйКонструкторОшибки() Экспорт

	// Действие
	Конструктор = КонструкторыОшибок.Создать("config.invalid", "Ошибка конфигурации", 42);

	// Проверка
	Ожидаем.Что(ТипЗнч(Конструктор)).Равно(Тип("КонструкторОшибки"));
	Снимок = Новый СнимокКадраОшибки(Конструктор.Построить());
	Ожидаем.Что(Снимок.КодОшибки()).Равно("config.invalid");
	Ожидаем.Что(Снимок.Данные()).Равно(42);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПозволитьДобавитьСтруктурированныеДанные() Экспорт

	// Действие
	Ошибка = КонструкторыОшибок.Создать("config.invalid", "Ошибка конфигурации")
		.Данные("Формат", "JSON")
		.Построить();

	// Проверка
	Ожидаем.Что((Новый СнимокКадраОшибки(Ошибка)).Данные().Формат).Равно("JSON");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьИменованныйКонструкторОшибки() Экспорт

	// Действие
	Конструктор = КонструкторыОшибок.РесурсНеНайден("application.json");

	// Проверка
	Ожидаем.Что(ТипЗнч(Конструктор)).Равно(Тип("КонструкторОшибки"));
	Снимок = Новый СнимокКадраОшибки(Конструктор.Построить());
	Ожидаем.Что(Снимок.КодОшибки()).Равно("resource.not_found");
	Ожидаем.Что(Снимок.Данные().ИмяРесурса).Равно("application.json");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПредоставитьПолноеЗеркалоИменованныхФабрик() Экспорт

	// Действие
	Конструкторы = Новый Массив;
	Конструкторы.Добавить(КонструкторыОшибок.НеверныйТипАргумента("Порт", "Число", "80"));
	Конструкторы.Добавить(КонструкторыОшибок.АргументНеЗаполнен("Адрес"));
	Конструкторы.Добавить(КонструкторыОшибок.НедопустимоеЗначениеАргумента("Порт", "быть положительным"));
	Конструкторы.Добавить(КонструкторыОшибок.АргументВнеДиапазона("Порт", "от 1 до 65535"));
	Конструкторы.Добавить(КонструкторыОшибок.ОперацияОтменена("Загрузка"));
	Конструкторы.Добавить(КонструкторыОшибок.ОперацияВНедопустимомСостоянии("Загрузка"));
	Конструкторы.Добавить(КонструкторыОшибок.ОперацияНеРеализована("Загрузка"));
	Конструкторы.Добавить(КонструкторыОшибок.ОперацияНеПоддерживается("Загрузка"));
	Конструкторы.Добавить(КонструкторыОшибок.ИстеклоВремяОжиданияОперации("Загрузка"));
	Конструкторы.Добавить(КонструкторыОшибок.ОперацияНедоступна("Загрузка"));
	Конструкторы.Добавить(КонструкторыОшибок.ДоступЗапрещен("application.json"));
	Конструкторы.Добавить(КонструкторыОшибок.РесурсНеНайден("application.json"));
	Конструкторы.Добавить(КонструкторыОшибок.РесурсУжеСуществует("application.json"));
	Конструкторы.Добавить(КонструкторыОшибок.РесурсУжеИспользуется("application.json"));
	Конструкторы.Добавить(КонструкторыОшибок.РесурсЗакрыт("application.json"));
	Конструкторы.Добавить(КонструкторыОшибок.РесурсИсчерпан("пул"));
	Конструкторы.Добавить(КонструкторыОшибок.РесурсНеПуст("каталог"));
	Конструкторы.Добавить(КонструкторыОшибок.ВозможностьНедоступна("TLS"));
	Конструкторы.Добавить(КонструкторыОшибок.СоединениеОтклонено("db.example.org"));
	Конструкторы.Добавить(КонструкторыОшибок.СоединениеСброшено("db.example.org"));
	Конструкторы.Добавить(КонструкторыОшибок.СоединениеЗакрыто("db.example.org"));
	Конструкторы.Добавить(КонструкторыОшибок.ИстеклоВремяОжиданияСоединения("db.example.org"));
	Конструкторы.Добавить(КонструкторыОшибок.СетевоеИмяНеНайдено("db.example.org"));
	Конструкторы.Добавить(КонструкторыОшибок.НекорректныеДанные("Конфигурация"));
	Конструкторы.Добавить(КонструкторыОшибок.ДанныеСлишкомБольшие("Пакет", "10 МБ"));
	Конструкторы.Добавить(КонструкторыОшибок.ДанныеПовреждены("Архив"));
	Конструкторы.Добавить(КонструкторыОшибок.НевернаяКодировкаДанных("Файл", "UTF-8"));
	Конструкторы.Добавить(КонструкторыОшибок.КодировкаНеПоддерживается("UTF-32"));
	Конструкторы.Добавить(КонструкторыОшибок.НеизвестнаяКодировка("X-UNKNOWN"));
	Конструкторы.Добавить(КонструкторыОшибок.НарушенВнутреннийИнвариант("Счётчик неотрицателен"));


	Ошибки = Новый Массив;
	Ошибки.Добавить(ФабрикаОшибок.НеверныйТипАргумента("Порт", "Число", "80"));
	Ошибки.Добавить(ФабрикаОшибок.АргументНеЗаполнен("Адрес"));
	Ошибки.Добавить(ФабрикаОшибок.НедопустимоеЗначениеАргумента("Порт", "быть положительным"));
	Ошибки.Добавить(ФабрикаОшибок.АргументВнеДиапазона("Порт", "от 1 до 65535"));
	Ошибки.Добавить(ФабрикаОшибок.ОперацияОтменена("Загрузка"));
	Ошибки.Добавить(ФабрикаОшибок.ОперацияВНедопустимомСостоянии("Загрузка"));
	Ошибки.Добавить(ФабрикаОшибок.ОперацияНеРеализована("Загрузка"));
	Ошибки.Добавить(ФабрикаОшибок.ОперацияНеПоддерживается("Загрузка"));
	Ошибки.Добавить(ФабрикаОшибок.ИстеклоВремяОжиданияОперации("Загрузка"));
	Ошибки.Добавить(ФабрикаОшибок.ОперацияНедоступна("Загрузка"));
	Ошибки.Добавить(ФабрикаОшибок.ДоступЗапрещен("application.json"));
	Ошибки.Добавить(ФабрикаОшибок.РесурсНеНайден("application.json"));
	Ошибки.Добавить(ФабрикаОшибок.РесурсУжеСуществует("application.json"));
	Ошибки.Добавить(ФабрикаОшибок.РесурсУжеИспользуется("application.json"));
	Ошибки.Добавить(ФабрикаОшибок.РесурсЗакрыт("application.json"));
	Ошибки.Добавить(ФабрикаОшибок.РесурсИсчерпан("пул"));
	Ошибки.Добавить(ФабрикаОшибок.РесурсНеПуст("каталог"));
	Ошибки.Добавить(ФабрикаОшибок.ВозможностьНедоступна("TLS"));
	Ошибки.Добавить(ФабрикаОшибок.СоединениеОтклонено("db.example.org"));
	Ошибки.Добавить(ФабрикаОшибок.СоединениеСброшено("db.example.org"));
	Ошибки.Добавить(ФабрикаОшибок.СоединениеЗакрыто("db.example.org"));
	Ошибки.Добавить(ФабрикаОшибок.ИстеклоВремяОжиданияСоединения("db.example.org"));
	Ошибки.Добавить(ФабрикаОшибок.СетевоеИмяНеНайдено("db.example.org"));
	Ошибки.Добавить(ФабрикаОшибок.НекорректныеДанные("Конфигурация"));
	Ошибки.Добавить(ФабрикаОшибок.ДанныеСлишкомБольшие("Пакет", "10 МБ"));
	Ошибки.Добавить(ФабрикаОшибок.ДанныеПовреждены("Архив"));
	Ошибки.Добавить(ФабрикаОшибок.НевернаяКодировкаДанных("Файл", "UTF-8"));
	Ошибки.Добавить(ФабрикаОшибок.КодировкаНеПоддерживается("UTF-32"));
	Ошибки.Добавить(ФабрикаОшибок.НеизвестнаяКодировка("X-UNKNOWN"));
	Ошибки.Добавить(ФабрикаОшибок.НарушенВнутреннийИнвариант("Счётчик неотрицателен"));

	// Проверка
	Ожидаем.Что(Конструкторы.Количество()).Равно(30);
	Ожидаем.Что(Ошибки.Количество()).Равно(Конструкторы.Количество());
	Для Индекс = 0 По Конструкторы.ВГраница() Цикл
		ПроверитьРавенствоСтандартныхОшибок(Конструкторы[Индекс], Ошибки[Индекс]);
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьКонструкторыКонтекстаИОбертывания() Экспорт

	// Подготовка
	Причина = ФабрикаОшибок.Создать("config.invalid", "Ошибка конфигурации");

	// Действие
	Контекст = КонструкторыОшибок.СКонтекстом(Причина, "Загрузка конфигурации");
	Обертывание = КонструкторыОшибок.Обернуть(Причина, "application.failed", "Ошибка приложения");

	// Проверка
	Ожидаем.Что(ТипЗнч(Контекст)).Равно(Тип("КонструкторОшибки"));
	Ожидаем.Что(ТипЗнч(Обертывание)).Равно(Тип("КонструкторОшибки"));
	Ожидаем.Что(Контекст.Построить().Причина).Равно(Причина);
	Ожидаем.Что(Обертывание.Построить().Причина).Равно(Причина);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьРавенствоСтандартныхОшибок(Конструктор, Ошибка)

	Ожидаем.Что(ТипЗнч(Конструктор)).Равно(Тип("КонструкторОшибки"));
	СнимокКонструктора = Новый СнимокКадраОшибки(Конструктор.Построить());
	СнимокФабрики = Новый СнимокКадраОшибки(Ошибка);

	Ожидаем.Что(СнимокКонструктора.Вид()).Равно(СнимокФабрики.Вид());
	Ожидаем.Что(СнимокКонструктора.КодОшибки()).Равно(СнимокФабрики.КодОшибки());
	Ожидаем.Что(СнимокКонструктора.Сообщение()).Равно(СнимокФабрики.Сообщение());
	Ожидаем.Что(СнимокКонструктора.Подсказка()).Равно(СнимокФабрики.Подсказка());
	Ожидаем.Что(СнимокКонструктора.URL()).Равно(СнимокФабрики.URL());

	ДанныеКонструктора = СнимокКонструктора.Данные();
	ДанныеФабрики = СнимокФабрики.Данные();
	Ожидаем.Что(ДанныеКонструктора.Количество()).Равно(ДанныеФабрики.Количество());
	Для Каждого Элемент Из ДанныеКонструктора Цикл
		Ожидаем.Что(ДанныеФабрики[Элемент.Ключ]).Равно(Элемент.Значение);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
