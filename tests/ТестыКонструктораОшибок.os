&Тест
Процедура ТестДолжен_ОтклонитьТипОшибкиУКонтекстногоКадра() Экспорт

	// Действие и Проверка
	Ожидаем.Что(ЭтотОбъект)
		.Метод("ПостроитьКонтекстСТипом")
		.ВыбрасываетИсключение(
			НСтр(
				"ru = 'Тип ошибки контекстного кадра должен быть равен Неопределено';"
				+ "en = 'Context frame error type must be undefined'"
			)
		);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПотребоватьПричинуДляКонтекстногоКадра() Экспорт

	// Действие и Проверка
	Ожидаем.Что(ЭтотОбъект)
		.Метод("ПостроитьКонтекстБезПричины")
		.ВыбрасываетИсключение(
			НСтр("ru = 'Контекстный кадр должен иметь причину'; en = 'Context frame must have a cause'")
		);

КонецПроцедуры

&Тест
Процедура ТестДолжен_КлассифицироватьНеподдерживаемыйВидКадра() Экспорт

	// Подготовка
	Ошибка = Неопределено;

	// Действие
	Попытка
		ОшибкаКадра = Новый КонструкторОшибки("http.proxy_error", "Ошибка прокси", "НеизвестныйВид").Построить();
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;

	// Проверка
	ПроверитьКонтрактноеИсключение(
		Ошибка,
		"argument.invalid_value",
		"Вид",
		"быть поддерживаемым видом кадра ошибки"
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_КлассифицироватьТипОшибкиКонтекстногоКадра() Экспорт

	// Подготовка
	Причина = ФабрикаОшибок.Создать("network.unavailable", "Сеть недоступна");
	Ошибка = Неопределено;

	// Действие
	Попытка
		ОшибкаКадра = Новый КонструкторОшибки("http.proxy_error", "Ошибка прокси", ВидыКадровОшибок.Контекст)
			.Причина(Причина)
			.Построить();
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;

	// Проверка
	ПроверитьКонтрактноеИсключение(
		Ошибка,
		"argument.invalid_value",
		"ТипОшибки",
		"быть равен Неопределено"
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_КлассифицироватьОтсутствующуюПричинуКонтекстногоКадра() Экспорт

	// Подготовка
	Ошибка = Неопределено;

	// Действие
	Попытка
		ОшибкаКадра = Новый КонструкторОшибки(Неопределено, "Контекст", ВидыКадровОшибок.Контекст).Построить();
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;

	// Проверка
	ПроверитьКонтрактноеИсключение(Ошибка, "argument.required", "Причина", "");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПостроитьСПодсказкой(Подсказка) Экспорт

	Возврат Новый КонструкторОшибки("http.proxy_error", "Ошибка прокси")
		.Подсказка(Подсказка)
		.Построить();

КонецФункции

Процедура ПроверитьКонтрактноеИсключение(Ошибка, ОжидаемыйТипОшибки, ИмяАргумента, Ожидание)

	Если Ошибка = Неопределено Тогда
		ВызватьИсключение "Ожидалось контрактное исключение конструктора";
	КонецЕсли;

	Снимок = Новый СнимокКадраОшибки(Ошибка);
	Ожидаем.Что(Снимок.ТипОшибки()).Равно(ОжидаемыйТипОшибки);
	Ожидаем.Что(Снимок.Данные().ИмяАргумента).Равно(ИмяАргумента);

	Если Ожидание <> "" Тогда
		Ожидаем.Что(Снимок.Данные().Ожидание).Равно(Ожидание);
	КонецЕсли;

КонецПроцедуры

Функция ПостроитьСТипомОшибки(ТипОшибки) Экспорт

	Возврат Новый КонструкторОшибки(ТипОшибки, "Ошибка прокси").Построить();

КонецФункции

Функция ПостроитьССообщением(Сообщение) Экспорт

	Возврат Новый КонструкторОшибки("http.proxy_error", Сообщение).Построить();

КонецФункции

Функция ПостроитьСПричиной(Причина) Экспорт

	Возврат Новый КонструкторОшибки("http.proxy_error", "Ошибка прокси")
		.Причина(Причина)
		.Построить();

КонецФункции

Функция ПостроитьСВидом(Вид) Экспорт

	Возврат Новый КонструкторОшибки("http.proxy_error", "Ошибка прокси", Вид).Построить();

КонецФункции

Функция ПостроитьКонтекстСТипом() Экспорт

	Причина = ФабрикаОшибок.Создать("network.unavailable", "Сеть недоступна");
	Возврат Новый КонструкторОшибки("http.proxy_error", "Ошибка прокси", ВидыКадровОшибок.Контекст)
		.Причина(Причина)
		.Построить();

КонецФункции

Функция ПостроитьКонтекстБезПричины() Экспорт

	Возврат Новый КонструкторОшибки(Неопределено, "Ошибка прокси", ВидыКадровОшибок.Контекст)
		.Построить();

КонецФункции

#КонецОбласти
