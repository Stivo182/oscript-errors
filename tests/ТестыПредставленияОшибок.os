&Тест
Процедура ТестДолжен_ВывестиМестоИсходнуюСтрокуИСтекРеальнойОшибки() Экспорт

	// Подготовка
	Цепочка = ПомощникТестированияОшибок.ЦепочкаСРазнымиМестамиСоздания();
	ВнешнийКадр = Новый СнимокКадраОшибки(Цепочка.ВнешнийКадр);
	ВнутреннийКадр = Новый СнимокКадраОшибки(Цепочка.ВнутреннийКадр);

	// Действие
	Представление = ДиагностикаОшибок.ПодробноеПредставление(Цепочка.Ошибка);
	
	// Проверка
	Ожидаем.Что(Представление).Содержит(
		"Не удалось загрузить настройки приложения" + Символы.ПС
			+ "Место: " + МестоКадра(ВнешнийКадр) + Символы.ПС
			+ "Исходная строка: " + СокрЛП(ВнешнийКадр.ИсходнаяСтрока())
	);
	Ожидаем.Что(Представление).Содержит(
		"Причина:" + Символы.ПС
			+ "  Файл settings.json не найден" + Символы.ПС
			+ "    Место: " + МестоКадра(ВнутреннийКадр) + Символы.ПС
			+ "    Исходная строка: " + СокрЛП(ВнутреннийКадр.ИсходнаяСтрока())
	);
	Ожидаем.Что(Представление).Содержит(
		"Стек вызовов:" + Символы.ПС
			+ "  1: " + Строка(ВнешнийКадр.Стек()[0]) + Символы.ПС
			+ "  2: " + Строка(ВнешнийКадр.Стек()[1])
	);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СмешаннаяЦепочка()

	ДанныеВнутреннейОшибки = Новый Структура("Путь", "config.json");
	ВнутренняяОшибка = ФабрикаОшибок.Создать("fs.file_not_found", "Файл не найден", ДанныеВнутреннейОшибки);
	ВнешняяОшибка = ПомощникТестированияОшибок.ВнешняяОшибка(
		"В файле конфигурации обнаружен некорректный JSON",
		ВнутренняяОшибка
	);
	ЭффективнаяОшибка = ФабрикаОшибок.Обернуть(
		ВнешняяОшибка,
		"config.load_failed",
		"Не удалось загрузить конфигурацию",
		Новый Структура("Формат", "JSON")
	);
	Контекст = ФабрикаОшибок.СКонтекстом(
		ЭффективнаяОшибка,
		"Загрузка конфигурации",
		Новый Структура("Операция", "Загрузка")
	);

	Возврат Новый Структура("Ошибка", Контекст);

КонецФункции

Функция ДлиннаяЦепочка(Длина)

	Ошибка = ПомощникТестированияОшибок.ВнешняяОшибка("Внешний кадр 1");

	Для НомерКадра = 2 По Длина Цикл
		Ошибка = ПомощникТестированияОшибок.ВнешняяОшибка(
			СтрШаблон("Внешний кадр %1", НомерКадра),
			Ошибка
		);
	КонецЦикла;

	Возврат Новый Структура("Ошибка", Ошибка);

КонецФункции

Функция ПредставлениеУсеченнойЦепочки(Длина)

	Причины = Новый Массив;
	Для НомерПричины = 1 По 63 Цикл
		НомерВнешнегоКадра = Длина - НомерПричины;
		Причины.Добавить(
			"  " + Строка(НомерПричины) + ": Внешний кадр " + Строка(НомерВнешнегоКадра)
		);
	КонецЦикла;

	Возврат "Внешний кадр " + Строка(Длина) + Символы.ПС + Символы.ПС
		+ "Причина:" + Символы.ПС
		+ СоединитьСтроки(Причины, Символы.ПС) + Символы.ПС + Символы.ПС
		+ "Цепочка причин усечена: показано 64 кадра";

КонецФункции

Функция ПредставлениеКонтекстовБезПричины()

	Строки = Новый Массив;
	Строки.Добавить("Контекст без просмотренной причины:");
	Номер = 64;
	Пока Номер >= 1 Цикл
		Строки.Добавить("  - Контекст " + Строка(Номер));
		Номер = Номер - 1;
	КонецЦикла;
	Строки.Добавить("");
	Строки.Добавить("Цепочка причин усечена: показано 64 кадра");

	Возврат СоединитьСтроки(Строки, Символы.ПС);

КонецФункции

Функция МестоКадра(Снимок)

	Возврат Снимок.ИмяМодуля() + ":" + Строка(Снимок.НомерСтроки());

КонецФункции

Функция СоединитьСтроки(Строки, Разделитель)

	Результат = "";
	Для Каждого ТекущаяСтрока Из Строки Цикл
		Если Не ПустаяСтрока(Результат) Тогда
			Результат = Результат + Разделитель;
		КонецЕсли;
		Результат = Результат + ТекущаяСтрока;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция Пробелы(Количество)

	Результат = "";
	Для Номер = 1 По Количество Цикл
		Результат = Результат + " ";
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти
