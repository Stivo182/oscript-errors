&Тест
Процедура ТестДолжен_ВыровнятьПродолжениеДесятойПодсказки() Экспорт

	// Подготовка
	Снимки = Новый Массив;
	Для Номер = 1 По 10 Цикл
		Подсказка = "Подсказка " + Строка(Номер);
		Если Номер = 10 Тогда
			Подсказка = "Первый шаг" + Символы.ПС + "Второй шаг";
		КонецЕсли;
		Снимки.Добавить(Новый ТестовыйСнимокКадраОшибки(
			Новый Структура(
				"Вид, ТипОшибки, Сообщение, Подсказка",
				ВидыКадровОшибок.Ошибка,
				"service.failed",
				"Ошибка сервиса " + Строка(Номер),
				Подсказка
			)
		));
	КонецЦикла;

	// Действие
	Представление = ФорматированиеПредставленияОшибок.ПодробноеПредставление(Снимки, Ложь);

	// Проверка
	Ожидаем.Что(Представление).Содержит(
		"  10: Первый шаг" + Символы.ПС + "      Второй шаг"
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВывестиИсходнуюСтрокуТолькоДляВнешнегоКадра() Экспорт

	// Подготовка
	Снимки = Новый Массив;
	Снимки.Добавить(Новый ТестовыйСнимокКадраОшибки(
		Новый Структура(
			"Вид, Сообщение, ИсходнаяСтрока",
			ВидыКадровОшибок.Контекст,
			"Выполнение операции",
			"ВыполнитьОперацию();"
		)
	));
	Снимки.Добавить(Новый ТестовыйСнимокКадраОшибки(
		Новый Структура(
			"Вид, ТипОшибки, Сообщение, ИсходнаяСтрока",
			ВидыКадровОшибок.Ошибка,
			"core.failed",
			"Операция завершилась ошибкой",
			"ВызватьИсключение;"
		)
	));
	Снимки.Добавить(Новый ТестовыйСнимокКадраОшибки(
		Новый Структура(
			"Вид, Сообщение, ИсходнаяСтрока",
			ВидыКадровОшибок.ВнешняяОшибка,
			"Внешняя причина",
