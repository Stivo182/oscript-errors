КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьНечисловойПриоритет() Экспорт

	// Подготовка
	Правило = Новый ПравилоКлассификацииОшибок()
		.СовпадаетС("Тестовое сообщение")
		.СПриоритетом("Высокий")
		.КлассифицируетКак(
			"test.invalid",
			"Тестовая ошибка"
		);

	// Действие и Проверка
	ПроверитьНекорректноеПравило(
		Правило,
		КодыСтандартныхОшибок.НеверныйТипАргумента()
	);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ИндексСПравилом(Правило)

	Правила = Новый Массив;
	Правила.Добавить(Правило);
	Возврат Новый ИндексПравилКлассификацииОшибок(Правила, "ТестовыеПравила");

КонецФункции

Функция Кадр(
	Описание,
	НативныйТип = Неопределено,
	РазрешенДляПоиска = Истина,
	ВнутреннееСообщение = Неопределено
)

	Если ВнутреннееСообщение = Неопределено Тогда
		ВнутреннееСообщение = Описание;
	КонецЕсли;

	Возврат Новый ФиксированнаяСтруктура(
		Новый Структура(
			"Описание, НативныйТип, РазрешенДляПоиска, ВнутреннееСообщение",
			Описание,
			НативныйТип,
			РазрешенДляПоиска,
			ВнутреннееСообщение
		)
	);

КонецФункции

Процедура ПроверитьНекорректноеПравило(Правило, ОжидаемыйКодОшибки)

	Ошибка = Неопределено;
	Попытка
		Индекс = ИндексСПравилом(Правило);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;

	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Ошибка)).Равно(ОжидаемыйКодОшибки);

КонецПроцедуры

#КонецОбласти
