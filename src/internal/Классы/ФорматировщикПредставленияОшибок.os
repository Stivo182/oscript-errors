Перем _ФорматировщикЗначений; // ФорматировщикЗначенийОшибки
Перем _РегистраторСбоев; // РегистраторСбоевБиблиотекиОшибок
Перем _ПоддерживаемыеРазделы; // ФиксированныйМассив из Строка

#Область ОбработчикиСобытий

// Создает форматировщик представлений ошибок.
//
// Параметры:
//  ФорматировщикЗначений - ФорматировщикЗначенийОшибки - Форматировщик произвольных значений.
//  РегистраторСбоев - РегистраторСбоевБиблиотекиОшибок - Регистратор подавленных сбоев.
Процедура ПриСозданииОбъекта(ФорматировщикЗначений, РегистраторСбоев)

	_ФорматировщикЗначений = ФорматировщикЗначений;
	_РегистраторСбоев = РегистраторСбоев;
	_ПоддерживаемыеРазделы = Новый ФиксированныйМассив(
		СтрРазделить(
			"current,causes,hints,urls,uninspected_contexts,truncation,stack",
			",",
			Ложь
		)
	);

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Формирует строки ограниченного представления произвольного значения.
//
// Параметры:
//  Значение - Произвольный - Представляемое значение.
//  Отступ - Число - Количество пробелов перед каждой строкой.
//
// Возвращаемое значение:
//  Массив из Строка - Новые строки представления.
Функция СтрокиДанных(Значение, Отступ = 0) Экспорт

	Возврат _ФорматировщикЗначений.Строки(Значение, Отступ);

КонецФункции

// Формирует строки общего стека вызовов и нумерует их, если строк больше одной.
//
// Параметры:
//  Стек - Массив - Представляемый стек вызовов.
//  Отступ - Число - Количество пробелов перед каждой строкой.
//
// Возвращаемое значение:
//  Массив из Строка - Новые строки представления стека вызовов.
Функция СтрокиСтекаВызовов(Стек, Отступ = 0) Экспорт

	Представления = ПредставленияЭлементовСтека(Стек);
	Результат = Новый Массив;
	Нумеровать = Представления.Количество() > 1;

	Для Номер = 0 По Представления.ВГраница() Цикл
		Маркер = "";
		Если Нумеровать Тогда
			Маркер = Строка(Номер + 1) + ": ";
		КонецЕсли;
		_ФорматировщикЗначений.ДобавитьЗначениеСМаркером(Результат, Отступ, Маркер, Представления[Номер]);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Формирует краткое представление текущего кадра.
//
// Параметры:
//  Снимки - Массив из СнимокКадраОшибки - Снимки от внешнего кадра к корневому.
//  ЭффективнаяОшибка - СнимокКадраОшибки, Неопределено - Эффективная ошибка цепочки.
//
// Возвращаемое значение:
//  Строка - Текущий кадр с эффективной ошибкой для контекста или внешней обёртки.
Функция КраткоеПредставление(Снимки, ЭффективнаяОшибка = Неопределено) Экспорт

	Если Снимки.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	КодЭффективнойОшибки = Неопределено;
	СообщениеЭффективнойОшибки = "";
	ЗаполнитьЭффективнуюОшибку(
		ЭффективнаяОшибка,
		КодЭффективнойОшибки,
		СообщениеЭффективнойОшибки
	);

	Снимок = Снимки[0];

	Возврат КраткоеПредставлениеКадра(
		Снимок.Вид(),
		Снимок.КодОшибки(),
		Снимок.Сообщение(),
		КодЭффективнойОшибки,
		СообщениеЭффективнойОшибки
	);

КонецФункции

// Формирует краткое представление полей одного кадра без чтения цепочки причин.
//
// Параметры:
//  Вид - Строка - Вид кадра.
//  КодОшибки - Строка, Неопределено - Машинный код ошибки.
//  Сообщение - Строка - Сообщение кадра.
//  КодЭффективнойОшибки - Строка, Неопределено - Код эффективной ошибки цепочки.
//  СообщениеЭффективнойОшибки - Строка - Сообщение эффективной ошибки цепочки.
//
// Возвращаемое значение:
//  Строка - Представление кадра с эффективной ошибкой для контекста или внешней обёртки.
Функция КраткоеПредставлениеКадра(
	Вид,
	КодОшибки,
	Сообщение,
	КодЭффективнойОшибки = Неопределено,
	СообщениеЭффективнойОшибки = ""
) Экспорт

	Если Вид = ВидыКадровОшибок.Ошибка() Тогда
		Возврат СтрШаблон("%1: %2", КодОшибки, Сообщение);
	КонецЕсли;

	Если (Вид = ВидыКадровОшибок.Контекст()
		Или Вид = ВидыКадровОшибок.ВнешняяОшибка())
		И КодЭффективнойОшибки <> Неопределено Тогда
		Возврат СтрШаблон(
			"%1: %2 -> %3",
			КодЭффективнойОшибки,
			Сообщение,
			СообщениеЭффективнойОшибки
		);
	КонецЕсли;

	Возврат Сообщение;

КонецФункции

// Формирует полный диагностический отчёт по просмотренным физическим кадрам.
//
// Параметры:
//  Снимки - Массив из СнимокКадраОшибки - Снимки от внешнего кадра к корневому.
//  Усечена - Булево - Признак наличия непросмотренного продолжения цепочки.
//
// Возвращаемое значение:
//  Строка - Полное диагностическое представление.
Функция ДиагностическоеПредставление(Снимки, Усечена) Экспорт

	Возврат СформироватьИзРазделов(Снимки, Усечена, ПоддерживаемыеРазделы());

КонецФункции

// Формирует пользовательское представление текущего кадра.
//
// Параметры:
//  Снимки - Массив из СнимокКадраОшибки - Снимки от внешнего кадра к корневому.
//  ЭффективнаяОшибка - СнимокКадраОшибки, Неопределено - Эффективная ошибка цепочки.
//
// Возвращаемое значение:
//  Строка - Текущий кадр, эффективная ошибка для обёртки, подсказка и URL текущего кадра.
Функция ПользовательскоеПредставление(Снимки, ЭффективнаяОшибка = Неопределено) Экспорт

	Если Снимки.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	КодЭффективнойОшибки = Неопределено;
	СообщениеЭффективнойОшибки = "";
	ЗаполнитьЭффективнуюОшибку(
		ЭффективнаяОшибка,
		КодЭффективнойОшибки,
		СообщениеЭффективнойОшибки
	);

	Снимок = Снимки[0];

	Возврат ПользовательскоеПредставлениеКадра(
		Снимок.Вид(),
		Снимок.КодОшибки(),
		Снимок.Сообщение(),
		Снимок.Подсказка(),
		Снимок.URL(),
		КодЭффективнойОшибки,
		СообщениеЭффективнойОшибки
	);

КонецФункции

// Формирует пользовательское представление полей одного кадра без чтения цепочки причин.
//
// Параметры:
//  Вид - Строка - Вид кадра.
//  КодОшибки - Строка, Неопределено - Машинный код ошибки.
//  Сообщение - Строка - Сообщение кадра.
//  Подсказка - Строка - Подсказка кадра.
//  URL - Строка - Ссылка на описание ошибки.
//  КодЭффективнойОшибки - Строка, Неопределено - Код эффективной ошибки цепочки.
//  СообщениеЭффективнойОшибки - Строка - Сообщение эффективной ошибки цепочки.
//
// Возвращаемое значение:
//  Строка - Кадр, эффективная ошибка для обёртки, подсказка и URL кадра.
Функция ПользовательскоеПредставлениеКадра(
	Вид,
	КодОшибки,
	Сообщение,
	Подсказка,
	URL,
	КодЭффективнойОшибки = Неопределено,
	СообщениеЭффективнойОшибки = ""
) Экспорт

	КраткоеПредставление = КраткоеПредставлениеКадра(
		Вид,
		КодОшибки,
		Сообщение,
		КодЭффективнойОшибки,
		СообщениеЭффективнойОшибки
	);

	Если ПустаяСтрока(Подсказка) И ПустаяСтрока(URL) Тогда
		Возврат КраткоеПредставление;
	КонецЕсли;

	Блоки = Новый Массив;
	Блоки.Добавить(КраткоеПредставление);

	Если Не ПустаяСтрока(Подсказка) Тогда
		Блоки.Добавить(БлокИменованногоЗначения(
			НСтр("ru = 'Подсказка:'; en = 'Hint:'"),
			Подсказка
		));
	КонецЕсли;

	Если Не ПустаяСтрока(URL) Тогда
		Блоки.Добавить(БлокИменованногоЗначения("URL:", URL));
	КонецЕсли;

	Возврат СтрСоединить(Блоки, Символы.ПС + Символы.ПС);

КонецФункции

// Возвращает поддерживаемые верхнеуровневые разделы диагностического отчёта.
//
// Возвращаемое значение:
//  ФиксированныйМассив из Строка - Идентификаторы разделов в каноническом порядке.
Функция ПоддерживаемыеРазделы() Экспорт

	Возврат _ПоддерживаемыеРазделы;

КонецФункции

// Формирует диагностический отчёт из выбранных верхнеуровневых разделов.
//
// Параметры:
//  Снимки - Массив из СнимокКадраОшибки - Снимки от внешнего кадра к корневому.
//  Усечена - Булево - Признак наличия непросмотренного продолжения цепочки.
//  Разделы - Массив из Строка, ФиксированныйМассив из Строка - Идентификаторы разделов в порядке вывода.
//
// Возвращаемое значение:
//  Строка - Диагностическое представление из выбранных разделов.
Функция СформироватьИзРазделов(Снимки, Усечена, Разделы) Экспорт

	Блоки = Новый Массив;
	Разбор = РазобратьСнимки(Снимки);

	Для Каждого Раздел Из Разделы Цикл
		Блок = БлокРаздела(Раздел, Разбор, Снимки, Усечена);
		Если Блок <> "" Тогда
			Блоки.Добавить(Блок);
		КонецЕсли;
	КонецЦикла;

	Возврат СтрСоединить(Блоки, Символы.ПС + Символы.ПС);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаполнитьЭффективнуюОшибку(Снимок, КодОшибки, Сообщение)

	Если Снимок <> Неопределено Тогда
		КодОшибки = Снимок.КодОшибки();
		Сообщение = Снимок.Сообщение();
	КонецЕсли;

КонецПроцедуры

Функция БлокИменованногоЗначения(Заголовок, Значение)

	Строки = Новый Массив;
	Строки.Добавить(Заголовок);
	_ФорматировщикЗначений.ДобавитьЗначениеСМаркером(Строки, 2, "", Значение);

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

Функция БлокРаздела(Раздел, Разбор, Снимки, Усечена)

	Если Раздел = "current" И Разбор.Группы.Количество() > 0 Тогда
		Возврат БлокГруппы(Разбор.Группы[0], 0, "", 0, Ложь);
	ИначеЕсли Раздел = "causes" И Разбор.Группы.Количество() > 1 Тогда
		Возврат БлокПричин(Разбор.Группы);
	ИначеЕсли Раздел = "hints" И Разбор.Подсказки.Количество() > 0 Тогда
		Возврат БлокИменованногоСписка(НСтр("ru = 'Подсказка:'; en = 'Hint:'"), Разбор.Подсказки);
	ИначеЕсли Раздел = "urls" И Разбор.Ссылки.Количество() > 0 Тогда
		Возврат БлокИменованногоСписка("URL:", Разбор.Ссылки);
	ИначеЕсли Раздел = "uninspected_contexts" И Усечена И Разбор.Контексты.Количество() > 0 Тогда
		Возврат БлокКонтекстов(
			НСтр(
				"ru = 'Контекст без просмотренной причины:';
				|en = 'Context without an inspected cause:'"
			),
			Разбор.Контексты
		);
	ИначеЕсли Раздел = "truncation" И Усечена Тогда
		Возврат НСтр("ru = 'Цепочка причин усечена'; en = 'Cause chain truncated'");
	ИначеЕсли Раздел = "stack" И Снимки.Количество() > 0 Тогда
		Возврат БлокСтекаВызовов(Снимки[0].СтекВызовов());
	КонецЕсли;

	Возврат "";

КонецФункции

Функция РазобратьСнимки(Снимки)

	Результат = Новый Структура(
		"Группы, Контексты, Подсказки, Ссылки",
		Новый Массив,
		Новый Массив,
		Новый Массив,
		Новый Массив
	);
	Контексты = Новый Массив;

	Для Каждого Снимок Из Снимки Цикл
		Подсказка = Снимок.Подсказка();
		Если Не ПустаяСтрока(Подсказка) Тогда
			Результат.Подсказки.Добавить(Подсказка);
		КонецЕсли;

		URL = Снимок.URL();
		Если Не ПустаяСтрока(URL) Тогда
			Результат.Ссылки.Добавить(URL);
		КонецЕсли;

		Если Снимок.Вид() = ВидыКадровОшибок.Контекст() Тогда
			Контексты.Добавить(Снимок);
		Иначе
			Результат.Группы.Добавить(Новый Структура("Снимок, Контексты", Снимок, Контексты));
			Контексты = Новый Массив;
		КонецЕсли;
	КонецЦикла;

	Результат.Контексты = Контексты;

	Возврат Результат;

КонецФункции

Функция БлокГруппы(
	Группа,
	ОтступЗаголовка,
	МаркерНомера,
	ОтступПолей,
	ЭтоПричина
)

	Строки = Новый Массив;
	ДобавитьГруппу(Строки, Группа, ОтступЗаголовка, МаркерНомера, ОтступПолей, ЭтоПричина);

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

Процедура ДобавитьГруппу(
	Строки,
	Группа,
	ОтступЗаголовка,
	МаркерНомера,
	ОтступПолей,
	ЭтоПричина
)

	Снимок = Группа.Снимок;
	Вид = Снимок.Вид();
	КодОшибки = Снимок.КодОшибки();
	Сообщение = Снимок.Сообщение();
	Данные = Снимок.Данные();
	МестоСоздания = Снимок.МестоСоздания();
	МаркерЗаголовка = "";
	Если Вид = ВидыКадровОшибок.Ошибка() Тогда
		МаркерЗаголовка = КодОшибки + ": ";
	КонецЕсли;

	_ФорматировщикЗначений.ДобавитьЗначениеСМаркером(
		Строки,
		ОтступЗаголовка,
		МаркерНомера + МаркерЗаголовка,
		Сообщение
	);

	Если Группа.Контексты.Количество() > 0 Тогда
		Если Не ЭтоПричина Тогда
			Строки.Добавить("");
		КонецЕсли;

		Строки.Добавить(
			_ФорматировщикЗначений.СтрокаОтступа(ОтступПолей) + НСтр("ru = 'Контекст:'; en = 'Context:'")
		);
		МаркерКонтекста = "";
		Если Группа.Контексты.Количество() > 1 Тогда
			МаркерКонтекста = "- ";
		КонецЕсли;

		Для Каждого Контекст Из Группа.Контексты Цикл
			ДобавитьКонтекст(
				Строки,
				Контекст,
				ОтступПолей + 2,
				МаркерКонтекста
			);
		КонецЦикла;
	КонецЕсли;

	Если Не ЭтоПричина И Данные <> Неопределено Тогда
		Строки.Добавить("");
	КонецЕсли;

	ДобавитьДополнительныеПоля(Строки, Данные, Вид, МестоСоздания, ОтступПолей);

КонецПроцедуры

Функция БлокПричин(Группы)

	Строки = Новый Массив;
	Строки.Добавить(НСтр("ru = 'Причина:'; en = 'Cause:'"));
	КоличествоПричин = Группы.Количество() - 1;

	Для НомерПричины = 1 По Группы.ВГраница() Цикл
		МаркерНомера = "";
		ОтступПолей = 4;
		Если КоличествоПричин > 1 Тогда
			МаркерНомера = Строка(НомерПричины) + ": ";
			ОтступПолей = 2 + СтрДлина(МаркерНомера);
		КонецЕсли;

		ДобавитьГруппу(Строки, Группы[НомерПричины], 2, МаркерНомера, ОтступПолей, Истина);
	КонецЦикла;

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

Функция БлокИменованногоСписка(Заголовок, Значения)

	Строки = Новый Массив;
	Строки.Добавить(Заголовок);
	Нумеровать = Значения.Количество() > 1;

	Для Номер = 0 По Значения.ВГраница() Цикл
		Маркер = "";
		Если Нумеровать Тогда
			Маркер = Строка(Номер + 1) + ": ";
		КонецЕсли;
		_ФорматировщикЗначений.ДобавитьЗначениеСМаркером(Строки, 2, Маркер, Значения[Номер]);
	КонецЦикла;

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

Функция БлокСтекаВызовов(Стек)

	СтрокиСтека = СтрокиСтекаВызовов(Стек, 2);
	Если СтрокиСтека.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Строки = Новый Массив;
	Строки.Добавить(НСтр("ru = 'Стек вызовов:'; en = 'Call stack:'"));
	ДобавитьСтроки(Строки, СтрокиСтека);

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

Процедура ДобавитьКонтекст(Строки, Снимок, Отступ, Маркер)

	_ФорматировщикЗначений.ДобавитьЗначениеСМаркером(Строки, Отступ, Маркер, Снимок.Сообщение());
	ДобавитьДополнительныеПоля(
		Строки,
		Снимок.Данные(),
		Снимок.Вид(),
		Снимок.МестоСоздания(),
		Отступ + СтрДлина(Маркер)
	);

КонецПроцедуры

Процедура ДобавитьДополнительныеПоля(Строки, Данные, Вид, МестоСоздания, Отступ)

	Если Данные <> Неопределено Тогда
		Если _ФорматировщикЗначений.ЭтоПустойКонтейнер(Данные) Тогда
			Маркер = _ФорматировщикЗначений.МаркерПустогоКонтейнера(Данные);
			ДобавитьПоле(Строки, Отступ, НСтр("ru = 'Данные'; en = 'Data'"), Маркер);
		Иначе
			Строки.Добавить(
				_ФорматировщикЗначений.СтрокаОтступа(Отступ) + НСтр("ru = 'Данные:'; en = 'Data:'")
			);
			ДобавитьСтроки(
				Строки,
				_ФорматировщикЗначений.Строки(Данные, Отступ + 2)
			);
		КонецЕсли;
	КонецЕсли;

	ДобавитьМесто(Строки, МестоСоздания, Отступ);

	Если Вид = ВидыКадровОшибок.ВнешняяОшибка()
		И МестоСоздания.ИсходнаяСтрока <> "" Тогда
		ДобавитьПоле(
			Строки,
			Отступ,
			НСтр("ru = 'Исходная строка'; en = 'Source line'"),
			СокрЛП(МестоСоздания.ИсходнаяСтрока)
		);
	КонецЕсли;

КонецПроцедуры

Функция БлокКонтекстов(Заголовок, Контексты)

	Строки = Новый Массив;
	Строки.Добавить(Заголовок);
	Маркер = "";
	Если Контексты.Количество() > 1 Тогда
		Маркер = "- ";
	КонецЕсли;

	Для Каждого Контекст Из Контексты Цикл
		ДобавитьКонтекст(Строки, Контекст, 2, Маркер);
	КонецЦикла;

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

Процедура ДобавитьМесто(Строки, МестоСоздания, Отступ)

	ИмяМодуля = МестоСоздания.ИмяМодуля;
	НомерСтроки = МестоСоздания.НомерСтроки;

	Если ИмяМодуля <> "" И НомерСтроки > 0 Тогда
		ДобавитьПоле(
			Строки,
			Отступ,
			НСтр("ru = 'Место'; en = 'Location'"),
			СтрШаблон("%1:%2", ИмяМодуля, НомерСтроки)
		);
	ИначеЕсли ИмяМодуля <> "" Тогда
		ДобавитьПоле(Строки, Отступ, НСтр("ru = 'Место'; en = 'Location'"), ИмяМодуля);
	ИначеЕсли НомерСтроки > 0 Тогда
		ДобавитьПоле(Строки, Отступ, НСтр("ru = 'Строка'; en = 'Line'"), Строка(НомерСтроки));
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьПоле(Строки, Отступ, Имя, Значение)

	_ФорматировщикЗначений.ДобавитьЗначениеСМаркером(Строки, Отступ, Имя + ": ", Значение);

КонецПроцедуры

Процедура ДобавитьСтроки(Приемник, Источник)

	Для Каждого Строка Из Источник Цикл
		Приемник.Добавить(Строка);
	КонецЦикла;

КонецПроцедуры

Функция ПредставленияЭлементовСтека(Стек)

	Результат = Новый Массив;
	Для Каждого Элемент Из Стек Цикл
		Результат.Добавить(БезопасноеПредставление(Элемент));
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция БезопасноеПредставление(Значение)

	Попытка
		Возврат Строка(Значение);
	Исключение
		_РегистраторСбоев.ЗаписатьПодавленныйСбой(
			"format.render_diagnostic_value",
			Значение,
			ИнформацияОбОшибке()
		);
		Возврат НСтр("ru = '<недоступно>'; en = '<unavailable>'");
	КонецПопытки;

КонецФункции

#КонецОбласти
