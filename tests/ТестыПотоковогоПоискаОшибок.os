#Область Тесты

&Тест
Процедура ТестДолжен_СоздатьСнимокСНормализованнымиПолями() Экспорт

	// Подготовка
	Данные = Новый Структура("Ресурс", "config.json");
	Ошибка = Новый ПостроительОшибки("config.invalid", "Ошибка конфигурации")
		.ПроизвольныеДанные(Данные)
		.Подсказка("Исправьте файл")
		.URL("https://example.org/errors/config.invalid")
		.Построить();

	// Действие
	Снимок = Новый СнимокКадраОшибки(Ошибка);

	// Проверка
	Ожидаем.Что(Снимок.Вид()).Равно(ВидыКадровОшибок.Ошибка());
	Ожидаем.Что(Снимок.КодОшибки()).Равно("config.invalid");
	Ожидаем.Что(Снимок.Сообщение()).Равно("Ошибка конфигурации");
	Ожидаем.Что(Снимок.Данные()).Равно(Данные);
	Ожидаем.Что(Снимок.Подсказка()).Равно("Исправьте файл");
	Ожидаем.Что(Снимок.URL()).Равно("https://example.org/errors/config.invalid");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПрочитатьМетаданныеСобственногоКадра() Экспорт

	// Подготовка
	Данные = Новый Структура("Ресурс", "config.json");
	Ошибка = Новый ПостроительОшибки("config.invalid", "Ошибка конфигурации")
		.ПроизвольныеДанные(Данные)
		.Подсказка("Исправьте файл")
		.URL("https://example.org/errors/config.invalid")
		.Построить();

	// Действие
	Метаданные = ЧтениеКадраОшибки.ПрочитатьМетаданные(Ошибка);

	// Проверка
	Ожидаем.Что(Метаданные.Вид).Равно(ВидыКадровОшибок.Ошибка());
	Ожидаем.Что(Метаданные.КодОшибки).Равно("config.invalid");
	Ожидаем.Что(Метаданные.Сообщение).Равно("Ошибка конфигурации");
	Ожидаем.Что(Метаданные.Данные).Равно(Данные);
	Ожидаем.Что(Метаданные.Подсказка).Равно("Исправьте файл");
	Ожидаем.Что(Метаданные.URL).Равно("https://example.org/errors/config.invalid");

КонецПроцедуры

&Тест
Процедура ТестДолжен_НайтиПервыйФизическийКадрПоКоду() Экспорт

	// Подготовка
	Причина = ФабрикаОшибок.Создать("connection.timeout", "Первый таймаут");
	Ошибка = ФабрикаОшибок.Обернуть(Причина, "connection.timeout", "Второй таймаут");

	// Действие
	НайденныйКадр = ОбходЦепочкиОшибки.НайтиПервуюПоКодам(Ошибка, "CONNECTION.TIMEOUT");

	// Проверка
	Ожидаем.Что(НайденныйКадр).Равно(Ошибка);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("connection", Истина)
&ИсточникЗначение("CONNECTION.TIMEOUT", Истина)
&ИсточникЗначение("connectionless", Ложь)
Процедура ТестДолжен_НайтиКадрПоГруппе(ГруппаОшибок, ОжидаемыйРезультат) Экспорт

	// Подготовка
	Ошибка = ФабрикаОшибок.Создать("connection.timeout", "Таймаут");

	// Действие
	НайденныйКадр = ОбходЦепочкиОшибки.НайтиПервуюПоГруппе(Ошибка, ГруппаОшибок);

	// Проверка
	Ожидаем.Что(НайденныйКадр <> Неопределено).Равно(ОжидаемыйРезультат);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПропуститьКонтекстИПоврежденныеМетаданныеПриПоиске() Экспорт

	// Подготовка
	Причина = ФабрикаОшибок.Создать("connection.timeout", "Таймаут");
	Образец = ФабрикаОшибок.Создать("sample.failed", "Образец");
	ПоврежденныйКадр = ПомощникТестированияОшибок.ОшибкаСПоврежденнымКонвертом(Образец, Причина);
	Ошибка = ФабрикаОшибок.ОбернутьКонтекстом(ПоврежденныйКадр, "Подключение");

	// Действие
	НайденныйКадр = ОбходЦепочкиОшибки.НайтиПервуюПоКодам(Ошибка, "connection.timeout");

	// Проверка
	Ожидаем.Что(НайденныйКадр).Равно(Причина);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОграничитьПотоковыйПоискШестьюдесятьюЧетырьмяКадрами() Экспорт

	// Подготовка
	Ошибка = СоздатьЦепочкуОшибок(65);

	// Действие
	НайденныйКадр = ОбходЦепочкиОшибки.НайтиПервуюПоКодам(Ошибка, "benchmark.level_1");

	// Проверка
	Ожидаем.Что(НайденныйКадр).Равно(Неопределено);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьЦепочкуОшибок(Глубина)

	Ошибка = ФабрикаОшибок.Создать("benchmark.level_1", "Ошибка уровня 1");
	Для НомерУровня = 2 По Глубина Цикл
		Ошибка = ФабрикаОшибок.Обернуть(
			Ошибка,
			"benchmark.level_" + НомерУровня,
			"Ошибка уровня " + НомерУровня
		);
	КонецЦикла;

	Возврат Ошибка;

КонецФункции

#КонецОбласти
