#Использовать asserts
#Использовать "../src"

#Область Тесты

&Тест
Процедура ТестДолжен_СоздатьРазборОшибки() Экспорт

	// Подготовка
	Ошибка = ФабрикаОшибок.Создать("config.invalid", "Ошибка конфигурации");

	// Действие
	Разбор = ДиагностикаОшибок.Разобрать(Ошибка);

	// Проверка
	Ожидаем.Что(ТипЗнч(Разбор)).Равно(Тип("РазборОшибки"));
	Ожидаем.Что(Разбор.КодОшибки()).Равно("config.invalid");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьКодЭффективнойОшибки() Экспорт

	// Подготовка
	Причина = ФабрикаОшибок.Создать("config.invalid", "Ошибка конфигурации");
	Ошибка = ФабрикаОшибок.ОбернутьКонтекстом(Причина, "Загрузка конфигурации");

	// Действие
	КодОшибки = ДиагностикаОшибок.КодОшибки(Ошибка);

	// Проверка
	Ожидаем.Что(КодОшибки).Равно("config.invalid");

КонецПроцедуры

&Тест
Процедура ТестДолжен_НайтиКодВоВсейЦепочке() Экспорт

	// Подготовка
	Ошибка = ТестоваяЦепочка();

	// Действие
	СодержитПричину = ДиагностикаОшибок.Содержит(Ошибка, "connection.timeout");
	СодержитНеизвестныйКод = ДиагностикаОшибок.Содержит(Ошибка, "connection.refused");

	// Проверка
	Ожидаем.Что(СодержитПричину).Равно(Истина);
	Ожидаем.Что(СодержитНеизвестныйКод).Равно(Ложь);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НайтиЛюбойКодВоВсейЦепочке() Экспорт

	// Подготовка
	Ошибка = ТестоваяЦепочка();
	КодыОшибок = Новый Массив;
	КодыОшибок.Добавить("connection.refused");
	КодыОшибок.Добавить("connection.timeout");

	// Действие
	СодержитЛюбойКод = ДиагностикаОшибок.СодержитЛюбойИз(Ошибка, КодыОшибок);

	// Проверка
	Ожидаем.Что(СодержитЛюбойКод).Равно(Истина);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НайтиГруппуВоВсейЦепочке() Экспорт

	// Подготовка
	Ошибка = ТестоваяЦепочка();

	// Действие
	СодержитГруппу = ДиагностикаОшибок.СодержитГруппу(Ошибка, "connection");

	// Проверка
	Ожидаем.Что(СодержитГруппу).Равно(Истина);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НайтиПервуюОшибкуСКодом() Экспорт

	// Подготовка
	Причина = ФабрикаОшибок.Создать("connection.timeout", "Первый таймаут");
	Ошибка = ФабрикаОшибок.Обернуть(Причина, "connection.timeout", "Второй таймаут");

	// Действие
	Снимок = ДиагностикаОшибок.НайтиПервую(Ошибка, "connection.timeout");
	НеизвестныйСнимок = ДиагностикаОшибок.НайтиПервую(Ошибка, "connection.refused");

	// Проверка
	Ожидаем.Что(Снимок.ИсходнаяОшибка()).Равно(Ошибка);
	Ожидаем.Что(НеизвестныйСнимок).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьКраткоеПредставление() Экспорт

	// Подготовка
	Ошибка = ТестоваяЦепочка();
	ОжидаемоеПредставление = ДиагностикаОшибок.Разобрать(Ошибка).КраткоеПредставление();

	// Действие
	Представление = ДиагностикаОшибок.КраткоеПредставление(Ошибка);

	// Проверка
	Ожидаем.Что(Представление).Равно(ОжидаемоеПредставление);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьПользовательскоеПредставление() Экспорт

	// Подготовка
	Ошибка = ТестоваяЦепочка();
	ОжидаемоеПредставление = ДиагностикаОшибок.Разобрать(Ошибка).ПользовательскоеПредставление();

	// Действие
	Представление = ДиагностикаОшибок.ПользовательскоеПредставление(Ошибка);

	// Проверка
	Ожидаем.Что(Представление).Равно(ОжидаемоеПредставление);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьДиагностическоеПредставление() Экспорт

	// Подготовка
	Ошибка = ТестоваяЦепочка();
	ОжидаемоеПредставление = ДиагностикаОшибок.Разобрать(Ошибка).ДиагностическоеПредставление();

	// Действие
	Представление = ДиагностикаОшибок.ДиагностическоеПредставление(Ошибка);

	// Проверка
	Ожидаем.Что(Представление).Равно(ОжидаемоеПредставление);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ТестоваяЦепочка()

	Причина = Новый ПостроительОшибки("connection.timeout", "Превышено время ожидания")
		.Данные("Узел", "db.example.org")
		.Подсказка("Повторите запрос")
		.Построить();

	Возврат ФабрикаОшибок.Обернуть(
		Причина,
		"profile.load_failed",
		"Не удалось загрузить профиль"
	);

КонецФункции

#КонецОбласти
