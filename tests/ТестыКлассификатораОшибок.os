// Инициализирует состояние тестового набора.
&ПередКаждым
Процедура ИнициализироватьТесты() Экспорт

	_БлокировкаСтарта = Новый БлокировкаРесурса();

КонецПроцедуры

#КонецОбласти

#Область Тесты

&Тест
Процедура ТестДолжен_НеСоздаватьПоставщикаПоТипуПриРегистрации() Экспорт

	// Подготовка
	УстановитьПеременнуюСреды("OSCRIPT_ERRORS_TEST_PROVIDER_CONSTRUCTORS", "0");
	Классификатор = Новый КлассификаторОшибок;

	// Действие
	Классификатор.ДобавитьПоставщикаПравил(Тип("ТестовыйПоставщикПравил"));

	// Проверка
	Ожидаем.Что(ПолучитьПеременнуюСреды("OSCRIPT_ERRORS_TEST_PROVIDER_CONSTRUCTORS")).Равно("0");

КонецПроцедуры

