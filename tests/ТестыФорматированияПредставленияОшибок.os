&Тест
Процедура ТестДолжен_ВывестиЕдиныйСтекВызововВКонцеПодробногоПредставления() Экспорт

	// Подготовка
	ВнешнийСтек = Новый Массив;
	ВнешнийСтек.Добавить("ЗагрузитьНастройки:20");
	ВнешнийСтек.Добавить("ОбработчикКоманды:10");
	СтекПричины = Новый Массив;
	СтекПричины.Добавить("ПрочитатьФайл:30");
	Снимки = Новый Массив;
	Снимки.Добавить(Новый ТестовыйСнимокКадраОшибки(
		Новый Структура("Сообщение, Стек", "Не удалось загрузить настройки", ВнешнийСтек)
	));
	Снимки.Добавить(Новый ТестовыйСнимокКадраОшибки(
		Новый Структура(
			"Вид, ТипОшибки, Сообщение, Стек",
			ВидыКадровОшибок.Ошибка,
			"fs.file_not_found",
			"Файл settings.json не найден",
			СтекПричины
		)
	));

	// Действие
	Представление = ФорматированиеПредставленияОшибок.ПодробноеПредставление(Снимки, Ложь);

	// Проверка
	Ожидаем.Что(Представление).Равно("Не удалось загрузить настройки
	|
	|Причина:
	|  fs.file_not_found: Файл settings.json не найден
	|
	|Стек вызовов:
	|  1: ЗагрузитьНастройки:20
	|  2: ОбработчикКоманды:10");

