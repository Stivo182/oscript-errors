&Тест
Процедура ТестДолжен_ВывестиПодсказкуТолькоВПодробномПредставлении() Экспорт

	// Подготовка
	Ошибка = ФабрикаОшибок.Создать(
		"http.proxy_error",
		"Ошибка прокси",
		Неопределено,
		"Проверьте настройки прокси"
	);

	// Действие
	КраткоеПредставление = ДиагностикаОшибок.КраткоеПредставление(Ошибка);
	ПодробноеПредставление = ДиагностикаОшибок.ПодробноеПредставление(Ошибка);

	// Проверка
	Ожидаем.Что(КраткоеПредставление).Равно("http.proxy_error: Ошибка прокси");
	ОжидаемоеПодробноеПредставление = "http.proxy_error: Ошибка прокси
	|
	|Подсказка:
	|  Проверьте настройки прокси";
	Ожидаем.Что(ПодробноеПредставление).Равно(ОжидаемоеПодробноеПредставление);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НачатьПодробноеПредставлениеСВнешнейОбертки() Экспорт

	// Подготовка
	Причина = ФабрикаОшибок.Создать("config.load_failed", "Не удалось загрузить настройки");
	Ошибка = ПомощникТестированияОшибок.ВнешняяОшибка(
		"Не удалось инициализировать приложение",
		Причина
	);

	// Действие
	Краткое = ДиагностикаОшибок.КраткоеПредставление(Ошибка);
	Подробное = ДиагностикаОшибок.ПодробноеПредставление(Ошибка);

	// Проверка
	Ожидаем.Что(Краткое).Равно("config.load_failed: Не удалось загрузить настройки");
	Ожидаем.Что(Подробное).Равно("Не удалось инициализировать приложение
	|
	|Причина:
	|  config.load_failed: Не удалось загрузить настройки");

КонецПроцедуры

