#Использовать asserts
#Использовать "fixtures"
#Использовать "../src"
#Использовать "../src/internal"

Перем _ФорматировщикПредставления; // ФорматировщикПредставленияОшибок
Перем _БлокировкаСтарта; // БлокировкаРесурса
Перем _КоличествоГотовыхЗаданий; // Число
Перем _НачатьФорматирование; // Булево

#Область ОбработчикиСобытий

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

// Инициализирует состояние тестового набора.
&ПередВсеми
Процедура ИнициализироватьТесты() Экспорт

	_ФорматировщикПредставления = СервисыБиблиотекиОшибок.ФорматировщикПредставленияОшибок();
	_БлокировкаСтарта = Новый БлокировкаРесурса();

КонецПроцедуры

#КонецОбласти

#Область Тесты

&Тест
Процедура ТестДолжен_НумероватьСтекВызововТолькоПриНесколькихСтроках() Экспорт

	// Подготовка
	ОднаСтрока = Новый Массив;
	ОднаСтрока.Добавить("ОбработчикКоманды:10");
	НесколькоСтрок = Новый Массив;
	НесколькоСтрок.Добавить("ЗагрузитьНастройки:20");
	НесколькоСтрок.Добавить("ОбработчикКоманды:10");

	// Действие
	ПредставлениеОднойСтроки = _ФорматировщикПредставления.СтрокиСтекаВызовов(ОднаСтрока, 4);
	ПредставлениеНесколькихСтрок = _ФорматировщикПредставления.СтрокиСтекаВызовов(НесколькоСтрок, 4);

	// Проверка
	Ожидаем.Что(Соединить(ПредставлениеОднойСтроки)).Равно("    ОбработчикКоманды:10");
	Ожидаем.Что(Соединить(ПредставлениеНесколькихСтрок)).Равно(
		"    1: ЗагрузитьНастройки:20" + Символы.ПС + "    2: ОбработчикКоманды:10"
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПредставитьПограничныеЭлементыСтекаВызовов() Экспорт

	// Подготовка
	ПустойСтек = Новый Массив;
	ЕдинственныйМногострочный = Новый Массив;
	ЕдинственныйМногострочный.Добавить("Первая" + Символы.ПС + "Вторая");
	ОсобыеЭлементы = Новый Массив;
	ОсобыеЭлементы.Добавить("");
	ОсобыеЭлементы.Добавить(Новый НепредставимоеЗначение);
	ОсобыеЭлементы.Добавить("Первая" + Символы.ПС + "Вторая");

	// Действие
	ПустоеПредставление = _ФорматировщикПредставления.СтрокиСтекаВызовов(ПустойСтек, 4);
	МногострочноеПредставление = _ФорматировщикПредставления.СтрокиСтекаВызовов(
		ЕдинственныйМногострочный,
		4
	);
	ПредставлениеОсобыхЭлементов = _ФорматировщикПредставления.СтрокиСтекаВызовов(ОсобыеЭлементы, 4);

	// Проверка
	Ожидаем.Что(ПустоеПредставление.Количество()).Равно(0);
	Ожидаем.Что(Соединить(МногострочноеПредставление)).Равно(
		"    Первая" + Символы.ПС + "    Вторая"
	);
	Ожидаем.Что(Соединить(ПредставлениеОсобыхЭлементов)).Равно(
		"    1: " + Символ(34) + Символ(34) + Символы.ПС
			+ "    2: <недоступно>" + Символы.ПС
			+ "    3: Первая" + Символы.ПС
			+ "       Вторая"
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПараллельноФормироватьОтступыБезОбщегоИзменяемогоСостояния() Экспорт

	// Подготовка
	_КоличествоГотовыхЗаданий = 0;
	_НачатьФорматирование = Ложь;
	ОжидаемаяДлина = 5000;
	Параметры = Новый Массив;
	Параметры.Добавить(ОжидаемаяДлина);
	Задания = Новый Массив;
	Для НомерЗадания = 1 По 4 Цикл
		Задания.Добавить(ФоновыеЗадания.Выполнить(ЭтотОбъект, "СформироватьОтступ", Параметры));
	КонецЦикла;
	Для НомерОжидания = 1 По 5000 Цикл
		Если КоличествоГотовыхЗаданий() = Задания.Количество() Тогда
			Прервать;
		КонецЕсли;
		Приостановить(1);
	КонецЦикла;

	// Действие и Проверка
	КоличествоГотовыхЗаданий = КоличествоГотовыхЗаданий();
	РазрешитьПараллельноеФорматирование();
	Ожидаем.Что(КоличествоГотовыхЗаданий).Равно(Задания.Количество());
	ФоновыеЗадания.ОжидатьВсе(Задания);

	Для Каждого Задание Из Задания Цикл
		Ожидаем.Что(СтрДлина(Задание.Результат)).Равно(ОжидаемаяДлина + 1);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Соединить(Строки)

	Результат = "";
	Для Каждого Строка Из Строки Цикл
		Если Результат <> "" Тогда
			Результат = Результат + Символы.ПС;
		КонецЕсли;
		Результат = Результат + Строка;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция СформироватьОтступ(Количество) Экспорт

	ЗарегистрироватьГотовоеЗадание();
	Пока Не ПараллельноеФорматированиеРазрешено() Цикл
		Приостановить(1);
	КонецЦикла;

	Возврат _ФорматировщикПредставления.СтрокиДанных(1, Количество)[0];

КонецФункции

Процедура ЗарегистрироватьГотовоеЗадание()

	_БлокировкаСтарта.Заблокировать();
	_КоличествоГотовыхЗаданий = _КоличествоГотовыхЗаданий + 1;
	_БлокировкаСтарта.Разблокировать();

КонецПроцедуры

Функция КоличествоГотовыхЗаданий()

	_БлокировкаСтарта.Заблокировать();
	Результат = _КоличествоГотовыхЗаданий;
	_БлокировкаСтарта.Разблокировать();

	Возврат Результат;

КонецФункции

Процедура РазрешитьПараллельноеФорматирование()

	_БлокировкаСтарта.Заблокировать();
	_НачатьФорматирование = Истина;
	_БлокировкаСтарта.Разблокировать();

КонецПроцедуры

Функция ПараллельноеФорматированиеРазрешено()

	_БлокировкаСтарта.Заблокировать();
	Результат = _НачатьФорматирование;
	_БлокировкаСтарта.Разблокировать();

	Возврат Результат;

КонецФункции

#КонецОбласти
