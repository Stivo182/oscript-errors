Перем _МаксимальноеКоличествоКадров; // Число

#Область СлужебныйПрограммныйИнтерфейс

// Просматривает физическую цепочку ошибки от внешнего кадра к корневому.
// Просмотр ограничен 64 кадрами и терпим к повреждённым причинам.
//
// Параметры:
//  Ошибка - ИнформацияОбОшибке - Внешний кадр просматриваемой цепочки.
//
// Возвращаемое значение:
//  Структура:
//   * Кадры - Массив из ИнформацияОбОшибке - Просмотренные физические кадры;
//   * Усечена - Булево - Признак наличия непросмотренной причины.
Функция Просмотреть(Ошибка) Экспорт

	ПроверкаКадровОшибок.ПроверитьОшибку(Ошибка);

	Результат = Новый Структура("Кадры, Усечена", Новый Массив, Ложь);
	ТекущийКадр = Ошибка;

	Для НомерКадра = 1 По _МаксимальноеКоличествоКадров Цикл
		Результат.Кадры.Добавить(ТекущийКадр);
		Причина = БезопасноПолучитьПричину(ТекущийКадр);

		Если Причина = Неопределено Тогда
			Возврат Результат;
		КонецЕсли;

		Если НомерКадра = _МаксимальноеКоличествоКадров Тогда
			Результат.Усечена = Истина;
			Возврат Результат;
		КонецЕсли;

		ТекущийКадр = Причина;
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция БезопасноПолучитьПричину(Кадр)

	Попытка
		Причина = Кадр.Причина;
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Если ТипЗнч(Причина) = Тип("ИнформацияОбОшибке") Тогда
		Возврат Причина;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

#КонецОбласти

_МаксимальноеКоличествоКадров = 64;
