&Тест
Процедура ТестДолжен_КлассифицироватьНеподдерживаемыйВидКадра() Экспорт

	// Подготовка
	Ошибка = Неопределено;

	// Действие
	Попытка
		ОшибкаКадра = Новый КонструкторОшибки("http.proxy_error", "Ошибка прокси", "НеизвестныйВид").Построить();
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;

	// Проверка
	ПроверитьКонтрактноеИсключение(
		Ошибка,
		"argument.invalid_value",
		"Вид",
		"одно из значений: Ошибка, Контекст"
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПроверитьТипыПолейКонтекстногоКадра() Экспорт

	// Подготовка
	Причина = ФабрикаОшибок.Создать("network.unavailable", "Сеть недоступна");

	// Действие
	ОшибкаКода = ОшибкаПриПроверкеКадра(42, Причина, "", "");
	ОшибкаПодсказки = ОшибкаПриПроверкеКадра(Неопределено, Причина, 42, "");
	ОшибкаURL = ОшибкаПриПроверкеКадра(Неопределено, Причина, "", 42);

	// Проверка
	ПроверитьКонтрактноеИсключение(ОшибкаКода, "argument.invalid_type", "КодОшибки", "");
	Ожидаем.Что(Новый СнимокКадраОшибки(ОшибкаКода).Сообщение()).Равно(
		СтрШаблон(
			НСтр("ru = 'Аргумент ''%1'' должен иметь тип %2'; en = 'Argument ''%1'' must be of type %2'"),
			"КодОшибки",
			Строка(Тип("Строка"))
		)
	);
	ПроверитьКонтрактноеИсключение(ОшибкаПодсказки, "argument.invalid_type", "Подсказка", "");
	ПроверитьКонтрактноеИсключение(ОшибкаURL, "argument.invalid_type", "URL", "");

КонецПроцедуры

&Тест
Процедура ТестДолжен_КлассифицироватьКодОшибкиКонтекстногоКадра() Экспорт

	// Подготовка
	Причина = ФабрикаОшибок.Создать("network.unavailable", "Сеть недоступна");
