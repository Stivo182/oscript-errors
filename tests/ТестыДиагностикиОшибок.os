КонецПроцедуры

&Тест
Процедура ТестДолжен_НайтиПервуюОшибкуСКодом() Экспорт

	// Подготовка
	Причина = ФабрикаОшибок.Создать("connection.timeout", "Первый таймаут");
	Ошибка = ФабрикаОшибок.Обернуть(Причина, "connection.timeout", "Второй таймаут");

	// Действие
	Снимок = ДиагностикаОшибок.НайтиПервую(Ошибка, "connection.timeout");
	НеизвестныйСнимок = ДиагностикаОшибок.НайтиПервую(Ошибка, "connection.refused");

	// Проверка
	Ожидаем.Что(Снимок.ИсходнаяОшибка()).Равно(Ошибка);
	Ожидаем.Что(НеизвестныйСнимок).Равно(Неопределено);

КонецПроцедуры

