// Демонстрирует запросы к сохранённым снимкам полной цепочки ошибки.
// Разбор один раз просматривает цепочку и повторно использует результат.

#Использовать errors

Причина = ФабрикаОшибок.Создать(
	"fs.file_not_found",
	"Файл настроек не найден",
	Новый Структура("Путь", "application.json")
);
Ошибка = ФабрикаОшибок.Обернуть(
	Причина,
	"config.load_failed",
	"Не удалось загрузить настройки"
);
Ошибка = ФабрикаОшибок.ОбернутьКонтекстом(Ошибка, "Запуск приложения");

Разбор = ДиагностикаОшибок.Разобрать(Ошибка);

Сообщить("Кадров: " + Строка(Разбор.Снимки().Количество()));
Сообщить("Ошибок: " + Строка(Разбор.Ошибки().Количество()));
Сообщить("Контекстов: " + Строка(Разбор.Контексты().Количество()));
Сообщить("Эффективный код: " + Разбор.ЭффективнаяОшибка().КодОшибки());

Корень = Разбор.КорневаяПричина();
Если Корень <> Неопределено Тогда
	Сообщить("Корневой код: " + Корень.КодОшибки());
КонецЕсли;

Сообщить("Физическая цепочка:");
Для Каждого Снимок Из Разбор.Снимки() Цикл
	Сообщить(СтрШаблон("- %1: %2", Снимок.Вид(), Снимок.Сообщение()));
КонецЦикла;
