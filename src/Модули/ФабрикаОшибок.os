#Использовать "../internal"

#Область ПрограммныйИнтерфейс

// Создаёт классифицированную ошибку без причины.
//
// Параметры:
//  ТипОшибки - Строка - Стабильный машинный тип ошибки.
//  Сообщение - Строка - Человекочитаемое описание ошибки.
//  Данные - Произвольный - Связанные с ошибкой данные.
//  Подсказка - Строка - Подсказка по исправлению ошибки.
//
// Возвращаемое значение:
//  ИнформацияОбОшибке - Новый кадр ошибки.
Функция Создать(ТипОшибки, Сообщение, Данные = Неопределено, Подсказка = "") Экспорт

	Возврат Новый КонструкторОшибки(ТипОшибки, Сообщение)
		.Данные(Данные)
		.Подсказка(Подсказка)
		.Построить();

КонецФункции

// Добавляет контекст, не изменяя машинную классификацию причины.
//
// Параметры:
//  Причина - ИнформацияОбОшибке - Непосредственная причина нового кадра.
//  Сообщение - Строка - Описание выполнявшейся операции.
//  Данные - Произвольный - Связанные с контекстом данные.
//
// Возвращаемое значение:
//  ИнформацияОбОшибке - Новый кадр контекста.
Функция СКонтекстом(Причина, Сообщение, Данные = Неопределено) Экспорт

	Возврат Новый КонструкторОшибки(Неопределено, Сообщение, ВидыКадровОшибок.Контекст)
		.Данные(Данные)
		.Причина(Причина)
		.Построить();

КонецФункции

// Оборачивает причину новой машинной классификацией.
//
// Параметры:
//  Причина - ИнформацияОбОшибке - Непосредственная причина нового кадра.
//  ТипОшибки - Строка - Новый стабильный машинный тип ошибки.
//  Сообщение - Строка - Человекочитаемое описание ошибки.
//  Данные - Произвольный - Связанные с ошибкой данные.
//  Подсказка - Строка - Подсказка по исправлению ошибки.
//
// Возвращаемое значение:
//  ИнформацияОбОшибке - Новый классифицированный кадр.
Функция Обернуть(Причина, ТипОшибки, Сообщение, Данные = Неопределено, Подсказка = "") Экспорт

	Возврат Новый КонструкторОшибки(ТипОшибки, Сообщение)
		.Данные(Данные)
		.Причина(Причина)
		.Подсказка(Подсказка)
		.Построить();

КонецФункции

// Возвращает fluent-конструктор классифицированной ошибки.
//
// Параметры:
//  ТипОшибки - Строка - Стабильный машинный тип ошибки.
//  Сообщение - Строка - Человекочитаемое описание ошибки.
//
// Возвращаемое значение:
//  КонструкторОшибки - Новый конструктор ошибки.
Функция Конструктор(ТипОшибки, Сообщение) Экспорт

	Возврат Новый КонструкторОшибки(ТипОшибки, Сообщение);

КонецФункции

// Создаёт ошибку неверного типа аргумента.
//
// Параметры:
//  ИмяАргумента - Строка - Имя аргумента с неверным типом.
//  ОжидаемыйТип - Строка - Строковое представление ожидаемого типа.
//  ФактическоеЗначение - Произвольный - Значение с неверным типом.
//  Сообщение - Строка - Человекочитаемое описание ошибки.
//
// Возвращаемое значение:
//  ИнформацияОбОшибке - Новый кадр ошибки контракта.
Функция НеверныйТипАргумента(ИмяАргумента, ОжидаемыйТип, ФактическоеЗначение, Сообщение = "") Экспорт

	ПроверкаАргументов.ПроверитьТип("ИмяАргумента", ИмяАргумента, Тип("Строка"));
	ПроверкаАргументов.ПроверитьЗаполненность("ИмяАргумента", ИмяАргумента);
	ПроверкаАргументов.ПроверитьТип("ОжидаемыйТип", ОжидаемыйТип, Тип("Строка"));
	ПроверкаАргументов.ПроверитьЗаполненность("ОжидаемыйТип", ОжидаемыйТип);
	ПроверкаАргументов.ПроверитьТип("Сообщение", Сообщение, Тип("Строка"));

	Возврат СозданиеОшибокКонтрактов.НеверныйТипАргумента(
		ИмяАргумента,
		ОжидаемыйТип,
		ФактическоеЗначение,
		Сообщение
	);

КонецФункции

// Создаёт ошибку незаполненного обязательного аргумента.
//
// Параметры:
//  ИмяАргумента - Строка - Имя незаполненного аргумента.
//  Сообщение - Строка - Человекочитаемое описание ошибки.
//
// Возвращаемое значение:
//  ИнформацияОбОшибке - Новый кадр ошибки контракта.
Функция АргументНеЗаполнен(ИмяАргумента, Сообщение = "") Экспорт

	ПроверкаАргументов.ПроверитьТип("ИмяАргумента", ИмяАргумента, Тип("Строка"));
	ПроверкаАргументов.ПроверитьЗаполненность("ИмяАргумента", ИмяАргумента);
	ПроверкаАргументов.ПроверитьТип("Сообщение", Сообщение, Тип("Строка"));

	Возврат СозданиеОшибокКонтрактов.АргументНеЗаполнен(ИмяАргумента, Сообщение);

КонецФункции

// Создаёт ошибку недопустимого значения аргумента.
//
// Параметры:
//  ИмяАргумента - Строка - Имя аргумента с недопустимым значением.
//  Ожидание - Строка - Описание допустимого значения или ограничения.
//  Сообщение - Строка - Человекочитаемое описание ошибки.
//
// Возвращаемое значение:
//  ИнформацияОбОшибке - Новый кадр ошибки контракта.
Функция НедопустимоеЗначениеАргумента(ИмяАргумента, Ожидание, Сообщение = "") Экспорт

	ПроверкаАргументов.ПроверитьТип("ИмяАргумента", ИмяАргумента, Тип("Строка"));
	ПроверкаАргументов.ПроверитьЗаполненность("ИмяАргумента", ИмяАргумента);
	ПроверкаАргументов.ПроверитьТип("Ожидание", Ожидание, Тип("Строка"));
	ПроверкаАргументов.ПроверитьЗаполненность("Ожидание", Ожидание);
	ПроверкаАргументов.ПроверитьТип("Сообщение", Сообщение, Тип("Строка"));

	Возврат СозданиеОшибокКонтрактов.НедопустимоеЗначениеАргумента(
		ИмяАргумента,
		Ожидание,
		Сообщение
	);

КонецФункции

#КонецОбласти
