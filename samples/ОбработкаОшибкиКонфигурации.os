// Демонстрирует обработку реальной ошибки преобразования порта из JSON-конфигурации.
// Ошибка получает стабильный код, данные и контекст, затем оборачивается на границе приложения.
// Внешний обработчик находит исходную причину и выводит диагностическое представление.

#Использовать errors

Функция ПрочитатьJSONИзФайла(ПутьКФайлу)

	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.ОткрытьФайл(ПутьКФайлу, КодировкаТекста.UTF8);
		Данные = ПрочитатьJSON(Чтение);
		Чтение.Закрыть();
		Возврат Данные;
	Исключение
		ВызватьИсключение ФабрикаОшибок.Обернуть(
			ИнформацияОбОшибке(),
			"config.read_failed",
			"Не удалось прочитать файл настроек",
			Новый Структура("Путь", ПутьКФайлу)
		);
	КонецПопытки;

КонецФункции

Функция ПроверитьНастройки(Настройки, ПутьКФайлу)

	Попытка
		Порт = Число(Настройки.service.port);
	Исключение
		Причина = Новый КонструкторОшибки(
			"config.invalid_port",
			"Порт HTTP-сервиса должен быть числом"
		)
			.Причина(ИнформацияОбОшибке())
			.Данные("Путь", ПутьКФайлу)
			.Данные("Значение", Настройки.service.port)
			.Подсказка("Укажите целое число от 1 до 65535")
			.Построить();
		ВызватьИсключение ФабрикаОшибок.СКонтекстом(Причина, "Проверка настроек HTTP-сервиса");
	КонецПопытки;

	Возврат Новый Структура("Имя,Адрес,Порт", Настройки.service.name, Настройки.service.host, Порт);

КонецФункции

Функция ЗагрузитьНастройки(ПутьКФайлу)

	Попытка
		Настройки = ПрочитатьJSONИзФайла(ПутьКФайлу);
		Возврат ПроверитьНастройки(Настройки, ПутьКФайлу);
	Исключение
		ВызватьИсключение ФабрикаОшибок.СКонтекстом(
			ИнформацияОбОшибке(),
			"Загрузка настроек приложения",
			Новый Структура("Путь", ПутьКФайлу)
		);
	КонецПопытки;

КонецФункции

Процедура ЗапуститьПриложение()

	ПутьКФайлу = ОбъединитьПути(ТекущийСценарий().Каталог, "data", "application.json");

	Попытка
		Настройки = ЗагрузитьНастройки(ПутьКФайлу);
		Сообщить(СтрШаблон("Сервис %1 слушает %2:%3", Настройки.Имя, Настройки.Адрес, Настройки.Порт));
	Исключение
		ВызватьИсключение ФабрикаОшибок.Обернуть(
			ИнформацияОбОшибке(),
			"app.start_failed",
			"Не удалось запустить сервис заказов"
		);
	КонецПопытки;

КонецПроцедуры

Процедура ОбработатьОшибкуЗапуска(Ошибка)

	Исследователь = ДиагностикаОшибок.Исследовать(Ошибка);
	ОшибкаПорта = Исследователь.НайтиОшибку("config.invalid_port");
	Если ОшибкаПорта <> Неопределено Тогда
		Данные = ОшибкаПорта.Данные();
		Сообщить(СтрШаблон("Некорректный порт '%1' в файле %2", Данные.Значение, Данные.Путь));
		Сообщить("Рекомендация: " + ОшибкаПорта.Подсказка());
	КонецЕсли;

	Сообщить("");
	Сообщить("Диагностика:");
	Сообщить(Исследователь.ДиагностическоеПредставление());

КонецПроцедуры

Попытка
	ЗапуститьПриложение();
Исключение
	ОбработатьОшибкуЗапуска(ИнформацияОбОшибке());
КонецПопытки;
