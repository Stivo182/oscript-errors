#Использовать "../../../src"

Перем _Правила; // Массив, ФиксированныйМассив из ПравилоКлассификацииОшибок
Перем _КоличествоВызововВсе; // Число
Перем _КоличествоОшибокВсе; // Число
Перем _Задержка; // Число
Перем _Блокировка; // БлокировкаРесурса

#Область ОбработчикиСобытий

// Создает тестового поставщика правил с наблюдаемыми вызовами.
//
// Параметры:
//  Правила - Массив, ФиксированныйМассив из ПравилоКлассификацииОшибок, Неопределено - Возвращаемые правила.
Процедура ПриСозданииОбъекта(Правила = Неопределено)

	_Блокировка = Новый БлокировкаРесурса();
	_КоличествоВызововВсе = 0;
	_КоличествоОшибокВсе = 0;
	_Задержка = 0;
	_Правила = ?(Правила = Неопределено, ПравилаПоУмолчанию(), Правила);

	КоличествоСозданий = ПолучитьПеременнуюСреды("OSCRIPT_ERRORS_TEST_PROVIDER_CONSTRUCTORS");
	Если ПустаяСтрока(КоличествоСозданий) Тогда
		КоличествоСозданий = 0;
	КонецЕсли;

	УстановитьПеременнуюСреды(
		"OSCRIPT_ERRORS_TEST_PROVIDER_CONSTRUCTORS",
		Строка(Число(КоличествоСозданий) + 1)
	);

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Возвращает правила и увеличивает счетчик вызовов.
//
// Возвращаемое значение:
//  Массив, ФиксированныйМассив из ПравилоКлассификацииОшибок - Правила поставщика.
//
// Исключения:
//  Если для очередного вызова настроена тестовая ошибка.
Функция Все() Экспорт

	_Блокировка.Заблокировать();
	_КоличествоВызововВсе = _КоличествоВызововВсе + 1;

	КоличествоОбщихВызовов = ПолучитьПеременнуюСреды("OSCRIPT_ERRORS_TEST_PROVIDER_CALLS");
	Если ПустаяСтрока(КоличествоОбщихВызовов) Тогда
		КоличествоОбщихВызовов = 0;
	КонецЕсли;

	УстановитьПеременнуюСреды(
		"OSCRIPT_ERRORS_TEST_PROVIDER_CALLS",
		Строка(Число(КоличествоОбщихВызовов) + 1)
	);

	ЗавершитьСОшибкой = _КоличествоОшибокВсе > 0;
	Если ЗавершитьСОшибкой Тогда
		_КоличествоОшибокВсе = _КоличествоОшибокВсе - 1;
	КонецЕсли;

	_Блокировка.Разблокировать();

	Если _Задержка > 0 Тогда
		Приостановить(_Задержка);
	КонецЕсли;

	Если ЗавершитьСОшибкой Тогда
		ВызватьИсключение "Тестовая ошибка поставщика правил";
	КонецЕсли;

	Возврат _Правила;

КонецФункции

// Возвращает количество вызовов Все().
//
// Возвращаемое значение:
//  Число - Количество вызовов.
Функция КоличествоВызововВсе() Экспорт

	_Блокировка.Заблокировать();
	Результат = _КоличествоВызововВсе;
	_Блокировка.Разблокировать();

	Возврат Результат;

КонецФункции

// Настраивает ошибки следующих вызовов Все().
//
// Параметры:
//  Количество - Число - Количество вызовов, которые должны завершиться ошибкой.
Процедура ЗавершитьСледующиеВызовыОшибкой(Количество = 1) Экспорт

	_КоличествоОшибокВсе = Количество;

КонецПроцедуры

// Настраивает задержку вызова Все().
//
// Параметры:
//  Миллисекунды - Число - Длительность задержки.
Процедура УстановитьЗадержку(Миллисекунды) Экспорт

	_Задержка = Миллисекунды;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПравилаПоУмолчанию()

	Правила = Новый Массив;
	Правила.Добавить(
		Новый ПравилоКлассификацииОшибок()
			.СовпадаетС("Сообщение поставщика")
			.КлассифицируетКак(
				"test.provider",
				"Ошибка поставщика"
			)
	);

	Возврат Правила;

КонецФункции

#КонецОбласти
