&Тест
Процедура ТестДолжен_СохранитьПодсказкуПриСозданииОшибки() Экспорт

	// Действие
	Ошибка = Новый ПостроительОшибки(
		"http.proxy_error",
		"Ошибка прокси"
	)
		.Подсказка("Проверьте переменную HTTPS_PROXY")
		.Построить();

