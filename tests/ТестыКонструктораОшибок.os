&Тест
Процедура ТестДолжен_ПостроитьКадрСМетаданнымиИПричиной() Экспорт

	// Подготовка
	Данные = Новый Структура("ИмяРесурса", "config.json");
	Причина = Новый ИнформацияОбОшибке(
		"Исходная ошибка",
		Новый ФиксированнаяСтруктура(Новый Структура)
	);

	// Действие
	Ошибка = Новый КонструкторОшибки("resource.not_found", "Файл не найден")
		.ПроизвольныеДанные(Данные)
		.Подсказка("Проверьте путь")
		.Причина(Причина)
		.Построить();

	// Проверка
	Ожидаем.Что(ТипЗнч(Ошибка.Параметры)).Равно(Тип("ФиксированнаяСтруктура"));
	Ожидаем.Что(Ошибка.Параметры.Количество()).Равно(10);
	Ожидаем.Что(Ошибка.Параметры.Маркер).Равно(ФорматКадраОшибки.МаркерМетаданных());
	Ожидаем.Что(Ошибка.Параметры.ВерсияФормата).Равно(ФорматКадраОшибки.ВерсияФормата());
	Ожидаем.Что(Ошибка.Параметры.Вид).Равно(ВидыКадровОшибок.Ошибка());
	Ожидаем.Что(Ошибка.Параметры.КодОшибки).Равно("resource.not_found");
	Ожидаем.Что(Ошибка.Параметры.Сообщение).Равно("Файл не найден");
	Ожидаем.Что(Ошибка.Параметры.Данные).Равно(Данные);
	Ожидаем.Что(Ошибка.Параметры.Подсказка).Равно("Проверьте путь");
	Ожидаем.Что(Ошибка.Параметры.URL).Равно("");
	Ожидаем.Что(Ошибка.Параметры.КодЭффективнойОшибки).Равно("resource.not_found");
	Ожидаем.Что(Ошибка.Параметры.СообщениеЭффективнойОшибки).Равно("Файл не найден");
	Ожидаем.Что(Ошибка.Причина).Равно(Причина);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗаписатьПользовательскоеПредставлениеТекущегоКадраВОписание() Экспорт

	// Подготовка
	Причина = Новый КонструкторОшибки("network.unavailable", "Сеть недоступна").Построить();
	Конструктор = Новый КонструкторОшибки("http.proxy_error", "Ошибка прокси")
		.Данные("Прокси", "proxy.example.org")
		.Подсказка("Проверьте настройки прокси")
		.URL("https://docs.example.org/proxy")
		.Причина(Причина);

	// Действие
	Ошибка = Конструктор.Построить();

	// Проверка
	ОжидаемоеОписание = "http.proxy_error: Ошибка прокси
	|
	|Подсказка:
	|  Проверьте настройки прокси
	|
	|URL:
	|  https://docs.example.org/proxy";
	Ожидаем.Что(Ошибка.Описание).Равно(ОжидаемоеОписание);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ДополнитьТекущийКонтекстЭффективнойОшибкой() Экспорт

	// Подготовка
	Ошибка = Новый КонструкторОшибки("config.invalid", "Некорректный JSON").Построить();
	Ошибка = Новый КонструкторОшибки(Неопределено, "Чтение настроек", ВидыКадровОшибок.Контекст())
		.Причина(Ошибка)
		.Построить();

	// Действие
	Ошибка = Новый КонструкторОшибки(Неопределено, "Загрузка приложения", ВидыКадровОшибок.Контекст())
		.Причина(Ошибка)
		.Построить();

	// Проверка
	Ожидаем.Что(Ошибка.Описание).Равно(
		"config.invalid: Загрузка приложения -> Некорректный JSON"
	);
	Ожидаем.Что(Ошибка.Параметры.КодЭффективнойОшибки).Равно("config.invalid");
	Ожидаем.Что(Ошибка.Параметры.СообщениеЭффективнойОшибки).Равно("Некорректный JSON");
	Ожидаем.Что((Новый ИсследовательОшибки(Ошибка)).КраткоеПредставление()).Равно(
		"config.invalid: Загрузка приложения -> Некорректный JSON"
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеДобавлятьПричинуСтандартнойПроверкиВОписание() Экспорт

	// Подготовка
	Попытка
		ПроверкаАргументов.ПроверитьТип("Значение", 42, Тип("Строка"));
	Исключение
		Причина = ИнформацияОбОшибке();
	КонецПопытки;

	// Действие
	Ошибка = Новый КонструкторОшибки("operation.failed", "Операция не выполнена")
		.Причина(Причина)
		.Построить();

	// Проверка
	Ожидаем.Что(Ошибка.Описание).Равно("operation.failed: Операция не выполнена");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПостроитьОшибкуЧерезFluentИнтерфейс() Экспорт

	// Подготовка
	Конструктор = Новый КонструкторОшибки("http.proxy_error", "Ошибка прокси");

	// Действие
	РезультатНастройки = Конструктор
		.Данные("Прокси", "proxy.example.org")
		.Данные("Порт", 3128)
		.Подсказка("Старая подсказка")
		.Подсказка("Проверьте настройки прокси");
	Ошибка = Конструктор.Построить();

	// Проверка
	Снимок = Новый СнимокКадраОшибки(Ошибка);
	Ожидаем.Что(РезультатНастройки).Равно(Конструктор);
	Ожидаем.Что(Снимок.Вид()).Равно(ВидыКадровОшибок.Ошибка());
	Ожидаем.Что(Снимок.Данные().Прокси).Равно("proxy.example.org");
	Ожидаем.Что(Снимок.Данные().Порт).Равно(3128);
	Ожидаем.Что(Снимок.Данные().Количество()).Равно(2);
	Ожидаем.Что(Снимок.Подсказка()).Равно("Проверьте настройки прокси");
	Ожидаем.Что(Ошибка.Причина).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ТестДолжен_УстановитьURL() Экспорт

	// Подготовка
