#Использовать asserts
#Использовать "fixtures"
#Использовать "../src"

#Область Тесты

&Тест
Процедура ТестДолжен_ПредставитьСмешаннуюЦепочку() Экспорт

	// Подготовка
	Данные = Новый Структура("Формат", "JSON");
	Причина = ФабрикаОшибок.Создать("fs.file_not_found", "Файл не найден");
	ВнешняяОшибка = ПомощникТестированияОшибок.ВнешняяОшибка(
		"Внешний кадр",
		Причина
	);
	ЭффективнаяОшибка = КонструкторыОшибок.Обернуть(
		ВнешняяОшибка,
		"config.load_failed",
		"Не удалось загрузить",
		Данные
	)
		.Подсказка("Проверьте файл")
		.Построить();
	Ошибка = ФабрикаОшибок.СКонтекстом(ЭффективнаяОшибка, "Загрузка конфигурации");

	// Действие
	Представление = Новый ИсследовательОшибки(Ошибка).ВСтруктуру();

	// Проверка
	Ожидаем.Что(Представление.Цепочка.Количество()).Равно(4);
	Ожидаем.Что(Представление.Цепочка[0].Вид).Равно("Контекст");
	Ожидаем.Что(Представление.Цепочка[1].КодОшибки).Равно("config.load_failed");
	Ожидаем.Что(Представление.Цепочка[1].Данные).Равно(Данные);
	Ожидаем.Что(Представление.ЭффективнаяОшибка).Равно(Представление.Цепочка[1]);
	Ожидаем.Что(Представление.ЦепочкаУсечена).Равно(Ложь);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПреобразоватьКадрыСтекаВСтруктуры() Экспорт

	// Подготовка
	Цепочка = ПомощникТестированияОшибок.ЦепочкаСРазнымиМестамиСоздания();
	ИсходныйКадр = Новый СнимокКадраОшибки(Цепочка.Ошибка).СтекВызовов()[0];

	// Действие
	Представление = Новый ИсследовательОшибки(Цепочка.Ошибка).ВСтруктуру();
	КадрСтека = Представление.Стек[0];

	// Проверка
	Ожидаем.Что(ТипЗнч(КадрСтека)).Равно(Тип("Структура"));
	Ожидаем.Что(КадрСтека.ИмяМодуля).Равно(ИсходныйКадр.ИмяМодуля);
	Ожидаем.Что(КадрСтека.НомерСтроки).Равно(ИсходныйКадр.НомерСтроки);
	Ожидаем.Что(Представление.Цепочка[0].Свойство("Стек")).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПредставитьВнешнююОшибкуБезЭффективной() Экспорт

	// Подготовка
	Ошибка = ПомощникТестированияОшибок.ВнешняяОшибка("Ошибка сторонней библиотеки");

	// Действие
	Представление = Новый ИсследовательОшибки(Ошибка).ВСтруктуру();

	// Проверка
	Ожидаем.Что(Представление.Цепочка.Количество()).Равно(1);
	Ожидаем.Что(Представление.Цепочка[0].Вид).Равно(ВидыКадровОшибок.ВнешняяОшибка());
	Ожидаем.Что(Представление.Цепочка[0].КодОшибки).Равно("");
	Ожидаем.Что(Представление.ЭффективнаяОшибка).Равно(Неопределено);
	Ожидаем.Что(Представление.ЦепочкаУсечена).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтметитьУсеченнуюЦепочку() Экспорт

	// Подготовка
	Цепочка = ПомощникТестированияОшибок.ДлиннаяЦепочка(65);

	// Действие
	Представление = Новый ИсследовательОшибки(Цепочка.Ошибка).ВСтруктуру();

	// Проверка
	Ожидаем.Что(Представление.Цепочка.Количество()).Равно(64);
	Ожидаем.Что(Представление.ЦепочкаУсечена).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьСсылкуНаДанныеОшибки() Экспорт

	// Подготовка
	Данные = Новый Структура("ДоПреобразования", Истина);
	Ошибка = ФабрикаОшибок.Создать("data.invalid", "Некорректные данные", Данные);

	// Действие
	Представление = Новый ИсследовательОшибки(Ошибка).ВСтруктуру();
	Данные.Вставить("ПослеПреобразования", Истина);

	// Проверка
	Ожидаем.Что(Представление.ЭффективнаяОшибка.Данные.ПослеПреобразования).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВключитьURLВСтруктурированноеПредставление() Экспорт

	// Подготовка
	Ошибка = КонструкторыОшибок.Создать("config.invalid", "Ошибка конфигурации")
		.URL("https://example.org/errors/config-invalid")
		.Построить();

	// Действие
	Представление = (Новый ИсследовательОшибки(Ошибка)).ВСтруктуру();

	// Проверка
	Ожидаем.Что(Представление.ЭффективнаяОшибка.URL).Равно("https://example.org/errors/config-invalid");
	Ожидаем.Что(Представление.Цепочка[0].URL).Равно("https://example.org/errors/config-invalid");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьСтабильныйНаборПолей() Экспорт

	// Подготовка
	Ошибка = ФабрикаОшибок.Создать("operation.failed", "Операция завершилась с ошибкой");

	// Действие
	Представление = Новый ИсследовательОшибки(Ошибка).ВСтруктуру();
	Кадр = Представление.Цепочка[0];

	// Проверка
	Ожидаем.Что(Представление.Количество()).Равно(4);
	Ожидаем.Что(Представление.Свойство("Кадры")).ЭтоЛожь();
	Ожидаем.Что(Кадр.Количество()).Равно(9);
	Ожидаем.Что(Кадр.Свойство("Вид")).ЭтоИстина();
	Ожидаем.Что(Кадр.Свойство("КодОшибки")).ЭтоИстина();
	Ожидаем.Что(Кадр.Свойство("Сообщение")).ЭтоИстина();
	Ожидаем.Что(Кадр.Свойство("Данные")).ЭтоИстина();
	Ожидаем.Что(Кадр.Свойство("Подсказка")).ЭтоИстина();
	Ожидаем.Что(Кадр.Свойство("ИмяМодуля")).ЭтоИстина();
	Ожидаем.Что(Кадр.Свойство("НомерСтроки")).ЭтоИстина();
	Ожидаем.Что(Кадр.Свойство("ИсходнаяСтрока")).ЭтоИстина();
	Ожидаем.Что(Представление.Свойство("Стек")).ЭтоИстина();

КонецПроцедуры

#КонецОбласти
