Перем _МаркерМетаданных; // Строка
Перем _ВерсияФормата; // Число

#Область ОбработчикиСобытий

// Создает описание формата метаданных кадра ошибки.
Процедура ПриСозданииОбъекта()

	_МаркерМетаданных = "onescript.exception.envelope";
	_ВерсияФормата = 1;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Возвращает стабильный маркер внутренних метаданных кадра.
//
// Возвращаемое значение:
//  Строка - Маркер метаданных кадра.
Функция МаркерМетаданных() Экспорт

	Возврат _МаркерМетаданных;

КонецФункции

// Возвращает текущую версию формата внутренних метаданных кадра.
//
// Возвращаемое значение:
//  Число - Версия формата метаданных кадра.
Функция ВерсияФормата() Экспорт

	Возврат _ВерсияФормата;

КонецФункции

#КонецОбласти
