#Область ПрограммныйИнтерфейс

// Создаёт внешний кадр с необязательной причиной.
//
// Параметры:
//  Сообщение - Строка - Описание внешнего кадра.
//  Причина - ИнформацияОбОшибке, Неопределено - Причина внешнего кадра.
//
// Возвращаемое значение:
//  ИнформацияОбОшибке - Новый внешний кадр.
Функция ВнешняяОшибка(Сообщение, Причина = Неопределено) Экспорт

	Если Причина = Неопределено Тогда
		Возврат Новый ИнформацияОбОшибке(Сообщение, Новый Структура("Источник", "Тест"));
	КонецЕсли;

	Возврат Новый ИнформацияОбОшибке(Сообщение, Новый Структура("Источник", "Тест"), Причина);

КонецФункции

// Создаёт цепочку внешних кадров заданной длины.
//
// Параметры:
//  Длина - Число - Количество кадров в цепочке.
//
// Возвращаемое значение:
//  Структура - Поля Ошибка и Корень содержат внешний и корневой кадры.
Функция ДлиннаяЦепочка(Длина) Экспорт

	Корень = ВнешняяОшибка("Внешний кадр 1");
	Ошибка = Корень;

	Для НомерКадра = 2 По Длина Цикл
		Ошибка = ВнешняяОшибка(СтрШаблон("Внешний кадр %1", НомерКадра), Ошибка);
	КонецЦикла;

	Возврат Новый Структура("Ошибка, Корень", Ошибка, Корень);

КонецФункции

// Повторно выбрасывает сохранённую ошибку и возвращает результат перехвата.
//
// Параметры:
//  Ошибка - ИнформацияОбОшибке - Повторно выбрасываемая ошибка.
//
// Возвращаемое значение:
//  ИнформацияОбОшибке - Перехваченная ошибка.
Функция ПовторноВыброшеннаяОшибка(Ошибка) Экспорт

	Попытка
		ВызватьИсключение Ошибка;
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

КонецФункции

// Создаёт кадр с повреждённым конвертом без обязательного поля Данные.
//
// Параметры:
//  Образец - ИнформацияОбОшибке - Собственный кадр для получения метаданных.
//  Причина - ИнформацияОбОшибке - Причина создаваемого кадра.
//
// Возвращаемое значение:
//  ИнформацияОбОшибке - Кадр с повреждённым конвертом.
Функция ОшибкаСПоврежденнымКонвертом(Образец, Причина) Экспорт

	Поля = Новый Структура;
	Поля.Вставить("Маркер", Образец.Параметры.Маркер);
	Поля.Вставить("Вид", Образец.Параметры.Вид);
	Поля.Вставить("ТипОшибки", 42);

	Возврат Новый ИнформацияОбОшибке("Повреждённый конверт", Новый ФиксированнаяСтруктура(Поля), Причина);

КонецФункции

// Создаёт кадр с корректной формой конверта и чужим маркером.
//
// Параметры:
//  Образец - ИнформацияОбОшибке - Собственный кадр для получения метаданных.
//  Причина - ИнформацияОбОшибке - Причина создаваемого кадра.
//
// Возвращаемое значение:
//  ИнформацияОбОшибке - Кадр с чужим маркером.
Функция ОшибкаСЧужимМаркером(Образец, Причина) Экспорт

	Поля = Новый Структура;
	Поля.Вставить("Маркер", "foreign.error.envelope");
	Поля.Вставить("Вид", Образец.Параметры.Вид);
	Поля.Вставить("ТипОшибки", "foreign.hidden_error");
	Поля.Вставить("Данные", Неопределено);

	Возврат Новый ИнформацияОбОшибке("Чужой маркер", Новый ФиксированнаяСтруктура(Поля), Причина);

КонецФункции

#КонецОбласти
