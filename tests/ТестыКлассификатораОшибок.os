&Тест
Процедура ТестДолжен_ПовторитьЗагрузкуПоставщикаПослеОшибки() Экспорт

	// Подготовка
	Поставщик = Новый ТестовыйПоставщикПравил;
	Поставщик.ЗавершитьСледующиеВызовыОшибкой();
	Классификатор = Новый КлассификаторОшибок;
	Классификатор.ДобавитьПоставщикаПравил(Поставщик);
	ОшибкаВозникла = Ложь;

	// Действие
	Попытка
		Классификатор.Классифицировать(ОшибкаССообщением("Сообщение поставщика"));
	Исключение
		ОшибкаВозникла = Истина;
	КонецПопытки;

	Результат = Классификатор.Классифицировать(ОшибкаССообщением("Сообщение поставщика"));

	// Проверка
	Ожидаем.Что(ОшибкаВозникла).ЭтоИстина();
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Результат)).Равно("test.provider");
	Ожидаем.Что(Поставщик.КоличествоВызововВсе()).Равно(2);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьПодготовленногоПоставщикаПослеОшибкиСледующего() Экспорт

	// Подготовка
	ПервыйПоставщик = Новый ТестовыйПоставщикПравил;
	ВторойПоставщик = Новый ТестовыйПоставщикПравил(Новый Массив);
	ВторойПоставщик.ЗавершитьСледующиеВызовыОшибкой();
	Классификатор = Новый КлассификаторОшибок;
	Классификатор.ДобавитьПоставщикаПравил(ПервыйПоставщик);
	Классификатор.ДобавитьПоставщикаПравил(ВторойПоставщик);

	// Действие
	Попытка
		Классификатор.Классифицировать(ОшибкаССообщением("Сообщение поставщика"));
	Исключение
	КонецПопытки;

	Результат = Классификатор.Классифицировать(ОшибкаССообщением("Сообщение поставщика"));

	// Проверка
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Результат)).Равно("test.provider");
	Ожидаем.Что(ПервыйПоставщик.КоличествоВызововВсе()).Равно(1);
	Ожидаем.Что(ВторойПоставщик.КоличествоВызововВсе()).Равно(2);

КонецПроцедуры

