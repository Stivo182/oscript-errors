// Демонстрирует создание, выбрасывание и исследование классифицированной ошибки.
// Fluent-конструктор позволяет задать подсказку до построения ошибки.

#Использовать errors

Ошибка = КонструкторыОшибок.Создать(
	"storage.quota_exceeded",
	"Недостаточно места в хранилище"
)
	.Данные("ТребуетсяМБ", 800)
	.Данные("ДоступноМБ", 250)
	.Подсказка("Освободите место или увеличьте квоту")
	.Построить();

Попытка
	ВызватьИсключение Ошибка;
Исключение
	Исследователь = ДиагностикаОшибок.Исследовать(ИнформацияОбОшибке());
	Данные = Исследователь.Данные();

	Сообщить("Код: " + Исследователь.КодОшибки());
	Сообщить(СтрШаблон("Требуется %1 МБ, доступно %2 МБ", Данные.ТребуетсяМБ, Данные.ДоступноМБ));
	Сообщить("Подсказка: " + Исследователь.Подсказка());
КонецПопытки;
