#Использовать logos

Перем _Лог; // Лог

#Область СлужебныйПрограммныйИнтерфейс

// Записывает отладочную диагностику подавленного внутреннего сбоя.
// Ошибка логирования не должна изменять основной поток выполнения.
//
// Параметры:
//  Операция - Строка - Стабильный идентификатор внутренней операции.
//  Значение - Произвольный - Значение, тип которого включается в событие.
//  Ошибка - ИнформацияОбОшибке - Подавленная внутренняя ошибка.
Процедура ЗаписатьПодавленныйСбой(Операция, Значение, Ошибка) Экспорт

	Попытка
		_Лог.Поля(
			"Событие", "errors.internal.failure_suppressed",
			"Операция", Операция,
			"ТипЗначения", Строка(ТипЗнч(Значение)),
			"ОписаниеОшибки", Ошибка.Описание
		).Отладка("Подавлена внутренняя ошибка библиотеки");
	Исключение
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

_Лог = Логирование.ПолучитьЛог("oscript.lib.errors");
