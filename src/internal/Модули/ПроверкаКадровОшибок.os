Перем _РегулярноеВыражениеКодаОшибки; // РегулярноеВыражение

#Область СлужебныйПрограммныйИнтерфейс

// Проверяет корректность машинного кода ошибки.
//
// Параметры:
//  Значение - Произвольный - Проверяемое значение.
//
// Возвращаемое значение:
//  Булево - Истина, если значение является корректным кодом ошибки.
Функция КорректныйКодОшибки(Значение) Экспорт

	Возврат ТипЗнч(Значение) = Тип("Строка")
		И РегулярноеВыражениеКодаОшибки().Совпадает(Значение);

КонецФункции

// Проверяет корректность сообщения ошибки.
//
// Параметры:
//  Значение - Произвольный - Проверяемое значение.
//
// Возвращаемое значение:
//  Булево - Истина, если значение является непустой строкой.
Функция КорректноеСообщение(Значение) Экспорт

	Возврат ТипЗнч(Значение) = Тип("Строка") И Не ПустаяСтрока(Значение);

КонецФункции

// Проверяет корректность подсказки ошибки.
//
// Параметры:
//  Значение - Произвольный - Проверяемое значение.
//
// Возвращаемое значение:
//  Булево - Истина, если значение является строкой.
Функция КорректнаяПодсказка(Значение) Экспорт

	Возврат ТипЗнч(Значение) = Тип("Строка");

КонецФункции

// Проверяет корректность URL документации ошибки.
//
// Параметры:
//  Значение - Произвольный - Проверяемое значение.
//
// Возвращаемое значение:
//  Булево - Истина, если значение является строкой.
Функция КорректныйURL(Значение) Экспорт

	Возврат ТипЗнч(Значение) = Тип("Строка");

КонецФункции

// Проверяет корректность причины ошибки.
//
// Параметры:
//  Значение - Произвольный - Проверяемое значение.
//
// Возвращаемое значение:
//  Булево - Истина, если значение является информацией об ошибке или Неопределено.
Функция КорректнаяПричина(Значение) Экспорт

	Возврат Значение = Неопределено Или ТипЗнч(Значение) = Тип("ИнформацияОбОшибке");

КонецФункции

// Проверяет машинный код ошибки и выбрасывает исключение при нарушении контракта.
//
// Параметры:
//  Значение - Произвольный - Проверяемое значение.
Процедура ПроверитьКодОшибки(Значение) Экспорт

	ПроверкаАргументов.ПроверитьТип("КодОшибки", Значение, Тип("Строка"));

	ПроверкаАргументов.ПроверитьДопустимость(
		"КодОшибки",
		КорректныйКодОшибки(Значение),
		"формату кода",
		НСтр("ru = 'Код ошибки имеет неверный формат'; en = 'Error code has an invalid format'")
	);

КонецПроцедуры

// Проверяет сообщение ошибки и выбрасывает исключение при нарушении контракта.
//
// Параметры:
//  Значение - Произвольный - Проверяемое значение.
Процедура ПроверитьСообщение(Значение) Экспорт

	ПроверкаАргументов.ПроверитьТип("Сообщение", Значение, Тип("Строка"));
	ПроверкаАргументов.ПроверитьЗаполненность("Сообщение", Значение);

КонецПроцедуры

// Проверяет подсказку ошибки и выбрасывает исключение при нарушении контракта.
//
// Параметры:
//  Значение - Произвольный - Проверяемое значение.
Процедура ПроверитьПодсказку(Значение) Экспорт

	ПроверкаАргументов.ПроверитьТип("Подсказка", Значение, Тип("Строка"));

КонецПроцедуры

// Проверяет URL документации ошибки и выбрасывает исключение при нарушении контракта.
//
// Параметры:
//  Значение - Произвольный - Проверяемое значение.
Процедура ПроверитьURL(Значение) Экспорт

	ПроверкаАргументов.ПроверитьТип("URL", Значение, Тип("Строка"));

КонецПроцедуры

// Проверяет причину ошибки и выбрасывает исключение при нарушении контракта.
//
// Параметры:
//  Значение - Произвольный - Проверяемое значение.
Процедура ПроверитьПричину(Значение) Экспорт

	Если Значение <> Неопределено Тогда
		ПроверкаАргументов.ПроверитьТип("Причина", Значение, Тип("ИнформацияОбОшибке"));
	КонецЕсли;

КонецПроцедуры

// Проверяет входной объект ошибки.
//
// Параметры:
//  Значение - Произвольный - Проверяемое значение.
Процедура ПроверитьОшибку(Значение) Экспорт

	ПроверкаАргументов.ПроверитьТип("Ошибка", Значение, Тип("ИнформацияОбОшибке"));

КонецПроцедуры

// Проверяет поля кадра ошибки и их согласованность с видом кадра.
//
// Параметры:
//  Вид - Строка - Вид кадра ошибки.
//  КодОшибки - Строка, Неопределено - Машинный код ошибки.
//  Сообщение - Строка - Человекочитаемое описание ошибки.
//  Причина - ИнформацияОбОшибке, Неопределено - Непосредственная причина.
//  Подсказка - Строка - Подсказка по исправлению ошибки.
//  URL - Строка - URL документации ошибки.
Процедура ПроверитьКадр(Вид, КодОшибки, Сообщение, Причина, Подсказка, URL) Экспорт

	ПроверкаАргументов.ПроверитьТип("Вид", Вид, Тип("Строка"));

	ПроверкаАргументов.ПроверитьОдноИз(
		"Вид",
		Вид,
		ДопустимыеВидыКадров(),
		НСтр("ru = 'Вид кадра ошибки не поддерживается'; en = 'Error frame kind is not supported'")
	);

	Если КодОшибки <> Неопределено Тогда
		ПроверкаАргументов.ПроверитьТип("КодОшибки", КодОшибки, Тип("Строка"));
	КонецЕсли;

	ПроверитьСообщение(Сообщение);
	ПроверитьПричину(Причина);
	ПроверитьПодсказку(Подсказка);
	ПроверитьURL(URL);

	Если Вид = ВидыКадровОшибок.Ошибка() Тогда
		ПроверитьКодОшибки(КодОшибки);
		Возврат;
	КонецЕсли;

	ПроверитьКонтекстныйКадр(КодОшибки, Причина, Подсказка, URL);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьКонтекстныйКадр(КодОшибки, Причина, Подсказка, URL)

	ПроверкаАргументов.ПроверитьРавенство(
		"КодОшибки",
		КодОшибки,
		Неопределено
	);

	ПроверкаАргументов.ПроверитьРавенство(
		"Подсказка",
		Подсказка,
		""
	);

	ПроверкаАргументов.ПроверитьРавенство(
		"URL",
		URL,
		""
	);

	ПроверкаАргументов.ПроверитьЗаполненность(
		"Причина",
		Причина,
		НСтр("ru = 'Контекстный кадр должен иметь причину'; en = 'Context frame must have a cause'")
	);

КонецПроцедуры

Функция ДопустимыеВидыКадров()

	Значения = Новый Массив;
	Значения.Добавить(ВидыКадровОшибок.Ошибка());
	Значения.Добавить(ВидыКадровОшибок.Контекст());

	Возврат Новый ФиксированныйМассив(Значения);

КонецФункции

Функция РегулярноеВыражениеКодаОшибки()

	Если _РегулярноеВыражениеКодаОшибки = Неопределено Тогда
		_РегулярноеВыражениеКодаОшибки = Новый РегулярноеВыражение(
			"\A[a-zA-Zа-яА-ЯёЁ][a-zA-Zа-яА-ЯёЁ0-9_]*"
			+ "(\.[a-zA-Zа-яА-ЯёЁ][a-zA-Zа-яА-ЯёЁ0-9_]*)+\z"
		);
		_РегулярноеВыражениеКодаОшибки.ИгнорироватьРегистр = Истина;
		_РегулярноеВыражениеКодаОшибки.Многострочный = Ложь;
	КонецЕсли;

	Возврат _РегулярноеВыражениеКодаОшибки;

КонецФункции

#КонецОбласти
