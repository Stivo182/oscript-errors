#Использовать asserts
#Использовать "fixtures"
#Использовать "../src"
#Использовать "../src/internal"

Перем _ФорматировщикПредставления; // ФорматировщикПредставленияОшибок

#Область Тесты

&Тест
Процедура ТестДолжен_ВывестиВсеПодсказкиОтдельноПослеПричин() Экспорт

	// Подготовка
	Снимки = Новый Массив;
	Снимки.Добавить(Новый ТестовыйСнимокКадраОшибки(
		Новый Структура(
			"Вид, КодОшибки, Сообщение, Подсказка",
			ВидыКадровОшибок.Ошибка(),
			"application.failed",
			"Не удалось выполнить операцию",
			"Проверьте настройки приложения"
		)
	));
	Снимки.Добавить(Новый ТестовыйСнимокКадраОшибки(
		Новый Структура(
			"Вид, КодОшибки, Сообщение, Подсказка",
			ВидыКадровОшибок.Ошибка(),
			"service.unavailable",
			"Сервис недоступен",
			"Повторите запрос позднее"
		)
	));

	// Действие
	Представление = _ФорматировщикПредставления.ДиагностическоеПредставление(Снимки, Ложь);

	// Проверка
	Ожидаем.Что(Представление).Равно("application.failed: Не удалось выполнить операцию
	|
	|Причина:
	|  service.unavailable: Сервис недоступен
	|
	|Подсказка:
	|  1: Проверьте настройки приложения
	|  2: Повторите запрос позднее");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СобратьПодсказкуКонтекстногоКадра() Экспорт

	// Подготовка
	Снимки = Новый Массив;
	Снимки.Добавить(Новый ТестовыйСнимокКадраОшибки(
		Новый Структура(
			"Вид, Сообщение, Подсказка",
			ВидыКадровОшибок.Контекст(),
			"Выполнение запроса",
			"Проверьте параметры запроса"
		)
	));
	Снимки.Добавить(Новый ТестовыйСнимокКадраОшибки(
		Новый Структура(
			"Вид, КодОшибки, Сообщение",
			ВидыКадровОшибок.Ошибка(),
			"service.failed",
			"Сервис вернул ошибку"
		)
	));

	// Действие
	Представление = _ФорматировщикПредставления.ДиагностическоеПредставление(Снимки, Ложь);

	// Проверка
	Ожидаем.Что(Представление).Содержит(
		"Подсказка:" + Символы.ПС + "  Проверьте параметры запроса"
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВыровнятьПродолжениеДесятойПодсказки() Экспорт

	// Подготовка
	Снимки = Новый Массив;
	Для Номер = 1 По 10 Цикл
		Подсказка = "Подсказка " + Строка(Номер);
		Если Номер = 10 Тогда
			Подсказка = "Первый шаг" + Символы.ПС + "Второй шаг";
		КонецЕсли;
		Снимки.Добавить(Новый ТестовыйСнимокКадраОшибки(
			Новый Структура(
				"Вид, КодОшибки, Сообщение, Подсказка",
				ВидыКадровОшибок.Ошибка(),
				"service.failed",
				"Ошибка сервиса " + Строка(Номер),
				Подсказка
			)
		));
	КонецЦикла;

	// Действие
	Представление = _ФорматировщикПредставления.ДиагностическоеПредставление(Снимки, Ложь);

	// Проверка
	Ожидаем.Что(Представление).Содержит(
		"  10: Первый шаг" + Символы.ПС + "      Второй шаг"
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЛокализоватьЗаголовокПодсказкиПользовательскогоПредставления() Экспорт

	// Подготовка
	Снимки = Новый Массив;
	Снимки.Добавить(Новый ТестовыйСнимокКадраОшибки(
		Новый Структура(
			"Вид, КодОшибки, Сообщение, Подсказка",
			ВидыКадровОшибок.Ошибка(),
			"application.failed",
			"Operation failed",
			"Retry the operation"
		)
	));

	// Действие
	Представление = _ФорматировщикПредставления.ПользовательскоеПредставление(Снимки);

	// Проверка
	Ожидаем.Что(Представление).Содержит(
		НСтр("ru = 'Подсказка:'; en = 'Hint:'") + Символы.ПС + "  Retry the operation"
	);
	Если ЭтоАнглийскаяЛокаль() Тогда
		ПроверитьОтсутствиеСтрок(Представление, РусскиеЗаголовкиДиагностическогоПредставления());
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Пробелы(Количество)

	Результат = "";
	Для Номер = 1 По Количество Цикл
		Результат = Результат + " ";
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция РусскиеЗаголовкиДиагностическогоПредставления()

	Результат = Новый Массив;
	Результат.Добавить("Причина:");
	Результат.Добавить("Контекст:");
	Результат.Добавить("Данные:");
	Результат.Добавить("Место:");
	Результат.Добавить("Строка:");
	Результат.Добавить("Исходная строка:");
	Результат.Добавить("Подсказка:");
	Результат.Добавить("Стек вызовов:");
	Результат.Добавить("Цепочка причин усечена");
	Результат.Добавить("Контекст без просмотренной причины:");

	Возврат Результат;

КонецФункции

Функция ЭтоАнглийскаяЛокаль()

	Возврат НСтр("ru = 'ru'; en = 'en'") = "en";

КонецФункции

Процедура ПроверитьОтсутствиеСтрок(Текст, ЗапрещенныеСтроки)

	Для Каждого ЗапрещеннаяСтрока Из ЗапрещенныеСтроки Цикл
		Ожидаем.Что(СтрЧислоВхождений(Текст, ЗапрещеннаяСтрока)).Равно(0);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

_ФорматировщикПредставления = Новый ФорматировщикПредставленияОшибок();
