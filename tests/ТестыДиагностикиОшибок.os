#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СмешаннаяЦепочка()

	ДанныеВнутреннейОшибки = Новый Структура("Путь", "config.json");
	ВнутренняяОшибка = ФабрикаОшибок.Создать("fs.file_not_found", "Файл не найден", ДанныеВнутреннейОшибки);
	ВнешняяОшибка = ПомощникТестированияОшибок.ВнешняяОшибка("Ошибка JSON-парсера", ВнутренняяОшибка);
	ДанныеЭффективнойОшибки = Новый Структура("Формат", "JSON");
	ЭффективнаяОшибка = ФабрикаОшибок.Обернуть(
		ВнешняяОшибка,
		"config.load_failed",
		"Не удалось загрузить конфигурацию",
		ДанныеЭффективнойОшибки
	);
	Контекст = ФабрикаОшибок.СКонтекстом(ЭффективнаяОшибка, "Загрузка конфигурации");

	Возврат Новый Структура(
		"Ошибка, Контекст, ЭффективнаяОшибка, ВнешняяОшибка, ВнутренняяОшибка, ДанныеЭффективнойОшибки",
		Контекст,
		Контекст,
		ЭффективнаяОшибка,
		ВнешняяОшибка,
		ВнутренняяОшибка,
		ДанныеЭффективнойОшибки
	);

КонецФункции

Процедура ПроверитьПорядокКадров(ФактическиеКадры, ОжидаемыеКадры)

	Ожидаем.Что(ФактическиеКадры.Количество()).Равно(ОжидаемыеКадры.Количество());

	Для НомерКадра = 0 По ОжидаемыеКадры.ВГраница() Цикл
		Ожидаем.Что(ФактическиеКадры[НомерКадра]).Равно(ОжидаемыеКадры[НомерКадра]);
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьНеверныйТипВходногоАргумента(ИмяМетода, Параметры)

	Ожидаем.Что(ДиагностикаОшибок)
		.Метод(ИмяМетода, Параметры)
		.ВыбрасываетИсключение("Ошибка должна иметь тип ИнформацияОбОшибке");

КонецПроцедуры

#КонецОбласти
