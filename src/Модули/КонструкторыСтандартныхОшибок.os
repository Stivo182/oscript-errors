#Использовать "../internal"

#Область ПрограммныйИнтерфейс

// Возвращает конструктор для ошибки неверного типа аргумента.
//
// Параметры:
//  ИмяАргумента - Строка - Имя аргумента с неверным типом.
//  ОжидаемыйТип - Строка - Строковое представление ожидаемого типа.
//  ФактическоеЗначение - Произвольный - Значение с неверным типом.
//  Сообщение - Строка - Человекочитаемое описание ошибки.
//
// Возвращаемое значение:
//  КонструкторОшибки - Настроенный конструктор ошибки.
Функция НеверныйТипАргумента(ИмяАргумента, ОжидаемыйТип, ФактическоеЗначение, Сообщение = "") Экспорт

	ПроверкаАргументов.ПроверитьТип("ИмяАргумента", ИмяАргумента, Тип("Строка"));
	ПроверкаАргументов.ПроверитьЗаполненность("ИмяАргумента", ИмяАргумента);
	ПроверкаАргументов.ПроверитьТип("ОжидаемыйТип", ОжидаемыйТип, Тип("Строка"));
	ПроверкаАргументов.ПроверитьЗаполненность("ОжидаемыйТип", ОжидаемыйТип);
	ПроверкаАргументов.ПроверитьТип("Сообщение", Сообщение, Тип("Строка"));

	КодОшибки = "argument.invalid_type";
	Сообщение = СообщенияОшибокАргументов.НеверныйТип(ИмяАргумента, ОжидаемыйТип, Сообщение);
	Данные = Новый Структура(
		"ИмяАргумента, ОжидаемыйТип, ФактическийТип",
		ИмяАргумента,
		ОжидаемыйТип,
		Строка(ТипЗнч(ФактическоеЗначение))
	);

	Возврат СоздатьОшибку(КодОшибки, Сообщение, Данные);

КонецФункции

// Возвращает конструктор для ошибки незаполненного обязательного аргумента.
//
// Параметры:
//  ИмяАргумента - Строка - Имя незаполненного аргумента.
//  Сообщение - Строка - Человекочитаемое описание ошибки.
//
// Возвращаемое значение:
//  КонструкторОшибки - Настроенный конструктор ошибки.
Функция АргументНеЗаполнен(ИмяАргумента, Сообщение = "") Экспорт

	ПроверкаАргументов.ПроверитьТип("ИмяАргумента", ИмяАргумента, Тип("Строка"));
	ПроверкаАргументов.ПроверитьЗаполненность("ИмяАргумента", ИмяАргумента);
	ПроверкаАргументов.ПроверитьТип("Сообщение", Сообщение, Тип("Строка"));

	КодОшибки = "argument.required";
	Сообщение = СообщенияОшибокАргументов.НеЗаполнен(ИмяАргумента, Сообщение);
	Данные = Новый Структура("ИмяАргумента", ИмяАргумента);

	Возврат СоздатьОшибку(КодОшибки, Сообщение, Данные);

КонецФункции

// Возвращает конструктор для ошибки недопустимого значения аргумента.
//
// Параметры:
//  ИмяАргумента - Строка - Имя аргумента с недопустимым значением.
//  Ожидание - Строка - Описание допустимого значения или ограничения.
//  Сообщение - Строка - Человекочитаемое описание ошибки.
//
// Возвращаемое значение:
//  КонструкторОшибки - Настроенный конструктор ошибки.
Функция НедопустимоеЗначениеАргумента(ИмяАргумента, Ожидание, Сообщение = "") Экспорт

	ПроверкаАргументов.ПроверитьТип("ИмяАргумента", ИмяАргумента, Тип("Строка"));
	ПроверкаАргументов.ПроверитьЗаполненность("ИмяАргумента", ИмяАргумента);
	ПроверкаАргументов.ПроверитьТип("Ожидание", Ожидание, Тип("Строка"));
	ПроверкаАргументов.ПроверитьЗаполненность("Ожидание", Ожидание);
	ПроверкаАргументов.ПроверитьТип("Сообщение", Сообщение, Тип("Строка"));

	КодОшибки = "argument.invalid_value";
	Сообщение = СообщенияОшибокАргументов.НедопустимоеЗначение(ИмяАргумента, Ожидание, Сообщение);
	Данные = Новый Структура("ИмяАргумента, Ожидание", ИмяАргумента, Ожидание);

	Возврат СоздатьОшибку(КодОшибки, Сообщение, Данные);

КонецФункции

// Возвращает конструктор для ошибки аргумента вне допустимого диапазона.
//
// Параметры:
//  ИмяАргумента - Строка - Имя аргумента вне диапазона.
//  ОжидаемыйДиапазон - Строка - Описание допустимого диапазона.
//  Сообщение - Строка - Человекочитаемое описание ошибки.
//
// Возвращаемое значение:
//  КонструкторОшибки - Настроенный конструктор ошибки.
Функция АргументВнеДиапазона(ИмяАргумента, ОжидаемыйДиапазон, Сообщение = "") Экспорт

	ПроверкаАргументов.ПроверитьТип("ИмяАргумента", ИмяАргумента, Тип("Строка"));
	ПроверкаАргументов.ПроверитьЗаполненность("ИмяАргумента", ИмяАргумента);
	ПроверкаАргументов.ПроверитьТип("ОжидаемыйДиапазон", ОжидаемыйДиапазон, Тип("Строка"));
	ПроверкаАргументов.ПроверитьЗаполненность("ОжидаемыйДиапазон", ОжидаемыйДиапазон);
	ПроверкаАргументов.ПроверитьТип("Сообщение", Сообщение, Тип("Строка"));

	КодОшибки = "argument.out_of_range";
	Сообщение = СообщенияОшибокАргументов.ВнеДиапазона(ИмяАргумента, ОжидаемыйДиапазон, Сообщение);
	Данные = Новый Структура(
		"ИмяАргумента, ОжидаемыйДиапазон",
		ИмяАргумента,
		ОжидаемыйДиапазон
	);

	Возврат СоздатьОшибку(КодОшибки, Сообщение, Данные);

КонецФункции

// Возвращает конструктор для ошибки отменённой операции.
//
// Параметры:
//  ИмяОперации - Строка - Имя отменённой операции.
//  Сообщение - Строка - Человекочитаемое описание ошибки.
//
// Возвращаемое значение:
//  КонструкторОшибки - Настроенный конструктор ошибки.
Функция ОперацияОтменена(ИмяОперации, Сообщение = "") Экспорт

	ПроверитьСтандартныйПараметр("ИмяОперации", ИмяОперации, Сообщение);

	Возврат СоздатьОднопараметрическуюОшибку(
		"operation.cancelled",
		"ИмяОперации",
		ИмяОперации,
		НСтр("ru = 'Операция ''%1'' отменена'; en = 'Operation ''%1'' was cancelled'"),
		Сообщение
	);

КонецФункции

// Возвращает конструктор для ошибки операции, недопустимой в текущем состоянии.
//
// Параметры:
//  ИмяОперации - Строка - Имя недопустимой операции.
//  Сообщение - Строка - Человекочитаемое описание ошибки.
//
// Возвращаемое значение:
//  КонструкторОшибки - Настроенный конструктор ошибки.
Функция ОперацияВНедопустимомСостоянии(ИмяОперации, Сообщение = "") Экспорт

	ПроверитьСтандартныйПараметр("ИмяОперации", ИмяОперации, Сообщение);

	Возврат СоздатьОднопараметрическуюОшибку(
		"operation.invalid_state",
		"ИмяОперации",
		ИмяОперации,
		НСтр(
			"ru = 'Операция ''%1'' недопустима в текущем состоянии';"
			+ "en = 'Operation ''%1'' is invalid in the current state'"
		),
		Сообщение
	);

КонецФункции

