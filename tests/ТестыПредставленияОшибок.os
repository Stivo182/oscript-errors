#Область Тесты

&Тест
Процедура ТестДолжен_ВернутьКраткоеПредставлениеСмешаннойЦепочки() Экспорт

	// Подготовка
	Цепочка = СмешаннаяЦепочка();

	// Действие
	Представление = ДиагностикаОшибок.КраткоеПредставление(Цепочка.Ошибка);

	// Проверка
	Ожидаем.Что(Представление).Равно(
		"[config.load_failed] Загрузка конфигурации: Не удалось загрузить конфигурацию"
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьСообщениеВнешнегоКадраВКраткомПредставлении() Экспорт

	// Подготовка
	Ошибка = ПомощникТестированияОшибок.ВнешняяОшибка("Ошибка JSON-парсера");

	// Действие
	Представление = ДиагностикаОшибок.КраткоеПредставление(Ошибка);

	// Проверка
	Ожидаем.Что(Представление).Равно("Ошибка JSON-парсера");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьПустоеСообщениеПервогоВнешнегоКадра() Экспорт

	// Подготовка
	Корень = ПомощникТестированияОшибок.ВнешняяОшибка("Корневая ошибка");
	Ошибка = ПомощникТестированияОшибок.ВнешняяОшибка("", Корень);

	// Действие
	Представление = ДиагностикаОшибок.КраткоеПредставление(Ошибка);

	// Проверка
	Ожидаем.Что(Представление).Равно("");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьПодробноеПредставлениеВсехКадров() Экспорт

	// Подготовка
	Цепочка = СмешаннаяЦепочка();

	// Действие
	Представление = ДиагностикаОшибок.ПодробноеПредставление(Цепочка.Ошибка);

	// Проверка
	Ожидаем.Что(Представление).Содержит("#0 [Контекст] Загрузка конфигурации");
	Ожидаем.Что(Представление).Содержит("#1 [Ошибка: config.load_failed] Не удалось загрузить конфигурацию");
	Ожидаем.Что(Представление).Содержит("#2 [Внешняя ошибка] Ошибка JSON-парсера");
	Ожидаем.Что(Представление).Содержит("#3 [Ошибка: fs.file_not_found] Файл не найден");
	Ожидаем.Что(Представление).Содержит("    Данные:");
	Ожидаем.Что(СтрНайти(Представление, "#0 [Контекст]")).Меньше(
		СтрНайти(Представление, "#1 [Ошибка: config.load_failed]")
	);
	Ожидаем.Что(СтрНайти(Представление, "#1 [Ошибка: config.load_failed]")).Меньше(
		СтрНайти(Представление, "#2 [Внешняя ошибка]")
	);
	Ожидаем.Что(СтрНайти(Представление, "#2 [Внешняя ошибка]")).Меньше(
		СтрНайти(Представление, "#3 [Ошибка: fs.file_not_found]")
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПродолжитьПодробноеПредставлениеПриОшибкеПреобразованияДанных() Экспорт

	// Подготовка
	Ошибка = ФабрикаОшибок.Создать("core.failed", "Ошибка", Новый НепредставимоеЗначение);

	// Действие
	Представление = ДиагностикаОшибок.ПодробноеПредставление(Ошибка);

	// Проверка
	Ожидаем.Что(Представление).Содержит("    Данные: <недоступно>");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтметитьУсечениеВПодробномПредставлении() Экспорт

	// Подготовка
	Цепочка = ДлиннаяВыброшеннаяЦепочка(65);

	// Действие
	Представление = ДиагностикаОшибок.ПодробноеПредставление(Цепочка.Ошибка);

	// Проверка
	Ожидаем.Что(Представление).Содержит("Цепочка усечена");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьНеверныйТипАргументаТекстовыхПредставлений() Экспорт

	// Подготовка
	Параметры = Новый Массив;
	Параметры.Добавить("не ошибка");

	// Действие и Проверка
	Ожидаем.Что(ДиагностикаОшибок)
		.Метод("КраткоеПредставление", Параметры)
		.ВыбрасываетИсключение("Ошибка должна иметь тип ИнформацияОбОшибке");
	Ожидаем.Что(ДиагностикаОшибок)
		.Метод("ПодробноеПредставление", Параметры)
		.ВыбрасываетИсключение("Ошибка должна иметь тип ИнформацияОбОшибке");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВывестиПодсказкуТолькоВПодробномПредставлении() Экспорт

	// Подготовка
	Ошибка = ФабрикаОшибок.Создать(
		"http.proxy_error",
		"Ошибка прокси",
		Неопределено,
		"Проверьте настройки прокси"
	);

	// Действие
	КраткоеПредставление = ДиагностикаОшибок.КраткоеПредставление(Ошибка);
	ПодробноеПредставление = ДиагностикаОшибок.ПодробноеПредставление(Ошибка);

	// Проверка
	Ожидаем.Что(СтрНайти(КраткоеПредставление, "Подсказка:")).Равно(0);
	Ожидаем.Что(ПодробноеПредставление).Содержит("    Подсказка: Проверьте настройки прокси");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СмешаннаяЦепочка()

	ДанныеВнутреннейОшибки = Новый Структура("Путь", "config.json");
	ВнутренняяОшибка = ФабрикаОшибок.Создать("fs.file_not_found", "Файл не найден", ДанныеВнутреннейОшибки);
	ВнутренняяОшибка = ПомощникТестированияОшибок.ПовторноВыброшеннаяОшибка(ВнутренняяОшибка);
	ВнешняяОшибка = ПомощникТестированияОшибок.ВнешняяОшибка("Ошибка JSON-парсера", ВнутренняяОшибка);
	ВнешняяОшибка = ПомощникТестированияОшибок.ПовторноВыброшеннаяОшибка(ВнешняяОшибка);
	ЭффективнаяОшибка = ФабрикаОшибок.Обернуть(
		ВнешняяОшибка,
		"config.load_failed",
		"Не удалось загрузить конфигурацию",
		Новый Структура("Формат", "JSON")
	);
	ЭффективнаяОшибка = ПомощникТестированияОшибок.ПовторноВыброшеннаяОшибка(ЭффективнаяОшибка);
	Контекст = ФабрикаОшибок.СКонтекстом(
		ЭффективнаяОшибка,
		"Загрузка конфигурации",
		Новый Структура("Операция", "Загрузка")
	);
	Контекст = ПомощникТестированияОшибок.ПовторноВыброшеннаяОшибка(Контекст);

	Возврат Новый Структура("Ошибка", Контекст);

КонецФункции

Функция ДлиннаяВыброшеннаяЦепочка(Длина)

	Ошибка = ПомощникТестированияОшибок.ВнешняяОшибка("Внешний кадр 1");
	Ошибка = ПомощникТестированияОшибок.ПовторноВыброшеннаяОшибка(Ошибка);

	Для НомерКадра = 2 По Длина Цикл
		Ошибка = ПомощникТестированияОшибок.ВнешняяОшибка(
			СтрШаблон("Внешний кадр %1", НомерКадра),
			Ошибка
		);
		Ошибка = ПомощникТестированияОшибок.ПовторноВыброшеннаяОшибка(Ошибка);
	КонецЦикла;

	Возврат Новый Структура("Ошибка", Ошибка);

КонецФункции

#КонецОбласти
