	// Действие
	Представление = ФорматированиеПредставленияОшибок.ПодробноеПредставление(Снимки, Ложь);

	// Проверка
	Ожидаем.Что(Представление).Равно("core.failed: Операция завершилась ошибкой
	|
	|Контекст:
	|  Выполнение операции
	|
	|Причина:
	|  Внешняя причина
	|    Исходная строка: ПрочитатьФайл();");

