&Тест
Процедура ТестДолжен_НазначитьРазныеИдентификаторыСмешаннымПравилам() Экспорт

	// Подготовка
	Поставщик = Новый ТестовыйПоставщикПравил(
		ПравилаДляСообщения("Сообщение поставщика", "test.provider")
	);

	Классификатор = Новый КлассификаторОшибок;
	Классификатор.ДобавитьПоставщикаПравил(Поставщик);
	Классификатор.ДобавитьПравила(ПравилаДляСообщения("Готовое сообщение", "test.ready"));

	// Действие
	РезультатПоставщика = Классификатор.Классифицировать(ОшибкаССообщением("Сообщение поставщика"));
	РезультатГотовыхПравил = Классификатор.Классифицировать(ОшибкаССообщением("Готовое сообщение"));
	ИдентификаторПоставщика = Новый СнимокКадраОшибки(РезультатПоставщика).Данные().Правило;
	ИдентификаторГотовыхПравил = Новый СнимокКадраОшибки(РезультатГотовыхПравил).Данные().Правило;

	// Проверка
	Ожидаем.Что(ИдентификаторПоставщика <> ИдентификаторГотовыхПравил).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВыбратьПервоеСообщениеКодаИзСмешанныхРегистраций() Экспорт

	// Подготовка
	Поставщик = Новый ТестовыйПоставщикПравил(
		ПравилаДляСообщенияСОписанием("Второй шаблон", "test.same", "Второе описание")
	);

	Классификатор = Новый КлассификаторОшибок;
	Классификатор.ДобавитьПравила(
		ПравилаДляСообщенияСОписанием("Первый шаблон", "test.same", "Первое описание")
	);
	Классификатор.ДобавитьПоставщикаПравил(Поставщик);

	Причина = ФабрикаОшибок.Создать("test.same", "Исходное сообщение");
	Ошибка = ФабрикаОшибок.Создать("foreign.code", "Внешняя ошибка", Неопределено, Причина);

	// Действие
	Результат = Классификатор.Классифицировать(Ошибка);

	// Проверка
	Ожидаем.Что(Новый СнимокКадраОшибки(Результат).Сообщение()).Равно("Первое описание");

КонецПроцедуры

