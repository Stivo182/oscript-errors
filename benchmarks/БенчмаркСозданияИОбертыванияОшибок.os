#Использовать "../src"
#Использовать "../src/internal"

Перем _Причина;   // ИнформацияОбОшибке
Перем _Данные;    // Структура
Перем _Метаданные; // ФиксированнаяСтруктура
Перем _Результат; // Произвольный

#Область ОбработчикиСобытий

// Создаёт бенчмарк формирования кадров ошибок.
&КоличествоИтераций(20)
&КоличествоПрогревочныхИтераций(6)
&МинимальноеВремяИтерации(250)
&МониторингПамяти
Процедура ПриСозданииОбъекта()
КонецПроцедуры

// Подготавливает причину и данные для измеряемых операций.
//
// Параметры:
//  Контекст - Структура - Контекст выполняемого кейса бенчмарка.
&ПередКаждымКейсом
Процедура ПодготовитьДанные(Контекст) Экспорт

	_Причина = ФабрикаОшибок.Создать("benchmark.cause", "Исходная ошибка");
	_Данные = Новый Структура("Операция, Ресурс", "Загрузка", "config.json");
	_Метаданные = Новый ФиксированнаяСтруктура(Новый Структура("Источник", "benchmark"));

КонецПроцедуры

#КонецОбласти

#Область Бенчмарки

// Измеряет платформенное создание ошибки без причины.
&Бенчмарк
Процедура СоздатьПлатформеннуюОшибку() Экспорт
	_Результат = Новый ИнформацияОбОшибке("Ошибка операции", _Метаданные);
КонецПроцедуры

// Измеряет платформенное создание ошибки с причиной.
&Бенчмарк
Процедура СоздатьПлатформеннуюОшибкуСПричиной() Экспорт
	_Результат = Новый ИнформацияОбОшибке("Ошибка операции", _Метаданные, _Причина);
КонецПроцедуры

// Измеряет чтение настройки формата из окружения.
&Бенчмарк
Процедура ПрочитатьНастройкуФормата() Экспорт
	_Результат = ПолучитьПеременнуюСреды("ONESCRIPT_ERRORS_FORMAT");
КонецПроцедуры

// Измеряет валидацию полей создаваемого кадра.
&Бенчмарк
Процедура ПроверитьПоляОшибки() Экспорт
	ПроверкаКадровОшибок.ПроверитьКадр(
		ВидыКадровОшибок.Ошибка(),
		"benchmark.failed",
		"Ошибка операции",
		Неопределено,
		"",
		""
	);
КонецПроцедуры

// Измеряет форматирование описания одного кадра.
&Бенчмарк
Процедура СформироватьОписаниеОшибки() Экспорт
	_Результат = ФорматированиеПредставленияОшибок.ПользовательскоеПредставлениеКадра(
		ВидыКадровОшибок.Ошибка(),
		"benchmark.failed",
		"Ошибка операции",
		"",
		"",
		"benchmark.failed",
		"Ошибка операции"
	);
КонецПроцедуры

// Измеряет создание конверта из уже проверенных полей.
&Бенчмарк
Процедура СоздатьПроверенныйКонверт() Экспорт
	_Результат = СозданиеКонвертовОшибок.СоздатьОшибку(
		"benchmark.failed: Ошибка операции",
		"benchmark.failed",
		"Ошибка операции",
		_Данные
	);
КонецПроцедуры

// Измеряет только создание построителя ошибки.
&Бенчмарк
Процедура СоздатьПостроительОшибки() Экспорт
	_Результат = Новый ПостроительОшибки("benchmark.failed", "Ошибка операции");
КонецПроцедуры

// Измеряет построение ошибки без пользовательских данных.
&Бенчмарк
Процедура ПостроитьОшибкуБезДанных() Экспорт
	_Результат = Новый ПостроительОшибки("benchmark.failed", "Ошибка операции").Построить();
КонецПроцедуры

// Измеряет построение ошибки с пользовательскими данными.
&Бенчмарк
Процедура ПостроитьОшибкуСДанными() Экспорт
	_Результат = Новый ПостроительОшибки("benchmark.failed", "Ошибка операции")
		.ПроизвольныеДанные(_Данные)
		.Построить();
КонецПроцедуры

// Измеряет создание классифицированной ошибки с данными.
&Бенчмарк
Процедура СоздатьОшибку() Экспорт
	_Результат = ФабрикаОшибок.Создать("benchmark.failed", "Ошибка операции", _Данные);
КонецПроцедуры

// Измеряет обёртывание причины новой классифицированной ошибкой.
&Бенчмарк
Процедура ОбернутьОшибку() Экспорт
	_Результат = ФабрикаОшибок.Обернуть(
		_Причина,
		"benchmark.failed",
		"Ошибка операции",
		_Данные
	);
КонецПроцедуры

// Измеряет добавление контекста к причине.
&Бенчмарк
Процедура ОбернутьОшибкуКонтекстом() Экспорт
	_Результат = ФабрикаОшибок.ОбернутьКонтекстом(_Причина, "Выполнение операции", _Данные);
КонецПроцедуры

#КонецОбласти
