#Использовать "../src"

Перем _КлассификаторСТочнымПравилом; // КлассификаторОшибок
Перем _КлассификаторСоставнымПравилом; // КлассификаторОшибок
Перем _КлассификаторБезПодходящегоПравила; // КлассификаторОшибок
Перем _КлассификаторСПравиломПрефикса; // КлассификаторОшибок
Перем _КлассификаторСПравиломФрагмента; // КлассификаторОшибок
Перем _КлассификаторСПравиломОкончания; // КлассификаторОшибок
Перем _КлассификаторСПравиломПрефиксаИФрагмента; // КлассификаторОшибок
Перем _КлассификаторСПравиломПрефиксаИОкончания; // КлассификаторОшибок
Перем _КлассификаторСПравиломФрагментаИОкончания; // КлассификаторОшибок
Перем _ОшибкаСТочнымСообщением; // ИнформацияОбОшибке
Перем _ОшибкаСоставногоПравила; // ИнформацияОбОшибке
Перем _НераспознаннаяОшибка; // ИнформацияОбОшибке
Перем _Результат; // ИнформацияОбОшибке, Неопределено

#Область ОбработчикиСобытий

// Создаёт бенчмарк классификации неструктурированных ошибок.
&МониторингПамяти
&КоличествоИтераций(20)
&КоличествоПрогревочныхИтераций(10)
&КолонкаМакс
Процедура ПриСозданииОбъекта()
КонецПроцедуры

// Подготавливает классификаторы и нативные ошибки для измерений.
//
// Параметры:
//  Контекст - Структура - Контекст выполняемого кейса бенчмарка.
&ПередКаждымКейсом
Процедура ПодготовитьДанные(Контекст) Экспорт

	_КлассификаторСТочнымПравилом = СоздатьКлассификатор(ПравилоТочногоСообщения());
	_КлассификаторСоставнымПравилом = СоздатьКлассификатор(СоставноеПравило());
	_КлассификаторБезПодходящегоПравила = СоздатьКлассификатор(ПравилоТочногоСообщения());
	_КлассификаторСПравиломПрефикса = СоздатьКлассификатор(ПравилоПрефикса());
	_КлассификаторСПравиломФрагмента = СоздатьКлассификатор(ПравилоФрагмента());
	_КлассификаторСПравиломОкончания = СоздатьКлассификатор(ПравилоОкончания());
	_КлассификаторСПравиломПрефиксаИФрагмента = СоздатьКлассификатор(ПравилоПрефиксаИФрагмента());
	_КлассификаторСПравиломПрефиксаИОкончания = СоздатьКлассификатор(ПравилоПрефиксаИОкончания());
	_КлассификаторСПравиломФрагментаИОкончания = СоздатьКлассификатор(ПравилоФрагментаИОкончания());

	_ОшибкаСТочнымСообщением = НоваяОшибка("External exception (System.IO.IOException): Файл недоступен");
	_ОшибкаСоставногоПравила = НоваяОшибка(
		"External exception (System.IO.IOException): Операция с ресурсом не найдена"
	);
	_НераспознаннаяОшибка = НоваяОшибка(
		"External exception (System.InvalidOperationException): Неизвестная ошибка"
	);

КонецПроцедуры

#КонецОбласти

#Область Бенчмарки

// Измеряет классификацию правила по точному внутреннему сообщению и нативному типу.
&Бенчмарк(Наименование = "Точное правило")
Процедура КлассифицироватьПоТочномуПравилу() Экспорт

	_Результат = _КлассификаторСТочнымПравилом.Классифицировать(_ОшибкаСТочнымСообщением);

КонецПроцедуры

// Измеряет классификацию правила по префиксу, фрагменту и окончанию внутреннего сообщения.
&Бенчмарк(Наименование = "Составное текстовое правило")
Процедура КлассифицироватьПоСоставномуПравилу() Экспорт

	_Результат = _КлассификаторСоставнымПравилом.Классифицировать(_ОшибкаСоставногоПравила);

КонецПроцедуры

// Измеряет классификацию правила по префиксу внутреннего сообщения.
&Бенчмарк(Наименование = "Правило по префиксу")
Процедура КлассифицироватьПоПравилуПрефикса() Экспорт

	_Результат = _КлассификаторСПравиломПрефикса.Классифицировать(_ОшибкаСоставногоПравила);

КонецПроцедуры

// Измеряет классификацию правила по фрагменту внутреннего сообщения.
&Бенчмарк(Наименование = "Правило по фрагменту")
Процедура КлассифицироватьПоПравилуФрагмента() Экспорт

	_Результат = _КлассификаторСПравиломФрагмента.Классифицировать(_ОшибкаСоставногоПравила);

КонецПроцедуры

// Измеряет классификацию правила по окончанию внутреннего сообщения.
&Бенчмарк(Наименование = "Правило по окончанию")
Процедура КлассифицироватьПоПравилуОкончания() Экспорт

	_Результат = _КлассификаторСПравиломОкончания.Классифицировать(_ОшибкаСоставногоПравила);

КонецПроцедуры

// Измеряет классификацию правила по префиксу и фрагменту внутреннего сообщения.
&Бенчмарк(Наименование = "Правило по префиксу и фрагменту")
Процедура КлассифицироватьПоПравилуПрефиксаИФрагмента() Экспорт

	_Результат = _КлассификаторСПравиломПрефиксаИФрагмента.Классифицировать(_ОшибкаСоставногоПравила);

КонецПроцедуры

// Измеряет классификацию правила по префиксу и окончанию внутреннего сообщения.
&Бенчмарк(Наименование = "Правило по префиксу и окончанию")
Процедура КлассифицироватьПоПравилуПрефиксаИОкончания() Экспорт

	_Результат = _КлассификаторСПравиломПрефиксаИОкончания.Классифицировать(_ОшибкаСоставногоПравила);

КонецПроцедуры

// Измеряет классификацию правила по фрагменту и окончанию внутреннего сообщения.
&Бенчмарк(Наименование = "Правило по фрагменту и окончанию")
Процедура КлассифицироватьПоПравилуФрагментаИОкончания() Экспорт

	_Результат = _КлассификаторСПравиломФрагментаИОкончания.Классифицировать(_ОшибкаСоставногоПравила);

КонецПроцедуры

// Измеряет полный проход по правилам без результата.
&Бенчмарк(Наименование = "Промах правила")
Процедура НеКлассифицироватьНераспознаннуюОшибку() Экспорт

	_Результат = _КлассификаторБезПодходящегоПравила.Классифицировать(_НераспознаннаяОшибка);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьКлассификатор(Правило)

	Правила = Новый Массив;
	Правила.Добавить(Правило);

	Классификатор = Новый КлассификаторОшибок;
	Классификатор.ДобавитьПравила(Новый ФиксированныйМассив(Правила));

	Возврат Классификатор;

КонецФункции

Функция ПравилоТочногоСообщения()

	Возврат Новый ПравилоКлассификацииОшибок()
		.СНативнымТипом("System.IO.IOException")
		.СовпадаетС("Файл недоступен")
		.КлассифицируетКак("benchmark.exact", "Точная ошибка бенчмарка");

КонецФункции

Функция СоставноеПравило()

	Возврат Новый ПравилоКлассификацииОшибок()
		.СНативнымТипом("System.IO.IOException")
		.НачинаетсяС("Операция")
		.Содержит("ресурс")
		.ОканчиваетсяНа("не найдена")
		.КлассифицируетКак("benchmark.composite", "Составная ошибка бенчмарка");

КонецФункции

Функция ПравилоПрефикса()

	Возврат Новый ПравилоКлассификацииОшибок()
		.СНативнымТипом("System.IO.IOException")
		.НачинаетсяС("Операция")
		.КлассифицируетКак("benchmark.prefix", "Ошибка по префиксу");

КонецФункции

Функция ПравилоФрагмента()

	Возврат Новый ПравилоКлассификацииОшибок()
		.СНативнымТипом("System.IO.IOException")
		.Содержит("ресурс")
		.КлассифицируетКак("benchmark.fragment", "Ошибка по фрагменту");

КонецФункции

Функция ПравилоОкончания()

	Возврат Новый ПравилоКлассификацииОшибок()
		.СНативнымТипом("System.IO.IOException")
		.ОканчиваетсяНа("не найдена")
		.КлассифицируетКак("benchmark.suffix", "Ошибка по окончанию");

КонецФункции

Функция ПравилоПрефиксаИФрагмента()

	Возврат Новый ПравилоКлассификацииОшибок()
		.СНативнымТипом("System.IO.IOException")
		.НачинаетсяС("Операция")
		.Содержит("ресурс")
		.КлассифицируетКак("benchmark.prefix_fragment", "Ошибка по префиксу и фрагменту");

КонецФункции

Функция ПравилоПрефиксаИОкончания()

	Возврат Новый ПравилоКлассификацииОшибок()
		.СНативнымТипом("System.IO.IOException")
		.НачинаетсяС("Операция")
		.ОканчиваетсяНа("не найдена")
		.КлассифицируетКак("benchmark.prefix_suffix", "Ошибка по префиксу и окончанию");

КонецФункции

Функция ПравилоФрагментаИОкончания()

	Возврат Новый ПравилоКлассификацииОшибок()
		.СНативнымТипом("System.IO.IOException")
		.Содержит("ресурс")
		.ОканчиваетсяНа("не найдена")
		.КлассифицируетКак("benchmark.fragment_suffix", "Ошибка по фрагменту и окончанию");

КонецФункции

Функция НоваяОшибка(Описание)

	Возврат Новый ИнформацияОбОшибке(Описание, Новый Структура("Источник", "Бенчмарк"));

КонецФункции

#КонецОбласти
