#Использовать "../internal"

Перем _Снимки; // Массив из СнимокКадраОшибки
Перем _Ошибки; // Массив из СнимокКадраОшибки
Перем _Контексты; // Массив из СнимокКадраОшибки
Перем _ЭффективнаяОшибка; // СнимокКадраОшибки, Неопределено
Перем _ЦепочкаУсечена; // Булево

#Область ОбработчикиСобытий

// Создаёт неизменяемое исследование физической цепочки ошибки.
//
// Параметры:
//  Ошибка - ИнформацияОбОшибке - Внешний кадр исследуемой цепочки.
Процедура ПриСозданииОбъекта(Ошибка)

	Просмотр = ОбходЦепочкиОшибки.Просмотреть(Ошибка);

	_Снимки = Новый Массив;
	_Ошибки = Новый Массив;
	_Контексты = Новый Массив;
	_ЭффективнаяОшибка = Неопределено;
	_ЦепочкаУсечена = Просмотр.Усечена;

	Для Каждого Кадр Из Просмотр.Кадры Цикл
		Снимок = Новый СнимокКадраОшибки(Кадр);
		_Снимки.Добавить(Снимок);

		Если Снимок.Вид() = ВидыКадровОшибок.Ошибка Тогда
			_Ошибки.Добавить(Снимок);
			Если _ЭффективнаяОшибка = Неопределено Тогда
				_ЭффективнаяОшибка = Снимок;
			КонецЕсли;
		ИначеЕсли Снимок.Вид() = ВидыКадровОшибок.Контекст Тогда
			_Контексты.Добавить(Снимок);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Возвращает все просмотренные физические кадры.
//
// Возвращаемое значение:
//  Массив из СнимокКадраОшибки - Независимая копия снимков в физическом порядке.
Функция Кадры() Экспорт

	Возврат КопияМассива(_Снимки);

КонецФункции

// Возвращает все распознанные ошибки.
//
// Возвращаемое значение:
//  ВыборкаОшибок - Новая выборка классифицированных кадров.
Функция Ошибки() Экспорт

	Возврат Новый ВыборкаОшибок(_Ошибки);

КонецФункции

// Возвращает все распознанные контекстные кадры.
//
// Возвращаемое значение:
//  Массив из СнимокКадраОшибки - Независимая копия контекстов в физическом порядке.
Функция Контексты() Экспорт

	Возврат КопияМассива(_Контексты);

КонецФункции

// Возвращает первую распознанную ошибку.
//
// Возвращаемое значение:
//  СнимокКадраОшибки, Неопределено - Эффективная ошибка.
Функция ЭффективнаяОшибка() Экспорт

	Возврат _ЭффективнаяОшибка;

КонецФункции

// Возвращает последний просмотренный физический кадр.
//
// Возвращаемое значение:
//  СнимокКадраОшибки - Последний доступный кадр.
Функция ПоследнийКадр() Экспорт

	Возврат _Снимки[_Снимки.ВГраница()];

КонецФункции

// Возвращает фактическую корневую причину полностью просмотренной цепочки.
//
// Возвращаемое значение:
//  СнимокКадраОшибки, Неопределено - Корень или Неопределено для усечённой цепочки.
Функция КорневаяПричина() Экспорт

	Если _ЦепочкаУсечена Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ПоследнийКадр();

КонецФункции

// Проверяет наличие непросмотренной причины.
//
// Возвращаемое значение:
//  Булево - Истина, если физическая цепочка усечена.
Функция ЦепочкаУсечена() Экспорт

	Возврат _ЦепочкаУсечена;

КонецФункции

// Возвращает машинный тип эффективной ошибки.
//
// Возвращаемое значение:
//  Строка, Неопределено - Тип эффективной ошибки.
Функция ТипОшибки() Экспорт

	Если _ЭффективнаяОшибка = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат _ЭффективнаяОшибка.ТипОшибки();

КонецФункции

// Возвращает пользовательские данные эффективной ошибки.
//
// Возвращаемое значение:
//  Произвольный, Неопределено - Данные эффективной ошибки.
Функция Данные() Экспорт

	Если _ЭффективнаяОшибка = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат _ЭффективнаяОшибка.Данные();

КонецФункции

// Возвращает первую непустую подсказку распознанной ошибки.
//
// Возвращаемое значение:
//  Строка - Подсказка или пустая строка.
Функция Подсказка() Экспорт

	Для Каждого Снимок Из _Ошибки Цикл
		Если Не ПустаяСтрока(Снимок.Подсказка()) Тогда
			Возврат Снимок.Подсказка();
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// Проверяет наличие ошибки указанного типа.
//
// Параметры:
//  ТипОшибки - Строка - Искомый машинный тип.
//
// Возвращаемое значение:
//  Булево - Истина, если тип найден.
Функция ЕстьОшибка(ТипОшибки) Экспорт

	Возврат НайтиОшибку(ТипОшибки) <> Неопределено;

КонецФункции

// Находит первую ошибку указанного типа.
//
// Параметры:
//  ТипОшибки - Строка - Искомый машинный тип.
//
// Возвращаемое значение:
//  СнимокКадраОшибки, Неопределено - Первый подходящий снимок.
Функция НайтиОшибку(ТипОшибки) Экспорт

	ПроверкаКадровОшибок.ПроверитьТипОшибки(ТипОшибки);

	Для Каждого Снимок Из _Ошибки Цикл
		Если НРег(Снимок.ТипОшибки()) = НРег(ТипОшибки) Тогда
			Возврат Снимок;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Находит все ошибки одного или нескольких типов.
//
// Параметры:
//  ТипыОшибок - Строка - Один машинный тип или CSV-список типов.
//
// Возвращаемое значение:
//  ВыборкаОшибок - Новая выборка подходящих снимков.
Функция НайтиОшибки(ТипыОшибок) Экспорт

	ИскомыеТипы = РазобратьТипыОшибок(ТипыОшибок);
	Результат = Новый Массив;

	Для Каждого Снимок Из _Ошибки Цикл
		Если ИскомыеТипы.Получить(НРег(Снимок.ТипОшибки())) = Истина Тогда
			Результат.Добавить(Снимок);
		КонецЕсли;
	КонецЦикла;

	Возврат Новый ВыборкаОшибок(Результат);

КонецФункции

// Возвращает краткое человекочитаемое представление ошибки.
//
// Возвращаемое значение:
//  Строка - Краткое представление эффективной ошибки и контекстов.
Функция КраткоеПредставление() Экспорт

	Возврат ФорматированиеПредставленияОшибок.КраткоеПредставление(_Снимки);

КонецФункции

// Возвращает подробный диагностический отчёт.
//
// Возвращаемое значение:
//  Строка - Семантические группы ошибки, контекстов и причин.
Функция ПодробноеПредставление() Экспорт

	Возврат ФорматированиеПредставленияОшибок.ПодробноеПредставление(_Снимки, _ЦепочкаУсечена);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция РазобратьТипыОшибок(ТипыОшибок)

	Если ТипЗнч(ТипыОшибок) <> Тип("Строка") Тогда
		ПроверкаКадровОшибок.ПроверитьТипОшибки(ТипыОшибок);
	КонецЕсли;

	Результат = Новый Соответствие;
	Для Каждого ТипОшибки Из СтрРазделить(ТипыОшибок, ",", Истина) Цикл
		ТипОшибки = СокрЛП(ТипОшибки);
		ПроверкаКадровОшибок.ПроверитьТипОшибки(ТипОшибки);
		Результат.Вставить(НРег(ТипОшибки), Истина);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция КопияМассива(ИсходныйМассив)

	Результат = Новый Массив;
	Для Каждого Элемент Из ИсходныйМассив Цикл
		Результат.Добавить(Элемент);
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти
