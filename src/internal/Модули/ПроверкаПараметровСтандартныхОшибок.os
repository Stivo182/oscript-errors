#Область СлужебныйПрограммныйИнтерфейс

// Проверяет, что служебный параметр является непустой строкой.
//
// Параметры:
//  ИмяПараметра - Строка - Имя проверяемого параметра.
//  Значение - Произвольный - Проверяемое значение.
Процедура ПроверитьНепустуюСтроку(ИмяПараметра, Значение) Экспорт

	ПроверитьТип(ИмяПараметра, Значение, Тип("Строка"));

	Если ПустаяСтрока(Значение) Тогда
		ВызватьИсключение ФабрикаСтандартныхОшибок.АргументНеЗаполнен(ИмяПараметра);
	КонецЕсли;

КонецПроцедуры

// Проверяет тип условия стандартной проверки.
//
// Параметры:
//  Условие - Произвольный - Проверяемое значение условия.
Процедура ПроверитьУсловие(Условие) Экспорт

	ПроверитьТип("Условие", Условие, Тип("Булево"));

КонецПроцедуры

// Проверяет тип пользовательского сообщения.
//
// Параметры:
//  Сообщение - Произвольный - Проверяемое сообщение.
Процедура ПроверитьСообщение(Сообщение) Экспорт

	ПроверитьТип("Сообщение", Сообщение, Тип("Строка"));

КонецПроцедуры

// Проверяет, что параметр является массивом или фиксированным массивом.
//
// Параметры:
//  ИмяПараметра - Строка - Имя проверяемого параметра.
//  Значение - Произвольный - Проверяемое значение.
Процедура ПроверитьКоллекциюЗначений(ИмяПараметра, Значение) Экспорт

	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения <> Тип("Массив") И ТипЗначения <> Тип("ФиксированныйМассив") Тогда
		ВызватьИсключение ФабрикаСтандартныхОшибок.НеверныйТипАргумента(
			ИмяПараметра,
			НСтр(
				"ru = 'Массив или ФиксированныйМассив';"
				+ "en = 'Array or FixedArray'"
			),
			Значение
		);
	КонецЕсли;

КонецПроцедуры

// Проверяет, что параметр является числом.
//
// Параметры:
//  ИмяПараметра - Строка - Имя проверяемого параметра.
//  Значение - Произвольный - Проверяемое значение.
Процедура ПроверитьЧисло(ИмяПараметра, Значение) Экспорт

	ПроверитьТип(ИмяПараметра, Значение, Тип("Число"));

КонецПроцедуры

// Проверяет, что все элементы коллекции являются непустыми строками.
//
// Параметры:
//  ИмяПараметра - Строка - Имя проверяемого параметра.
//  Значение - Массив, ФиксированныйМассив - Проверяемая коллекция.
Процедура ПроверитьКоллекциюНепустыхСтрок(ИмяПараметра, Значение) Экспорт

	ПроверитьКоллекциюЗначений(ИмяПараметра, Значение);
	Для Каждого Элемент Из Значение Цикл
		ПроверитьНепустуюСтроку(ИмяПараметра, Элемент);
	КонецЦикла;

КонецПроцедуры

// Проверяет допустимость значения служебного параметра.
//
// Параметры:
//  ИмяПараметра - Строка - Имя проверяемого параметра.
//  Условие - Булево - Результат проверки допустимости.
//  Ожидание - Строка - Описание допустимого значения.
Процедура ПроверитьДопустимость(ИмяПараметра, Условие, Ожидание) Экспорт

	Если Не Условие Тогда
		ВызватьИсключение ФабрикаСтандартныхОшибок.НедопустимоеЗначениеАргумента(
			ИмяПараметра,
			Ожидание
		);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьТип(ИмяПараметра, Значение, ОжидаемыйТип)

	Если ТипЗнч(Значение) <> ОжидаемыйТип Тогда
		ВызватьИсключение ФабрикаСтандартныхОшибок.НеверныйТипАргумента(
			ИмяПараметра,
			Строка(ОжидаемыйТип),
			Значение
		);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
