&Тест
Процедура ТестДолжен_ВывестиПодсказкуТолькоВДиагностическомПредставлении() Экспорт

	// Подготовка
	Ошибка = КонструкторыОшибок.Создать(
		"http.proxy_error",
		"Ошибка прокси",
		Неопределено
	)
		.Подсказка("Проверьте настройки прокси")
		.Построить();

	// Действие
	КраткоеПредставление = ДиагностикаОшибок.Исследовать(Ошибка).КраткоеПредставление();
	ДиагностическоеПредставление = ДиагностикаОшибок.Исследовать(Ошибка).ДиагностическоеПредставление();

	// Проверка
	Ожидаем.Что(КраткоеПредставление).Равно("http.proxy_error: Ошибка прокси");
	ОжидаемоеДиагностическоеПредставление = "http.proxy_error: Ошибка прокси
	|
	|Подсказка:
	|  Проверьте настройки прокси";
	Ожидаем.Что(ДиагностическоеПредставление).Равно(ОжидаемоеДиагностическоеПредставление);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВывестиURLПодПодсказкойТолькоВДиагностическомПредставлении() Экспорт

	// Подготовка
	Ошибка = КонструкторыОшибок.Создать("config.invalid", "Ошибка конфигурации")
		.Подсказка("Проверьте формат файла")
		.URL("https://example.org/errors/config-invalid")
		.Построить();

	// Действие
	Исследователь = Новый ИсследовательОшибки(Ошибка);
	КраткоеПредставление = Исследователь.КраткоеПредставление();
	ДиагностическоеПредставление = Исследователь.ДиагностическоеПредставление();

	// Проверка
	Ожидаем.Что(КраткоеПредставление).Равно("config.invalid: Ошибка конфигурации");
	ОжидаемоеПредставление = "config.invalid: Ошибка конфигурации
	|
	|Подсказка:
	|  Проверьте формат файла
	|
	|URL:
	|  https://example.org/errors/config-invalid";
	Ожидаем.Что(ДиагностическоеПредставление).Равно(ОжидаемоеПредставление);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьТриПредставленияДляТекущейВнешнейОбертки() Экспорт

	// Подготовка
	Причина = ФабрикаОшибок.Создать("config.load_failed", "Не удалось загрузить настройки");
	Ошибка = ПомощникТестированияОшибок.ВнешняяОшибка(
		"Не удалось инициализировать приложение",
		Причина
	);
	Исследователь = ДиагностикаОшибок.Исследовать(Ошибка);
	ОжидаемоеПредставление = "config.load_failed: Не удалось инициализировать приложение"
		+ " -> Не удалось загрузить настройки";

	// Действие
	Краткое = Исследователь.КраткоеПредставление();
	Пользовательское = Исследователь.ПользовательскоеПредставление();
	Диагностическое = Исследователь.ДиагностическоеПредставление();

	// Проверка
	Ожидаем.Что(Краткое).Равно(ОжидаемоеПредставление);
	Ожидаем.Что(Пользовательское).Равно(ОжидаемоеПредставление);
	Ожидаем.Что(Диагностическое).Равно("Не удалось инициализировать приложение
	|
	|Причина:
	|  config.load_failed: Не удалось загрузить настройки");

КонецПроцедуры

