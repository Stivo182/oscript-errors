	);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("")
&ИсточникЗначение(42)
Процедура ТестДолжен_ОтклонитьНекорректноеСообщение(Сообщение) Экспорт

	// Подготовка
	Параметры = Новый Массив;
	Параметры.Добавить("fs.file_not_found");
	Параметры.Добавить(Сообщение);
	ОжидаемоеСообщение = ?(
		ТипЗнч(Сообщение) = Тип("Строка"),
		СтандартноеСообщениеНезаполненногоАргумента("Сообщение"),
		СтандартноеСообщениеНеверногоТипа("Сообщение", Строка(Тип("Строка")))
	);

	// Действие и Проверка
	ПроверитьИсключениеМетода(
		"Создать",
		Параметры,
		ОжидаемоеСообщение
	);

КонецПроцедуры

