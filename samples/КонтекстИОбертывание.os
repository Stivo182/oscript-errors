// Показывает различие между добавлением контекста и оборачиванием ошибки.
// Контекст сохраняет исходный тип, а оборачивание задаёт новый эффективный тип.

#Использовать errors

Ошибка = ФабрикаОшибок.Создать("network.timeout", "Превышено время ожидания ответа");
Сообщить("Исходный тип: " + (Новый ИсследовательОшибки(Ошибка)).ТипОшибки());

Ошибка = ФабрикаОшибок.СКонтекстом(Ошибка, "Получение профиля пользователя");
Сообщить("После добавления контекста: " + (Новый ИсследовательОшибки(Ошибка)).ТипОшибки());

Ошибка = ФабрикаОшибок.Обернуть(
	Ошибка,
	"profile.load_failed",
	"Не удалось загрузить профиль"
);
Сообщить("После оборачивания: " + (Новый ИсследовательОшибки(Ошибка)).ТипОшибки());
