#Область Тесты

&Тест
Процедура ТестДолжен_СоздатьРазборОшибки() Экспорт

	// Подготовка
	Ошибка = ФабрикаОшибок.Создать("config.invalid", "Ошибка конфигурации");

	// Действие
	Разбор = ДиагностикаОшибок.Разобрать(Ошибка);

	// Проверка
	Ожидаем.Что(ТипЗнч(Разбор)).Равно(Тип("РазборОшибки"));
	Ожидаем.Что(Разбор.КодОшибки()).Равно("config.invalid");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьКодЭффективнойОшибки() Экспорт

	// Подготовка
	Причина = ФабрикаОшибок.Создать("config.invalid", "Ошибка конфигурации");
	Ошибка = ФабрикаОшибок.ОбернутьКонтекстом(Причина, "Загрузка конфигурации");

	// Действие
	КодОшибки = ДиагностикаОшибок.КодОшибки(Ошибка);

	// Проверка
	Ожидаем.Что(КодОшибки).Равно("config.invalid");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОграничитьЧтениеКодаШестьюдесятьюЧетырьмяКадрами() Экспорт

	// Подготовка
	ОшибкаНаГранице = ФабрикаОшибок.Создать("core.failed", "Ошибка на границе");
	Для НомерКадра = 1 По 63 Цикл
		ОшибкаНаГранице = ПомощникТестированияОшибок.ВнешняяОшибка("Внешний кадр", ОшибкаНаГранице);
	КонецЦикла;
	ОшибкаЗаГраницей = ПомощникТестированияОшибок.ВнешняяОшибка("Лишний кадр", ОшибкаНаГранице);

	// Действие
	КодНаГранице = ДиагностикаОшибок.КодОшибки(ОшибкаНаГранице);
	КодЗаГраницей = ДиагностикаОшибок.КодОшибки(ОшибкаЗаГраницей);

	// Проверка
	Ожидаем.Что(КодНаГранице).Равно("core.failed");
	Ожидаем.Что(КодЗаГраницей).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПропуститьЧужойИПоврежденныйКонвертыПриЧтенииКода() Экспорт

	// Подготовка
	ВнутренняяОшибка = ФабрикаОшибок.Создать("core.failed", "Корневая ошибка");
	Образец = ФабрикаОшибок.Создать("sample.error", "Образец");
	ЧужойМаркер = ПомощникТестированияОшибок.ОшибкаСЧужимМаркером(Образец, ВнутренняяОшибка);
	Ошибка = ПомощникТестированияОшибок.ОшибкаСПоврежденнымКонвертом(Образец, ЧужойМаркер);

	// Действие
	КодОшибки = ДиагностикаОшибок.КодОшибки(Ошибка);

	// Проверка
	Ожидаем.Что(КодОшибки).Равно("core.failed");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПрочитатьКодПослеПовторногоВыброса() Экспорт

	// Подготовка
	ИсходнаяОшибка = ФабрикаОшибок.Создать("storage.read_failed", "Ошибка чтения");
	Ошибка = ПомощникТестированияОшибок.ПовторноВыброшеннаяОшибка(ИсходнаяОшибка);

	// Действие
	КодОшибки = ДиагностикаОшибок.КодОшибки(Ошибка);

	// Проверка
	Ожидаем.Что(КодОшибки).Равно("storage.read_failed");

КонецПроцедуры

&Тест
Процедура ТестДолжен_НайтиКодВоВсейЦепочке() Экспорт

	// Подготовка
	Ошибка = ТестоваяЦепочка();

	// Действие
	СодержитПричину = ДиагностикаОшибок.Содержит(Ошибка, "connection.timeout");
	СодержитНеизвестныйКод = ДиагностикаОшибок.Содержит(Ошибка, "connection.refused");

	// Проверка
	Ожидаем.Что(СодержитПричину).Равно(Истина);
	Ожидаем.Что(СодержитНеизвестныйКод).Равно(Ложь);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьНестроковыйКодПриПоиске() Экспорт

	// Подготовка
	Ошибка = ТестоваяЦепочка();
	ОшибкаПоиска = Неопределено;

	// Действие
	Попытка
		ДиагностикаОшибок.Содержит(Ошибка, 42);
	Исключение
		ОшибкаПоиска = ИнформацияОбОшибке();
	КонецПопытки;

	// Проверка
	Если ОшибкаПоиска = Неопределено Тогда
		ВызватьИсключение "Ожидалось контрактное исключение";
	КонецЕсли;

	Снимок = Новый СнимокКадраОшибки(ОшибкаПоиска);
	Ожидаем.Что(Снимок.КодОшибки()).Равно("argument.invalid_type");
	Ожидаем.Что(Снимок.Данные().ИмяАргумента).Равно("КодОшибки");
	Ожидаем.Что(Снимок.Данные().ФактическийТип).Равно(Строка(Тип("Число")));

КонецПроцедуры

&Тест
Процедура ТестДолжен_НайтиЛюбойКодВоВсейЦепочке() Экспорт

	// Подготовка
	Ошибка = ТестоваяЦепочка();
	КодыОшибок = Новый Массив;
	КодыОшибок.Добавить("connection.refused");
	КодыОшибок.Добавить("connection.timeout");

	// Действие
	СодержитЛюбойКод = ДиагностикаОшибок.СодержитЛюбойИз(Ошибка, КодыОшибок);

	// Проверка
	Ожидаем.Что(СодержитЛюбойКод).Равно(Истина);

КонецПроцедуры

