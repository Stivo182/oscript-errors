#Использовать "../src"

&Параметры(1, 10, 50)
Перем ГлубинаЦепочки Экспорт; // Число

Перем _Выборка; // ВыборкаОшибок
Перем _ИскомыеКоды; // ФиксированныйМассив из Строка
Перем _Результат; // Булево

#Область ОбработчикиСобытий

// Создаёт бенчмарк поиска в материализованной выборке ошибок.
&МониторингПамяти
&КоличествоИтераций(5)
&КоличествоПрогревочныхИтераций(3)
&МинимальноеВремяИтерации(100)
Процедура ПриСозданииОбъекта()
КонецПроцедуры

// Подготавливает выборку заданного размера.
//
// Параметры:
//  Контекст - Структура - Контекст выполняемого кейса бенчмарка.
&ПередКаждымКейсом
Процедура ПодготовитьВыборку(Контекст) Экспорт

	Ошибка = СоздатьЦепочку(ГлубинаЦепочки);
	_Выборка = ДиагностикаОшибок.Разобрать(Ошибка).Ошибки();
	_ИскомыеКоды = Новый ФиксированныйМассив(
		СтрРазделить("benchmark.missing,benchmark.level_1", ",", Ложь)
	);

КонецПроцедуры

#КонецОбласти

#Область Бенчмарки

// Измеряет поиск одного из кодов с совпадением в конце выборки.
&Бенчмарк
Процедура СодержитЛюбойИзКодов() Экспорт

	_Результат = _Выборка.СодержитЛюбойИз(_ИскомыеКоды);

КонецПроцедуры

// Измеряет поиск группы с совпадением в начале выборки.
&Бенчмарк
Процедура СодержитГруппу() Экспорт

	_Результат = _Выборка.СодержитГруппу("benchmark");

КонецПроцедуры

// Измеряет поиск отсутствующей группы с полным проходом выборки.
&Бенчмарк
Процедура СодержитОтсутствующуюГруппу() Экспорт

	_Результат = _Выборка.СодержитГруппу("missing");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьЦепочку(Глубина)

	Ошибка = ФабрикаОшибок.Создать(КодУровня(1), "Ошибка уровня 1");

	Для НомерУровня = 2 По Глубина Цикл
		Ошибка = ФабрикаОшибок.Обернуть(
			Ошибка,
			КодУровня(НомерУровня),
			"Ошибка уровня " + НомерУровня
		);
	КонецЦикла;

	Возврат Ошибка;

КонецФункции

Функция КодУровня(НомерУровня)

	Возврат "benchmark.level_" + НомерУровня;

КонецФункции

#КонецОбласти
