&Тест
Процедура ТестДолжен_ВыровнятьМногострочныеПоляПодробногоПредставления() Экспорт

	// Подготовка
	Данные = Новый Структура("Текст", "Альфа" + Символы.ПС + "Бета");
	Ошибка = ФабрикаОшибок.Создать(
		"core.multiline",
		"Первая строка" + Символы.ПС + "Вторая строка",
		Данные,
		"Первый шаг" + Символы.ПС + "Второй шаг"
	);

	// Действие
	Представление = ДиагностикаОшибок.ПодробноеПредставление(Ошибка);

	// Проверка
	ОжидаемоеПредставление = "core.multiline: Первая строка" + Символы.ПС
		+ Пробелы(16) + "Вторая строка" + Символы.ПС
		+ Символы.ПС
		+ "Данные:" + Символы.ПС
		+ "  Текст: Альфа" + Символы.ПС
		+ "         Бета" + Символы.ПС + Символы.ПС
		+ "Подсказка:" + Символы.ПС
		+ "  Первый шаг" + Символы.ПС
		+ "  Второй шаг";
	Ожидаем.Что(Представление).Равно(ОжидаемоеПредставление);

КонецПроцедуры

