#Использовать "../internal"

#Область ПрограммныйИнтерфейс

// Проверяет тип аргумента и выбрасывает ошибку при нарушении контракта.
//
// Параметры:
//  ИмяАргумента - Строка - Имя проверяемого аргумента.
//  Значение - Произвольный - Проверяемое значение.
//  ДопустимыеТипы - Тип, ОписаниеТипов, Строка, Массив, ФиксированныйМассив - Допустимые типы значения.
//     Строки интерпретируются как имена типов, несколько имён можно перечислить через запятую.
//  Сообщение - Строка - Необязательное описание ошибки.
Процедура ПроверитьТип(ИмяАргумента, Значение, ДопустимыеТипы, Сообщение = "") Экспорт

	ПроверитьИмяАргумента(ИмяАргумента);
	ТипДопустим = ТипЗначенияДопустим(Значение, ДопустимыеТипы);
	ПроверитьСообщение(Сообщение);

	Если Не ТипДопустим Тогда
		ВызватьИсключение ОшибкаНеверногоТипаАргумента(
			ИмяАргумента,
			ТекстДопустимыхТипов(ДопустимыеТипы),
			Значение,
			Сообщение
		);
	КонецЕсли;

КонецПроцедуры

// Проверяет заполненность аргумента и выбрасывает ошибку при нарушении контракта.
//
// Параметры:
//  ИмяАргумента - Строка - Имя проверяемого аргумента.
//  Значение - Произвольный - Проверяемое значение.
//  Сообщение - Строка - Необязательное описание ошибки.
Процедура ПроверитьЗаполненность(ИмяАргумента, Значение, Сообщение = "") Экспорт

	ПроверитьИмяАргумента(ИмяАргумента);
	ПроверитьСообщение(Сообщение);

	Если Не ЗаполненоИлиНеПоддерживается(Значение) Тогда
		ВызватьИсключение ОшибкаНезаполненногоАргумента(ИмяАргумента, Сообщение);
	КонецЕсли;

КонецПроцедуры

// Проверяет допустимость аргумента и выбрасывает ошибку при нарушении контракта.
//
// Параметры:
//  ИмяАргумента - Строка - Имя проверяемого аргумента.
//  Допустимо - Булево - Результат проверки допустимости.
//  Ожидание - Строка - Описание допустимого значения или ограничения.
//  Сообщение - Строка - Необязательное описание ошибки.
Процедура ПроверитьДопустимость(ИмяАргумента, Допустимо, Ожидание, Сообщение = "") Экспорт

	ПроверитьИмяАргумента(ИмяАргумента);
	ПроверитьТипПараметра("Допустимо", Допустимо, Тип("Булево"));
	ПроверитьНепустуюСтроку("Ожидание", Ожидание);
	ПроверитьСообщение(Сообщение);

	Если Не Допустимо Тогда
		ВызватьИсключение ОшибкаНедопустимогоЗначенияАргумента(
			ИмяАргумента,
			Ожидание,
			Сообщение
		);
	КонецЕсли;

КонецПроцедуры

// Проверяет равенство аргумента ожидаемому значению.
//
// Параметры:
//  ИмяАргумента - Строка - Имя проверяемого аргумента.
//  Значение - Произвольный - Проверяемое значение.
//  ОжидаемоеЗначение - Произвольный - Ожидаемое значение аргумента.
//  Сообщение - Строка - Необязательное описание ошибки.
Процедура ПроверитьРавенство(ИмяАргумента, Значение, ОжидаемоеЗначение, Сообщение = "") Экспорт

	ПроверитьИмяАргумента(ИмяАргумента);
	ПроверитьСообщение(Сообщение);

	Если Значение <> ОжидаемоеЗначение Тогда
		ВызватьИсключение ОшибкаНедопустимогоЗначенияАргумента(
			ИмяАргумента,
			ПредставлениеЗначения(ОжидаемоеЗначение),
			Сообщение
		);
	КонецЕсли;

КонецПроцедуры

// Проверяет вхождение аргумента в набор допустимых значений.
//
// Параметры:
//  ИмяАргумента - Строка - Имя проверяемого аргумента.
//  Значение - Произвольный - Проверяемое значение.
//  ДопустимыеЗначения - Массив, ФиксированныйМассив - Набор допустимых значений.
//  Сообщение - Строка - Необязательное описание ошибки.
Процедура ПроверитьДопустимоеЗначение(
	ИмяАргумента,
	Значение,
	ДопустимыеЗначения,
	Сообщение = ""
) Экспорт

	ПроверитьИмяАргумента(ИмяАргумента);
	ПроверитьДопустимыеЗначения(ДопустимыеЗначения);
	ПроверитьСообщение(Сообщение);

	Если ДопустимыеЗначения.Найти(Значение) = Неопределено Тогда
		ВызватьИсключение ОшибкаНедопустимогоЗначенияАргумента(
			ИмяАргумента,
			ТекстДопустимыхЗначений(ДопустимыеЗначения),
			Сообщение
		);
	КонецЕсли;

КонецПроцедуры

// Проверяет нахождение аргумента во включительном диапазоне и выбрасывает ошибку при нарушении контракта.
//
// Параметры:
//  ИмяАргумента - Строка - Имя проверяемого аргумента.
//  Значение - Число, Дата - Проверяемое значение.
//  МинимальноеЗначение - Число, Дата - Включительная нижняя граница.
//  МаксимальноеЗначение - Число, Дата - Включительная верхняя граница.
//  Сообщение - Строка - Необязательное описание ошибки.
Процедура ПроверитьДиапазон(
	ИмяАргумента,
	Значение,
	МинимальноеЗначение,
	МаксимальноеЗначение,
	Сообщение = ""
) Экспорт

	ПроверитьИмяАргумента(ИмяАргумента);

	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения <> Тип("Число") И ТипЗначения <> Тип("Дата") Тогда
		ВызватьИсключение ОшибкаНеверногоТипаАргумента(
			"Значение",
			ТекстДопустимыхТипов(ДопустимыеТипыДиапазона()),
			Значение
		);
	КонецЕсли;

	ПроверитьТипПараметра("МинимальноеЗначение", МинимальноеЗначение, ТипЗначения);
	ПроверитьТипПараметра("МаксимальноеЗначение", МаксимальноеЗначение, ТипЗначения);
	ПроверитьСообщение(Сообщение);
	ПроверитьПорядокГраниц(МинимальноеЗначение, МаксимальноеЗначение);

	Если Значение < МинимальноеЗначение Или Значение > МаксимальноеЗначение Тогда
		ВызватьИсключение ОшибкаАргументаВнеДиапазона(
			ИмяАргумента,
			ТекстОжидаемогоДиапазона(МинимальноеЗначение, МаксимальноеЗначение),
			Сообщение
		);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьДопустимыеЗначения(Значение)

	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения <> Тип("Массив") И ТипЗначения <> Тип("ФиксированныйМассив") Тогда
		ВызватьИсключение ОшибкаНеверногоТипаАргумента(
			"ДопустимыеЗначения",
			НСтр("ru = 'Массив или ФиксированныйМассив'; en = 'Array or FixedArray'"),
			Значение
		);
	КонецЕсли;

	Если Значение.Количество() = 0 Тогда
		ВызватьИсключение ОшибкаНезаполненногоАргумента("ДопустимыеЗначения");
	КонецЕсли;

КонецПроцедуры

Функция ТипЗначенияДопустим(Значение, ДопустимыеТипы)

	ТипФормы = ТипЗнч(ДопустимыеТипы);
	ТипЗначения = ТипЗнч(Значение);

	Если ТипФормы = Тип("Тип") Тогда
		Возврат ТипЗначения = ДопустимыеТипы;
	ИначеЕсли ТипФормы = Тип("ОписаниеТипов") Тогда
		Если ДопустимыеТипы.Типы().Количество() = 0 Тогда
			ВызватьИсключение ОшибкаНезаполненногоАргумента("ДопустимыеТипы");
		КонецЕсли;
		Возврат ДопустимыеТипы.СодержитТип(ТипЗначения);
	ИначеЕсли ТипФормы = Тип("Строка") Тогда
		Если ПустаяСтрока(ДопустимыеТипы) Тогда
			ВызватьИсключение ОшибкаНезаполненногоАргумента("ДопустимыеТипы");
		КонецЕсли;
		Типы = МассивТиповИзСтроки(ДопустимыеТипы, "ДопустимыеТипы");
	ИначеЕсли ТипФормы = Тип("Массив") Или ТипФормы = Тип("ФиксированныйМассив") Тогда
		Если ДопустимыеТипы.Количество() = 0 Тогда
			ВызватьИсключение ОшибкаНезаполненногоАргумента("ДопустимыеТипы");
		КонецЕсли;
		Типы = ДопустимыеТипы;
	Иначе
		ВызватьИсключение ОшибкаНеверногоТипаАргумента(
			"ДопустимыеТипы",
			ТекстДопустимыхФормТипов(),
			ДопустимыеТипы
		);
	КонецЕсли;

	ТипНайден = Ложь;
	Для Каждого ДопустимыйТип Из Типы Цикл
		Если ТипЗнч(ДопустимыйТип) = Тип("Тип") Тогда
			ПреобразованныйТип = ДопустимыйТип;
		Иначе
			ПреобразованныйТип = ПреобразоватьВТип("ДопустимыеТипы", ДопустимыйТип);
		КонецЕсли;

		Если ПреобразованныйТип = ТипЗначения Тогда
			ТипНайден = Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат ТипНайден;

КонецФункции

Функция ТекстДопустимыхФормТипов()

	Возврат ТекстДопустимыхТипов("Тип, ОписаниеТипов, Строка, Массив, ФиксированныйМассив");

КонецФункции

Функция МассивТиповИзСтроки(СтрокаТипов, ИмяПараметра)

	Результат = Новый Массив;
	Для Каждого ИмяТипа Из СтрРазделить(СтрокаТипов, ",", Истина) Цикл
		Результат.Добавить(ПреобразоватьВТип(ИмяПараметра, СокрЛП(ИмяТипа)));
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция МассивДопустимыхТипов(ДопустимыеТипы)

	Если ТипЗнч(ДопустимыеТипы) = Тип("Тип") Тогда
		Результат = Новый Массив;
		Результат.Добавить(ДопустимыеТипы);
		Возврат Результат;
	ИначеЕсли ТипЗнч(ДопустимыеТипы) = Тип("ОписаниеТипов") Тогда
		Возврат ДопустимыеТипы.Типы();
	ИначеЕсли ТипЗнч(ДопустимыеТипы) = Тип("Строка") Тогда
		Возврат МассивТиповИзСтроки(ДопустимыеТипы, "ДопустимыеТипы");
	Иначе
		Результат = Новый Массив;
		Для Каждого ДопустимыйТип Из ДопустимыеТипы Цикл
			Результат.Добавить(ПреобразоватьВТип("ДопустимыеТипы", ДопустимыйТип));
		КонецЦикла;
	КонецЕсли;

	Возврат Результат;

КонецФункции

Процедура ПроверитьИмяАргумента(Значение)

	ПроверитьНепустуюСтроку("ИмяАргумента", Значение);

КонецПроцедуры

Процедура ПроверитьСообщение(Значение)

	ПроверитьТипПараметра("Сообщение", Значение, Тип("Строка"));

КонецПроцедуры

Процедура ПроверитьНепустуюСтроку(ИмяПараметра, Значение)

	ПроверитьТипПараметра(ИмяПараметра, Значение, Тип("Строка"));

	Если ПустаяСтрока(Значение) Тогда
		ВызватьИсключение ОшибкаНезаполненногоАргумента(ИмяПараметра);
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьТипПараметра(ИмяПараметра, Значение, ОжидаемыйТип)

	Если ТипЗнч(Значение) <> ОжидаемыйТип Тогда
		ВызватьИсключение ОшибкаНеверногоТипаАргумента(
			ИмяПараметра,
			Строка(ОжидаемыйТип),
			Значение
		);
	КонецЕсли;

КонецПроцедуры

Функция ПреобразоватьВТип(ИмяПараметра, Значение)

	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Тип") Тогда
		Возврат Значение;
	ИначеЕсли ТипЗначения = Тип("Строка") Тогда
		Попытка
			Возврат Тип(Значение);
		Исключение
			ВызватьИсключение ОшибкаНеверногоТипаАргумента(
				ИмяПараметра,
				НСтр(
					"ru = 'Тип или зарегистрированное имя типа';"
					+ "en = 'Type or registered type name'"
				),
				Значение
			);
		КонецПопытки;
	КонецЕсли;

	ВызватьИсключение ОшибкаНеверногоТипаАргумента(
		ИмяПараметра,
		НСтр("ru = 'Тип или Строка'; en = 'Type or String'"),
		Значение
	);

КонецФункции

Функция ДопустимыеТипыДиапазона()

	Типы = Новый Массив;
	Типы.Добавить(Тип("Число"));
	Типы.Добавить(Тип("Дата"));

	Возврат Типы;

КонецФункции

Процедура ПроверитьПорядокГраниц(МинимальноеЗначение, МаксимальноеЗначение)

	Если МинимальноеЗначение > МаксимальноеЗначение Тогда
		ВызватьИсключение ОшибкаНедопустимогоЗначенияАргумента(
			"МинимальноеЗначение",
			НСтр(
				"ru = 'быть не больше МаксимальногоЗначения';"
				+ "en = 'not exceed MaximumValue'"
			)
		);
	КонецЕсли;

КонецПроцедуры

Функция ТекстОжидаемогоДиапазона(МинимальноеЗначение, МаксимальноеЗначение)

	Возврат СтрШаблон(
		НСтр("ru = 'от %1 до %2 включительно'; en = 'from %1 to %2 inclusive'"),
		МинимальноеЗначение,
		МаксимальноеЗначение
	);

КонецФункции

Функция ТекстДопустимыхТипов(ДопустимыеТипы)

	Представления = Новый Массив;
	Для Каждого ДопустимыйТип Из МассивДопустимыхТипов(ДопустимыеТипы) Цикл
		Представления.Добавить(Строка(ДопустимыйТип));
	КонецЦикла;

	Если Представления.Количество() = 1 Тогда
		Возврат Представления[0];
	КонецЕсли;

	ПоследнееПредставление = Представления[Представления.ВГраница()];
	ВсеКромеПоследнего = Новый Массив;
	Для Индекс = 0 По Представления.ВГраница() - 1 Цикл
		ВсеКромеПоследнего.Добавить(Представления[Индекс]);
	КонецЦикла;

	Возврат СтрШаблон(
		НСтр("ru = '%1 или %2'; en = '%1 or %2'"),
		СтрСоединить(ВсеКромеПоследнего, ", "),
		ПоследнееПредставление
	);

КонецФункции

Функция ПредставлениеЗначения(Значение)

	Если Значение = Неопределено Тогда
		Возврат НСтр("ru = 'Неопределено'; en = 'Undefined'");
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Строка") И Значение = "" Тогда
		Возврат НСтр("ru = 'пустая строка'; en = 'empty string'");
	КонецЕсли;

	Попытка
		Возврат Строка(Значение);
	Исключение
		СервисыБиблиотекиОшибок.РегистраторСбоевБиблиотекиОшибок().ЗаписатьПодавленныйСбой(
			"arguments.render_value",
			Значение,
			ИнформацияОбОшибке()
		);
		Возврат СтрШаблон("<%1>", Строка(ТипЗнч(Значение)));
	КонецПопытки;

КонецФункции

Функция ТекстДопустимыхЗначений(ДопустимыеЗначения)

	Представления = Новый Массив;
	Для Каждого ДопустимоеЗначение Из ДопустимыеЗначения Цикл
		Представления.Добавить(ПредставлениеЗначения(ДопустимоеЗначение));
	КонецЦикла;

	Возврат СтрШаблон(
		НСтр("ru = 'одно из значений: %1'; en = 'one of the values: %1'"),
		СтрСоединить(Представления, ", ")
	);

КонецФункции

Функция ЗаполненоИлиНеПоддерживается(Значение)

	Попытка
		Возврат ЗначениеЗаполнено(Значение);
	Исключение
		СервисыБиблиотекиОшибок.РегистраторСбоевБиблиотекиОшибок().ЗаписатьПодавленныйСбой(
			"arguments.check_filled",
			Значение,
			ИнформацияОбОшибке()
		);
		Возврат Истина;
	КонецПопытки;

КонецФункции

Функция ОшибкаНеверногоТипаАргумента(ИмяАргумента, ОжидаемыйТип, ФактическоеЗначение, Сообщение = "")

	КодОшибки = "argument.invalid_type";
	Формирователь = СервисыБиблиотекиОшибок.ФормировательСообщенийОшибокАргументов();
	Сообщение = Формирователь.НеверныйТип(ИмяАргумента, ОжидаемыйТип, Сообщение);
	Данные = Новый Структура(
		"ИмяАргумента, ОжидаемыйТип, ФактическийТип",
		ИмяАргумента,
		ОжидаемыйТип,
		Строка(ТипЗнч(ФактическоеЗначение))
	);

	Возврат СоздатьОшибкуАргумента(КодОшибки, Сообщение, Данные);

КонецФункции

Функция ОшибкаНезаполненногоАргумента(ИмяАргумента, Сообщение = "")

	КодОшибки = "argument.required";
	Формирователь = СервисыБиблиотекиОшибок.ФормировательСообщенийОшибокАргументов();
	Сообщение = Формирователь.НеЗаполнен(ИмяАргумента, Сообщение);
	Данные = Новый Структура("ИмяАргумента", ИмяАргумента);

	Возврат СоздатьОшибкуАргумента(КодОшибки, Сообщение, Данные);

КонецФункции

Функция ОшибкаНедопустимогоЗначенияАргумента(ИмяАргумента, Ожидание, Сообщение = "")

	КодОшибки = "argument.invalid_value";
	Формирователь = СервисыБиблиотекиОшибок.ФормировательСообщенийОшибокАргументов();
	Сообщение = Формирователь.НедопустимоеЗначение(ИмяАргумента, Ожидание, Сообщение);
	Данные = Новый Структура("ИмяАргумента, Ожидание", ИмяАргумента, Ожидание);

	Возврат СоздатьОшибкуАргумента(КодОшибки, Сообщение, Данные);

КонецФункции

Функция ОшибкаАргументаВнеДиапазона(ИмяАргумента, ОжидаемыйДиапазон, Сообщение = "")

	КодОшибки = "argument.out_of_range";
	Формирователь = СервисыБиблиотекиОшибок.ФормировательСообщенийОшибокАргументов();
	Сообщение = Формирователь.ВнеДиапазона(ИмяАргумента, ОжидаемыйДиапазон, Сообщение);
	Данные = Новый Структура(
		"ИмяАргумента, ОжидаемыйДиапазон",
		ИмяАргумента,
		ОжидаемыйДиапазон
	);

	Возврат СоздатьОшибкуАргумента(КодОшибки, Сообщение, Данные);

КонецФункции

Функция СоздатьОшибкуАргумента(КодОшибки, Сообщение, Данные)

	Вид = ВидыКадровОшибок.Ошибка();
	Описание = СервисыБиблиотекиОшибок.ФорматировщикПредставленияОшибок().КраткоеПредставлениеКадра(
		Вид,
		КодОшибки,
		Сообщение,
		КодОшибки,
		Сообщение
	);

	Создатель = СервисыБиблиотекиОшибок.СоздательКонвертаОшибки();
	Возврат Создатель.СоздатьОшибку(
		Описание,
		КодОшибки,
		Сообщение,
		Данные
	);

КонецФункции

#КонецОбласти
