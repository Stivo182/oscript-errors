&Тест
Процедура ТестДолжен_СохранитьПроизвольныеДанныеУниверсальныхФабрик() Экспорт

	// Подготовка
	Причина = ВнешняяОшибка("Исходная ошибка");
	ДанныеОшибки = Новый Структура("Путь", "settings.json");
	ДанныеКонтекста = Новый Массив;
	ДанныеКонтекста.Добавить("Чтение");
	ДанныеОбертывания = "Запуск приложения";

	// Действие
	Ошибка = ФабрикаОшибок.Создать("config.invalid", "Некорректная конфигурация", ДанныеОшибки);
	Контекст = ФабрикаОшибок.ОбернутьКонтекстом(Причина, "Чтение конфигурации", ДанныеКонтекста);
	ОбернутаяОшибка = ФабрикаОшибок.Обернуть(
		Причина,
		"application.start_failed",
		"Не удалось запустить приложение",
		ДанныеОбертывания
	);

	// Проверка
	Ожидаем.Что((Новый СнимокКадраОшибки(Ошибка)).Данные()).Равно(ДанныеОшибки);
	Ожидаем.Что((Новый СнимокКадраОшибки(Контекст)).Данные()).Равно(ДанныеКонтекста);
	Ожидаем.Что((Новый СнимокКадраОшибки(ОбернутаяОшибка)).Данные()).Равно(ДанныеОбертывания);

КонецПроцедуры

