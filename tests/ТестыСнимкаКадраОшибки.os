КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьСвойстваМестаСозданияКадра() Экспорт

	// Подготовка
	Ошибка = ПомощникТестированияОшибок.ЦепочкаСРазнымиМестамиСоздания().ВнешнийКадр;

	// Действие
	Снимок = Новый СнимокКадраОшибки(Ошибка);

	// Проверка
	Ожидаем.Что(Снимок.ИмяМодуля()).Равно(Ошибка.ИмяМодуля);
	Ожидаем.Что(Снимок.НомерСтроки()).Равно(Ошибка.НомерСтроки);
	Ожидаем.Что(Снимок.ИсходнаяСтрока()).Равно(Ошибка.ИсходнаяСтрока);
	Ожидаем.Что(Снимок.Стек().Количество()).Равно(Ошибка.ПолучитьСтекВызовов().Количество());

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьНезависимыеМассивыСтека() Экспорт

	// Подготовка
	Ошибка = ФабрикаОшибок.Создать("core.failed", "Ошибка");
	Ошибка = ПомощникТестированияОшибок.ПовторноВыброшеннаяОшибка(Ошибка);
	Снимок = Новый СнимокКадраОшибки(Ошибка);
	ПервыйСтек = Снимок.Стек();
	ИсходныйРазмер = ПервыйСтек.Количество();

	// Действие
	ПервыйСтек.Добавить("Проверочный элемент");

	// Проверка
	Ожидаем.Что(Снимок.Стек().Количество()).Равно(ИсходныйРазмер);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьНеверныйТипАргументаКонструктора() Экспорт

	// Подготовка
	Параметры = Новый Массив;
	Параметры.Добавить("не ошибка");

	// Действие и Проверка
	Ожидаем.Что(ЭтотОбъект)
		.Метод("СоздатьСнимок", Параметры)
		.ВыбрасываетИсключение("Ошибка должна иметь тип ИнформацияОбОшибке");

КонецПроцедуры

&Тест
Процедура ТестДолжен_РаспознатьСтарыйКадрБезПодсказки() Экспорт

	// Подготовка
	Поля = Новый Структура;
	Поля.Вставить("Маркер", "onescript.exception.envelope");
	Поля.Вставить("Вид", "Ошибка");
	Поля.Вставить("ТипОшибки", "legacy.failed");
	Поля.Вставить("Данные", Неопределено);
	Ошибка = Новый ИнформацияОбОшибке("Старая ошибка", Новый ФиксированнаяСтруктура(Поля));

	// Действие
	Снимок = Новый СнимокКадраОшибки(Ошибка);

	// Проверка
	Ожидаем.Что(Снимок.Вид()).Равно("Ошибка");
	Ожидаем.Что(Снимок.ТипОшибки()).Равно("legacy.failed");
	Ожидаем.Что(Снимок.Подсказка()).Равно("");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьСнимок(Ошибка) Экспорт

	Возврат Новый СнимокКадраОшибки(Ошибка);

КонецФункции

#КонецОбласти
