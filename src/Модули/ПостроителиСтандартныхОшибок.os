	Возврат СоздатьОднопараметрическуюОшибку(
		КодыСтандартныхОшибок.НарушенВнутреннийИнвариант(),
		"Инвариант",
		Инвариант,
		НСтр("ru = 'Нарушен внутренний инвариант: %1'; en = 'Internal invariant violated: %1'"),
		Сообщение
	);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьСтандартныйПараметр(ИмяПараметра, Значение, Сообщение)

	ПроверкаАргументов.ПроверитьТип(ИмяПараметра, Значение, Тип("Строка"));
	ПроверкаАргументов.ПроверитьЗаполненность(ИмяПараметра, Значение);
	ПроверкаАргументов.ПроверитьТип("Сообщение", Сообщение, Тип("Строка"));

КонецПроцедуры

Процедура ПроверитьДваСтандартныхПараметра(
	ИмяПараметра1,
	Значение1,
	ИмяПараметра2,
	Значение2,
	Сообщение
)

	ПроверитьСтандартныйПараметр(ИмяПараметра1, Значение1, Сообщение);
	ПроверкаАргументов.ПроверитьТип(ИмяПараметра2, Значение2, Тип("Строка"));
	ПроверкаАргументов.ПроверитьЗаполненность(ИмяПараметра2, Значение2);

КонецПроцедуры

Функция СоздатьОднопараметрическуюОшибку(КодОшибки, ИмяПоля, Значение, ШаблонСообщения, Сообщение)

	Если Сообщение = "" Тогда
		Сообщение = СтрШаблон(ШаблонСообщения, Значение);
	КонецЕсли;

	Возврат СоздатьОшибку(
		КодОшибки,
		Сообщение,
		Новый Структура(ИмяПоля, Значение)
	);

КонецФункции

Функция СоздатьДвухпараметрическуюОшибку(
	КодОшибки,
	ИмяПоля1,
	Значение1,
	ИмяПоля2,
	Значение2,
	ШаблонСообщения,
	Сообщение
)

	Если Сообщение = "" Тогда
		Сообщение = СтрШаблон(ШаблонСообщения, Значение1, Значение2);
	КонецЕсли;

	Возврат СоздатьОшибку(
		КодОшибки,
		Сообщение,
		Новый Структура(ИмяПоля1 + ", " + ИмяПоля2, Значение1, Значение2)
	);

КонецФункции

Функция СоздатьОшибку(КодОшибки, Сообщение, Данные)

	Построитель = Новый ПостроительОшибки(КодОшибки, Сообщение);
	Для Каждого Элемент Из Данные Цикл
		Построитель.Данные(Элемент.Ключ, Элемент.Значение);
	КонецЦикла;

	Возврат Построитель;

КонецФункции

#КонецОбласти
