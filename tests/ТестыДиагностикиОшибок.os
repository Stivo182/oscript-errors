&Тест
Процедура ТестДолжен_ПолучитьЭффективныйТипИзСмешаннойЦепочки() Экспорт

	// Подготовка
	Цепочка = СмешаннаяЦепочка();

	// Действие
	ТипОшибки = ДиагностикаОшибок.ПолучитьТипОшибки(Цепочка.Ошибка);

	// Проверка
	Ожидаем.Что(ТипОшибки).Равно("config.load_failed");

КонецПроцедуры

&Тест
Процедура ТестДолжен_НайтиВнешнююИВнутреннююКлассификации() Экспорт

	// Подготовка
	Цепочка = СмешаннаяЦепочка();

	// Действие и Проверка
	Ожидаем.Что(ДиагностикаОшибок.ЭтоОшибка(Цепочка.Ошибка, "config.load_failed")).Равно(Истина);
	Ожидаем.Что(ДиагностикаОшибок.ЭтоОшибка(Цепочка.Ошибка, "fs.file_not_found")).Равно(Истина);
	Ожидаем.Что(ДиагностикаОшибок.ЭтоОшибка(Цепочка.Ошибка, "network.timeout")).Равно(Ложь);
	Ожидаем.Что(ДиагностикаОшибок.НайтиОшибку(Цепочка.Ошибка, "fs.file_not_found")).Равно(Цепочка.ВнутренняяОшибка);

