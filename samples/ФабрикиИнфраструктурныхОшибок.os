#Использовать errors

Ошибки = Новый Массив;
Ошибки.Добавить(СтандартныеОшибки.ОперацияНедоступна("Синхронизация"));
Ошибки.Добавить(СтандартныеОшибки.РесурсНеНайден("Настройки приложения"));
Ошибки.Добавить(СтандартныеОшибки.ИстеклоВремяОжиданияСоединения("Сервис оплаты"));
Ошибки.Добавить(СтандартныеОшибки.ДанныеПовреждены("Кэш справочника"));
Ошибки.Добавить(СтандартныеОшибки.КодировкаНеПоддерживается("UTF-7"));
Ошибки.Добавить(СтандартныеОшибки.НарушенВнутреннийИнвариант("Состояние задачи согласовано"));

Для Каждого Ошибка Из Ошибки Цикл
	Снимок = Новый СнимокКадраОшибки(Ошибка);
	Сообщить(Снимок.КодОшибки() + ": " + Снимок.Сообщение());
КонецЦикла;
