	// Действие
	Снимок = Новый СнимокКадраОшибки(Ошибка);

	// Проверка
	Ожидаем.Что(Снимок.Вид()).Равно("ВнешняяОшибка");
	Ожидаем.Что(Снимок.ТипОшибки()).Равно("");
	Ожидаем.Что(Снимок.Данные()).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СчитатьНекорректныйТипОшибкиВнешнимКадром() Экспорт

	// Подготовка
	Образец = ФабрикаОшибок.Создать("sample.error", "Образец");
