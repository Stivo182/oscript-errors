#Использовать "../internal"

Перем _Снимки; // Массив из СнимокКадраОшибки
Перем _Ошибки; // ВыборкаОшибок
Перем _Контексты; // Массив из СнимокКадраОшибки
Перем _ЭффективнаяОшибка; // СнимокКадраОшибки, Неопределено
Перем _ЦепочкаУсечена; // Булево
Перем _Подсказка; // Строка
Перем _URL; // Строка
Перем _ИсходнаяОшибка; // ИнформацияОбОшибке
Перем _СнимокПредставления; // СнимокКадраОшибки, Неопределено
Перем _КодЭффективнойОшибки; // Строка, Неопределено
Перем _СообщениеЭффективнойОшибки; // Строка
Перем _РазборМатериализован; // Булево
Перем _ФорматировщикПредставления; // ФорматировщикПредставленияОшибок, Неопределено
Перем _КраткоеПредставление; // Строка, Неопределено
Перем _ПользовательскоеПредставление; // Строка, Неопределено

#Область ОбработчикиСобытий

// Создаёт ленивый разбор физической цепочки ошибки.
//
// Параметры:
//  Ошибка - ИнформацияОбОшибке - Внешний кадр исследуемой цепочки.
Процедура ПриСозданииОбъекта(Ошибка)

	ПроверкаКадровОшибок.ПроверитьОшибку(Ошибка);

	_ИсходнаяОшибка = Ошибка;
	_СнимокПредставления = Неопределено;
	_КодЭффективнойОшибки = Неопределено;
	_СообщениеЭффективнойОшибки = "";
	_РазборМатериализован = Ложь;
	_ФорматировщикПредставления = Неопределено;
	_КраткоеПредставление = Неопределено;
	_ПользовательскоеПредставление = Неопределено;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Возвращает все просмотренные физические кадры.
//
// Возвращаемое значение:
//  Массив из СнимокКадраОшибки - Независимая копия снимков в физическом порядке.
Функция Снимки() Экспорт

	МатериализоватьРазбор();

	Возврат КопияМассива(_Снимки);

КонецФункции

// Возвращает все распознанные ошибки.
//
// Возвращаемое значение:
//  ВыборкаОшибок - Неизменяемая выборка классифицированных кадров.
Функция Ошибки() Экспорт

	МатериализоватьРазбор();

	Возврат _Ошибки;

КонецФункции

// Возвращает все распознанные контекстные кадры.
//
// Возвращаемое значение:
//  Массив из СнимокКадраОшибки - Независимая копия контекстов в физическом порядке.
Функция Контексты() Экспорт

	МатериализоватьРазбор();

	Возврат КопияМассива(_Контексты);

КонецФункции

// Возвращает первую распознанную ошибку.
//
// Возвращаемое значение:
//  СнимокКадраОшибки, Неопределено - Эффективная ошибка.
Функция ЭффективнаяОшибка() Экспорт

	МатериализоватьРазбор();

	Возврат _ЭффективнаяОшибка;

КонецФункции

// Возвращает последний просмотренный физический кадр.
//
// Возвращаемое значение:
//  СнимокКадраОшибки - Последний доступный кадр.
Функция ПоследнийКадр() Экспорт

	МатериализоватьРазбор();

	Возврат _Снимки[_Снимки.ВГраница()];

КонецФункции

// Возвращает фактическую корневую причину полностью просмотренной цепочки.
//
// Возвращаемое значение:
//  СнимокКадраОшибки, Неопределено - Корень или Неопределено для усечённой цепочки.
Функция КорневаяПричина() Экспорт

	МатериализоватьРазбор();

	Если _ЦепочкаУсечена Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ПоследнийКадр();

КонецФункции

// Проверяет наличие непросмотренной причины.
//
// Возвращаемое значение:
//  Булево - Истина, если физическая цепочка усечена.
Функция ЦепочкаУсечена() Экспорт

	МатериализоватьРазбор();

	Возврат _ЦепочкаУсечена;

КонецФункции

// Возвращает машинный код эффективной ошибки.
//
// Возвращаемое значение:
//  Строка, Неопределено - Код эффективной ошибки.
Функция КодОшибки() Экспорт

	ПодготовитьПредставление();

	Возврат _КодЭффективнойОшибки;

КонецФункции

// Возвращает по ссылке пользовательские данные эффективной ошибки.
//
// Возвращаемое значение:
//  Произвольный, Неопределено - Данные эффективной ошибки.
Функция Данные() Экспорт

	МатериализоватьРазбор();

	Если _ЭффективнаяОшибка = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат _ЭффективнаяОшибка.Данные();

КонецФункции

// Возвращает первую непустую подсказку распознанной ошибки.
//
// Возвращаемое значение:
//  Строка - Подсказка или пустая строка.
Функция Подсказка() Экспорт

	МатериализоватьРазбор();

	Возврат _Подсказка;

КонецФункции

// Возвращает первый непустой URL распознанной ошибки.
//
// Возвращаемое значение:
//  Строка - URL документации или пустая строка.
Функция URL() Экспорт

	МатериализоватьРазбор();

	Возврат _URL;

КонецФункции

// Возвращает краткое человекочитаемое представление ошибки.
//
// Возвращаемое значение:
//  Строка - Текущий кадр с эффективной ошибкой для контекста или внешней обёртки.
Функция КраткоеПредставление() Экспорт

	Если _КраткоеПредставление = Неопределено Тогда
		ПодготовитьПредставление();

		_КраткоеПредставление = ФорматировщикПредставления().КраткоеПредставлениеКадра(
			_СнимокПредставления.Вид(),
			_СнимокПредставления.КодОшибки(),
			_СнимокПредставления.Сообщение(),
			_КодЭффективнойОшибки,
			_СообщениеЭффективнойОшибки
		);
	КонецЕсли;

	Возврат _КраткоеПредставление;

КонецФункции

// Возвращает подробное пользовательское представление ошибки.
//
// Возвращаемое значение:
//  Строка - Текущий кадр, эффективная ошибка для обёртки, подсказка и URL текущего кадра.
Функция ПользовательскоеПредставление() Экспорт

	Если _ПользовательскоеПредставление = Неопределено Тогда
		ПодготовитьПредставление();

		_ПользовательскоеПредставление = ФорматировщикПредставления().ПользовательскоеПредставлениеКадра(
			_СнимокПредставления.Вид(),
			_СнимокПредставления.КодОшибки(),
			_СнимокПредставления.Сообщение(),
			_СнимокПредставления.Подсказка(),
			_СнимокПредставления.URL(),
			_КодЭффективнойОшибки,
			_СообщениеЭффективнойОшибки
		);
	КонецЕсли;

	Возврат _ПользовательскоеПредставление;

КонецФункции

// Возвращает полный диагностический отчёт.
//
// Возвращаемое значение:
//  Строка - Семантические группы ошибки, контекстов и причин со стеком и данными.
Функция ДиагностическоеПредставление() Экспорт

	МатериализоватьРазбор();

	Возврат ФорматировщикПредставления().ДиагностическоеПредставление(_Снимки, _ЦепочкаУсечена);

КонецФункции

// Возвращает структурированное представление просмотренной физической цепочки.
//
// Возвращаемое значение:
//  Структура:
//   * Цепочка - Массив из Структура - Физическая цепочка от внешнего кадра к корневому:
//    ** Вид - Строка - Ошибка, Контекст или ВнешняяОшибка;
//    ** КодОшибки - Строка - Машинный код или пустая строка;
//    ** Сообщение - Строка - Сообщение кадра;
//    ** Данные - Произвольный, Неопределено - Исходные данные без копирования;
//    ** Подсказка - Строка - Подсказка или пустая строка;
//    ** URL - Строка - URL документации или пустая строка;
//    ** ИмяМодуля - Строка - Имя модуля или пустая строка;
//    ** НомерСтроки - Число - Номер строки или 0;
//    ** ИсходнаяСтрока - Строка - Исходная строка или пустая строка;
//   * ЭффективнаяОшибка - Структура, Неопределено - Первый классифицированный элемент массива Цепочка:
//     Содержит тот же объект Структура, что и соответствующий элемент массива Цепочка;
//    ** Вид - Строка - Ошибка;
//    ** КодОшибки - Строка - Машинный код ошибки;
//    ** Сообщение - Строка - Сообщение ошибки;
//    ** Данные - Произвольный, Неопределено - Исходные данные без копирования;
//    ** Подсказка - Строка - Подсказка или пустая строка;
//    ** URL - Строка - URL документации или пустая строка;
//    ** ИмяМодуля - Строка - Имя модуля или пустая строка;
//    ** НомерСтроки - Число - Номер строки или 0;
//    ** ИсходнаяСтрока - Строка - Исходная строка или пустая строка;
//   * ЦепочкаУсечена - Булево - Признак наличия непросмотренной причины;
//   * Стек - Массив из Структура - Стек вызовов внешнего физического кадра:
//    ** ИмяМодуля - Строка - Имя модуля;
//    ** НомерСтроки - Число - Номер строки.
Функция ВСтруктуру() Экспорт

	МатериализоватьРазбор();

	Результат = Новый Структура(
		"Цепочка, ЭффективнаяОшибка, ЦепочкаУсечена, Стек",
		Новый Массив,
		Неопределено,
		_ЦепочкаУсечена,
		ПредставлениеСтека(_Снимки[0].СтекВызовов())
	);

	Для Каждого Снимок Из _Снимки Цикл
		Представление = ПредставлениеКадра(Снимок);
		Результат.Цепочка.Добавить(Представление);

		Если Снимок = _ЭффективнаяОшибка Тогда
			Результат.ЭффективнаяОшибка = Представление;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПодготовитьПредставление()

	Если _СнимокПредставления <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	_СнимокПредставления = Новый СнимокКадраОшибки(_ИсходнаяОшибка);

	Если _СнимокПредставления.Вид() = ВидыКадровОшибок.Ошибка() Тогда
		_КодЭффективнойОшибки = _СнимокПредставления.КодОшибки();
		_СообщениеЭффективнойОшибки = _СнимокПредставления.Сообщение();
	Иначе
		ЗаполнитьЭффективнуюОшибку(
			_ИсходнаяОшибка,
			_КодЭффективнойОшибки,
			_СообщениеЭффективнойОшибки
		);
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьЭффективнуюОшибку(Ошибка, КодОшибки, Сообщение)

	ТекущийКадр = Ошибка;
	Для НомерКадра = 2 По ОбходЦепочкиОшибки.МаксимальноеКоличествоКадров() Цикл
		Причина = Неопределено;
		Если Не ОбходЦепочкиОшибки.ПопытатьсяПрочитатьПричину(ТекущийКадр, Причина)
			Или Причина = Неопределено Тогда
			Возврат;
		КонецЕсли;

		ТекущийКадр = Причина;
		Метаданные = ЧтениеКадраОшибки.ПрочитатьМетаданные(ТекущийКадр);

		Если Метаданные <> Неопределено И Метаданные.Вид = ВидыКадровОшибок.Ошибка() Тогда
			КодОшибки = Метаданные.КодОшибки;
			Сообщение = Метаданные.Сообщение;
			Возврат;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура МатериализоватьРазбор()

	Если _РазборМатериализован Тогда
		Возврат;
	КонецЕсли;

	Просмотр = ОбходЦепочкиОшибки.Просмотреть(_ИсходнаяОшибка);

	_Снимки = Новый Массив;
	_Контексты = Новый Массив;
	_ЭффективнаяОшибка = Неопределено;
	_Подсказка = "";
	_URL = "";

	Ошибки = Новый Массив;
	Для Каждого Кадр Из Просмотр.Кадры Цикл
		ПодготовитьСнимок(Кадр, Ошибки);
	КонецЦикла;

	_Ошибки = Новый ВыборкаОшибок(Ошибки);
	_ЦепочкаУсечена = Просмотр.Усечена;
	_РазборМатериализован = Истина;

КонецПроцедуры

Процедура ПодготовитьСнимок(Кадр, Ошибки)

	Если Кадр = _ИсходнаяОшибка И _СнимокПредставления <> Неопределено Тогда
		Снимок = _СнимокПредставления;
	Иначе
		Снимок = Новый СнимокКадраОшибки(Кадр);
	КонецЕсли;

	_Снимки.Добавить(Снимок);

	Если Снимок.Вид() = ВидыКадровОшибок.Ошибка() Тогда
		Ошибки.Добавить(Снимок);
		Если _ЭффективнаяОшибка = Неопределено Тогда
			_ЭффективнаяОшибка = Снимок;
		КонецЕсли;

		Если ПустаяСтрока(_Подсказка) Тогда
			ПодсказкаСнимка = Снимок.Подсказка();
			Если Не ПустаяСтрока(ПодсказкаСнимка) Тогда
				_Подсказка = ПодсказкаСнимка;
			КонецЕсли;
		КонецЕсли;

		Если ПустаяСтрока(_URL) Тогда
			URLСнимка = Снимок.URL();
			Если Не ПустаяСтрока(URLСнимка) Тогда
				_URL = URLСнимка;
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли Снимок.Вид() = ВидыКадровОшибок.Контекст() Тогда
		_Контексты.Добавить(Снимок);
	КонецЕсли;

КонецПроцедуры

Функция КопияМассива(ИсходныйМассив)

	Результат = Новый Массив;
	Для Каждого Элемент Из ИсходныйМассив Цикл
		Результат.Добавить(Элемент);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ПредставлениеКадра(Снимок)

	МестоСоздания = Снимок.МестоСоздания();

	Результат = Новый Структура;
	Результат.Вставить("Вид", Снимок.Вид());
	Результат.Вставить("КодОшибки", Снимок.КодОшибки());
	Результат.Вставить("Сообщение", Снимок.Сообщение());
	Результат.Вставить("Данные", Снимок.Данные());
	Результат.Вставить("Подсказка", Снимок.Подсказка());
	Результат.Вставить("URL", Снимок.URL());
	Результат.Вставить("ИмяМодуля", МестоСоздания.ИмяМодуля);
	Результат.Вставить("НомерСтроки", МестоСоздания.НомерСтроки);
	Результат.Вставить("ИсходнаяСтрока", МестоСоздания.ИсходнаяСтрока);

	Возврат Результат;

КонецФункции

Функция ПредставлениеСтека(Стек)

	Результат = Новый Массив;

	Для Каждого Кадр Из Стек Цикл
		Результат.Добавить(Новый Структура(
			"ИмяМодуля, НомерСтроки",
			Кадр.ИмяМодуля,
			Кадр.НомерСтроки
		));
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ФорматировщикПредставления()

	Если _ФорматировщикПредставления = Неопределено Тогда
		_ФорматировщикПредставления = Новый ФорматировщикПредставленияОшибок();
	КонецЕсли;

	Возврат _ФорматировщикПредставления;

КонецФункции

#КонецОбласти
