#Область СлужебныйПрограммныйИнтерфейс

// Формирует строки ограниченного представления произвольного значения.
//
// Параметры:
//  Значение - Произвольный - Представляемое значение.
//  Отступ - Число - Количество пробелов перед каждой строкой.
//
// Возвращаемое значение:
//  Массив из Строка - Новые строки представления.
Функция СтрокиДанных(Значение, Отступ = 0) Экспорт

	Результат = Новый Массив;
	ДобавитьЗначение(Результат, Значение, Отступ, 0, Новый Массив);

	Возврат Результат;

КонецФункции

// Формирует строки общего стека вызовов и нумерует их, если строк больше одной.
//
// Параметры:
//  Стек - Массив - Представляемый стек вызовов.
//  Отступ - Число - Количество пробелов перед каждой строкой.
//
// Возвращаемое значение:
//  Массив из Строка - Новые строки представления стека вызовов.
Функция СтрокиСтекаВызовов(Стек, Отступ = 0) Экспорт

	ЭлементыСтека = ПредставленияЭлементовСтека(Стек);
	Результат = Новый Массив;
	Нумеровать = ЭлементыСтека.Количество() > 1;

	Для Номер = 0 По ЭлементыСтека.ВГраница() Цикл
		МаркерНомера = "";
		Если Нумеровать Тогда
			МаркерНомера = Строка(Номер + 1) + ": ";
		КонецЕсли;
		ДобавитьЗначениеСМаркером(Результат, Отступ, МаркерНомера, ЭлементыСтека[Номер].Текст);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Формирует семантический диагностический отчёт по просмотренным физическим кадрам.
//
// Параметры:
//  Снимки - Массив из СнимокКадраОшибки - Снимки от внешнего кадра к корневому.
//  Усечена - Булево - Признак наличия непросмотренного продолжения цепочки.
//
// Возвращаемое значение:
//  Строка - Подробное диагностическое представление.
Функция ПодробноеПредставление(Снимки, Усечена) Экспорт

	Блоки = Новый Массив;
	Группы = Новый Массив;
	Контексты = Новый Массив;
	Подсказки = Новый Массив;

	Для Каждого Снимок Из Снимки Цикл
		Если Не ПустаяСтрока(Снимок.Подсказка()) Тогда
			Подсказки.Добавить(Снимок.Подсказка());
		КонецЕсли;

		Кадр = Новый Структура("Снимок", Снимок);

		Если Снимок.Вид() = ВидыКадровОшибок.Контекст Тогда
			Контексты.Добавить(Кадр);
		Иначе
			Группы.Добавить(Новый Структура("Кадр, Контексты", Кадр, Контексты));
			Контексты = Новый Массив;
		КонецЕсли;

	КонецЦикла;

	Если Группы.Количество() > 0 Тогда
		Блоки.Добавить(БлокГруппы(Группы[0], 0, "", 2, Ложь));
	КонецЕсли;

	Если Группы.Количество() > 1 Тогда
		Блоки.Добавить(БлокПричин(Группы));
	КонецЕсли;

	Если Подсказки.Количество() > 0 Тогда
		Блоки.Добавить(БлокПодсказок(Подсказки));
	КонецЕсли;

	Если Усечена И Контексты.Количество() > 0 Тогда
		Блоки.Добавить(БлокКонтекстовБезПричины(Контексты));
	КонецЕсли;

	Если Усечена Тогда
		Блоки.Добавить("Цепочка причин усечена: показано 64 кадра");
	КонецЕсли;

	Если Снимки.Количество() > 0 Тогда
		БлокСтека = БлокСтекаВызовов(Снимки[0].Стек());
		Если БлокСтека <> "" Тогда
			Блоки.Добавить(БлокСтека);
		КонецЕсли;
	КонецЕсли;

	Возврат СоединитьСтроки(Блоки, Символы.ПС + Символы.ПС);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция БлокГруппы(Группа, ОтступЗаголовка, МаркерНомера, ОтступПолей, ЭтоПричина)

	Строки = Новый Массив;
	Кадр = Группа.Кадр;
	Снимок = Кадр.Снимок;

	ДобавитьЗначениеСМаркером(
		Строки,
		ОтступЗаголовка,
		МаркерНомера + МаркерЗаголовкаГруппы(Снимок, ЭтоПричина),
		Снимок.Сообщение()
	);

	Если Группа.Контексты.Количество() > 0 Тогда
		Строки.Добавить(Пробелы(ОтступПолей) + "Контекст:");
		Для Каждого Контекст Из Группа.Контексты Цикл
			ДобавитьКонтекст(Строки, Контекст, ОтступПолей + 2);
		КонецЦикла;
	КонецЕсли;

	ДобавитьДополнительныеПоля(Строки, Кадр, ОтступПолей);

	Возврат СоединитьСтроки(Строки, Символы.ПС);

КонецФункции

Функция БлокПричин(Группы)

	Строки = Новый Массив;
	Строки.Добавить("  Причина:");
	КоличествоПричин = Группы.Количество() - 1;

	Для НомерПричины = 1 По Группы.ВГраница() Цикл

		МаркерНомера = "";
		ОтступПолей = 6;
		Если КоличествоПричин > 1 Тогда
			МаркерНомера = Строка(НомерПричины) + ": ";
			ОтступПолей = 4 + СтрДлина(МаркерНомера);
		КонецЕсли;

		Строки.Добавить(БлокГруппы(Группы[НомерПричины], 4, МаркерНомера, ОтступПолей, Истина));

	КонецЦикла;

	Возврат СоединитьСтроки(Строки, Символы.ПС);

КонецФункции

Функция БлокПодсказок(Подсказки)

	Строки = Новый Массив;
	Строки.Добавить("  Подсказка:");
	Нумеровать = Подсказки.Количество() > 1;

	Для Номер = 0 По Подсказки.ВГраница() Цикл
		МаркерНомера = "";
		Если Нумеровать Тогда
			МаркерНомера = Строка(Номер + 1) + ": ";
		КонецЕсли;
		ДобавитьЗначениеСМаркером(Строки, 4, МаркерНомера, Подсказки[Номер]);
	КонецЦикла;

	Возврат СоединитьСтроки(Строки, Символы.ПС);

КонецФункции
Функция БлокСтекаВызовов(Стек)

	СтрокиОбщегоСтека = СтрокиСтекаВызовов(Стек, 4);
	Если СтрокиОбщегоСтека.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Строки = Новый Массив;
	Строки.Добавить("  Стек вызовов:");
	ДобавитьСтроки(Строки, СтрокиОбщегоСтека);

	Возврат СоединитьСтроки(Строки, Символы.ПС);

КонецФункции

Функция МаркерЗаголовкаГруппы(Снимок, ЭтоПричина)

	Если Снимок.Вид() = ВидыКадровОшибок.Ошибка Тогда
		Возврат Снимок.ТипОшибки() + ": ";
	КонецЕсли;

	Возврат "";

КонецФункции

Процедура ДобавитьКонтекст(Строки, Контекст, Отступ)

	ДобавитьЗначениеСМаркером(Строки, Отступ, "- ", Контекст.Снимок.Сообщение());
	ДобавитьДополнительныеПоля(Строки, Контекст, Отступ + 2);

КонецПроцедуры

Процедура ДобавитьДополнительныеПоля(Строки, Кадр, Отступ)

	Снимок = Кадр.Снимок;

	Данные = Снимок.Данные();
	Если Данные <> Неопределено Тогда
		Если ЭтоКонтейнер(Данные) И Данные.Количество() = 0 Тогда
			ДобавитьПоле(Строки, Отступ, "Данные", МаркерПустогоКонтейнера(Данные));
		Иначе
			Строки.Добавить(Пробелы(Отступ) + "Данные:");
			ДобавитьСтроки(Строки, СтрокиДанных(Данные, Отступ + 2));
		КонецЕсли;
	КонецЕсли;


	ДобавитьМесто(Строки, Снимок, Отступ);

	Если Снимок.ИсходнаяСтрока() <> "" Тогда
		ДобавитьПоле(Строки, Отступ, "Исходная строка", СокрЛП(Снимок.ИсходнаяСтрока()));
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьМесто(Строки, Снимок, Отступ)

	ИмяМодуля = Снимок.ИмяМодуля();
	НомерСтроки = Снимок.НомерСтроки();

	Если ИмяМодуля <> "" И НомерСтроки > 0 Тогда
		ДобавитьПоле(Строки, Отступ, "Место", СтрШаблон("%1:%2", ИмяМодуля, НомерСтроки));
	ИначеЕсли ИмяМодуля <> "" Тогда
		ДобавитьПоле(Строки, Отступ, "Место", ИмяМодуля);
	ИначеЕсли НомерСтроки > 0 Тогда
		ДобавитьПоле(Строки, Отступ, "Строка", Строка(НомерСтроки));
	КонецЕсли;

КонецПроцедуры

Функция БлокКонтекстовБезПричины(Контексты)

	Строки = Новый Массив;
	Строки.Добавить("Контекст без просмотренной причины:");
	Для Каждого Контекст Из Контексты Цикл
		ДобавитьКонтекст(Строки, Контекст, 2);
	КонецЦикла;

	Возврат СоединитьСтроки(Строки, Символы.ПС);

КонецФункции

Процедура ДобавитьПоле(Строки, Отступ, Имя, Значение)

	ДобавитьЗначениеСМаркером(Строки, Отступ, Имя + ": ", Значение);

КонецПроцедуры

Процедура ДобавитьЗначениеСМаркером(Строки, Отступ, Маркер, Значение)

	Префикс = Пробелы(Отступ) + Маркер;
	СтрокиЗначения = СтрокиТекста(Значение);

	Если СтрокиЗначения.Количество() = 0 Тогда
		Строки.Добавить(Префикс + Символ(34) + Символ(34));
		Возврат;
	КонецЕсли;

	Строки.Добавить(Префикс + СтрокиЗначения[0]);

	ОтступПродолжения = Пробелы(СтрДлина(Префикс));
	Для НомерСтроки = 1 По СтрокиЗначения.ВГраница() Цикл
		Строки.Добавить(ОтступПродолжения + СтрокиЗначения[НомерСтроки]);
	КонецЦикла;

КонецПроцедуры

Функция СтрокиТекста(Значение)

	Текст = Строка(Значение);
	Текст = СтрЗаменить(Текст, Символы.ВК + Символы.ПС, Символы.ПС);
	Текст = СтрЗаменить(Текст, Символы.ВК, Символы.ПС);

	Если Текст = "" Тогда
		Возврат Новый Массив;
	КонецЕсли;

	Возврат СтрРазделить(Текст, Символы.ПС, Истина);

КонецФункции

Процедура ДобавитьСтроки(Приемник, Источник)

	Для Каждого Строка Из Источник Цикл
		Приемник.Добавить(Строка);
	КонецЦикла;

КонецПроцедуры

Функция ПредставленияЭлементовСтека(Стек)

	Результат = Новый Массив;
	Для Каждого Элемент Из Стек Цикл
		Результат.Добавить(БезопасноеПредставление(Элемент));
	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура ДобавитьЗначение(Строки, Значение, Отступ, Глубина, ПутьКонтейнеров)

	Если Не ЭтоКонтейнер(Значение) Тогда
		ДобавитьЗначениеСМаркером(Строки, Отступ, "", БезопасныйТекст(Значение));
		Возврат;
	КонецЕсли;

	Если Глубина >= 3 Тогда
		Строки.Добавить(Пробелы(Отступ) + "<максимальная глубина>");
		Возврат;
	КонецЕсли;

	Если ПутьКонтейнеров.Найти(Значение) <> Неопределено Тогда
		Строки.Добавить(Пробелы(Отступ) + "<циклическая ссылка>");
		Возврат;
	КонецЕсли;

	Если Значение.Количество() = 0 Тогда
		Строки.Добавить(Пробелы(Отступ) + МаркерПустогоКонтейнера(Значение));
		Возврат;
	КонецЕсли;

	ПутьКонтейнеров.Добавить(Значение);

	Если ЭтоСтруктура(Значение) Тогда
		ДобавитьСтруктуру(Строки, Значение, Отступ, Глубина, ПутьКонтейнеров);
	ИначеЕсли ЭтоСоответствие(Значение) Тогда
		ДобавитьСоответствие(Строки, Значение, Отступ, Глубина, ПутьКонтейнеров);
	Иначе
		ДобавитьМассив(Строки, Значение, Отступ, Глубина, ПутьКонтейнеров);
	КонецЕсли;

	ПутьКонтейнеров.Удалить(ПутьКонтейнеров.ВГраница());

КонецПроцедуры

Процедура ДобавитьСтруктуру(Строки, Значение, Отступ, Глубина, ПутьКонтейнеров)

	КоличествоДобавленных = 0;

	Для Каждого Элемент Из Значение Цикл

		Если КоличествоДобавленных = 20 Тогда
			Прервать;
		КонецЕсли;

		ДобавитьПару(
			Строки,
			Элемент.Ключ,
			Элемент.Значение,
			Отступ,
			Глубина,
			ПутьКонтейнеров
		);

		КоличествоДобавленных = КоличествоДобавленных + 1;

	КонецЦикла;

	ДобавитьМаркерЛимита(Строки, Значение.Количество(), Отступ, Ложь);

КонецПроцедуры

Процедура ДобавитьСоответствие(Строки, Значение, Отступ, Глубина, ПутьКонтейнеров)

	Элементы = ОтсортированныеЭлементыСоответствия(Значение, Глубина, ПутьКонтейнеров);
	КоличествоДобавленных = 0;

	Для Каждого Элемент Из Элементы Цикл

		Если КоличествоДобавленных = 20 Тогда
			Прервать;
		КонецЕсли;

		ДобавитьПару(
			Строки,
			Элемент.Ключ,
			Элемент.ИсходноеЗначение,
			Отступ,
			Глубина,
			ПутьКонтейнеров
		);

		КоличествоДобавленных = КоличествоДобавленных + 1;

	КонецЦикла;

	ДобавитьМаркерЛимита(Строки, Значение.Количество(), Отступ, Ложь);

КонецПроцедуры

Процедура ДобавитьМассив(Строки, Значение, Отступ, Глубина, ПутьКонтейнеров)

	КоличествоДобавленных = 0;

	Для Каждого Элемент Из Значение Цикл

		Если КоличествоДобавленных = 20 Тогда
			Прервать;
		КонецЕсли;

		Если ЭтоКонтейнер(Элемент) И Не ЭтоОднострочныйКонтейнер(Элемент, Глубина + 1, ПутьКонтейнеров) Тогда
			Строки.Добавить(Пробелы(Отступ) + "-");
			ДобавитьЗначение(Строки, Элемент, Отступ + 2, Глубина + 1, ПутьКонтейнеров);
		Иначе
			Текст = ОднострочноеПредставление(Элемент, Глубина + 1, ПутьКонтейнеров);
			ДобавитьЗначениеСМаркером(Строки, Отступ, "- ", Текст);
		КонецЕсли;

		КоличествоДобавленных = КоличествоДобавленных + 1;

	КонецЦикла;

	ДобавитьМаркерЛимита(Строки, Значение.Количество(), Отступ, Истина);

КонецПроцедуры

Процедура ДобавитьПару(Строки, Ключ, Значение, Отступ, Глубина, ПутьКонтейнеров)

	Если ЭтоКонтейнер(Значение) И Не ЭтоОднострочныйКонтейнер(Значение, Глубина + 1, ПутьКонтейнеров) Тогда
		Строки.Добавить(Пробелы(Отступ) + Ключ + ":");
		ДобавитьЗначение(Строки, Значение, Отступ + 2, Глубина + 1, ПутьКонтейнеров);
	Иначе
		Текст = ОднострочноеПредставление(Значение, Глубина + 1, ПутьКонтейнеров);
		ДобавитьЗначениеСМаркером(Строки, Отступ, Ключ + ": ", Текст);
	КонецЕсли;

КонецПроцедуры

Функция ЭтоОднострочныйКонтейнер(Значение, Глубина, ПутьКонтейнеров)

	Возврат Глубина >= 3
		Или ПутьКонтейнеров.Найти(Значение) <> Неопределено
		Или Значение.Количество() = 0;

КонецФункции

Функция ОднострочноеПредставление(Значение, Глубина, ПутьКонтейнеров)

	Если Не ЭтоКонтейнер(Значение) Тогда
		Возврат БезопасныйТекст(Значение);
	ИначеЕсли Глубина >= 3 Тогда
		Возврат "<максимальная глубина>";
	ИначеЕсли ПутьКонтейнеров.Найти(Значение) <> Неопределено Тогда
		Возврат "<циклическая ссылка>";
	КонецЕсли;

	Возврат МаркерПустогоКонтейнера(Значение);

КонецФункции

Функция ОтсортированныеЭлементыСоответствия(Значение, Глубина, ПутьКонтейнеров)

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("ТипКлюча");
	Результат.Колонки.Добавить("Ключ");
	Результат.Колонки.Добавить("ПредставлениеЗначения");
	Результат.Колонки.Добавить("Порядок");
	Результат.Колонки.Добавить("ИсходноеЗначение");
	Порядок = 0;

	Для Каждого Элемент Из Значение Цикл

		СтрокаТаблицы = Результат.Добавить();
		СтрокаТаблицы.ТипКлюча = БезопасныйТекст(ТипЗнч(Элемент.Ключ));
		СтрокаТаблицы.Ключ = ПредставлениеКлючаСоответствия(Элемент.Ключ);
		СтрокаТаблицы.ПредставлениеЗначения = ПредставлениеЗначенияДляСортировки(
			Элемент.Значение,
			Глубина + 1,
			ПутьКонтейнеров
		);
		СтрокаТаблицы.Порядок = Порядок;
		СтрокаТаблицы.ИсходноеЗначение = Элемент.Значение;

		Порядок = Порядок + 1;

	КонецЦикла;

	Результат.Сортировать("ТипКлюча, Ключ, ПредставлениеЗначения, Порядок");

	Возврат Результат;

КонецФункции

Функция ПредставлениеЗначенияДляСортировки(Значение, Глубина, ПутьКонтейнеров)

	Строки = Новый Массив;
	ДобавитьЗначение(Строки, Значение, 0, Глубина, ПутьКонтейнеров);

	Возврат СоединитьСтроки(Строки, Символы.ПС);

КонецФункции

Функция ПредставлениеКлючаСоответствия(Ключ)

	Результат = БезопасныйТекст(Ключ);
	Результат = СтрЗаменить(Результат, "\", "\\");
	Результат = СтрЗаменить(Результат, Символы.ВК, "\r");
	Результат = СтрЗаменить(Результат, Символы.ПС, "\n");
	Результат = СтрЗаменить(Результат, Символы.Таб, "\t");

	Если Результат = "" Тогда
		Результат = Символ(34) + Символ(34);
	КонецЕсли;

	Возврат Результат;

КонецФункции

Процедура ДобавитьМаркерЛимита(Строки, Количество, Отступ, ЭтоМассив)

	Если Количество <= 20 Тогда
		Возврат;
	КонецЕсли;

	Префикс = "";
	Если ЭтоМассив Тогда
		Префикс = "- ";
	КонецЕсли;
	Строки.Добавить(
		Пробелы(Отступ) + Префикс + СтрШаблон("... ещё %1 элементов", Количество - 20)
	);

КонецПроцедуры

Функция МаркерПустогоКонтейнера(Значение)

	Если ЭтоМассив(Значение) Тогда
		Возврат "[]";
	КонецЕсли;

	Возврат "{}";

КонецФункции

Функция ЭтоКонтейнер(Значение)

	Возврат ЭтоСтруктура(Значение) Или ЭтоСоответствие(Значение) Или ЭтоМассив(Значение);

КонецФункции

Функция ЭтоСтруктура(Значение)

	ТипЗначения = ТипЗнч(Значение);

	Возврат ТипЗначения = Тип("Структура") Или ТипЗначения = Тип("ФиксированнаяСтруктура");

КонецФункции

Функция ЭтоСоответствие(Значение)

	ТипЗначения = ТипЗнч(Значение);

	Возврат ТипЗначения = Тип("Соответствие") Или ТипЗначения = Тип("ФиксированноеСоответствие");

КонецФункции

Функция ЭтоМассив(Значение)

	ТипЗначения = ТипЗнч(Значение);

	Возврат ТипЗначения = Тип("Массив") Или ТипЗначения = Тип("ФиксированныйМассив");

КонецФункции

Функция БезопасныйТекст(Значение)

	Если Значение = Неопределено Тогда
		Возврат "Неопределено";
	КонецЕсли;

	Результат = БезопасноеПредставление(Значение).Текст;

	Если Результат = "" Тогда
		Возврат Символ(34) + Символ(34);
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция БезопасноеПредставление(Значение)

	Попытка
		Возврат Новый Структура("Текст, Доступно", Строка(Значение), Истина);
	Исключение
		Возврат Новый Структура("Текст, Доступно", "<недоступно>", Ложь);
	КонецПопытки;

КонецФункции

Функция Пробелы(Количество)

	Результат = "";
	Для Счетчик = 1 По Количество Цикл
		Результат = Результат + " ";
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция СоединитьСтроки(Строки, Разделитель)

	Результат = "";
	Для Каждого ТекущаяСтрока Из Строки Цикл
		Если Результат <> "" Тогда
			Результат = Результат + Разделитель;
		КонецЕсли;
		Результат = Результат + ТекущаяСтрока;
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти
