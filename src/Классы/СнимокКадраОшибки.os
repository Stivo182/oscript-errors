#Использовать "../internal"

Перем _ИсходнаяОшибка; // ИнформацияОбОшибке
Перем _Вид; // Строка
Перем _ТипОшибки; // Строка
Перем _Сообщение; // Строка
Перем _Данные; // Произвольный, Неопределено
Перем _Подсказка; // Строка
Перем _ИмяМодуля; // Строка
Перем _НомерСтроки; // Число
Перем _ИсходнаяСтрока; // Строка
Перем _Стек; // Массив из КадрСтекаВызовов

#Область ОбработчикиСобытий

// Создаёт снимок физического кадра ошибки.
//
// Параметры:
//  Ошибка - ИнформацияОбОшибке - Физический кадр для создания снимка.
Процедура ПриСозданииОбъекта(Ошибка)

	ПроверкаКадровОшибок.ПроверитьОшибку(Ошибка);

	_ИсходнаяОшибка = Ошибка;
	_Вид = ВидыКадровОшибок.ВнешняяОшибка;
	_ТипОшибки = "";
	_Данные = Неопределено;
	_Подсказка = "";
	_Сообщение = "";
	_ИмяМодуля = "";
	_НомерСтроки = 0;
	_ИсходнаяСтрока = "";
	_Стек = Новый Массив;
	_Сообщение = Ошибка.Описание;

	РаспознатьКадр(Ошибка);
	ЗаполнитьСвойстваМестаСоздания(Ошибка);

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Возвращает исходный физический кадр.
//
// Возвращаемое значение:
//  ИнформацияОбОшибке - Кадр, из которого создан снимок.
Функция ИсходнаяОшибка() Экспорт

	Возврат _ИсходнаяОшибка;

КонецФункции

// Возвращает распознанный вид кадра.
//
// Возвращаемое значение:
//  Строка - Распознанный вид кадра.
Функция Вид() Экспорт

	Возврат _Вид;

КонецФункции

// Возвращает машинный тип собственного кадра.
//
// Возвращаемое значение:
//  Строка - Машинный тип собственного кадра или пустая строка, если тип отсутствует.
Функция ТипОшибки() Экспорт

	Возврат _ТипОшибки;

КонецФункции

// Возвращает описание физического кадра.
//
// Возвращаемое значение:
//  Строка - Описание физического кадра.
Функция Сообщение() Экспорт

	Возврат _Сообщение;

КонецФункции

// Возвращает пользовательские данные собственного кадра.
//
// Возвращаемое значение:
//  Произвольный, Неопределено - Пользовательские данные собственного кадра.
Функция Данные() Экспорт

	Возврат _Данные;

КонецФункции

// Возвращает подсказку по исправлению собственного кадра.
//
// Возвращаемое значение:
//  Строка - Подсказка или пустая строка, если она отсутствует.
Функция Подсказка() Экспорт

	Возврат _Подсказка;

КонецФункции

// Возвращает имя модуля места создания кадра.
//
// Возвращаемое значение:
//  Строка - Имя модуля места создания кадра или пустая строка, если имя отсутствует.
Функция ИмяМодуля() Экспорт

	Возврат _ИмяМодуля;

КонецФункции

// Возвращает номер строки места создания кадра.
//
// Возвращаемое значение:
//  Число - Номер строки места создания кадра или 0, если номер отсутствует.
Функция НомерСтроки() Экспорт

	Возврат _НомерСтроки;

КонецФункции

// Возвращает исходную строку места создания кадра.
//
// Возвращаемое значение:
//  Строка - Исходная строка места создания кадра или пустая строка, если строка отсутствует.
Функция ИсходнаяСтрока() Экспорт

	Возврат _ИсходнаяСтрока;

КонецФункции

// Возвращает независимую копию стека вызовов кадра.
//
// Возвращаемое значение:
//  Массив из КадрСтекаВызовов - Независимая копия стека вызовов кадра.
Функция Стек() Экспорт

	Результат = Новый Массив;
	Для Каждого ЭлементСтека Из _Стек Цикл
		Результат.Добавить(ЭлементСтека);
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура РаспознатьКадр(Кадр)

	Попытка
		Параметры = Кадр.Параметры;
		Если ТипЗнч(Параметры) <> Тип("ФиксированнаяСтруктура") Тогда
			Возврат;
		КонецЕсли;

		Если Не ЭтоПоддерживаемыеМетаданныеКадра(Параметры) Тогда
			Возврат;
		КонецЕсли;

		_Вид = Параметры.Вид;
		Если Параметры.ТипОшибки <> Неопределено Тогда
			_ТипОшибки = Параметры.ТипОшибки;
		КонецЕсли;
		_Данные = Параметры.Данные;

		Подсказка = "";
		Если Параметры.Свойство("Подсказка", Подсказка) Тогда
			_Подсказка = Подсказка;
		КонецЕсли;
	Исключение
	КонецПопытки;

КонецПроцедуры

Процедура ЗаполнитьСвойстваМестаСоздания(Ошибка)

	Попытка
		СтекКадра = Ошибка.ПолучитьСтекВызовов();
		Для Каждого ЭлементСтека Из СтекКадра Цикл
			_Стек.Добавить(ЭлементСтека);
		КонецЦикла;

		_ИмяМодуля = Ошибка.ИмяМодуля;
		_НомерСтроки = Ошибка.НомерСтроки;
		_ИсходнаяСтрока = Ошибка.ИсходнаяСтрока;
	Исключение
	КонецПопытки;

КонецПроцедуры

// Проверяет метаданные собственного кадра на соответствие внутреннему формату.
//
// Параметры:
//  Параметры - ФиксированнаяСтруктура - Проверяемые метаданные кадра.
//
// Возвращаемое значение:
//  Булево - Истина, если метаданные поддерживаются библиотекой.
Функция ЭтоПоддерживаемыеМетаданныеКадра(Параметры)

	Маркер = Неопределено;
	Вид = Неопределено;
	ТипОшибки = Неопределено;
	Данные = Неопределено;
	Подсказка = "";

	ВсеПоляПрисутствуют = Параметры.Свойство("Маркер", Маркер)
		И Параметры.Свойство("Вид", Вид)
		И Параметры.Свойство("ТипОшибки", ТипОшибки)
		И Параметры.Свойство("Данные", Данные);

	Если Не ВсеПоляПрисутствуют Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Параметры.Свойство("Подсказка", Подсказка)
		И Не ПроверкаКадровОшибок.КорректнаяПодсказка(Подсказка) Тогда
		Возврат Ложь;
	КонецЕсли;

	КорректныйМаркер = ТипЗнч(Маркер) = Тип("Строка")
		И Маркер = ФорматКадраОшибки.МаркерМетаданных();

	Если Не КорректныйМаркер Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Вид = ВидыКадровОшибок.Ошибка Тогда
		Возврат ПроверкаКадровОшибок.КорректныйТипОшибки(ТипОшибки);
	КонецЕсли;

	Если Вид = ВидыКадровОшибок.Контекст Тогда
		Возврат ТипОшибки = Неопределено;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

#КонецОбласти
