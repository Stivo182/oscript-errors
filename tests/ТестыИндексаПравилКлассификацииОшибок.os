&Тест
Процедура ТестДолжен_СохранитьИдентификаторПравилаВКандидате() Экспорт

	// Подготовка
	Правило = Новый ПравилоКлассификацииОшибок()
		.СовпадаетС("Тестовое сообщение")
		.СИдентификатором("test.exact.v1")
		.КлассифицируетКак(
			"test.exact",
			"Тестовая ошибка"
		);
	Индекс = ИндексСПравилом(Правило);
	Кандидаты = Новый Массив;

	// Действие
	Индекс.СобратьКандидаты(Кадр("Тестовое сообщение"), Кандидаты);

	// Проверка
	Ожидаем.Что(Кандидаты[0].Данные.Правило).Равно("test.exact.v1");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьТочноеСообщениеСДругимУсловием() Экспорт

	// Подготовка
	Правило = Новый ПравилоКлассификацииОшибок()
		.СовпадаетС("Точное сообщение")
		.Содержит("сообщение")
		.КлассифицируетКак(
			"test.invalid",
			"Тестовая ошибка"
		);

	// Действие и Проверка
	ПроверитьНекорректноеПравило(
		Правило,
		КодыСтандартныхОшибок.НедопустимоеЗначениеАргумента()
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьТекстовоеПравилоБезПрефикса() Экспорт

	// Подготовка
	Правило = Новый ПравилоКлассификацииОшибок()
		.Содержит("Фрагмент")
		.КлассифицируетКак(
			"test.invalid",
			"Тестовая ошибка"
		);

	// Действие и Проверка
	ПроверитьНекорректноеПравило(
