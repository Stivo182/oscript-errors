#Использовать "../internal"

#Область ПрограммныйИнтерфейс

// Возвращает безопасное представление физической цепочки ошибки.
//
// Параметры:
//  Ошибка - ИнформацияОбОшибке - Исследуемая ошибка.
//
// Возвращаемое значение:
//  Структура:
//   * ТипОшибки - Строка, Неопределено - Эффективный тип ошибки;
//   * Усечена - Булево - Признак наличия непросмотренной причины;
//   * СнимкиКадров - Массив из СнимокКадраОшибки - Снимки физических кадров.
Функция ВСтруктуру(Ошибка) Экспорт

	Просмотр = ВнутреннееУстройствоОшибок.ПросмотретьЦепочку(Ошибка);

	Результат = Новый Структура(
		"ТипОшибки, Усечена, СнимкиКадров",
		Неопределено,
		Просмотр.Усечена,
		Новый Массив
	);

	Для Каждого ОписаниеКадра Из Просмотр.Кадры Цикл
		СнимокКадра = ОписаниеКадра.Снимок;
		Результат.СнимкиКадров.Добавить(СнимокКадра);

		Если Результат.ТипОшибки = Неопределено И СнимокКадра.Вид() = ВидыКадровОшибок.Ошибка Тогда
			Результат.ТипОшибки = СнимокКадра.ТипОшибки();
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Возвращает тип первой распознанной ошибки в физической цепочке.
//
// Параметры:
//  Ошибка - ИнформацияОбОшибке - Исследуемая ошибка.
//
// Возвращаемое значение:
//  Строка, Неопределено - Эффективный тип ошибки.
Функция ПолучитьТипОшибки(Ошибка) Экспорт

	Просмотр = ВнутреннееУстройствоОшибок.ПросмотретьЦепочку(Ошибка);

	Для Каждого ОписаниеКадра Из Просмотр.Кадры Цикл
		Если ОписаниеКадра.Снимок.Вид() = ВидыКадровОшибок.Ошибка Тогда
			Возврат ОписаниеКадра.Снимок.ТипОшибки();
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Проверяет наличие ошибки указанного типа во всей просмотренной цепочке.
//
// Параметры:
//  Ошибка - ИнформацияОбОшибке - Исследуемая ошибка.
//  ТипОшибки - Строка - Искомый машинный тип ошибки.
//
// Возвращаемое значение:
//  Булево - Истина, если ошибка указанного типа найдена.
Функция ЭтоОшибка(Ошибка, ТипОшибки) Экспорт

	Возврат НайтиОшибку(Ошибка, ТипОшибки) <> Неопределено;

КонецФункции

// Находит первый кадр ошибки указанного типа.
//
// Параметры:
//  Ошибка - ИнформацияОбОшибке - Исследуемая ошибка.
//  ТипОшибки - Строка - Искомый машинный тип ошибки.
//
// Возвращаемое значение:
//  ИнформацияОбОшибке, Неопределено - Найденный исходный кадр ошибки.
Функция НайтиОшибку(Ошибка, ТипОшибки) Экспорт

	ВнутреннееУстройствоОшибок.ПроверитьОшибку(Ошибка);
	ВнутреннееУстройствоОшибок.ПроверитьТипОшибки(ТипОшибки);

	Просмотр = ВнутреннееУстройствоОшибок.ПросмотретьЦепочку(Ошибка);

	Для Каждого ОписаниеКадра Из Просмотр.Кадры Цикл
		Если ОписаниеКадра.Снимок.Вид() = ВидыКадровОшибок.Ошибка
			И ОписаниеКадра.Снимок.ТипОшибки() = ТипОшибки Тогда
			Возврат ОписаниеКадра.Кадр;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Возвращает пользовательские данные эффективной ошибки без преобразования.
//
// Параметры:
//  Ошибка - ИнформацияОбОшибке - Исследуемая ошибка.
//
// Возвращаемое значение:
//  Произвольный, Неопределено - Данные эффективной ошибки.
Функция Данные(Ошибка) Экспорт

	Просмотр = ВнутреннееУстройствоОшибок.ПросмотретьЦепочку(Ошибка);

	Для Каждого ОписаниеКадра Из Просмотр.Кадры Цикл
		Если ОписаниеКадра.Снимок.Вид() = ВидыКадровОшибок.Ошибка Тогда
			Возврат ОписаниеКадра.Снимок.Данные();
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Возвращает распознанные контекстные кадры в физическом порядке.
//
// Параметры:
//  Ошибка - ИнформацияОбОшибке - Исследуемая ошибка.
//
// Возвращаемое значение:
//  Массив из ИнформацияОбОшибке - Новый массив исходных кадров контекста.
Функция Контексты(Ошибка) Экспорт

	Просмотр = ВнутреннееУстройствоОшибок.ПросмотретьЦепочку(Ошибка);
	Результат = Новый Массив;

	Для Каждого ОписаниеКадра Из Просмотр.Кадры Цикл
		Если ОписаниеКадра.Снимок.Вид() = ВидыКадровОшибок.Контекст Тогда
			Результат.Добавить(ОписаниеКадра.Кадр);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Возвращает все просмотренные физические кадры от внешнего к корневому.
//
// Параметры:
//  Ошибка - ИнформацияОбОшибке - Исследуемая ошибка.
//
// Возвращаемое значение:
//  Массив из ИнформацияОбОшибке - Новый массив исходных физических кадров.
Функция Цепочка(Ошибка) Экспорт

	Просмотр = ВнутреннееУстройствоОшибок.ПросмотретьЦепочку(Ошибка);
	Результат = Новый Массив;

	Для Каждого ОписаниеКадра Из Просмотр.Кадры Цикл
		Результат.Добавить(ОписаниеКадра.Кадр);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Возвращает последний просмотренный физический кадр.
//
// Параметры:
//  Ошибка - ИнформацияОбОшибке - Исследуемая ошибка.
//
// Возвращаемое значение:
//  ИнформацияОбОшибке - Фактический корень или последний кадр усечённой цепочки.
Функция КорневаяПричина(Ошибка) Экспорт

	Кадры = Цепочка(Ошибка);

	Возврат Кадры[Кадры.ВГраница()];

КонецФункции

#КонецОбласти
