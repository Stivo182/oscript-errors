&Тест
Процедура ТестДолжен_СортироватьОдинаковыеКлючиПоПредставлениюКонтейнера() Экспорт

	// Подготовка
	Данные = Новый Соответствие;
	Данные.Вставить(Новый НепредставимоеЗначение, Новый Структура("Значение", "Б"));
	Данные.Вставить(Новый НепредставимоеЗначение, Новый Структура("Значение", "А"));
	ОжидаемыйТекст = "<недоступно>:" + Символы.ПС
		+ "  Значение: А" + Символы.ПС
		+ "<недоступно>:" + Символы.ПС
		+ "  Значение: Б";

	// Действие
	Строки = ФорматированиеПредставленияОшибок.СтрокиДанных(Данные);

	// Проверка
	Ожидаем.Что(Соединить(Строки)).Равно(ОжидаемыйТекст);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЛокализоватьМаркерыОграниченногоПредставленияДанных() Экспорт

	// Подготовка
	Данные = Новый Структура;
	Данные.Вставить("ValueA", Неопределено);
	Данные.Вставить("ValueB", Новый НепредставимоеЗначение);
	ГлубинаТри = Новый Структура("L3", 1);
	ГлубинаДва = Новый Структура("L2", ГлубинаТри);
	ГлубинаОдин = Новый Структура("L1", ГлубинаДва);
	Данные.Вставить("Deep", ГлубинаОдин);
	Данные.Вставить("Limited", СоздатьКоллекцию("Массив", 21));
	ЦиклическиеДанные = Новый Массив;
	ЦиклическиеДанные.Добавить(ЦиклическиеДанные);
	Данные.Вставить("Cycle", ЦиклическиеДанные);

	// Действие
	Представление = Соединить(ФорматированиеПредставленияОшибок.СтрокиДанных(Данные));

	// Проверка
	Для Каждого Маркер Из ЛокализованныеМаркерыОграниченияДанных() Цикл
		Ожидаем.Что(Представление).Содержит(Маркер);
	КонецЦикла;
	Если ЭтоАнглийскаяЛокаль() Тогда
		ПроверитьОтсутствиеСтрок(Представление, РусскиеМаркерыОграниченияДанных());
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьКоллекцию(ВидКоллекции, Количество)

	Если ВидКоллекции = "Массив" Тогда
		Результат = Новый Массив;
	ИначеЕсли ВидКоллекции = "Структура" Тогда
		Результат = Новый Структура;
	Иначе
		Результат = Новый Соответствие;
	КонецЕсли;

	Для Номер = 1 По Количество Цикл
		Ключ = "Элемент" + Прав("00" + Строка(Номер), 2);
		Если ВидКоллекции = "Массив" Тогда
			Результат.Добавить(Номер);
		Иначе
			Результат.Вставить(Ключ, Номер);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция Соединить(Строки)

	Результат = "";
	Для Каждого Строка Из Строки Цикл
		Если Результат <> "" Тогда
			Результат = Результат + Символы.ПС;
		КонецЕсли;
		Результат = Результат + Строка;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ЛокализованныеМаркерыОграниченияДанных()

	Результат = Новый Массив;
	Результат.Добавить(НСтр("ru = 'Неопределено'; en = 'Undefined'"));
	Результат.Добавить(НСтр("ru = '<недоступно>'; en = '<unavailable>'"));
	Результат.Добавить(НСтр("ru = '<максимальная глубина>'; en = '<maximum depth>'"));
	Результат.Добавить(НСтр("ru = '<циклическая ссылка>'; en = '<circular reference>'"));
	Результат.Добавить(НСтр("ru = '... ещё 1 элемент'; en = '... 1 more item'"));

	Возврат Результат;

КонецФункции

Функция РусскиеМаркерыОграниченияДанных()

	Результат = Новый Массив;
	Результат.Добавить("Неопределено");
	Результат.Добавить("<недоступно>");
	Результат.Добавить("<максимальная глубина>");
	Результат.Добавить("<циклическая ссылка>");
	Результат.Добавить("... ещё");

	Возврат Результат;

КонецФункции

Функция ЭтоАнглийскаяЛокаль()

	Возврат НСтр("ru = 'ru'; en = 'en'") = "en";

КонецФункции

Процедура ПроверитьОтсутствиеСтрок(Текст, ЗапрещенныеСтроки)

	Для Каждого ЗапрещеннаяСтрока Из ЗапрещенныеСтроки Цикл
		Ожидаем.Что(СтрЧислоВхождений(Текст, ЗапрещеннаяСтрока)).Равно(0);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
