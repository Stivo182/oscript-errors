#Область СлужебныйПрограммныйИнтерфейс

// Возвращает сообщение ошибки неверного типа аргумента без проверки параметров.
//
// Параметры:
//  ИмяАргумента - Строка - Имя аргумента с неверным типом.
//  ОжидаемыйТип - Строка - Строковое представление ожидаемого типа.
//  Сообщение - Строка - Пользовательское сообщение или пустая строка для формирования стандартного.
//
// Возвращаемое значение:
//  Строка - Пользовательское или стандартное сообщение ошибки.
Функция НеверныйТип(ИмяАргумента, ОжидаемыйТип, Сообщение = "") Экспорт

	Если Сообщение <> "" Тогда
		Возврат Сообщение;
	КонецЕсли;

	Возврат СтрШаблон(
		НСтр("ru = 'Аргумент ''%1'' должен иметь тип %2'; en = 'Argument ''%1'' must be of type %2'"),
		ИмяАргумента,
		ОжидаемыйТип
	);

КонецФункции

// Возвращает сообщение ошибки незаполненного аргумента без проверки параметров.
//
// Параметры:
//  ИмяАргумента - Строка - Имя незаполненного аргумента.
//  Сообщение - Строка - Пользовательское сообщение или пустая строка для формирования стандартного.
//
// Возвращаемое значение:
//  Строка - Пользовательское или стандартное сообщение ошибки.
Функция НеЗаполнен(ИмяАргумента, Сообщение = "") Экспорт

	Если Сообщение <> "" Тогда
		Возврат Сообщение;
	КонецЕсли;

	Возврат СтрШаблон(
		НСтр("ru = 'Аргумент ''%1'' должен быть заполнен'; en = 'Argument ''%1'' is required'"),
		ИмяАргумента
	);

КонецФункции

// Возвращает сообщение ошибки недопустимого значения аргумента без проверки параметров.
//
// Параметры:
//  ИмяАргумента - Строка - Имя аргумента с недопустимым значением.
//  Ожидание - Строка - Описание допустимого значения или ограничения.
//  Сообщение - Строка - Пользовательское сообщение или пустая строка для формирования стандартного.
//
// Возвращаемое значение:
//  Строка - Пользовательское или стандартное сообщение ошибки.
Функция НедопустимоеЗначение(ИмяАргумента, Ожидание, Сообщение = "") Экспорт

	Если Сообщение <> "" Тогда
		Возврат Сообщение;
	КонецЕсли;

	Возврат СтрШаблон(
		НСтр(
			"ru = 'Аргумент ''%1'' имеет недопустимое значение: ожидается %2';"
			+ "en = 'Argument ''%1'' has an invalid value: expected %2'"
		),
		ИмяАргумента,
		Ожидание
	);

КонецФункции

// Возвращает сообщение ошибки аргумента вне диапазона без проверки параметров.
//
// Параметры:
//  ИмяАргумента - Строка - Имя аргумента вне диапазона.
//  ОжидаемыйДиапазон - Строка - Описание допустимого диапазона.
//  Сообщение - Строка - Пользовательское сообщение или пустая строка для формирования стандартного.
//
// Возвращаемое значение:
//  Строка - Пользовательское или стандартное сообщение ошибки.
Функция ВнеДиапазона(ИмяАргумента, ОжидаемыйДиапазон, Сообщение = "") Экспорт

	Если Сообщение <> "" Тогда
		Возврат Сообщение;
	КонецЕсли;

	Возврат СтрШаблон(
		НСтр(
			"ru = 'Аргумент ''%1'' находится вне допустимого диапазона: ожидается %2';"
			+ "en = 'Argument ''%1'' is out of range: expected %2'"
		),
		ИмяАргумента,
		ОжидаемыйДиапазон
	);

КонецФункции

#КонецОбласти
