&Тест
Процедура ТестДолжен_ВыровнятьМногострочныеПоляДиагностическогоПредставления() Экспорт

	// Подготовка
	Данные = Новый Структура("Текст", "Альфа" + Символы.ПС + "Бета");
	Ошибка = КонструкторыОшибок.Создать(
		"core.multiline",
		"Первая строка" + Символы.ПС + "Вторая строка",
		Данные
	)
		.Подсказка("Первый шаг" + Символы.ПС + "Второй шаг")
		.Построить();

	// Действие
	Представление = ДиагностикаОшибок.Исследовать(Ошибка).ДиагностическоеПредставление();

	// Проверка
	ОжидаемоеПредставление = "core.multiline: Первая строка" + Символы.ПС
		+ Пробелы(16) + "Вторая строка" + Символы.ПС
		+ Символы.ПС
		+ "Данные:" + Символы.ПС
		+ "  Текст: Альфа" + Символы.ПС
		+ "         Бета" + Символы.ПС + Символы.ПС
		+ "Подсказка:" + Символы.ПС
		+ "  Первый шаг" + Символы.ПС
		+ "  Второй шаг";
	Ожидаем.Что(Представление).Равно(ОжидаемоеПредставление);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПредставитьФиксированноеСоответствиеВДанныхОшибки() Экспорт

	// Подготовка
	Соответствие = Новый Соответствие;
	Соответствие.Вставить("Формат", "JSON");
	Соответствие.Вставить("Попытки", 3);
	Данные = Новый ФиксированноеСоответствие(Соответствие);
	Ошибка = ФабрикаОшибок.Создать("config.failed", "Ошибка конфигурации", Данные);

	// Действие
	Представление = ДиагностикаОшибок.Исследовать(Ошибка).ДиагностическоеПредставление();

	// Проверка
	Ожидаем.Что(Представление).Равно("config.failed: Ошибка конфигурации
	|
	|Данные:
	|  Попытки: 3
	|  Формат: JSON");

