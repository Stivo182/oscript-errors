&Тест
Процедура ТестДолжен_ВернутьНезависимыеМассивыСтека() Экспорт

	// Подготовка
	Ошибка = ФабрикаОшибок.Создать("core.failed", "Ошибка");
	Ошибка = ПомощникТестированияОшибок.ПовторноВыброшеннаяОшибка(Ошибка);
	Снимок = Новый СнимокКадраОшибки(Ошибка);
	ПервыйСтек = Снимок.Стек();
	ИсходныйРазмер = ПервыйСтек.Количество();

	// Действие
	ПервыйСтек.Добавить("Проверочный элемент");

	// Проверка
	Ожидаем.Что(Снимок.Стек().Количество()).Равно(ИсходныйРазмер);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьНеверныйТипАргументаКонструктора() Экспорт

	// Подготовка
	Параметры = Новый Массив;
	Параметры.Добавить("не ошибка");

	// Действие и Проверка
	Ожидаем.Что(ЭтотОбъект)
		.Метод("СоздатьСнимок", Параметры)
		.ВыбрасываетИсключение(
			СтрШаблон(
				НСтр("ru = 'Аргумент ''%1'' должен иметь тип %2'; en = 'Argument ''%1'' must be of type %2'"),
				"Ошибка",
				Строка(Тип("ИнформацияОбОшибке"))
			)
		);

КонецПроцедуры

&Тест
Процедура ТестДолжен_КлассифицироватьНеверныйТипАргументаКонструктора() Экспорт

	// Подготовка
	Ошибка = Неопределено;

	// Действие
	Попытка
		Снимок = Новый СнимокКадраОшибки("не ошибка");
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;

	// Проверка
	Если Ошибка = Неопределено Тогда
		ВызватьИсключение "Ожидалось контрактное исключение конструктора снимка";
	КонецЕсли;

	Снимок = Новый СнимокКадраОшибки(Ошибка);
	Ожидаем.Что(Снимок.КодОшибки()).Равно("argument.invalid_type");
	Ожидаем.Что(Снимок.Данные().ИмяАргумента).Равно("Ошибка");
	Ожидаем.Что(Снимок.Данные().ОжидаемыйТип).Равно(Строка(Тип("ИнформацияОбОшибке")));
	Ожидаем.Что(Снимок.Данные().ФактическийТип).Равно(Строка(Тип("Строка")));
	Ожидаем.Что(Снимок.Данные().Свойство("ФактическоеЗначение")).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_СчитатьКадрБезСообщенияВМетаданныхВнешним() Экспорт

	// Подготовка
	Поля = Новый Структура;
	Поля.Вставить("Маркер", "onescript.exception.envelope");
	Поля.Вставить("Вид", "Ошибка");
	Поля.Вставить("КодОшибки", "legacy.failed");
	Поля.Вставить("Данные", Неопределено);
	Ошибка = Новый ИнформацияОбОшибке("Старая ошибка", Новый ФиксированнаяСтруктура(Поля));

	// Действие
	Снимок = Новый СнимокКадраОшибки(Ошибка);

	// Проверка
	Ожидаем.Что(Снимок.Вид()).Равно(ВидыКадровОшибок.ВнешняяОшибка());
	Ожидаем.Что(Снимок.КодОшибки()).Равно("");
	Ожидаем.Что(Снимок.Сообщение()).Равно("Старая ошибка");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СчитатьКадрНеподдерживаемойВерсииВнешним() Экспорт

