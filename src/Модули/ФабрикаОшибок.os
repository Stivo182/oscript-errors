#Использовать "../internal"

#Область ПрограммныйИнтерфейс

// Создаёт классифицированную ошибку без причины.
//
// Параметры:
//  КодОшибки - Строка - Стабильный машинный код ошибки.
//  Сообщение - Строка - Человекочитаемое описание ошибки.
//  Данные - Произвольный - Связанные с ошибкой данные.
//
// Возвращаемое значение:
//  ИнформацияОбОшибке - Новый кадр ошибки.
Функция Создать(КодОшибки, Сообщение, Данные = Неопределено) Экспорт

	Проверяющий = СервисыБиблиотекиОшибок.ПроверяющийКадрыОшибок();
	Проверяющий.ПроверитьКадр(ВидыКадровОшибок.Ошибка(), КодОшибки, Сообщение, Неопределено, "", "");

	Создатель = СервисыБиблиотекиОшибок.СоздательКонвертаОшибки();

	Возврат Создатель.СоздатьОшибкуПоПолям(
		КодОшибки,
		Сообщение,
		Данные
	);

КонецФункции

// Добавляет контекст, не изменяя машинную классификацию причины.
//
// Параметры:
//  Причина - ИнформацияОбОшибке - Непосредственная причина нового кадра.
//  Сообщение - Строка - Описание выполнявшейся операции.
//  Данные - Произвольный - Связанные с контекстом данные.
//
// Возвращаемое значение:
//  ИнформацияОбОшибке - Новый кадр контекста.
Функция ОбернутьКонтекстом(Причина, Сообщение, Данные = Неопределено) Экспорт

	Построитель = Новый ПостроительОшибки(Неопределено, Сообщение, ВидыКадровОшибок.Контекст())
		.Причина(Причина);

	Если Данные <> Неопределено Тогда
		Построитель.ПроизвольныеДанные(Данные);
	КонецЕсли;

	Возврат Построитель.Построить();

КонецФункции

// Оборачивает причину новой машинной классификацией.
//
// Параметры:
//  Причина - ИнформацияОбОшибке - Непосредственная причина нового кадра.
//  КодОшибки - Строка - Новый стабильный машинный код ошибки.
//  Сообщение - Строка - Человекочитаемое описание ошибки.
//  Данные - Произвольный - Связанные с ошибкой данные.
//
// Возвращаемое значение:
//  ИнформацияОбОшибке - Новый классифицированный кадр.
Функция Обернуть(Причина, КодОшибки, Сообщение, Данные = Неопределено) Экспорт

	Проверяющий = СервисыБиблиотекиОшибок.ПроверяющийКадрыОшибок();
	Проверяющий.ПроверитьКадр(ВидыКадровОшибок.Ошибка(), КодОшибки, Сообщение, Причина, "", "");

	Создатель = СервисыБиблиотекиОшибок.СоздательКонвертаОшибки();

	Возврат Создатель.СоздатьОшибкуПоПолям(
		КодОшибки,
		Сообщение,
		Данные,
		"",
		"",
		Причина
	);

КонецФункции

#КонецОбласти
