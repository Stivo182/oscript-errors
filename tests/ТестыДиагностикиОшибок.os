&Тест
Процедура ТестДолжен_ВернутьВсеФизическиеКадрыПоПорядку() Экспорт

	// Подготовка
	Цепочка = СмешаннаяЦепочка();
	ОжидаемыеКадры = Новый Массив;
	ОжидаемыеКадры.Добавить(Цепочка.Контекст);
	ОжидаемыеКадры.Добавить(Цепочка.ЭффективнаяОшибка);
	ОжидаемыеКадры.Добавить(Цепочка.ВнешняяОшибка);
	ОжидаемыеКадры.Добавить(Цепочка.ВнутренняяОшибка);

	// Действие
	Кадры = ДиагностикаОшибок.Цепочка(Цепочка.Ошибка);

	// Проверка
	ПроверитьПорядокКадров(Кадры, ОжидаемыеКадры);
	Ожидаем.Что(ДиагностикаОшибок.КорневаяПричина(
		Цепочка.Ошибка
	)).Равно(Цепочка.ВнутренняяОшибка);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПройтиВнешниеКадрыДоМеждуИПослеСобственных() Экспорт

	// Подготовка
	ВнешнийКорень = ПомощникТестированияОшибок.ВнешняяОшибка("Внешний корень");
	СобственнаяОшибка = ФабрикаОшибок.Обернуть(ВнешнийКорень, "service.unavailable", "Сервис недоступен");
	ВнешняяСередина = ПомощникТестированияОшибок.ВнешняяОшибка("Служебная обёртка", СобственнаяОшибка);
	Контекст = ФабрикаОшибок.СКонтекстом(ВнешняяСередина, "Вызов сервиса");
	ВнешняяОшибка = ПомощникТестированияОшибок.ВнешняяОшибка("Async", Контекст);

	// Действие и Проверка
	Ожидаем.Что(ДиагностикаОшибок.ПолучитьТипОшибки(ВнешняяОшибка)).Равно("service.unavailable");
	Ожидаем.Что(ДиагностикаОшибок.Контексты(ВнешняяОшибка)[0]).Равно(Контекст);
	Ожидаем.Что(ДиагностикаОшибок.КорневаяПричина(ВнешняяОшибка)).Равно(ВнешнийКорень);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НайтиСобственныйКадрПослеПовторногоВыброса() Экспорт

	// Подготовка
