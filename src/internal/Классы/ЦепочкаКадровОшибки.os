Перем _Кадры; // Массив из ФиксированнаяСтруктура

#Область ОбработчикиСобытий

// Инициализирует цепочку кадров ошибки.
//
// Параметры:
//  Снимок - СнимокКадраОшибки - Снимок исходной ошибки.
Процедура ПриСозданииОбъекта(Снимок)

	_Кадры = СобратьКадры(Снимок);

КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Возвращает независимую копию кадров для внутренних правил классификации.
//
// Возвращаемое значение:
//  Массив из ФиксированнаяСтруктура - Независимая копия кадров в порядке обхода с полями:
//    * Глубина - Число - Позиция физической ошибки в цепочке, начиная с нуля.
//    * ИсходнаяОшибка - ИнформацияОбОшибке - Физическая ошибка, из которой получен кадр.
//    * Описание - Строка - Текст кадра.
//    * НативныйТип - Строка, Неопределено - Имя .NET-типа из текста внешнего исключения или Неопределено.
//    * ВнутреннееСообщение - Строка - Текст нативной ошибки без служебной обёртки типа.
//    * КодОшибки - Строка - Структурированный код ошибки или пустая строка.
//    * Данные - Произвольный, Неопределено - Данные структурированной ошибки.
//    * Восстановлен - Булево - Признак кадра из ПодробноеПредставлениеОшибки().
//    * РазрешенДляПоиска - Булево - Признак доступности текста кадра для поиска.
Функция Кадры() Экспорт

	Результат = Новый Массив;
	Для Каждого Кадр Из _Кадры Цикл
		Результат.Добавить(Кадр);
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция РазобратьНативнуюОшибку(Описание)

	ПрефиксРусскогоИсключения = "Внешнее исключение (";
	ПрефиксАнглийскогоИсключения = "External exception (";

	Если СтрНачинаетсяС(Описание, ПрефиксРусскогоИсключения) Тогда
		Префикс = ПрефиксРусскогоИсключения;
	ИначеЕсли СтрНачинаетсяС(Описание, ПрефиксАнглийскогоИсключения) Тогда
		Префикс = ПрефиксАнглийскогоИсключения;
	Иначе
		Возврат Неопределено;
	КонецЕсли;

	ПозицияОкончанияТипа = СтрНайти(Описание, "):");
	Если ПозицияОкончанияТипа = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	ДлинаТипа = ПозицияОкончанияТипа - СтрДлина(Префикс) - 1;
	Если ДлинаТипа <= 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Новый ФиксированнаяСтруктура(Новый Структура(
		"НативныйТип, ВнутреннееСообщение",
		Сред(Описание, СтрДлина(Префикс) + 1, ДлинаТипа),
		СокрЛ(Сред(Описание, ПозицияОкончанияТипа + 2))
	));

КонецФункции

Функция ВосстановитьОписанияИзПодробногоПредставления(Описание)

	Если Не ЭтоПодробноеПредставлениеОшибки(Описание) Тогда
		Возврат Неопределено;
	КонецЕсли;

	ПозицияКонцаЗаголовка = НайтиПозициюКонцаЗаголовка(Описание);
	Если ПозицияКонцаЗаголовка = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Заголовок = Лев(Описание, ПозицияКонцаЗаголовка);
	ОписаниеКадра = ИзвлечьОписаниеИзЗаголовка(Заголовок);
	Если ОписаниеКадра = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Результат = Новый Массив;
	Результат.Добавить(ОписаниеКадра);
	ОжидаетсяПричина = Ложь;
	Остаток = Сред(Описание, ПозицияКонцаЗаголовка + 1);
	Строки = СтрРазделить(Остаток, Символы.ПС, Ложь);

	Для Индекс = 0 По Строки.ВГраница() Цикл
		Строка = СокрЛП(Строки[Индекс]);

		Если ПустаяСтрока(Строка) Тогда
			Продолжить;
		КонецЕсли;

		Если ЭтоМаркерПричиныПодробногоПредставления(Строка) Тогда
			Если ОжидаетсяПричина Тогда
				Возврат Неопределено;
			КонецЕсли;

			ОжидаетсяПричина = Истина;
			Продолжить;
		КонецЕсли;

		Если ОжидаетсяПричина Тогда
			ОписаниеКадра = ИзвлечьОписаниеИзЗаголовка(Строка);
			Если ОписаниеКадра = Неопределено Тогда
				ОписаниеКадра = Строка;
			КонецЕсли;

			Результат.Добавить(ОписаниеКадра);
			ОжидаетсяПричина = Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат ?(ОжидаетсяПричина, Неопределено, Результат);

КонецФункции

Функция НайтиПозициюКонцаЗаголовка(Описание)

	ПозицияСВозвратомКаретки = СтрНайти(Описание, "}" + Символы.ВК + Символы.ПС);
	ПозицияСПереводомСтроки = СтрНайти(Описание, "}" + Символы.ПС);

	Если ПозицияСВозвратомКаретки > 0 Тогда
		Возврат ПозицияСВозвратомКаретки;
	КонецЕсли;

	Если ПозицияСПереводомСтроки > 0 Тогда
		Возврат ПозицияСПереводомСтроки;
	КонецЕсли;

	Возврат ?(СтрЗаканчиваетсяНа(Описание, "}"), СтрДлина(Описание), 0);

КонецФункции

Функция ЭтоМаркерПричиныПодробногоПредставления(Строка)

	НормализованнаяСтрока = НРег(СокрЛП(Строка));
	Возврат НормализованнаяСтрока = "по причине:"
		Или НормализованнаяСтрока = "caused by:";

КонецФункции

Функция ЭтоПодробноеПредставлениеОшибки(Описание)

	Возврат СтрНачинаетсяС(Описание, "{Модуль ")
		Или СтрНачинаетсяС(Описание, "{Module ");

КонецФункции

Функция ИзвлечьОписаниеИзЗаголовка(Строка)

	Если СтрЗаканчиваетсяНа(Строка, Символы.ВК) Тогда
		Строка = Лев(Строка, СтрДлина(Строка) - 1);
	КонецЕсли;

	Если Не ЭтоПодробноеПредставлениеОшибки(Строка)
		Или Не СтрЗаканчиваетсяНа(Строка, "}") Тогда
		Возврат Неопределено;
	КонецЕсли;

	ВторойРазделитель = СтрНайти(Строка, " / ", НаправлениеПоиска.СНачала,, 2);
	Если ВторойРазделитель = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	ПозицияОписания = ВторойРазделитель + СтрДлина(" / ");
	Возврат Сред(Строка, ПозицияОписания, СтрДлина(Строка) - ПозицияОписания);

КонецФункции

Функция СобратьКадры(КорневойСнимок)

	Кадры = Новый Массив;
	ТекущаяОшибка = КорневойСнимок.ИсходнаяОшибка();
	Снимок = КорневойСнимок;
	Глубина = 0;

	Пока ЭтоКадрОшибки(ТекущаяОшибка) Цикл
		Если Снимок = Неопределено Тогда
			Снимок = Новый СнимокКадраОшибки(ТекущаяОшибка);
		КонецЕсли;

		Описание = Снимок.Сообщение();
		ВосстановленныеОписания = ВосстановитьОписанияИзПодробногоПредставления(Описание);

		Кадры.Добавить(НовыйКадр(
			Глубина,
			ТекущаяОшибка,
			Описание,
			Снимок.КодОшибки(),
			Снимок.Данные(),
			Ложь
		));

		Если ВосстановленныеОписания <> Неопределено Тогда
			Для ИндексОписания = 0 По ВосстановленныеОписания.ВГраница() Цикл
				Кадры.Добавить(НовыйКадр(
					Глубина,
					ТекущаяОшибка,
					ВосстановленныеОписания[ИндексОписания],
					"",
					Неопределено,
					Истина
				));
			КонецЦикла;
		КонецЕсли;

		ТекущаяОшибка = ТекущаяОшибка.Причина;
		Снимок = Неопределено;
		Глубина = Глубина + 1;
	КонецЦикла;

	Возврат Кадры;

КонецФункции

Функция НовыйКадр(Глубина, ИсходнаяОшибка, Описание, КодОшибки, Данные, Восстановлен)

	НативнаяОшибка = РазобратьНативнуюОшибку(Описание);
	НативныйТип = Неопределено;
	ВнутреннееСообщение = Описание;

	Если НативнаяОшибка <> Неопределено Тогда
		НативныйТип = НативнаяОшибка.НативныйТип;
		ВнутреннееСообщение = НативнаяОшибка.ВнутреннееСообщение;
	КонецЕсли;

	Поля = Новый Структура(
		"Глубина, ИсходнаяОшибка, Описание, НативныйТип, ВнутреннееСообщение, "
			+ "КодОшибки, Данные, Восстановлен, РазрешенДляПоиска",
		Глубина,
		ИсходнаяОшибка,
		Описание,
		НативныйТип,
		ВнутреннееСообщение,
		КодОшибки,
		Данные,
		Восстановлен,
		Восстановлен Или Не ЭтоПодробноеПредставлениеОшибки(Описание)
	);

	Возврат Новый ФиксированнаяСтруктура(Поля);

КонецФункции

Функция ЭтоКадрОшибки(Значение)
	Возврат ТипЗнч(Значение) = Тип("ИнформацияОбОшибке");
КонецФункции

#КонецОбласти
