КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьНеверныйТипСпискаКодов() Экспорт

	// Подготовка
	Выборка = Новый ВыборкаОшибок(Новый Массив);
	Ошибка = Неопределено;

	// Действие
	Попытка
		Выборка.Отобрать(42);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;

	// Проверка
	Если Ошибка = Неопределено Тогда
		ВызватьИсключение "Ожидалось контрактное исключение";
	КонецЕсли;
	Снимок = Новый СнимокКадраОшибки(Ошибка);
	Ожидаем.Что(Снимок.КодОшибки()).Равно("argument.invalid_type");
	Ожидаем.Что(Снимок.Данные().ИмяАргумента).Равно("КодыОшибок");
	Ожидаем.Что(Снимок.Данные().ФактическийТип).Равно(Строка(Тип("Число")));

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьОшибкуНеверногоТипаДляСнимковВыборки() Экспорт

	// Подготовка
	Ошибка = Неопределено;

	// Действие
	Попытка
		Выборка = Новый ВыборкаОшибок("не массив");
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;

	// Проверка
	ПроверитьКонтрактноеИсключение(
		Ошибка,
		"argument.invalid_type",
		"Снимки",
		"ОжидаемыйТип",
		Строка(Тип("Массив"))
	);
	Снимок = Новый СнимокКадраОшибки(Ошибка);
	Ожидаем.Что(Снимок.Данные().ФактическийТип).Равно(Строка(Тип("Строка")));
	Ожидаем.Что(Снимок.Данные().Свойство("ФактическоеЗначение")).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьОшибкуНедопустимогоЗначенияДляТипаЭлементаВыборки() Экспорт

	// Подготовка
	Снимки = Новый Массив;
	Снимки.Добавить("не снимок");
	Ошибка = Неопределено;

	// Действие
	Попытка
		Выборка = Новый ВыборкаОшибок(Снимки);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;

	// Проверка
	ПроверитьКонтрактноеИсключение(
		Ошибка,
		"argument.invalid_value",
		"Снимки",
		"Ожидание",
		"содержать только снимки кадров ошибок"
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьОшибкуНедопустимогоЗначенияДляВидаЭлементаВыборки() Экспорт

	// Подготовка
	Причина = ФабрикаОшибок.Создать("core.failed", "Ошибка");
	Контекст = ФабрикаОшибок.ОбернутьКонтекстом(Причина, "Контекст");
	Снимки = Новый Массив;
	Снимки.Добавить(Новый СнимокКадраОшибки(Контекст));
	Ошибка = Неопределено;

	// Действие
	Попытка
		Выборка = Новый ВыборкаОшибок(Снимки);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;

	// Проверка
	ПроверитьКонтрактноеИсключение(
		Ошибка,
		"argument.invalid_value",
		"Снимки",
		"Ожидание",
		"содержать только снимки кадров ошибок"
	);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СнимокОшибки(КодОшибки, Сообщение)

	Возврат Новый СнимокКадраОшибки(ФабрикаОшибок.Создать(КодОшибки, Сообщение));

КонецФункции

Процедура ПроверитьКонтрактноеИсключение(Ошибка, КодОшибки, ИмяАргумента, ИмяПоля, ОжидаемоеЗначение)

	Если Ошибка = Неопределено Тогда
		ВызватьИсключение "Ожидалось контрактное исключение";
	КонецЕсли;

	Снимок = Новый СнимокКадраОшибки(Ошибка);
	Ожидаем.Что(Снимок.КодОшибки()).Равно(КодОшибки);
	Ожидаем.Что(Снимок.Данные().ИмяАргумента).Равно(ИмяАргумента);
	Ожидаем.Что(Снимок.Данные()[ИмяПоля]).Равно(ОжидаемоеЗначение);

КонецПроцедуры

#КонецОбласти
