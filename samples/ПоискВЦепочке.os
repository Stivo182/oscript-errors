// Демонстрирует проверку и поиск кода во вложенной цепочке ошибок.
// Сценарий извлекает данные и подсказку найденной причины.

#Использовать errors

Причина = Новый КонструкторОшибки("database.timeout", "База данных не ответила вовремя")
	.Данные("ТаймаутСек", 30)
	.Подсказка("Повторите запрос позднее")
	.Построить();

Причина = ФабрикаОшибок.СКонтекстом(Причина, "Чтение списка заказов");
Ошибка = ФабрикаОшибок.Обернуть(Причина, "orders.load_failed", "Не удалось получить список заказов");

Исследователь = ДиагностикаОшибок.Исследовать(Ошибка);
НайденнаяПричина = Исследователь.НайтиОшибку("database.timeout");
ДанныеПричины = НайденнаяПричина.Данные();

Сообщить("Эффективный код: " + Исследователь.КодОшибки());
Сообщить("Есть database.timeout: " + Строка(Исследователь.ЕстьОшибка("database.timeout")));
Сообщить(СтрШаблон("Таймаут: %1 сек", ДанныеПричины.ТаймаутСек));
Сообщить("Подсказка: " + НайденнаяПричина.Подсказка());
