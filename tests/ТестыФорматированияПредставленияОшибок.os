КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьКоллекцию(ВидКоллекции, Количество)

	Если ВидКоллекции = "Массив" Тогда
		Результат = Новый Массив;
	ИначеЕсли ВидКоллекции = "Структура" Тогда
		Результат = Новый Структура;
	Иначе
		Результат = Новый Соответствие;
	КонецЕсли;

	Для Номер = 1 По Количество Цикл
		Ключ = "Элемент" + Прав("00" + Строка(Номер), 2);
		Если ВидКоллекции = "Массив" Тогда
			Результат.Добавить(Номер);
		Иначе
			Результат.Вставить(Ключ, Номер);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция Соединить(Строки)

	Результат = "";
	Для Каждого Строка Из Строки Цикл
		Если Результат <> "" Тогда
			Результат = Результат + Символы.ПС;
		КонецЕсли;
		Результат = Результат + Строка;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция Пробелы(Количество)

	Результат = "";
	Для Номер = 1 По Количество Цикл
		Результат = Результат + " ";
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти
