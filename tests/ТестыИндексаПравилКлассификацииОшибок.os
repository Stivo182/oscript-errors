#Область Тесты

&Тест
Процедура ТестДолжен_СопоставитьТочноеЛокализованноеСообщение() Экспорт

	// Подготовка
	Правило = Новый ПравилоКлассификацииОшибок()
		.СовпадаетС("ru = 'Русское сообщение'; en = 'English message'")
		.КлассифицируетКак(
			"test.exact",
			"Тестовая ошибка"
		);
	Индекс = ИндексСПравилом(Правило);
	Кандидаты = Новый Массив;

	// Действие
	Индекс.СобратьКандидаты(Кадр("Русское сообщение"), Кандидаты);
	Индекс.СобратьКандидаты(Кадр("English message"), Кандидаты);

	// Проверка
	Ожидаем.Что(Кандидаты).ИмеетДлину(2);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СопоставитьТочноеСообщениеНативнойОшибкиБезТипа() Экспорт

	// Подготовка
	Правило = Новый ПравилоКлассификацииОшибок()
		.СовпадаетС("Файл уже существует")
		.КлассифицируетКак("test.native_exact", "Тестовая ошибка");
	Индекс = ИндексСПравилом(Правило);
	Кандидаты = Новый Массив;
	КадрОшибки = Кадр(
		"External exception (System.IO.IOException): Файл уже существует",
		"System.IO.IOException",
		Истина,
		"Файл уже существует"
	);

	// Действие
	Индекс.СобратьКандидаты(КадрОшибки, Кандидаты);

	// Проверка
	Ожидаем.Что(Кандидаты).ИмеетДлину(1);
	Ожидаем.Что(Кандидаты[0].Код).Равно("test.native_exact");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СопоставитьТочноеСообщениеНативнойОшибкиСТипом() Экспорт

	// Подготовка
	Правило = Новый ПравилоКлассификацииОшибок()
		.СНативнымТипом("System.IO.IOException")
		.СовпадаетС("Файл уже существует")
		.КлассифицируетКак("test.native_exact", "Тестовая ошибка");
	Индекс = ИндексСПравилом(Правило);
	Кандидаты = Новый Массив;
	КадрОшибки = Кадр(
		"External exception (System.IO.IOException): Файл уже существует",
		"System.IO.IOException",
		Истина,
		"Файл уже существует"
	);
	КадрОшибкиДругогоТипа = Кадр(
		"External exception (System.ArgumentException): Файл уже существует",
		"System.ArgumentException",
		Истина,
		"Файл уже существует"
	);

	// Действие
	Индекс.СобратьКандидаты(КадрОшибки, Кандидаты);
	Индекс.СобратьКандидаты(КадрОшибкиДругогоТипа, Кандидаты);

	// Проверка
	Ожидаем.Что(Кандидаты).ИмеетДлину(1);
	Ожидаем.Что(Кандидаты[0].Код).Равно("test.native_exact");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СопоставитьПрефиксФрагментИОкончание() Экспорт

	// Подготовка
	Правило = Новый ПравилоКлассификацииОшибок()
		.НачинаетсяС("Начало")
		.Содержит("фрагмент")
		.ОканчиваетсяНа("конец")
		.КлассифицируетКак(
			"test.text",
			"Тестовая ошибка"
		);
	Индекс = ИндексСПравилом(Правило);
	Кандидаты = Новый Массив;

	// Действие
	Индекс.СобратьКандидаты(Кадр("Начало фрагмент продолжение"), Кандидаты);
	Индекс.СобратьКандидаты(Кадр("Постороннее фрагмент конец"), Кандидаты);
	Индекс.СобратьКандидаты(Кадр("Начало без условия конец"), Кандидаты);
	Индекс.СобратьКандидаты(Кадр("Начало фрагмент конец"), Кандидаты);

	// Проверка
	Ожидаем.Что(Кандидаты).ИмеетДлину(1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СопоставитьТипПрефиксИОкончаниеОдногоКадра() Экспорт

	// Подготовка
	Правило = Новый ПравилоКлассификацииОшибок()
		.СНативнымТипом("System.IO.IOException")
		.НачинаетсяС("Начало")
		.ОканчиваетсяНа("конец")
		.КлассифицируетКак(
			"test.type",
			"Тестовая ошибка"
		);
	Индекс = ИндексСПравилом(Правило);
	Кандидаты = Новый Массив;

	// Действие
	Индекс.СобратьКандидаты(Кадр("Начало текста конец", "System.ArgumentException"), Кандидаты);
	Индекс.СобратьКандидаты(Кадр("Другое текста конец", "System.IO.IOException"), Кандидаты);
	Индекс.СобратьКандидаты(Кадр("Начало текста конец", "System.IO.IOException"), Кандидаты);

	// Проверка
	Ожидаем.Что(Кандидаты).ИмеетДлину(1);
	Ожидаем.Что(Кандидаты[0].Данные.НативныйТип).Равно("System.IO.IOException");

КонецПроцедуры

