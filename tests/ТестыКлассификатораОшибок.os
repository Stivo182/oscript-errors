&Тест
Процедура ТестДолжен_ОдинРазЗагрузитьПоставщикаПриПараллельномОбращении() Экспорт

	// Подготовка
	_КоличествоГотовыхЗаданий = 0;
	_НачатьКлассификацию = Ложь;

	Поставщик = Новый ТестовыйПоставщикПравил;
	Поставщик.УстановитьЗадержку(50);

	Классификатор = Новый КлассификаторОшибок;
	Классификатор.ДобавитьПоставщикаПравил(Поставщик);

	Параметры = Новый Массив;
	Параметры.Добавить(Классификатор);

	Задания = Новый Массив;
	Для НомерЗадания = 1 По 4 Цикл
		Задания.Добавить(ФоновыеЗадания.Выполнить(ЭтотОбъект, "КлассифицироватьВФоне", Параметры));
	КонецЦикла;

	Для НомерОжидания = 1 По 5000 Цикл
		Если КоличествоГотовыхЗаданий() = Задания.Количество() Тогда
			Прервать;
		КонецЕсли;
		Приостановить(1);
	КонецЦикла;

	// Действие и Проверка
	КоличествоГотовыхЗаданий = КоличествоГотовыхЗаданий();
	РазрешитьПараллельнуюКлассификацию();
	Ожидаем.Что(КоличествоГотовыхЗаданий).Равно(Задания.Количество());
	
	ФоновыеЗадания.ОжидатьВсе(Задания);

	Для Каждого Задание Из Задания Цикл
		Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Задание.Результат)).Равно("test.provider");
	КонецЦикла;

	Ожидаем.Что(Поставщик.КоличествоВызововВсе()).Равно(1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьНеопределеноБезПравил() Экспорт

