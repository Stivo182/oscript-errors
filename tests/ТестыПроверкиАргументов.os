&Тест
Процедура ТестДолжен_СформироватьОжиданиеТиповИзСтроки() Экспорт

	// Подготовка
	ОжидаемыйТип = Строка(Тип("Число")) + НСтр("ru = ' или '; en = ' or '") + Строка(Тип("Дата"));
	ОшибкаТипа = ОшибкаПриПроверкеТипа("Значение", Истина, "Число, Дата");
	ОшибкаНабора = ОшибкаПриПроверкеТипа("Значение", "Строка", "Число, Дата");

	// Действие
	СнимокТипа = Новый СнимокКадраОшибки(ОшибкаТипа);
	СнимокНабора = Новый СнимокКадраОшибки(ОшибкаНабора);

	// Проверка
	Ожидаем.Что(СнимокТипа.Данные().ОжидаемыйТип).Равно(ОжидаемыйТип);
	Ожидаем.Что(СнимокНабора.Данные().ОжидаемыйТип).Равно(ОжидаемыйТип);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьНезарегистрированноеИмяТипа() Экспорт

	// Подготовка
	ОшибкаОжидаемогоТипа = ОшибкаПриПроверкеТипа("Значение", 1, "НесуществующийТип");
	ОшибкаНабораТипов = ОшибкаПриПроверкеТипа("Значение", 1, "НесуществующийТип");

	// Действие
	СнимокОжидаемогоТипа = Новый СнимокКадраОшибки(ОшибкаОжидаемогоТипа);
	СнимокНабораТипов = Новый СнимокКадраОшибки(ОшибкаНабораТипов);

	// Проверка
	Ожидаем.Что(СнимокОжидаемогоТипа.КодОшибки()).Равно("argument.invalid_type");
	Ожидаем.Что(СнимокОжидаемогоТипа.Данные().ИмяАргумента).Равно("ДопустимыеТипы");
	Ожидаем.Что(СнимокНабораТипов.КодОшибки()).Равно("argument.invalid_type");
	Ожидаем.Что(СнимокНабораТипов.Данные().ИмяАргумента).Равно("ДопустимыеТипы");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьОшибкуНеверногоТипаПриОтсутствииВНабореТипов() Экспорт

	// Подготовка
	ДопустимыеТипы = ДопустимыеТипыЧислоИДата();
	ОжидаемыйТип = Строка(Тип("Число")) + НСтр("ru = ' или '; en = ' or '") + Строка(Тип("Дата"));
	Ошибка = ОшибкаПриПроверкеТипа("Значение", "Строка", ДопустимыеТипы);

	// Действие
	Снимок = Новый СнимокКадраОшибки(Ошибка);

	// Проверка
	Ожидаем.Что(Снимок.КодОшибки()).Равно("argument.invalid_type");
	Ожидаем.Что(Снимок.Данные().ИмяАргумента).Равно("Значение");
	Ожидаем.Что(Снимок.Данные().ОжидаемыйТип).Равно(ОжидаемыйТип);
	Ожидаем.Что(Снимок.Данные().ФактическийТип).Равно(Строка(Тип("Строка")));

КонецПроцедуры

&Тест
Процедура ТестДолжен_СформироватьОжиданиеНесколькихТиповЧерезЗапятуюИИли() Экспорт

	// Подготовка
	ДопустимыеТипы = Новый Массив;
	ДопустимыеТипы.Добавить(Тип("Число"));
	ДопустимыеТипы.Добавить(Тип("Дата"));
	ДопустимыеТипы.Добавить(Тип("Строка"));
	ОжидаемыйТип = Строка(Тип("Число")) + ", " + Строка(Тип("Дата"))
		+ НСтр("ru = ' или '; en = ' or '") + Строка(Тип("Строка"));
	Ошибка = ОшибкаПриПроверкеТипа("Значение", Истина, ДопустимыеТипы);

	// Действие
	Снимок = Новый СнимокКадраОшибки(Ошибка);

	// Проверка
	Ожидаем.Что(Снимок.Данные().ОжидаемыйТип).Равно(ОжидаемыйТип);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПроверитьКонтрактНабораТипов() Экспорт

	// Подготовка
	ОшибкаТипа = ОшибкаПриПроверкеТипа("Значение", 1, 42);
	ОшибкаПустого = ОшибкаПриПроверкеТипа("Значение", 1, Новый Массив);
	ОшибкаПустогоОписания = ОшибкаПриПроверкеТипа("Значение", 1, Новый ОписаниеТипов);
	ДопустимыеТипы = Новый Массив;
	ДопустимыеТипы.Добавить(42);
	ОшибкаЭлемента = ОшибкаПриПроверкеТипа("Значение", 1, ДопустимыеТипы);

	// Действие
	СнимокТипа = Новый СнимокКадраОшибки(ОшибкаТипа);
	СнимокПустого = Новый СнимокКадраОшибки(ОшибкаПустого);
	СнимокПустогоОписания = Новый СнимокКадраОшибки(ОшибкаПустогоОписания);
	СнимокЭлемента = Новый СнимокКадраОшибки(ОшибкаЭлемента);

	// Проверка
	Ожидаем.Что(СнимокТипа.КодОшибки()).Равно("argument.invalid_type");
	Ожидаем.Что(СнимокТипа.Данные().ИмяАргумента).Равно("ДопустимыеТипы");
	Ожидаем.Что(СнимокПустого.КодОшибки()).Равно("argument.required");
	Ожидаем.Что(СнимокПустого.Данные().ИмяАргумента).Равно("ДопустимыеТипы");
	Ожидаем.Что(СнимокПустогоОписания.КодОшибки()).Равно("argument.required");
	Ожидаем.Что(СнимокПустогоОписания.Данные().ИмяАргумента).Равно("ДопустимыеТипы");
	Ожидаем.Что(СнимокЭлемента.КодОшибки()).Равно("argument.invalid_type");
	Ожидаем.Что(СнимокЭлемента.Данные().ИмяАргумента).Равно("ДопустимыеТипы");

КонецПроцедуры

&Тест
Процедура ТестДолжен_БезопасноСформироватьОжиданиеНепредставимогоЗначения() Экспорт

	// Подготовка
	Ошибка = ОшибкаПриПроверкеРавенства("Данные", 1, Новый НепредставимоеЗначение);

	// Действие
	Снимок = Новый СнимокКадраОшибки(Ошибка);

	// Проверка
	Ожидаем.Что(Снимок.КодОшибки()).Равно("argument.invalid_value");
	Ожидаем.Что(Снимок.Данные().Ожидание).Равно("<НепредставимоеЗначение>");

КонецПроцедуры

&Тест
Процедура ТестДолжен_БезопасноСформироватьДопустимыеЗначения() Экспорт

	// Подготовка
	Допустимые = Новый Массив;
	Допустимые.Добавить(Новый НепредставимоеЗначение);
	Допустимые.Добавить("Ошибка");

	Представления = Новый Массив;
	Представления.Добавить("<НепредставимоеЗначение>");
	Представления.Добавить("Ошибка");

	Ожидание = СтрШаблон(
		НСтр("ru = 'одно из значений: %1'; en = 'one of the values: %1'"),
		СтрСоединить(Представления, ", ")
	);

	Ошибка = ОшибкаПриПроверкеДопустимогоЗначения("Вид", "Контекст", Допустимые);

	// Действие
	Снимок = Новый СнимокКадраОшибки(Ошибка);

	// Проверка
	Ожидаем.Что(Снимок.КодОшибки()).Равно("argument.invalid_value");
	Ожидаем.Что(Снимок.Данные().Ожидание).Равно(Ожидание);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОшибкаПриПроверкеТипа(ИмяАргумента, Значение, ОжидаемыйТип, Сообщение = "")

	Попытка
		ПроверкаАргументов.ПроверитьТип(ИмяАргумента, Значение, ОжидаемыйТип, Сообщение);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидалось исключение проверки типа";

КонецФункции

Функция ДопустимыеТипыЧислоИДата()

	Типы = Новый Массив;
	Типы.Добавить(Тип("Число"));
	Типы.Добавить(Тип("Дата"));

	Возврат Типы;

КонецФункции

Функция ОшибкаПриПроверкеЗаполненности(ИмяАргумента, Значение, Сообщение = "")

	Попытка
		ПроверкаАргументов.ПроверитьЗаполненность(ИмяАргумента, Значение, Сообщение);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидалось исключение проверки заполненности";

КонецФункции

Функция ОшибкаПриПроверкеДопустимости(ИмяАргумента, Допустимо, Ожидание, Сообщение = "")

	Попытка
		ПроверкаАргументов.ПроверитьДопустимость(ИмяАргумента, Допустимо, Ожидание, Сообщение);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидалось исключение проверки допустимости";

КонецФункции

Функция ОшибкаПриПроверкеДопустимогоЗначения(ИмяАргумента, Значение, ДопустимыеЗначения, Сообщение = "")

	Попытка
		ПроверкаАргументов.ПроверитьДопустимоеЗначение(ИмяАргумента, Значение, ДопустимыеЗначения, Сообщение);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидалось исключение проверки допустимых значений";

КонецФункции

Функция ОшибкаПриПроверкеРавенства(ИмяАргумента, Значение, ОжидаемоеЗначение, Сообщение = "")

	Попытка
		ПроверкаАргументов.ПроверитьРавенство(ИмяАргумента, Значение, ОжидаемоеЗначение, Сообщение);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидалось исключение проверки равенства";

КонецФункции

Функция ОшибкаПриПроверкеДиапазона(
	ИмяАргумента,
	Значение,
	МинимальноеЗначение,
	МаксимальноеЗначение,
	Сообщение = ""
)

	Попытка
		ПроверкаАргументов.ПроверитьДиапазон(
			ИмяАргумента,
			Значение,
			МинимальноеЗначение,
			МаксимальноеЗначение,
			Сообщение
		);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидалось исключение проверки диапазона";

КонецФункции

Процедура ПроверитьОшибкуКонтрактаДиапазона(Ошибка, КодОшибки, ИмяПараметра)

	Снимок = Новый СнимокКадраОшибки(Ошибка);
	Ожидаем.Что(Снимок.КодОшибки()).Равно(КодОшибки);
	Ожидаем.Что(Снимок.Данные().ИмяАргумента).Равно(ИмяПараметра);

КонецПроцедуры

Функция ОшибкаПриПроверкеФабрики()

	Попытка
		ФабрикаОшибок.Создать(42, "Сообщение");
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидалось исключение проверки фабрики";

КонецФункции

Функция СтандартноеСообщениеНеверногоТипа(ИмяАргумента, ОжидаемыйТип)

	Возврат СтрШаблон(
		НСтр("ru = 'Аргумент ''%1'' должен иметь тип %2'; en = 'Argument ''%1'' must be of type %2'"),
		ИмяАргумента,
		ОжидаемыйТип
	);

КонецФункции

Функция СтандартноеСообщениеНезаполненногоАргумента(ИмяАргумента)

	Возврат СтрШаблон(
		НСтр("ru = 'Аргумент ''%1'' должен быть заполнен'; en = 'Argument ''%1'' is required'"),
		ИмяАргумента
	);

КонецФункции

Функция СтандартноеСообщениеНедопустимогоЗначения(ИмяАргумента, Ожидание)

	Возврат СтрШаблон(
		НСтр(
			"ru = 'Аргумент ''%1'' имеет недопустимое значение: ожидается %2';"
			+ "en = 'Argument ''%1'' has an invalid value: expected %2'"
		),
		ИмяАргумента,
		Ожидание
	);

КонецФункции

Функция СтандартноеСообщениеАргументаВнеДиапазона(ИмяАргумента, ОжидаемыйДиапазон)

	Возврат СтрШаблон(
		НСтр(
			"ru = 'Аргумент ''%1'' находится вне допустимого диапазона: ожидается %2';"
			+ "en = 'Argument ''%1'' is out of range: expected %2'"
		),
		ИмяАргумента,
		ОжидаемыйДиапазон
	);

КонецФункции

Функция ТекстОжидаемогоДиапазона(МинимальноеЗначение, МаксимальноеЗначение)

	Возврат СтрШаблон(
		НСтр("ru = 'от %1 до %2 включительно'; en = 'from %1 to %2 inclusive'"),
		МинимальноеЗначение,
		МаксимальноеЗначение
	);

КонецФункции

#КонецОбласти
