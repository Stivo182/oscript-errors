#Использовать asserts
#Использовать "../src"
#Использовать "../src/internal"

Перем _БлокировкаСтарта; // БлокировкаРесурса
Перем _КоличествоГотовыхЗаданий; // Число
Перем _НачатьОбращение; // Булево

#Область ОбработчикиСобытий

// Инициализирует состояние тестового набора.
&ПередКаждым
Процедура ИнициализироватьТесты() Экспорт

	_БлокировкаСтарта = Новый БлокировкаРесурса();

КонецПроцедуры

#КонецОбласти

#Область Тесты

&Тест
Процедура ТестДолжен_СохранитьЭкземплярПриПараллельномОбращении() Экспорт

	// Подготовка
	_КоличествоГотовыхЗаданий = 0;
	_НачатьОбращение = Ложь;
	Задания = Новый Массив;
	Для НомерЗадания = 1 По 4 Цикл
		Задания.Добавить(ФоновыеЗадания.Выполнить(ЭтотОбъект, "ПолучитьСоздателяКонверта"));
	КонецЦикла;
	Для НомерОжидания = 1 По 5000 Цикл
		Если КоличествоГотовыхЗаданий() = Задания.Количество() Тогда
			Прервать;
		КонецЕсли;
		Приостановить(1);
	КонецЦикла;

	// Действие и Проверка
	КоличествоГотовыхЗаданий = КоличествоГотовыхЗаданий();
	РазрешитьПараллельноеОбращение();
	Ожидаем.Что(КоличествоГотовыхЗаданий).Равно(Задания.Количество());
	ФоновыеЗадания.ОжидатьВсе(Задания);
	ПервыйЭкземпляр = Задания[0].Результат;
	Для Каждого Задание Из Задания Цикл
		Ожидаем.Что(Задание.Результат).Равно(ПервыйЭкземпляр);
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранятьЭкземплярВнутреннегоСервиса() Экспорт

	// Подготовка
	ПервыйЭкземпляр = СервисыБиблиотекиОшибок.РегистраторСбоевБиблиотекиОшибок();

	// Действие
	ВторойЭкземпляр = СервисыБиблиотекиОшибок.РегистраторСбоевБиблиотекиОшибок();

	// Проверка
	Ожидаем.Что(ВторойЭкземпляр).Равно(ПервыйЭкземпляр);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьИСохранитьВсеВнутренниеСервисы() Экспорт

	// Действие
	Сервисы = Новый Массив;
	Сервисы.Добавить(Новый Структура(
		"Объект, ИмяТипа",
		СервисыБиблиотекиОшибок.РегистраторСбоевБиблиотекиОшибок(),
		"РегистраторСбоевБиблиотекиОшибок"
	));
	Сервисы.Добавить(Новый Структура(
		"Объект, ИмяТипа",
		СервисыБиблиотекиОшибок.ПроверяющийКадрыОшибок(),
		"ПроверяющийКадрыОшибок"
	));
	Сервисы.Добавить(Новый Структура(
		"Объект, ИмяТипа",
		СервисыБиблиотекиОшибок.ОписаниеФорматаКадраОшибки(),
		"ОписаниеФорматаКадраОшибки"
	));
	Сервисы.Добавить(Новый Структура(
		"Объект, ИмяТипа",
		СервисыБиблиотекиОшибок.ФормировательСообщенийОшибокАргументов(),
		"ФормировательСообщенийОшибокАргументов"
	));
	Сервисы.Добавить(Новый Структура(
		"Объект, ИмяТипа",
		СервисыБиблиотекиОшибок.НормализаторКодовОшибок(),
		"НормализаторКодовОшибок"
	));
	Сервисы.Добавить(Новый Структура(
		"Объект, ИмяТипа",
		СервисыБиблиотекиОшибок.ЧитательКадраОшибки(),
		"ЧитательКадраОшибки"
	));
	Сервисы.Добавить(Новый Структура(
		"Объект, ИмяТипа",
		СервисыБиблиотекиОшибок.ОбходчикЦепочкиОшибки(),
		"ОбходчикЦепочкиОшибки"
	));
	Сервисы.Добавить(Новый Структура(
		"Объект, ИмяТипа",
		СервисыБиблиотекиОшибок.ФорматировщикЗначенийОшибки(),
		"ФорматировщикЗначенийОшибки"
	));
	Сервисы.Добавить(Новый Структура(
		"Объект, ИмяТипа",
		СервисыБиблиотекиОшибок.ФорматировщикПредставленияОшибок(),
		"ФорматировщикПредставленияОшибок"
	));
	Сервисы.Добавить(Новый Структура(
		"Объект, ИмяТипа",
		СервисыБиблиотекиОшибок.СоздательКонвертаОшибки(),
		"СоздательКонвертаОшибки"
	));

	// Проверка
	Для Каждого Сервис Из Сервисы Цикл
		Ожидаем.Что(ТипЗнч(Сервис.Объект)).Равно(Тип(Сервис.ИмяТипа));
	КонецЦикла;
	Ожидаем.Что(СервисыБиблиотекиОшибок.ПроверяющийКадрыОшибок())
		.Равно(Сервисы[1].Объект);
	Ожидаем.Что(СервисыБиблиотекиОшибок.ОписаниеФорматаКадраОшибки())
		.Равно(Сервисы[2].Объект);
	Ожидаем.Что(СервисыБиблиотекиОшибок.ФормировательСообщенийОшибокАргументов())
		.Равно(Сервисы[3].Объект);
	Ожидаем.Что(СервисыБиблиотекиОшибок.НормализаторКодовОшибок())
		.Равно(Сервисы[4].Объект);
	Ожидаем.Что(СервисыБиблиотекиОшибок.ЧитательКадраОшибки())
		.Равно(Сервисы[5].Объект);
	Ожидаем.Что(СервисыБиблиотекиОшибок.ОбходчикЦепочкиОшибки())
		.Равно(Сервисы[6].Объект);
	Ожидаем.Что(СервисыБиблиотекиОшибок.ФорматировщикЗначенийОшибки())
		.Равно(Сервисы[7].Объект);
	Ожидаем.Что(СервисыБиблиотекиОшибок.ФорматировщикПредставленияОшибок())
		.Равно(Сервисы[8].Объект);
	Ожидаем.Что(СервисыБиблиотекиОшибок.СоздательКонвертаОшибки())
		.Равно(Сервисы[9].Объект);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьСоздателяКонверта() Экспорт

	ЗарегистрироватьГотовоеЗадание();
	Пока Не ПараллельноеОбращениеРазрешено() Цикл
		Приостановить(1);
	КонецЦикла;

	Возврат СервисыБиблиотекиОшибок.СоздательКонвертаОшибки();

КонецФункции

Процедура ЗарегистрироватьГотовоеЗадание()

	_БлокировкаСтарта.Заблокировать();
	_КоличествоГотовыхЗаданий = _КоличествоГотовыхЗаданий + 1;
	_БлокировкаСтарта.Разблокировать();

КонецПроцедуры

Функция КоличествоГотовыхЗаданий()

	_БлокировкаСтарта.Заблокировать();
	Результат = _КоличествоГотовыхЗаданий;
	_БлокировкаСтарта.Разблокировать();

	Возврат Результат;

КонецФункции

Процедура РазрешитьПараллельноеОбращение()

	_БлокировкаСтарта.Заблокировать();
	_НачатьОбращение = Истина;
	_БлокировкаСтарта.Разблокировать();

КонецПроцедуры

Функция ПараллельноеОбращениеРазрешено()

	_БлокировкаСтарта.Заблокировать();
	Результат = _НачатьОбращение;
	_БлокировкаСтарта.Разблокировать();

	Возврат Результат;

КонецФункции

#КонецОбласти
