#Использовать "../src"
#Использовать "../src/internal"

#Область Тесты

&Тест
Процедура ТестДолжен_ЗадатьУсловияФлюентнымИнтерфейсом() Экспорт

	// Действие
	Правило = Новый ПравилоКлассификацииОшибок
		.СНативнымТипом("System.Net.WebException")
		.НачинаетсяС("Gateway rejected request:")
		.ОканчиваетсяНа("request denied")
		.СПриоритетом(10)
		.СИдентификатором("test.gateway_rejected.v1")
		.КлассифицируетКак("test.gateway_rejected", "Шлюз отклонил запрос");

	// Проверка
	Ожидаем.Что(Правило.КодОшибки()).Равно("test.gateway_rejected");
	Ожидаем.Что(Правило.ОписаниеРезультата()).Равно("Шлюз отклонил запрос");
	Ожидаем.Что(Правило.НативныйТип()).Равно("System.Net.WebException");
	Ожидаем.Что(Правило.Префикс()).Равно("Gateway rejected request:");
	Ожидаем.Что(Правило.Окончание()).Равно("request denied");
	Ожидаем.Что(Правило.Приоритет()).Равно(10);
	Ожидаем.Что(Правило.Идентификатор()).Равно("test.gateway_rejected.v1");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьПравилоБезРезультатаКлассификации() Экспорт

	// Подготовка
	Правила = Новый Массив;
	Правила.Добавить(
		Новый ПравилоКлассификацииОшибок()
			.НачинаетсяС("Gateway rejected request:")
	);

	// Действие
	Ошибка = Неопределено;
	Попытка
		Индекс = Новый ИндексПравилКлассификацииОшибок(Правила, "ТестовыеПравила");
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;

	// Проверка
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Ошибка)).Равно(
		КодыСтандартныхОшибок.НедопустимоеЗначениеАргумента()
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СопоставитьТипПрефиксИОкончаниеОдногоКадра() Экспорт

	// Подготовка
	Правила = Новый Массив;
	Правила.Добавить(
		Новый ПравилоКлассификацииОшибок()
			.СНативнымТипом("System.Net.WebException")
			.НачинаетсяС("Gateway rejected request:")
			.ОканчиваетсяНа("request denied")
			.КлассифицируетКак(
				"test.gateway_rejected",
				"Шлюз отклонил запрос"
			)
	);

	Кандидаты = Новый Массив;
	Индекс = Новый ИндексПравилКлассификацииОшибок(Правила, "ТестовыеПравила");
	Кадр = Новый ФиксированнаяСтруктура(Новый Структура(
		"Описание, НативныйТип, ВнутреннееСообщение, РазрешенДляПоиска",
		"Gateway rejected request: request denied",
		"System.Net.WebException",
		"Gateway rejected request: request denied",
		Истина
	));

	// Действие
	Индекс.СобратьКандидаты(Кадр, Кандидаты);

	// Проверка
	Ожидаем.Что(Кандидаты).ИмеетДлину(1);
	Ожидаем.Что(Кандидаты[0].Код).Равно("test.gateway_rejected");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьТочноеСообщениеСДополнительнымУсловием() Экспорт

	// Подготовка
	Правила = Новый Массив;
	Правила.Добавить(
		Новый ПравилоКлассификацииОшибок()
			.СовпадаетС("Точное сообщение")
			.НачинаетсяС("Точное")
			.КлассифицируетКак(
				"test.invalid",
				"Некорректное правило"
			)
	);

	// Действие
	Ошибка = Неопределено;
	Попытка
		Индекс = Новый ИндексПравилКлассификацииОшибок(Правила, "ТестовыеПравила");
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;

	// Проверка
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Ошибка)).Равно(
		КодыСтандартныхОшибок.НедопустимоеЗначениеАргумента()
	);

КонецПроцедуры

#КонецОбласти
