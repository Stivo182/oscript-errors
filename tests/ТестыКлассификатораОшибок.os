КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция КлассификаторСОсновнымиПравилами()

	Возврат КлассификаторСПравилами(ОсновныеПравила());

КонецФункции

Функция КлассификаторСПравилами(Правила)

	Классификатор = Новый КлассификаторОшибок;
	Классификатор.ДобавитьПравила(Правила);

	Возврат Классификатор;

КонецФункции

Функция ПравилаДляСообщения(Сообщение, КодОшибки, Приоритет = 0)

	Правила = Новый Массив;
	Правила.Добавить(ТочноеПравило(КодОшибки, КодОшибки, Сообщение, Приоритет));

	Возврат Правила;

КонецФункции

Функция ПравилаДляСообщенияСОписанием(Сообщение, КодОшибки, Описание)

	Правила = Новый Массив;
	Правила.Добавить(ТочноеПравило(КодОшибки, Описание, Сообщение));

	Возврат Правила;

КонецФункции

Функция ОсновныеПравила()

	Правила = Новый Массив;
	Правила.Добавить(ТочноеПравило("test.main", "Основная ошибка", "Основное сообщение"));
	Правила.Добавить(ПрефиксПравило("test.secondary", "Вторичная ошибка", "Вторичное сообщение:"));
	Правила.Добавить(ТочноеПравило("test.specific", "Специфичная ошибка", "Специфичное сообщение"));

	Возврат Правила;

КонецФункции

Функция ТочноеПравилоСИдентификатором(ИсходноеСообщение, КодОшибки, Идентификатор)

	Возврат Новый ПравилоКлассификацииОшибок()
		.СовпадаетС(ИсходноеСообщение)
		.СИдентификатором(Идентификатор)
		.КлассифицируетКак(
			КодОшибки,
			ИсходноеСообщение
		);

КонецФункции

Функция ТочноеПравило(КодОшибки, ОписаниеОшибки, ИсходноеСообщение, Приоритет = 0)

	Возврат Новый ПравилоКлассификацииОшибок()
		.СовпадаетС(ИсходноеСообщение)
		.СПриоритетом(Приоритет)
		.КлассифицируетКак(
			КодОшибки,
			ОписаниеОшибки
		);

КонецФункции

Функция ПрефиксПравило(КодОшибки, ОписаниеОшибки, Префикс)

	Возврат Новый ПравилоКлассификацииОшибок()
		.НачинаетсяС(Префикс)
		.КлассифицируетКак(
			КодОшибки,
			ОписаниеОшибки
		);

КонецФункции

Функция ОшибкаССообщением(Сообщение)

	Попытка
		ВызватьИсключение Сообщение;
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка не возникла";

КонецФункции

Функция КлассифицироватьВФоне(Классификатор) Экспорт

	ЗарегистрироватьГотовоеЗадание();

	Пока Не ПараллельнаяКлассификацияРазрешена() Цикл
		Приостановить(1);
	КонецЦикла;

	Возврат Классификатор.Классифицировать(ОшибкаССообщением("Сообщение поставщика"));

КонецФункции

Процедура ЗарегистрироватьГотовоеЗадание()

	_БлокировкаСтарта.Заблокировать();
	_КоличествоГотовыхЗаданий = _КоличествоГотовыхЗаданий + 1;
	_БлокировкаСтарта.Разблокировать();

КонецПроцедуры

Функция КоличествоГотовыхЗаданий()

	_БлокировкаСтарта.Заблокировать();
	Результат = _КоличествоГотовыхЗаданий;
	_БлокировкаСтарта.Разблокировать();

	Возврат Результат;

КонецФункции

Процедура РазрешитьПараллельнуюКлассификацию()

	_БлокировкаСтарта.Заблокировать();
	_НачатьКлассификацию = Истина;
	_БлокировкаСтарта.Разблокировать();

КонецПроцедуры

Функция ПараллельнаяКлассификацияРазрешена()

	_БлокировкаСтарта.Заблокировать();
	Результат = _НачатьКлассификацию;
	_БлокировкаСтарта.Разблокировать();

	Возврат Результат;

КонецФункции

