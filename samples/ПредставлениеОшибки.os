// Сравнивает краткое пользовательское и подробное диагностическое представления.
// Оба формата строятся для одной цепочки с контекстом, данными и подсказкой.

#Использовать errors

Причина = ФабрикаОшибок.Создать(
	"network.timeout",
	"Сервис пользователей не ответил",
	Новый Структура("ТаймаутСек", 10),
	"Повторите операцию"
);
Причина = ФабрикаОшибок.СКонтекстом(Причина, "Запрос пользователя 42");
Ошибка = ФабрикаОшибок.Обернуть(Причина, "profile.load_failed", "Не удалось загрузить профиль");

Сообщить("Краткое представление:");
Сообщить(ДиагностикаОшибок.КраткоеПредставление(Ошибка));
Сообщить("");
Сообщить("Подробное представление:");
Сообщить(ДиагностикаОшибок.ПодробноеПредставление(Ошибка));
