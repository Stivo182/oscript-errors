// Показывает различие между добавлением контекста и оборачиванием ошибки.
// Контекст сохраняет исходный код, а оборачивание задаёт новый эффективный код.

#Использовать errors

Ошибка = ФабрикаОшибок.Создать("network.timeout", "Превышено время ожидания ответа");
Сообщить("Исходный код: " + (Новый ИсследовательОшибки(Ошибка)).КодОшибки());

Ошибка = ФабрикаОшибок.СКонтекстом(Ошибка, "Получение профиля пользователя");
Сообщить("После добавления контекста: " + (Новый ИсследовательОшибки(Ошибка)).КодОшибки());

Ошибка = ФабрикаОшибок.Обернуть(
	Ошибка,
	"profile.load_failed",
	"Не удалось загрузить профиль"
);
Сообщить("После оборачивания: " + (Новый ИсследовательОшибки(Ошибка)).КодОшибки());
