#Область Тесты

&Тест
Процедура ТестДолжен_СоздатьРазборОшибки() Экспорт

	// Подготовка
	Ошибка = ФабрикаОшибок.Создать("config.invalid", "Ошибка конфигурации");

	// Действие
	Разбор = ДиагностикаОшибок.Разобрать(Ошибка);

	// Проверка
	Ожидаем.Что(ТипЗнч(Разбор)).Равно(Тип("РазборОшибки"));
	Ожидаем.Что(Разбор.КодОшибки()).Равно("config.invalid");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьКодЭффективнойОшибки() Экспорт

	// Подготовка
	Причина = ФабрикаОшибок.Создать("config.invalid", "Ошибка конфигурации");
	Ошибка = ФабрикаОшибок.ОбернутьКонтекстом(Причина, "Загрузка конфигурации");

	// Действие
	КодОшибки = ДиагностикаОшибок.КодОшибки(Ошибка);

	// Проверка
	Ожидаем.Что(КодОшибки).Равно("config.invalid");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьДанныеЭффективнойОшибкиПоСсылке() Экспорт

	// Подготовка
	Данные = Новый Структура("Узел", "db.example.org");
	Причина = (Новый ПостроительОшибки("connection.timeout", "Превышено время ожидания"))
		.ПроизвольныеДанные(Данные)
		.Построить();
	Ошибка = ФабрикаОшибок.ОбернутьКонтекстом(Причина, "Вызов базы данных");

	// Действие
	Результат = ДиагностикаОшибок.ДанныеОшибки(Ошибка);
	Результат.Узел = "cache.example.org";

	// Проверка
	Ожидаем.Что(Результат).Равно(Данные);
	Ожидаем.Что(Данные.Узел).Равно("cache.example.org");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьЭффективнуюОшибку() Экспорт

	// Подготовка
	Причина = ФабрикаОшибок.Создать("config.invalid", "Ошибка конфигурации");
