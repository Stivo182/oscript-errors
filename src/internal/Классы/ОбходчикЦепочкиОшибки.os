Перем _ПроверяющийКадрыОшибок; // ПроверяющийКадрыОшибок
Перем _ЧитательКадраОшибки; // ЧитательКадраОшибки
Перем _НормализаторКодовОшибок; // НормализаторКодовОшибок
Перем _РегистраторСбоев; // РегистраторСбоевБиблиотекиОшибок

#Область ОбработчикиСобытий

// Создает обходчик физической цепочки ошибки.
//
// Параметры:
//  ПроверяющийКадрыОшибок - ПроверяющийКадрыОшибок - Проверяющий входных данных.
//  ЧитательКадраОшибки - ЧитательКадраОшибки - Читатель метаданных кадра.
//  НормализаторКодовОшибок - НормализаторКодовОшибок - Нормализатор искомых кодов.
//  РегистраторСбоев - РегистраторСбоевБиблиотекиОшибок - Регистратор подавленных сбоев.
Процедура ПриСозданииОбъекта(
	ПроверяющийКадрыОшибок,
	ЧитательКадраОшибки,
	НормализаторКодовОшибок,
	РегистраторСбоев
)

	_ПроверяющийКадрыОшибок = ПроверяющийКадрыОшибок;
	_ЧитательКадраОшибки = ЧитательКадраОшибки;
	_НормализаторКодовОшибок = НормализаторКодовОшибок;
	_РегистраторСбоев = РегистраторСбоев;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Возвращает максимальное количество кадров одного обхода цепочки.
//
// Возвращаемое значение:
//  Число - Максимальное количество просматриваемых физических кадров.
Функция МаксимальноеКоличествоКадров() Экспорт

	Возврат 64;

КонецФункции

// Просматривает физическую цепочку ошибки от внешнего кадра к корневому.
// Просмотр ограничен 64 кадрами и терпим к повреждённым причинам.
//
// Параметры:
//  Ошибка - ИнформацияОбОшибке - Внешний кадр просматриваемой цепочки.
//
// Возвращаемое значение:
//  Структура:
//   * Кадры - Массив из ИнформацияОбОшибке - Просмотренные физические кадры;
//   * Усечена - Булево - Признак наличия непросмотренной причины.
Функция Просмотреть(Ошибка) Экспорт

	_ПроверяющийКадрыОшибок.ПроверитьОшибку(Ошибка);

	Результат = Новый Структура("Кадры, Усечена", Новый Массив, Ложь);
	ТекущийКадр = Ошибка;

	Для НомерКадра = 1 По МаксимальноеКоличествоКадров() Цикл
		Результат.Кадры.Добавить(ТекущийКадр);
		Причина = Неопределено;
		ПричинаПрочитана = ПопытатьсяПрочитатьПричину(ТекущийКадр, Причина);

		Если Не ПричинаПрочитана Тогда
			Результат.Усечена = Истина;
			Возврат Результат;
		КонецЕсли;

		Если Причина = Неопределено Тогда
			Возврат Результат;
		КонецЕсли;

		Если НомерКадра = МаксимальноеКоличествоКадров() Тогда
			Результат.Усечена = Истина;
			Возврат Результат;
		КонецЕсли;

		ТекущийКадр = Причина;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Безопасно читает непосредственную причину кадра.
//
// Параметры:
//  Кадр - Произвольный - Кадр с доступным для чтения свойством Причина.
//
// Возвращаемое значение:
//  Структура:
//   * Причина - ИнформацияОбОшибке, Неопределено - Прочитанная причина;
//   * Прочитана - Булево - Признак успешного чтения свойства Причина.
Функция ПрочитатьПричину(Кадр) Экспорт

	Причина = Неопределено;
	Прочитана = ПопытатьсяПрочитатьПричину(Кадр, Причина);

	Возврат Новый Структура("Причина, Прочитана", Причина, Прочитана);

КонецФункции

// Безопасно читает непосредственную причину кадра в выходной параметр.
//
// Параметры:
//  Кадр - Произвольный - Кадр с доступным для чтения свойством Причина.
//  Причина - ИнформацияОбОшибке, Неопределено - Приёмник прочитанной причины.
//
// Возвращаемое значение:
//  Булево - Истина, если свойство Причина удалось прочитать.
Функция ПопытатьсяПрочитатьПричину(Кадр, Причина) Экспорт

	Причина = Неопределено;

	Попытка
		ПрочитанноеЗначение = Кадр.Причина;
	Исключение
		_РегистраторСбоев.ЗаписатьПодавленныйСбой(
			"chain.read_cause",
			Кадр,
			ИнформацияОбОшибке()
		);
		Возврат Ложь;
	КонецПопытки;

	Если ТипЗнч(ПрочитанноеЗначение) = Тип("ИнформацияОбОшибке") Тогда
		Причина = ПрочитанноеЗначение;
	КонецЕсли;

	Возврат Истина;

КонецФункции

// Возвращает первый физический кадр ошибки с одним из указанных кодов.
//
// Параметры:
//  Ошибка - ИнформацияОбОшибке - Внешний кадр просматриваемой цепочки.
//  КодыОшибок - Строка, Массив из Строка, ФиксированныйМассив из Строка - Искомые коды.
//
// Возвращаемое значение:
//  ИнформацияОбОшибке, Неопределено - Первый подходящий кадр или Неопределено.
Функция НайтиПервуюПоКодам(Ошибка, КодыОшибок) Экспорт

	_ПроверяющийКадрыОшибок.ПроверитьОшибку(Ошибка);
	ИскомыеКоды = _НормализаторКодовОшибок.Нормализовать(КодыОшибок);

	Возврат НайтиПервыйКадр(Ошибка, ИскомыеКоды, "Коды");

КонецФункции

// Возвращает первый физический кадр ошибки с указанным кодом.
//
// Параметры:
//  Ошибка - ИнформацияОбОшибке - Внешний кадр просматриваемой цепочки.
//  КодОшибки - Строка - Искомый код.
//
// Возвращаемое значение:
//  ИнформацияОбОшибке, Неопределено - Первый подходящий кадр или Неопределено.
Функция НайтиПервуюПоКоду(Ошибка, КодОшибки) Экспорт

	_ПроверяющийКадрыОшибок.ПроверитьОшибку(Ошибка);
	ИскомыйКод = _НормализаторКодовОшибок.НормализоватьКод(КодОшибки);

	Возврат НайтиПервыйКадр(Ошибка, ИскомыйКод, "Код");

КонецФункции

// Возвращает первый физический кадр ошибки из указанной группы.
//
// Параметры:
//  Ошибка - ИнформацияОбОшибке - Внешний кадр просматриваемой цепочки.
//  ГруппаОшибок - Строка - Один или несколько начальных сегментов машинного кода.
//
// Возвращаемое значение:
//  ИнформацияОбОшибке, Неопределено - Первый подходящий кадр или Неопределено.
Функция НайтиПервуюПоГруппе(Ошибка, ГруппаОшибок) Экспорт

	_ПроверяющийКадрыОшибок.ПроверитьОшибку(Ошибка);
	_ПроверяющийКадрыОшибок.ПроверитьГруппуОшибок(ГруппаОшибок);

	Возврат НайтиПервыйКадр(Ошибка, НРег(ГруппаОшибок), "Группа");

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НайтиПервыйКадр(Ошибка, УсловиеПоиска, ВидПоиска)

	ТекущийКадр = Ошибка;
	Для НомерКадра = 1 По МаксимальноеКоличествоКадров() Цикл
		Метаданные = _ЧитательКадраОшибки.ПрочитатьМетаданные(ТекущийКадр);
		Если Метаданные <> Неопределено
			И Метаданные.Вид = ВидыКадровОшибок.Ошибка()
			И КодСоответствует(Метаданные.КодОшибки, УсловиеПоиска, ВидПоиска) Тогда
			Возврат ТекущийКадр;
		КонецЕсли;

		Причина = Неопределено;
		Если Не ПопытатьсяПрочитатьПричину(ТекущийКадр, Причина)
			Или Причина = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;

		Если НомерКадра = МаксимальноеКоличествоКадров() Тогда
			Возврат Неопределено;
		КонецЕсли;

		ТекущийКадр = Причина;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Функция КодСоответствует(КодОшибки, УсловиеПоиска, ВидПоиска)

	НормализованныйКод = НРег(КодОшибки);
	Если ВидПоиска = "Коды" Тогда
		Возврат УсловиеПоиска.Получить(НормализованныйКод) = Истина;
	ИначеЕсли ВидПоиска = "Код" Тогда
		Возврат НормализованныйКод = УсловиеПоиска;
	КонецЕсли;

	Возврат НормализованныйКод = УсловиеПоиска
		Или СтрНайти(НормализованныйКод, УсловиеПоиска + ".") = 1;

КонецФункции

#КонецОбласти
