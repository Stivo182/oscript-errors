&Тест
Процедура ТестДолжен_СохранитьПодсказкуПриСозданииОшибки() Экспорт

	// Действие
	Ошибка = ФабрикаОшибок.Создать(
		"http.proxy_error",
		"Ошибка прокси",
		Неопределено,
		"Проверьте переменную HTTPS_PROXY"
	);

	// Проверка
	Снимок = Новый СнимокКадраОшибки(Ошибка);
	Ожидаем.Что(Снимок.Подсказка()).Равно("Проверьте переменную HTTPS_PROXY");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьПодсказкуПриОбертыванииОшибки() Экспорт

	// Подготовка
	Причина = ФабрикаОшибок.Создать("network.unavailable", "Сеть недоступна");

	// Действие
	Ошибка = ФабрикаОшибок.Обернуть(
		Причина,
		"http.proxy_error",
		"Ошибка прокси",
		Неопределено,
		"Проверьте настройки прокси"
	);

	// Проверка
	Снимок = Новый СнимокКадраОшибки(Ошибка);
	Ожидаем.Что(Снимок.Подсказка()).Равно("Проверьте настройки прокси");
	Ожидаем.Что(Ошибка.Причина).Равно(Причина);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьНестроковуюПодсказку() Экспорт

	// Подготовка
	Параметры = Новый Массив;
	Параметры.Добавить("http.proxy_error");
	Параметры.Добавить("Ошибка прокси");
	Параметры.Добавить(Неопределено);
	Параметры.Добавить(42);

	// Действие и Проверка
	Ожидаем.Что(ФабрикаОшибок)
		.Метод("Создать", Параметры)
		.ВыбрасываетИсключение(
			НСтр("ru = 'Подсказка должна быть строкой'; en = 'Hint must be a string'")
		);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьОшибкуНеверногоТипаАргумента() Экспорт

	// Подготовка
	Ошибка = ФабрикаОшибок.НеверныйТипАргумента("Имя", "Строка", 42);

	// Действие
	Снимок = Новый СнимокКадраОшибки(Ошибка);

	// Проверка
	Ожидаем.Что(Снимок.ТипОшибки()).Равно("argument.invalid_type");
	Ожидаем.Что(Снимок.Данные().ИмяАргумента).Равно("Имя");
	Ожидаем.Что(Снимок.Данные().ОжидаемыйТип).Равно("Строка");
	Ожидаем.Что(Снимок.Данные().ФактическийТип).Равно(Строка(Тип("Число")));
	Ожидаем.Что(Снимок.Данные().Свойство("ФактическоеЗначение")).ЭтоЛожь();
	Ожидаем.Что(Снимок.Сообщение()).Равно(СтандартноеСообщениеНеверногоТипа("Имя", "Строка"));

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьОшибкуНезаполненногоАргумента() Экспорт

	// Подготовка
	ОшибкаПоУмолчанию = ФабрикаОшибок.АргументНеЗаполнен("Имя");
	ОшибкаСПользовательскимСообщением = ФабрикаОшибок.АргументНеЗаполнен("Имя", "Пользовательское сообщение");

	// Действие
	СнимокПоУмолчанию = Новый СнимокКадраОшибки(ОшибкаПоУмолчанию);
	СнимокСПользовательскимСообщением = Новый СнимокКадраОшибки(ОшибкаСПользовательскимСообщением);

	// Проверка
	Ожидаем.Что(СнимокПоУмолчанию.ТипОшибки()).Равно("argument.required");
	Ожидаем.Что(СнимокПоУмолчанию.Данные().ИмяАргумента).Равно("Имя");
	Ожидаем.Что(СнимокПоУмолчанию.Данные().Количество()).Равно(1);
	Ожидаем.Что(СнимокПоУмолчанию.Сообщение()).Равно(СтандартноеСообщениеНезаполненногоАргумента("Имя"));
	Ожидаем.Что(СнимокСПользовательскимСообщением.Сообщение()).Равно("Пользовательское сообщение");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьОшибкуНедопустимогоЗначенияАргумента() Экспорт

	// Подготовка
	Ошибка = ФабрикаОшибок.НедопустимоеЗначениеАргумента("Количество", "быть больше нуля");

	// Действие
	Снимок = Новый СнимокКадраОшибки(Ошибка);

	// Проверка
	Ожидаем.Что(Снимок.ТипОшибки()).Равно("argument.invalid_value");
	Ожидаем.Что(Снимок.Данные().ИмяАргумента).Равно("Количество");
	Ожидаем.Что(Снимок.Данные().Ожидание).Равно("быть больше нуля");
	Ожидаем.Что(Снимок.Данные().Количество()).Равно(2);
	Ожидаем.Что(Снимок.Сообщение()).Равно(
		СтандартноеСообщениеНедопустимогоЗначения("Количество", "быть больше нуля")
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьПользовательскиеСообщенияСтандартныхФабрик() Экспорт

	// Подготовка
	ОшибкаНеверногоТипа = ФабрикаОшибок.НеверныйТипАргумента("Имя", "Строка", 42, "Неверный тип");
	ОшибкаНедопустимогоЗначения = ФабрикаОшибок.НедопустимоеЗначениеАргумента(
		"Количество",
		"быть больше нуля",
		"Недопустимое количество"
	);

	// Действие
	СнимокНеверногоТипа = Новый СнимокКадраОшибки(ОшибкаНеверногоТипа);
	СнимокНедопустимогоЗначения = Новый СнимокКадраОшибки(ОшибкаНедопустимогоЗначения);

	// Проверка
	Ожидаем.Что(СнимокНеверногоТипа.Сообщение()).Равно("Неверный тип");
	Ожидаем.Что(СнимокНедопустимогоЗначения.Сообщение()).Равно("Недопустимое количество");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("НеверныйТипАргумента", "ИмяАргумента", 42, "argument.invalid_type")
&ИсточникЗначение("НеверныйТипАргумента", "ИмяАргумента", "", "argument.required")
&ИсточникЗначение("НеверныйТипАргумента", "Сообщение", 42, "argument.invalid_type")
&ИсточникЗначение("НеверныйТипАргумента", "ОжидаемыйТип", 42, "argument.invalid_type")
&ИсточникЗначение("НеверныйТипАргумента", "ОжидаемыйТип", "", "argument.required")
&ИсточникЗначение("АргументНеЗаполнен", "ИмяАргумента", 42, "argument.invalid_type")
&ИсточникЗначение("АргументНеЗаполнен", "ИмяАргумента", "", "argument.required")
&ИсточникЗначение("АргументНеЗаполнен", "Сообщение", 42, "argument.invalid_type")
&ИсточникЗначение("НедопустимоеЗначениеАргумента", "ИмяАргумента", 42, "argument.invalid_type")
&ИсточникЗначение("НедопустимоеЗначениеАргумента", "ИмяАргумента", "", "argument.required")
&ИсточникЗначение("НедопустимоеЗначениеАргумента", "Сообщение", 42, "argument.invalid_type")
&ИсточникЗначение("НедопустимоеЗначениеАргумента", "Ожидание", 42, "argument.invalid_type")
&ИсточникЗначение("НедопустимоеЗначениеАргумента", "Ожидание", "", "argument.required")
Процедура ТестДолжен_ПроверитьСобственныеКонтрактыСтандартныхФабрик(
	ИмяФабрики,
	ИмяПараметра,
	НекорректноеЗначение,
	ОжидаемыйТипОшибки
) Экспорт

	// Подготовка
	Параметры = ПараметрыНекорректногоВызоваФабрики(ИмяФабрики, ИмяПараметра, НекорректноеЗначение);

	// Действие
	Ошибка = ОшибкаСтандартнойФабрики(ИмяФабрики, Параметры);
	Снимок = Новый СнимокКадраОшибки(Ошибка);

	// Проверка
	Ожидаем.Что(Снимок.ТипОшибки()).Равно(ОжидаемыйТипОшибки);
	Ожидаем.Что(Снимок.Данные().ИмяАргумента).Равно(ИмяПараметра);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("НестроковыйТипОшибки", "argument.invalid_type", "ТипОшибки", "ОжидаемыйТип", "Строка")
&ИсточникЗначение("НекорректныйФорматТипаОшибки", "argument.invalid_value", "ТипОшибки", "Ожидание", "формату типа")
&ИсточникЗначение("НестроковоеСообщение", "argument.invalid_type", "Сообщение", "ОжидаемыйТип", "Строка")
&ИсточникЗначение("ПустоеСообщение", "argument.required", "Сообщение", "ИмяАргумента", "Сообщение")
&ИсточникЗначение("НестроковаяПодсказка", "argument.invalid_type", "Подсказка", "ОжидаемыйТип", "Строка")
&ИсточникЗначение("НекорректнаяПричина", "argument.invalid_type", "Причина", "ОжидаемыйТип", "ИнформацияОбОшибке")
Процедура ТестДолжен_КлассифицироватьКонтрактыФабрики(
	ИмяПроверки,
	ОжидаемыйТипОшибки,
	ИмяАргумента,
	ИмяПоля,
	ОжидаемоеЗначение
) Экспорт

	// Действие
	Ошибка = ОшибкаКонтрактаФабрики(ИмяПроверки);
	Если ИмяПоля = "ОжидаемыйТип" Тогда
		Если ИмяПроверки = "НекорректнаяПричина" Тогда
			ОжидаемоеЗначение = Строка(Тип("ИнформацияОбОшибке"));
		Иначе
			ОжидаемоеЗначение = Строка(Тип("Строка"));
		КонецЕсли;
	КонецЕсли;

	// Проверка
	Снимок = Новый СнимокКадраОшибки(Ошибка);
	Ожидаем.Что(Снимок.ТипОшибки()).Равно(ОжидаемыйТипОшибки);
	Ожидаем.Что(Снимок.Данные().ИмяАргумента).Равно(ИмяАргумента);
	Ожидаем.Что(Снимок.Данные()[ИмяПоля]).Равно(ОжидаемоеЗначение);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ВнешняяОшибка(Сообщение)

	Попытка
		ВызватьИсключение Сообщение;
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

КонецФункции

Функция ОшибкаКонтрактаФабрики(ИмяПроверки)

	Попытка
		Если ИмяПроверки = "НестроковыйТипОшибки" Тогда
			ФабрикаОшибок.Создать(42, "Сообщение");
		ИначеЕсли ИмяПроверки = "НекорректныйФорматТипаОшибки" Тогда
			ФабрикаОшибок.Создать("core.not-failed", "Сообщение");
		ИначеЕсли ИмяПроверки = "НестроковоеСообщение" Тогда
			ФабрикаОшибок.Создать("core.failed", 42);
		ИначеЕсли ИмяПроверки = "ПустоеСообщение" Тогда
			ФабрикаОшибок.Создать("core.failed", "");
		ИначеЕсли ИмяПроверки = "НестроковаяПодсказка" Тогда
			ФабрикаОшибок.Создать("core.failed", "Сообщение", Неопределено, 42);
		Иначе
			ФабрикаОшибок.СКонтекстом("не ошибка", "Контекст");
		КонецЕсли;
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидалось контрактное исключение фабрики";

КонецФункции

Функция ОшибкаНеверногоТипаАргумента(ИмяАргумента, ОжидаемыйТип, ФактическоеЗначение, Сообщение = "")

	Попытка
		ФабрикаОшибок.НеверныйТипАргумента(
			ИмяАргумента,
			ОжидаемыйТип,
			ФактическоеЗначение,
			Сообщение
		);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидалось исключение фабрики ошибки неверного типа аргумента";

КонецФункции

Функция ОшибкаАргументаНеЗаполнен(ИмяАргумента, Сообщение = "")

	Попытка
		ФабрикаОшибок.АргументНеЗаполнен(ИмяАргумента, Сообщение);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидалось исключение фабрики ошибки незаполненного аргумента";

КонецФункции

Функция ОшибкаНедопустимогоЗначенияАргумента(ИмяАргумента, Ожидание, Сообщение = "")

	Попытка
		ФабрикаОшибок.НедопустимоеЗначениеАргумента(ИмяАргумента, Ожидание, Сообщение);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидалось исключение фабрики ошибки недопустимого значения аргумента";

КонецФункции

Функция ОшибкаСтандартнойФабрики(ИмяФабрики, Параметры)

	Попытка
		Если ИмяФабрики = "НеверныйТипАргумента" Тогда
			ФабрикаОшибок.НеверныйТипАргумента(
				Параметры[0],
				Параметры[1],
				Параметры[2],
				Параметры[3]
			);
		ИначеЕсли ИмяФабрики = "АргументНеЗаполнен" Тогда
			ФабрикаОшибок.АргументНеЗаполнен(Параметры[0], Параметры[1]);
		Иначе
			ФабрикаОшибок.НедопустимоеЗначениеАргумента(Параметры[0], Параметры[1], Параметры[2]);
		КонецЕсли;
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидалось исключение стандартной фабрики";

КонецФункции

Функция ПараметрыНекорректногоВызоваФабрики(ИмяФабрики, ИмяПараметра, НекорректноеЗначение)

	Параметры = Новый Массив;

	Если ИмяФабрики = "НеверныйТипАргумента" Тогда
		Параметры.Добавить("Имя");
		Параметры.Добавить("Строка");
		Параметры.Добавить("Значение");
		Параметры.Добавить("");
		ИндексПараметра = ИндексПараметраНеверногоТипа(ИмяПараметра);
	ИначеЕсли ИмяФабрики = "АргументНеЗаполнен" Тогда
		Параметры.Добавить("Имя");
		Параметры.Добавить("");
		ИндексПараметра = ИндексПараметраНезаполненногоАргумента(ИмяПараметра);
	Иначе
		Параметры.Добавить("Имя");
		Параметры.Добавить("быть заполненным");
		Параметры.Добавить("");
		ИндексПараметра = ИндексПараметраНедопустимогоЗначения(ИмяПараметра);
	КонецЕсли;

	Параметры[ИндексПараметра] = НекорректноеЗначение;

	Возврат Параметры;

КонецФункции

Функция ИндексПараметраНеверногоТипа(ИмяПараметра)

	Если ИмяПараметра = "ИмяАргумента" Тогда
		Возврат 0;
	ИначеЕсли ИмяПараметра = "ОжидаемыйТип" Тогда
		Возврат 1;
	Иначе
		Возврат 3;
	КонецЕсли;

КонецФункции

Функция ИндексПараметраНезаполненногоАргумента(ИмяПараметра)

	Если ИмяПараметра = "ИмяАргумента" Тогда
		Возврат 0;
	КонецЕсли;

	Возврат 1;

КонецФункции

Функция ИндексПараметраНедопустимогоЗначения(ИмяПараметра)

	Если ИмяПараметра = "ИмяАргумента" Тогда
		Возврат 0;
	ИначеЕсли ИмяПараметра = "Ожидание" Тогда
		Возврат 1;
	КонецЕсли;

	Возврат 2;

КонецФункции

Функция СтандартноеСообщениеНеверногоТипа(ИмяАргумента, ОжидаемыйТип)

	Возврат СтрШаблон(
		НСтр("ru = 'Аргумент %1 должен иметь тип %2'; en = 'Argument %1 must be of type %2'"),
		ИмяАргумента,
		ОжидаемыйТип
	);

КонецФункции

Функция СтандартноеСообщениеНезаполненногоАргумента(ИмяАргумента)

	Возврат СтрШаблон(
		НСтр("ru = 'Аргумент %1 должен быть заполнен'; en = 'Argument %1 is required'"),
		ИмяАргумента
	);

КонецФункции

Функция СтандартноеСообщениеНедопустимогоЗначения(ИмяАргумента, Ожидание)

	Возврат СтрШаблон(
		НСтр(
			"ru = 'Аргумент %1 имеет недопустимое значение: ожидается %2';"
			+ "en = 'Argument %1 has an invalid value: expected %2'"
		),
		ИмяАргумента,
		Ожидание
	);

КонецФункции

Процедура ПроверитьИсключениеМетода(ИмяМетода, Параметры, ОжидаемоеСообщение)

	Ожидаем.Что(ФабрикаОшибок)
		.Метод(ИмяМетода, Параметры)
		.ВыбрасываетИсключение(ОжидаемоеСообщение);

КонецПроцедуры

#КонецОбласти
