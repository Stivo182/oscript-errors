// Низкоуровневая фабрика стандартных структурированных ошибок.

#Область СлужебныйПрограммныйИнтерфейс

// Создаёт ошибку неверного типа аргумента.
//
// Параметры:
//  ИмяАргумента - Строка - Имя аргумента с неверным типом.
//  ОжидаемыйТип - Строка - Строковое представление ожидаемого типа.
//  ФактическоеЗначение - Произвольный - Значение с неверным типом.
//  Сообщение - Строка - Человекочитаемое описание ошибки.
//
// Возвращаемое значение:
//  ИнформацияОбОшибке - Новый кадр ошибки контракта.
Функция НеверныйТипАргумента(ИмяАргумента, ОжидаемыйТип, ФактическоеЗначение, Сообщение = "") Экспорт

	Данные = Новый Структура(
		"ИмяАргумента, ОжидаемыйТип, ФактическийТип",
		ИмяАргумента,
		ОжидаемыйТип,
		Строка(ТипЗнч(ФактическоеЗначение))
	);

	Если Сообщение = "" Тогда
		Сообщение = СтрШаблон(
			НСтр("ru = 'Аргумент %1 должен иметь тип %2'; en = 'Argument %1 must be of type %2'"),
			ИмяАргумента,
			ОжидаемыйТип
		);
	КонецЕсли;

	Возврат СоздатьОшибку("argument.invalid_type", Сообщение, Данные);

КонецФункции

// Создаёт ошибку незаполненного обязательного аргумента.
//
// Параметры:
//  ИмяАргумента - Строка - Имя незаполненного аргумента.
//  Сообщение - Строка - Человекочитаемое описание ошибки.
//
// Возвращаемое значение:
//  ИнформацияОбОшибке - Новый кадр ошибки контракта.
Функция АргументНеЗаполнен(ИмяАргумента, Сообщение = "") Экспорт

	Если Сообщение = "" Тогда
		Сообщение = СтрШаблон(
			НСтр("ru = 'Аргумент %1 должен быть заполнен'; en = 'Argument %1 is required'"),
			ИмяАргумента
		);
	КонецЕсли;

	Возврат СоздатьОшибку(
		"argument.required",
		Сообщение,
		Новый Структура("ИмяАргумента", ИмяАргумента)
	);

КонецФункции

// Создаёт ошибку недопустимого значения аргумента.
//
// Параметры:
//  ИмяАргумента - Строка - Имя аргумента с недопустимым значением.
//  Ожидание - Строка - Описание допустимого значения или ограничения.
//  Сообщение - Строка - Человекочитаемое описание ошибки.
//
// Возвращаемое значение:
//  ИнформацияОбОшибке - Новый кадр ошибки контракта.
Функция НедопустимоеЗначениеАргумента(ИмяАргумента, Ожидание, Сообщение = "") Экспорт

	Если Сообщение = "" Тогда
		Сообщение = СтрШаблон(
			НСтр(
				"ru = 'Аргумент %1 имеет недопустимое значение: ожидается %2';"
				+ "en = 'Argument %1 has an invalid value: expected %2'"
			),
			ИмяАргумента,
			Ожидание
		);
	КонецЕсли;

	Возврат СоздатьОшибку(
		"argument.invalid_value",
		Сообщение,
		Новый Структура("ИмяАргумента, Ожидание", ИмяАргумента, Ожидание)
	);

КонецФункции

// Создаёт ошибку аргумента вне допустимого диапазона.
//
// Параметры:
//  ИмяАргумента - Строка - Имя аргумента вне диапазона.
//  ОжидаемыйДиапазон - Строка - Описание допустимого диапазона.
//  Сообщение - Строка - Человекочитаемое описание ошибки.
//
// Возвращаемое значение:
//  ИнформацияОбОшибке - Новый кадр ошибки контракта.
Функция АргументВнеДиапазона(ИмяАргумента, ОжидаемыйДиапазон, Сообщение = "") Экспорт

	Если Сообщение = "" Тогда
		Сообщение = СтрШаблон(
			НСтр(
				"ru = 'Аргумент %1 находится вне допустимого диапазона: ожидается %2';"
				+ "en = 'Argument %1 is out of range: expected %2'"
			),
			ИмяАргумента,
			ОжидаемыйДиапазон
		);
	КонецЕсли;

	Возврат СоздатьОшибку(
		"argument.out_of_range",
		Сообщение,
		Новый Структура(
			"ИмяАргумента, ОжидаемыйДиапазон",
			ИмяАргумента,
			ОжидаемыйДиапазон
		)
	);

КонецФункции

