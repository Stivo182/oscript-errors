#Использовать "../internal"

Перем _Вид; // Строка
Перем _ТипОшибки; // Строка, Неопределено
Перем _Сообщение; // Строка, Неопределено
Перем _Данные; // Произвольный, Неопределено
Перем _ИмяМодуля; // Строка, Неопределено
Перем _НомерСтроки; // Число, Неопределено
Перем _ИсходнаяСтрока; // Строка, Неопределено
Перем _Стек; // Массив

#Область ОбработчикиСобытий

// Создаёт безопасный снимок физического кадра ошибки.
//
// Параметры:
//  Ошибка - ИнформацияОбОшибке - Физический кадр для создания снимка.
Процедура ПриСозданииОбъекта(Ошибка)

	ВнутреннееУстройствоОшибок.ПроверитьОшибку(Ошибка);
	ОписаниеКадра = ВнутреннееУстройствоОшибок.РаспознатьКадр(Ошибка);

	_Вид = ОписаниеКадра.Вид;
	_ТипОшибки = ОписаниеКадра.ТипОшибки;
	_Данные = ОписаниеКадра.Данные;
	_Сообщение = Неопределено;
	_ИмяМодуля = Неопределено;
	_НомерСтроки = Неопределено;
	_ИсходнаяСтрока = Неопределено;
	_Стек = Новый Массив;

	БезопасноПрочитатьСвойства(Ошибка);

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Возвращает распознанный вид кадра.
//
// Возвращаемое значение:
//  Строка - Распознанный вид кадра.
Функция Вид() Экспорт

	Возврат _Вид;

КонецФункции

// Возвращает машинный тип собственного кадра.
//
// Возвращаемое значение:
//  Строка, Неопределено - Машинный тип собственного кадра.
Функция ТипОшибки() Экспорт

	Возврат _ТипОшибки;

КонецФункции

// Возвращает описание физического кадра.
//
// Возвращаемое значение:
//  Строка, Неопределено - Описание физического кадра.
Функция Сообщение() Экспорт

	Возврат _Сообщение;

КонецФункции

// Возвращает пользовательские данные собственного кадра.
//
// Возвращаемое значение:
//  Произвольный, Неопределено - Пользовательские данные собственного кадра.
Функция Данные() Экспорт

	Возврат _Данные;

КонецФункции

// Возвращает имя модуля места создания кадра.
//
// Возвращаемое значение:
//  Строка, Неопределено - Имя модуля места создания кадра.
Функция ИмяМодуля() Экспорт

	Возврат _ИмяМодуля;

КонецФункции

// Возвращает номер строки места создания кадра.
//
// Возвращаемое значение:
//  Число, Неопределено - Номер строки места создания кадра.
Функция НомерСтроки() Экспорт

	Возврат _НомерСтроки;

КонецФункции

// Возвращает исходную строку места создания кадра.
//
// Возвращаемое значение:
//  Строка, Неопределено - Исходная строка места создания кадра.
Функция ИсходнаяСтрока() Экспорт

	Возврат _ИсходнаяСтрока;

КонецФункции

// Возвращает независимую копию стека вызовов кадра.
//
// Возвращаемое значение:
//  Массив - Независимая копия стека вызовов кадра.
Функция Стек() Экспорт

	Результат = Новый Массив;
	Для Каждого ЭлементСтека Из _Стек Цикл
		Результат.Добавить(ЭлементСтека);
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура БезопасноПрочитатьСвойства(Ошибка)

	Попытка
		_Сообщение = Ошибка.Описание;
	Исключение
	КонецПопытки;

	Попытка
		_ИмяМодуля = Ошибка.ИмяМодуля;
	Исключение
	КонецПопытки;

	Попытка
		_НомерСтроки = Ошибка.НомерСтроки;
	Исключение
	КонецПопытки;

	Попытка
		_ИсходнаяСтрока = Ошибка.ИсходнаяСтрока;
	Исключение
	КонецПопытки;

	Попытка
		СтекКадра = Ошибка.ПолучитьСтекВызовов();
	Исключение
		СтекКадра = Неопределено;
	КонецПопытки;

	Если СтекКадра <> Неопределено Тогда
		Попытка
			Для Каждого ЭлементСтека Из СтекКадра Цикл
				_Стек.Добавить(ЭлементСтека);
			КонецЦикла;
		Исключение
		КонецПопытки;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
