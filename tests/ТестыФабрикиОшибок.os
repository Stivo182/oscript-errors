	КонецПопытки;

	// Проверка
	Ожидаем.Что(Ошибка.Описание).Равно("Чтение конфигурации");
	Ожидаем.Что(Ошибка.Причина).Равно(Причина);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВыброситьИПерехватитьОбернутуюОшибку() Экспорт

	// Подготовка
	Причина = ВнешняяОшибка("Исходная ошибка");

	// Действие
	Попытка
		ВызватьИсключение ФабрикаОшибок.Обернуть(Причина, "application.start_failed", "Не удалось запустить приложение");
	Исключение
		Ошибка = ИнформацияОбОшибке();
