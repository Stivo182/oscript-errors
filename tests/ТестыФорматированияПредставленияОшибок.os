	Данные.Вставить(Новый НепредставимоеЗначение, Новый Структура("Значение", "Б"));
	Данные.Вставить(Новый НепредставимоеЗначение, Новый Структура("Значение", "А"));
	ОжидаемыйТекст = "<недоступно>:" + Символы.ПС
