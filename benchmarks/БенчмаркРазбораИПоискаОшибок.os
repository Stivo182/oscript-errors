#Использовать "../src"

&Параметры(1, 10, 50)
Перем ГлубинаЦепочки Экспорт; // Число

Перем _Ошибка; // ИнформацияОбОшибке
Перем _ОшибкаСКонтекстами; // ИнформацияОбОшибке
Перем _КодВнешнегоКадра; // Строка
Перем _КодСреднегоКадра; // Строка
Перем _КодКорневогоКадра; // Строка
Перем _ИскомыеКоды; // ФиксированныйМассив из Строка
Перем _Результат; // Произвольный

#Область ОбработчикиСобытий

// Создаёт бенчмарк разбора и поиска по цепочке ошибок.
&МониторингПамяти
&КоличествоИтераций(5)
&КоличествоПрогревочныхИтераций(3)
&МинимальноеВремяИтерации(100)
Процедура ПриСозданииОбъекта()
КонецПроцедуры

// Подготавливает цепочку ошибок заданной глубины.
//
// Параметры:
//  Контекст - Структура - Контекст выполняемого кейса бенчмарка.
&ПередКаждымКейсом
Процедура ПодготовитьЦепочку(Контекст) Экспорт

	_Ошибка = СоздатьЦепочку(ГлубинаЦепочки);
	_ОшибкаСКонтекстами = СоздатьЦепочкуКонтекстов(ГлубинаЦепочки);
	_КодВнешнегоКадра = КодУровня(ГлубинаЦепочки);
	_КодСреднегоКадра = КодУровня(Цел((ГлубинаЦепочки + 1) / 2));
	_КодКорневогоКадра = КодУровня(1);
	_ИскомыеКоды = Новый ФиксированныйМассив(
		СтрРазделить("benchmark.missing,benchmark.level_1", ",", Ложь)
	);

КонецПроцедуры

#КонецОбласти

#Область Бенчмарки

// Измеряет создание ленивого разбора подготовленной цепочки.
&Бенчмарк(Наименование = "Создание разбора")
&Категория("Разбор")
Процедура СоздатьРазбор() Экспорт
	_Результат = ДиагностикаОшибок.Разобрать(_Ошибка);
КонецПроцедуры

// Измеряет потоковое получение данных эффективной ошибки после обхода контекстов.
&Бенчмарк(Наименование = "Данные ошибки")
&Категория("Короткая диагностика")
Процедура ПолучитьДанныеОшибки() Экспорт
	_Результат = ДиагностикаОшибок.ДанныеОшибки(_ОшибкаСКонтекстами);
КонецПроцедуры

// Измеряет потоковое получение снимка эффективной ошибки после обхода контекстов.
&Бенчмарк(Наименование = "Эффективная ошибка")
&Категория("Короткая диагностика")
Процедура ПолучитьЭффективнуюОшибку() Экспорт
	_Результат = ДиагностикаОшибок.ЭффективнаяОшибка(_ОшибкаСКонтекстами);
КонецПроцедуры

// Измеряет потоковое получение корневой причины с полным обходом цепочки.
&Бенчмарк(Наименование = "Корневая причина")
&Категория("Короткая диагностика")
Процедура ПолучитьКорневуюПричину() Экспорт
	_Результат = ДиагностикаОшибок.КорневаяПричина(_Ошибка);
КонецПроцедуры

// Измеряет получение данных эффективной ошибки через полный разбор.
&Бенчмарк(Наименование = "Данные ошибки через полный разбор")
&Категория("Полный разбор")
Процедура ПолучитьДанныеОшибкиЧерезПолныйРазбор() Экспорт
	_Результат = ДиагностикаОшибок.Разобрать(_ОшибкаСКонтекстами).Данные();
КонецПроцедуры

// Измеряет получение снимка эффективной ошибки через полный разбор.
&Бенчмарк(Наименование = "Эффективная ошибка через полный разбор")
&Категория("Полный разбор")
Процедура ПолучитьЭффективнуюОшибкуЧерезПолныйРазбор() Экспорт
	_Результат = ДиагностикаОшибок.Разобрать(_ОшибкаСКонтекстами).ЭффективнаяОшибка();
КонецПроцедуры

// Измеряет получение корневой причины через полный разбор.
&Бенчмарк(Наименование = "Корневая причина через полный разбор")
&Категория("Полный разбор")
Процедура ПолучитьКорневуюПричинуЧерезПолныйРазбор() Экспорт
	_Результат = ДиагностикаОшибок.Разобрать(_Ошибка).КорневаяПричина();
КонецПроцедуры

// Измеряет поиск кода во внешнем кадре с ранним завершением обхода.
&Бенчмарк(Наименование = "Код во внешнем кадре")
&Категория("Поиск")
Процедура НайтиКодВоВнешнемКадре() Экспорт
	_Результат = ДиагностикаОшибок.Содержит(_Ошибка, _КодВнешнегоКадра);
КонецПроцедуры

// Измеряет поиск кода в среднем кадре цепочки.
&Бенчмарк(Наименование = "Код в среднем кадре")
&Категория("Поиск")
Процедура НайтиКодВСреднемКадре() Экспорт
	_Результат = ДиагностикаОшибок.Содержит(_Ошибка, _КодСреднегоКадра);
КонецПроцедуры

// Измеряет поиск существующего кода в корневом кадре цепочки.
&Бенчмарк(Наименование = "Код в корневом кадре")
&Категория("Поиск")
Процедура НайтиКодВКорневомКадре() Экспорт
	_Результат = ДиагностикаОшибок.Содержит(_Ошибка, _КодКорневогоКадра);
КонецПроцедуры

// Измеряет поиск отсутствующего кода с полным обходом цепочки.
&Бенчмарк(Наименование = "Отсутствующий код")
&Категория("Поиск")
Процедура НайтиОтсутствующийКод() Экспорт
	_Результат = ДиагностикаОшибок.Содержит(_Ошибка, "benchmark.missing");
КонецПроцедуры

// Измеряет поиск одного из нескольких кодов.
&Бенчмарк(Наименование = "Любой из кодов")
&Категория("Поиск")
Процедура НайтиЛюбойИзКодов() Экспорт
	_Результат = ДиагностикаОшибок.СодержитЛюбойИз(_Ошибка, _ИскомыеКоды);
КонецПроцедуры

// Измеряет поиск по группе машинных кодов.
&Бенчмарк(Наименование = "Группа кодов")
&Категория("Поиск")
Процедура НайтиГруппуКодов() Экспорт
	_Результат = ДиагностикаОшибок.СодержитГруппу(_Ошибка, "benchmark");
КонецПроцедуры

// Измеряет возврат первого снимка с корневым кодом.
&Бенчмарк(Наименование = "Первый снимок")
&Категория("Поиск")
Процедура НайтиПервыйСнимок() Экспорт
	_Результат = ДиагностикаОшибок.НайтиПервую(_Ошибка, _КодКорневогоКадра);
КонецПроцедуры

// Измеряет прежний материализованный путь как контроль.
&Бенчмарк(Наименование = "Код через полный разбор")
&Категория("Поиск")
Процедура НайтиКодЧерезПолныйРазбор() Экспорт
	_Результат = ДиагностикаОшибок.Разобрать(_Ошибка).Ошибки().Содержит(_КодКорневогоКадра);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьЦепочку(Глубина)

	Ошибка = ФабрикаОшибок.Создать(КодУровня(1), "Ошибка уровня 1", ДанныеУровня(1));

	Для НомерУровня = 2 По Глубина Цикл
		Ошибка = ФабрикаОшибок.Обернуть(
			Ошибка,
			КодУровня(НомерУровня),
			"Ошибка уровня " + НомерУровня,
			ДанныеУровня(НомерУровня)
		);
	КонецЦикла;

	Возврат Ошибка;

КонецФункции

Функция СоздатьЦепочкуКонтекстов(Глубина)

	Ошибка = ФабрикаОшибок.Создать(КодУровня(1), "Ошибка уровня 1", ДанныеУровня(1));

	Для НомерУровня = 2 По Глубина Цикл
		Ошибка = ФабрикаОшибок.ОбернутьКонтекстом(Ошибка, "Контекст уровня " + НомерУровня);
	КонецЦикла;

	Возврат Ошибка;

КонецФункции

Функция КодУровня(НомерУровня)
	Возврат "benchmark.level_" + НомерУровня;
КонецФункции

Функция ДанныеУровня(НомерУровня)
	Возврат Новый Структура("Уровень, Операция", НомерУровня, "Обработка");
КонецФункции

#КонецОбласти
