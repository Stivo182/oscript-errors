	// Действие
	Снимок = Новый СнимокКадраОшибки(Ошибка);

	// Проверка
	Ожидаем.Что(Снимок.Вид()).Равно(ВидыКадровОшибок.ВнешняяОшибка());
	Ожидаем.Что(Снимок.КодОшибки()).Равно("");
	Ожидаем.Что(Снимок.Сообщение()).Равно("Старая ошибка");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПолучитьИсходноеСообщениеИзМетаданных() Экспорт

	// Подготовка
	Поля = Новый Структура;
	Поля.Вставить("Маркер", "onescript.exception.envelope");
	Поля.Вставить("ВерсияФормата", 1);
	Поля.Вставить("Вид", "Ошибка");
	Поля.Вставить("КодОшибки", "http.proxy_error");
	Поля.Вставить("Данные", Неопределено);
	Поля.Вставить("Сообщение", "Ошибка прокси");
	Ошибка = Новый ИнформацияОбОшибке(
		"http.proxy_error: Ошибка прокси",
		Новый ФиксированнаяСтруктура(Поля)
	);

	// Действие
	Снимок = Новый СнимокКадраОшибки(Ошибка);

	// Проверка
	Ожидаем.Что(Снимок.Вид()).Равно(ВидыКадровОшибок.Ошибка());
	Ожидаем.Что(Снимок.Сообщение()).Равно("Ошибка прокси");

КонецПроцедуры

