Перем _МаксимальнаяГлубина;
Перем _МаксимальноеКоличествоЭлементов;

#Область СлужебныйПрограммныйИнтерфейс

// Формирует строки ограниченного представления произвольного значения.
//
// Параметры:
//  Значение - Произвольный - Представляемое значение.
//  Отступ - Число - Количество пробелов перед каждой строкой.
//
// Возвращаемое значение:
//  Массив из Строка - Новые строки представления.
Функция Строки(Значение, Отступ = 0) Экспорт

	Результат = Новый Массив;
	ДобавитьЗначение(Результат, Значение, Отступ, 0, Новый Массив);

	Возврат Результат;

КонецФункции

// Проверяет, является ли значение пустым поддерживаемым контейнером.
//
// Параметры:
//  Значение - Произвольный - Проверяемое значение.
//
// Возвращаемое значение:
//  Булево - Истина для пустого массива, структуры или соответствия.
Функция ЭтоПустойКонтейнер(Значение) Экспорт

	Возврат ЭтоКонтейнер(Значение) И Значение.Количество() = 0;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьЗначениеСМаркером(Строки, Отступ, Маркер, Значение)

	Префикс = Пробелы(Отступ) + Маркер;
	СтрокиЗначения = СтрокиТекста(Значение);

	Если СтрокиЗначения.Количество() = 0 Тогда
		Строки.Добавить(Префикс + Символ(34) + Символ(34));
		Возврат;
	КонецЕсли;

	Строки.Добавить(Префикс + СтрокиЗначения[0]);

	ОтступПродолжения = Пробелы(СтрДлина(Префикс));
	Для НомерСтроки = 1 По СтрокиЗначения.ВГраница() Цикл
		Строки.Добавить(ОтступПродолжения + СтрокиЗначения[НомерСтроки]);
	КонецЦикла;

КонецПроцедуры

Функция СтрокиТекста(Значение)

	Текст = Строка(Значение);
	Текст = СтрЗаменить(Текст, Символы.ВК + Символы.ПС, Символы.ПС);
	Текст = СтрЗаменить(Текст, Символы.ВК, Символы.ПС);

	Если Текст = "" Тогда
		Возврат Новый Массив;
	КонецЕсли;

	Возврат СтрРазделить(Текст, Символы.ПС, Истина);

КонецФункции

Процедура ДобавитьЗначение(Строки, Значение, Отступ, Глубина, ПутьКонтейнеров)

	Если Не ЭтоКонтейнер(Значение) Тогда
		ДобавитьЗначениеСМаркером(Строки, Отступ, "", БезопасныйТекст(Значение));
		Возврат;
	КонецЕсли;

	Если Глубина >= _МаксимальнаяГлубина Тогда
		Строки.Добавить(
			Пробелы(Отступ) + НСтр("ru = '<максимальная глубина>'; en = '<maximum depth>'")
		);
		Возврат;
	КонецЕсли;

	Если ПутьКонтейнеров.Найти(Значение) <> Неопределено Тогда
		Строки.Добавить(
			Пробелы(Отступ) + НСтр("ru = '<циклическая ссылка>'; en = '<circular reference>'")
		);
		Возврат;
	КонецЕсли;

	Если Значение.Количество() = 0 Тогда
		Строки.Добавить(Пробелы(Отступ) + МаркерПустогоКонтейнера(Значение));
		Возврат;
	КонецЕсли;

	ПутьКонтейнеров.Добавить(Значение);

	Если ЭтоСтруктура(Значение) Тогда
		ДобавитьСтруктуру(Строки, Значение, Отступ, Глубина, ПутьКонтейнеров);
	ИначеЕсли ЭтоСоответствие(Значение) Тогда
		ДобавитьСоответствие(Строки, Значение, Отступ, Глубина, ПутьКонтейнеров);
	Иначе
		ДобавитьМассив(Строки, Значение, Отступ, Глубина, ПутьКонтейнеров);
	КонецЕсли;

	ПутьКонтейнеров.Удалить(ПутьКонтейнеров.ВГраница());

КонецПроцедуры

Процедура ДобавитьСтруктуру(Строки, Значение, Отступ, Глубина, ПутьКонтейнеров)

	КоличествоДобавленных = 0;

	Для Каждого Элемент Из Значение Цикл

		Если КоличествоДобавленных = _МаксимальноеКоличествоЭлементов Тогда
			Прервать;
		КонецЕсли;

		ДобавитьПару(
			Строки,
			Элемент.Ключ,
			Элемент.Значение,
			Отступ,
			Глубина,
			ПутьКонтейнеров
		);

		КоличествоДобавленных = КоличествоДобавленных + 1;

	КонецЦикла;

	ДобавитьМаркерЛимита(Строки, Значение.Количество(), Отступ, Ложь);

КонецПроцедуры

Процедура ДобавитьСоответствие(Строки, Значение, Отступ, Глубина, ПутьКонтейнеров)

	Элементы = ОтсортированныеЭлементыСоответствия(Значение, Глубина, ПутьКонтейнеров);
	КоличествоДобавленных = 0;

	Для Каждого Элемент Из Элементы Цикл

		Если КоличествоДобавленных = _МаксимальноеКоличествоЭлементов Тогда
			Прервать;
		КонецЕсли;

		ДобавитьПару(
			Строки,
			Элемент.Ключ,
			Элемент.ИсходноеЗначение,
			Отступ,
			Глубина,
			ПутьКонтейнеров
		);

		КоличествоДобавленных = КоличествоДобавленных + 1;

	КонецЦикла;

	ДобавитьМаркерЛимита(Строки, Значение.Количество(), Отступ, Ложь);

КонецПроцедуры

Процедура ДобавитьМассив(Строки, Значение, Отступ, Глубина, ПутьКонтейнеров)

	КоличествоДобавленных = 0;

	Для Каждого Элемент Из Значение Цикл

		Если КоличествоДобавленных = _МаксимальноеКоличествоЭлементов Тогда
			Прервать;
		КонецЕсли;

		Если ЭтоКонтейнер(Элемент) И Не ЭтоОднострочныйКонтейнер(Элемент, Глубина + 1, ПутьКонтейнеров) Тогда
			Строки.Добавить(Пробелы(Отступ) + "-");
			ДобавитьЗначение(Строки, Элемент, Отступ + 2, Глубина + 1, ПутьКонтейнеров);
		Иначе
			Текст = ОднострочноеПредставление(Элемент, Глубина + 1, ПутьКонтейнеров);
			ДобавитьЗначениеСМаркером(Строки, Отступ, "- ", Текст);
		КонецЕсли;

		КоличествоДобавленных = КоличествоДобавленных + 1;

	КонецЦикла;

	ДобавитьМаркерЛимита(Строки, Значение.Количество(), Отступ, Истина);

КонецПроцедуры

Процедура ДобавитьПару(Строки, Ключ, Значение, Отступ, Глубина, ПутьКонтейнеров)

	Если ЭтоКонтейнер(Значение) И Не ЭтоОднострочныйКонтейнер(Значение, Глубина + 1, ПутьКонтейнеров) Тогда
		Строки.Добавить(Пробелы(Отступ) + Ключ + ":");
		ДобавитьЗначение(Строки, Значение, Отступ + 2, Глубина + 1, ПутьКонтейнеров);
	Иначе
		Текст = ОднострочноеПредставление(Значение, Глубина + 1, ПутьКонтейнеров);
		ДобавитьЗначениеСМаркером(Строки, Отступ, Ключ + ": ", Текст);
	КонецЕсли;

КонецПроцедуры

Функция ЭтоОднострочныйКонтейнер(Значение, Глубина, ПутьКонтейнеров)

	Возврат Глубина >= _МаксимальнаяГлубина
		Или ПутьКонтейнеров.Найти(Значение) <> Неопределено
		Или Значение.Количество() = 0;

КонецФункции

Функция ОднострочноеПредставление(Значение, Глубина, ПутьКонтейнеров)

	Если Не ЭтоКонтейнер(Значение) Тогда
		Возврат БезопасныйТекст(Значение);
	ИначеЕсли Глубина >= _МаксимальнаяГлубина Тогда
		Возврат НСтр("ru = '<максимальная глубина>'; en = '<maximum depth>'");
	ИначеЕсли ПутьКонтейнеров.Найти(Значение) <> Неопределено Тогда
		Возврат НСтр("ru = '<циклическая ссылка>'; en = '<circular reference>'");
	КонецЕсли;

	Возврат МаркерПустогоКонтейнера(Значение);

КонецФункции

Функция ОтсортированныеЭлементыСоответствия(Значение, Глубина, ПутьКонтейнеров)

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("ТипКлюча");
	Результат.Колонки.Добавить("Ключ");
	Результат.Колонки.Добавить("ПредставлениеЗначения");
	Результат.Колонки.Добавить("Порядок");
	Результат.Колонки.Добавить("ИсходноеЗначение");
	Порядок = 0;

	Для Каждого Элемент Из Значение Цикл

		СтрокаТаблицы = Результат.Добавить();
		СтрокаТаблицы.ТипКлюча = БезопасныйТекст(ТипЗнч(Элемент.Ключ));
		СтрокаТаблицы.Ключ = ПредставлениеКлючаСоответствия(Элемент.Ключ);
		СтрокаТаблицы.ПредставлениеЗначения = ПредставлениеЗначенияДляСортировки(
			Элемент.Значение,
			Глубина + 1,
			ПутьКонтейнеров
		);
		СтрокаТаблицы.Порядок = Порядок;
		СтрокаТаблицы.ИсходноеЗначение = Элемент.Значение;

		Порядок = Порядок + 1;

	КонецЦикла;

	Результат.Сортировать("ТипКлюча, Ключ, ПредставлениеЗначения, Порядок");

	Возврат Результат;

КонецФункции

Функция ПредставлениеЗначенияДляСортировки(Значение, Глубина, ПутьКонтейнеров)

	Строки = Новый Массив;
	ДобавитьЗначение(Строки, Значение, 0, Глубина, ПутьКонтейнеров);

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

Функция ПредставлениеКлючаСоответствия(Ключ)

	Результат = БезопасныйТекст(Ключ);
	Результат = СтрЗаменить(Результат, "\", "\\");
	Результат = СтрЗаменить(Результат, Символы.ВК, "\r");
	Результат = СтрЗаменить(Результат, Символы.ПС, "\n");
	Результат = СтрЗаменить(Результат, Символы.Таб, "\t");

	Если Результат = "" Тогда
		Результат = Символ(34) + Символ(34);
	КонецЕсли;

	Возврат Результат;

КонецФункции

Процедура ДобавитьМаркерЛимита(Строки, Количество, Отступ, ЭтоМассив)

	Если Количество <= _МаксимальноеКоличествоЭлементов Тогда
		Возврат;
	КонецЕсли;

	Префикс = "";
	Если ЭтоМассив Тогда
		Префикс = "- ";
	КонецЕсли;

	КоличествоСкрытых = Количество - _МаксимальноеКоличествоЭлементов;
	Строки.Добавить(
		Пробелы(Отступ) + Префикс + СтрШаблон(
			НСтр("ru = '... ещё %1 %2'; en = '... %1 more %2'"),
			КоличествоСкрытых,
			ФормаСловаЭлемент(КоличествоСкрытых)
		)
	);

КонецПроцедуры

Функция ФормаСловаЭлемент(Количество)

	Если Количество = 1 Тогда
		Возврат НСтр("ru = 'элемент'; en = 'item'");
	КонецЕсли;

	ОстатокОтСта = Количество % 100;
	Если ОстатокОтСта >= 11 И ОстатокОтСта <= 14 Тогда
		Возврат НСтр("ru = 'элементов'; en = 'items'");
	КонецЕсли;

	ОстатокОтДесяти = Количество % 10;
	Если ОстатокОтДесяти = 1 Тогда
		Возврат НСтр("ru = 'элемент'; en = 'items'");
	ИначеЕсли ОстатокОтДесяти >= 2 И ОстатокОтДесяти <= 4 Тогда
		Возврат НСтр("ru = 'элемента'; en = 'items'");
	КонецЕсли;

	Возврат НСтр("ru = 'элементов'; en = 'items'");

КонецФункции

// Возвращает маркер пустого контейнера данных.
//
// Параметры:
//  Значение - Массив, Структура, Соответствие - Пустой контейнер.
//
// Возвращаемое значение:
//  Строка - Маркер массива или именованного контейнера.
Функция МаркерПустогоКонтейнера(Значение) Экспорт

	Если ЭтоМассив(Значение) Тогда
		Возврат "[]";
	КонецЕсли;

	Возврат "{}";

КонецФункции

Функция ЭтоКонтейнер(Значение)

	Возврат ЭтоСтруктура(Значение) Или ЭтоСоответствие(Значение) Или ЭтоМассив(Значение);

КонецФункции

Функция ЭтоСтруктура(Значение)

	ТипЗначения = ТипЗнч(Значение);

	Возврат ТипЗначения = Тип("Структура") Или ТипЗначения = Тип("ФиксированнаяСтруктура");

КонецФункции

Функция ЭтоСоответствие(Значение)

	ТипЗначения = ТипЗнч(Значение);

	Возврат ТипЗначения = Тип("Соответствие") Или ТипЗначения = Тип("ФиксированноеСоответствие");

КонецФункции

Функция ЭтоМассив(Значение)

	ТипЗначения = ТипЗнч(Значение);

	Возврат ТипЗначения = Тип("Массив") Или ТипЗначения = Тип("ФиксированныйМассив");

КонецФункции

Функция БезопасныйТекст(Значение)

	Если Значение = Неопределено Тогда
		Возврат НСтр("ru = 'Неопределено'; en = 'Undefined'");
	КонецЕсли;

	Результат = БезопасноеПредставление(Значение);

	Если Результат = "" Тогда
		Возврат Символ(34) + Символ(34);
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция БезопасноеПредставление(Значение)

	Попытка
		Возврат Строка(Значение);
	Исключение
		ЛогированиеОшибок.ЗаписатьПодавленныйСбой(
			"format.render_limited_value",
			Значение,
			ИнформацияОбОшибке()
		);
		Возврат НСтр("ru = '<недоступно>'; en = '<unavailable>'");
	КонецПопытки;

КонецФункции

Функция Пробелы(Количество)

	Результат = "";
	Для Счетчик = 1 По Количество Цикл
		Результат = Результат + " ";
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

_МаксимальнаяГлубина = 3;
_МаксимальноеКоличествоЭлементов = 20;
