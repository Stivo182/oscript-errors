// Возвращаемое значение:
//  СоздательКонвертаОшибки - Сохраненный экземпляр создателя.
Функция СоздательКонвертаОшибки() Экспорт

	Возврат ПолучитьИлиСоздатьСервис("СоздательКонвертаОшибки");

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьИлиСоздатьСервис(ИмяКласса)

	// StructureImpl хранит значение как управляемую ссылку в List<IValue>.
	// По модели памяти .NET запись такой ссылки атомарна и публикует доступное через нее состояние объекта.
	// Зависимые чтения упорядочены, поэтому готовый сервис можно вернуть без захвата блокировки.
	// См. https://github.com/dotnet/runtime/blob/main/docs/design/specs/Memory-model.md#object-assignment
	// Ссылка после публикации не изменяется. При отсутствии сервиса блокировка и повторная проверка
	// гарантируют создание единственного экземпляра.
	Сервис = _Сервисы[ИмяКласса];
	Если Сервис <> Неопределено Тогда
		Возврат Сервис;
	КонецЕсли;

	Блокировка = ПолучитьБлокировкуСервиса(ИмяКласса);
	Блокировка.Заблокировать();

	Попытка
		Сервис = _Сервисы[ИмяКласса];
		Если Сервис = Неопределено Тогда
			Сервис = Новый(ИмяКласса, ПараметрыКонструктораСервиса(ИмяКласса));
			_Сервисы[ИмяКласса] = Сервис;
		КонецЕсли;
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Разблокировать();

	Возврат Сервис;

КонецФункции

Функция ПолучитьБлокировкуСервиса(ИмяКласса)

	// Для ссылки на блокировку действуют те же гарантии атомарной публикации .NET, что и для сервиса.
	// БлокировкаРесурса использует Monitor.Enter/Exit, которые дают acquire/release при повторной проверке.
	// Ссылка после публикации не изменяется. При отсутствии значения блокировка пула и повторная проверка
	// гарантируют создание единственного экземпляра блокировки.
	Блокировка = _БлокировкиСервисов[ИмяКласса];
	Если Блокировка <> Неопределено Тогда
		Возврат Блокировка;
	КонецЕсли;

	_БлокировкаПула.Заблокировать();

	Попытка
		Блокировка = _БлокировкиСервисов[ИмяКласса];
		Если Блокировка = Неопределено Тогда
			Блокировка = Новый БлокировкаРесурса();
			_БлокировкиСервисов[ИмяКласса] = Блокировка;
		КонецЕсли;
	Исключение
		_БлокировкаПула.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	_БлокировкаПула.Разблокировать();

	Возврат Блокировка;

КонецФункции

Функция ПараметрыКонструктораСервиса(ИмяКласса)

	Параметры = Новый Массив;

	Если ИмяКласса = "НормализаторКодовОшибок" Тогда
		Параметры.Добавить(ПроверяющийКадрыОшибок());
	ИначеЕсли ИмяКласса = "ЧитательКадраОшибки" Тогда
		Параметры.Добавить(ПроверяющийКадрыОшибок());
		Параметры.Добавить(ОписаниеФорматаКадраОшибки());
		Параметры.Добавить(РегистраторСбоевБиблиотекиОшибок());
	ИначеЕсли ИмяКласса = "ОбходчикЦепочкиОшибки" Тогда
		Параметры.Добавить(ПроверяющийКадрыОшибок());
		Параметры.Добавить(ЧитательКадраОшибки());
		Параметры.Добавить(НормализаторКодовОшибок());
		Параметры.Добавить(РегистраторСбоевБиблиотекиОшибок());
	ИначеЕсли ИмяКласса = "ФорматировщикЗначенийОшибки" Тогда
		Параметры.Добавить(РегистраторСбоевБиблиотекиОшибок());
	ИначеЕсли ИмяКласса = "ФорматировщикПредставленияОшибок" Тогда
		Параметры.Добавить(ФорматировщикЗначенийОшибки());
		Параметры.Добавить(РегистраторСбоевБиблиотекиОшибок());
	ИначеЕсли ИмяКласса = "СоздательКонвертаОшибки" Тогда
		Параметры.Добавить(ФорматировщикПредставленияОшибок());
		Параметры.Добавить(ОписаниеФорматаКадраОшибки());
		Параметры.Добавить(РегистраторСбоевБиблиотекиОшибок());
	КонецЕсли;

	Возврат Параметры;

КонецФункции

Процедура ИнициализироватьПулыСервисов()

	ИменаСервисов = "РегистраторСбоевБиблиотекиОшибок, ПроверяющийКадрыОшибок, "
		+ "ОписаниеФорматаКадраОшибки, ФормировательСообщенийОшибокАргументов, "
		+ "НормализаторКодовОшибок, ЧитательКадраОшибки, ОбходчикЦепочкиОшибки, "
		+ "ФорматировщикЗначенийОшибки, ФорматировщикПредставленияОшибок, "
		+ "СоздательКонвертаОшибки";

	_Сервисы = Новый Структура(ИменаСервисов);
	_БлокировкиСервисов = Новый Структура(ИменаСервисов);
	_БлокировкаПула = Новый БлокировкаРесурса();

КонецПроцедуры

#КонецОбласти

ИнициализироватьПулыСервисов();
