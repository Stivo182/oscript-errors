#Использовать "../src"

&Параметры(1, 10, 50)
Перем ГлубинаЦепочки Экспорт; // Число

Перем _Ошибка;      // ИнформацияОбОшибке
Перем _КодВнешнегоКадра; // Строка
Перем _КодСреднегоКадра; // Строка
Перем _КодКорневогоКадра; // Строка
Перем _ИскомыеКоды; // ФиксированныйМассив из Строка
Перем _Результат; // Произвольный

#Область ОбработчикиСобытий

// Создаёт бенчмарк разбора и поиска по цепочке ошибок.
&КоличествоИтераций(20)
&КоличествоПрогревочныхИтераций(6)
&МинимальноеВремяИтерации(250)
&МониторингПамяти
Процедура ПриСозданииОбъекта()
КонецПроцедуры

// Подготавливает цепочку ошибок заданной глубины.
//
// Параметры:
//  Контекст - Структура - Контекст выполняемого кейса бенчмарка.
&ПередКаждымКейсом
Процедура ПодготовитьЦепочку(Контекст) Экспорт

	_Ошибка = СоздатьЦепочку(ГлубинаЦепочки);
	_КодВнешнегоКадра = КодУровня(ГлубинаЦепочки);
	_КодСреднегоКадра = КодУровня(Цел((ГлубинаЦепочки + 1) / 2));
	_КодКорневогоКадра = КодУровня(1);
	_ИскомыеКоды = Новый ФиксированныйМассив(
		СтрРазделить("benchmark.missing,benchmark.level_1", ",", Ложь)
	);

КонецПроцедуры

#КонецОбласти

#Область Бенчмарки

// Измеряет полный разбор подготовленной цепочки.
&Бенчмарк
Процедура РазобратьЦепочку() Экспорт
	_Результат = ДиагностикаОшибок.Разобрать(_Ошибка);
КонецПроцедуры

// Измеряет поиск кода во внешнем кадре с ранним завершением обхода.
&Бенчмарк
Процедура НайтиКодВоВнешнемКадре() Экспорт
	_Результат = ДиагностикаОшибок.Содержит(_Ошибка, _КодВнешнегоКадра);
КонецПроцедуры

// Измеряет поиск кода в среднем кадре цепочки.
&Бенчмарк
Процедура НайтиКодВСреднемКадре() Экспорт
	_Результат = ДиагностикаОшибок.Содержит(_Ошибка, _КодСреднегоКадра);
КонецПроцедуры

// Измеряет поиск существующего кода в корневом кадре цепочки.
&Бенчмарк
Процедура НайтиКодВКорневомКадре() Экспорт
	_Результат = ДиагностикаОшибок.Содержит(_Ошибка, _КодКорневогоКадра);
КонецПроцедуры

// Измеряет поиск отсутствующего кода с полным обходом цепочки.
&Бенчмарк
Процедура НайтиОтсутствующийКод() Экспорт
	_Результат = ДиагностикаОшибок.Содержит(_Ошибка, "benchmark.missing");
КонецПроцедуры

// Измеряет поиск одного из нескольких кодов.
&Бенчмарк
Процедура НайтиЛюбойИзКодов() Экспорт
	_Результат = ДиагностикаОшибок.СодержитЛюбойИз(_Ошибка, _ИскомыеКоды);
КонецПроцедуры

// Измеряет поиск по группе машинных кодов.
&Бенчмарк
Процедура НайтиГруппуКодов() Экспорт
	_Результат = ДиагностикаОшибок.СодержитГруппу(_Ошибка, "benchmark");
КонецПроцедуры

// Измеряет возврат первого снимка с корневым кодом.
&Бенчмарк
Процедура НайтиПервыйСнимок() Экспорт
	_Результат = ДиагностикаОшибок.НайтиПервую(_Ошибка, _КодКорневогоКадра);
КонецПроцедуры

// Измеряет прежний материализованный путь как контроль.
&Бенчмарк
Процедура НайтиКодЧерезПолныйРазбор() Экспорт
	_Результат = ДиагностикаОшибок.Разобрать(_Ошибка).Ошибки().Содержит(_КодКорневогоКадра);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьЦепочку(Глубина)

	Ошибка = ФабрикаОшибок.Создать(КодУровня(1), "Ошибка уровня 1", ДанныеУровня(1));

	Для НомерУровня = 2 По Глубина Цикл
		Ошибка = ФабрикаОшибок.Обернуть(
			Ошибка,
			КодУровня(НомерУровня),
			"Ошибка уровня " + НомерУровня,
			ДанныеУровня(НомерУровня)
		);
	КонецЦикла;

	Возврат Ошибка;

КонецФункции

Функция КодУровня(НомерУровня)
	Возврат "benchmark.level_" + НомерУровня;
КонецФункции

Функция ДанныеУровня(НомерУровня)
	Возврат Новый Структура("Уровень, Операция", НомерУровня, "Обработка");
КонецФункции

#КонецОбласти
