#Использовать "../internal"

#Область ПрограммныйИнтерфейс

// Разбирает физическую цепочку ошибки.
//
// Параметры:
//  Ошибка - ИнформацияОбОшибке - Внешний кадр разбираемой цепочки.
//
// Возвращаемое значение:
//  РазборОшибки - Материализованный разбор цепочки.
Функция Разобрать(Ошибка) Экспорт

	Возврат Новый РазборОшибки(Ошибка);

КонецФункции

// Возвращает машинный код эффективной ошибки.
//
// Параметры:
//  Ошибка - ИнформацияОбОшибке - Внешний кадр разбираемой цепочки.
//
// Возвращаемое значение:
//  Строка, Неопределено - Код эффективной ошибки.
Функция КодОшибки(Ошибка) Экспорт

	Возврат Разобрать(Ошибка).КодОшибки();

КонецФункции

// Проверяет наличие ошибки с указанным машинным кодом во всей цепочке.
//
// Параметры:
//  Ошибка - ИнформацияОбОшибке - Внешний кадр разбираемой цепочки.
//  КодОшибки - Строка - Искомый машинный код.
//
// Возвращаемое значение:
//  Булево - Истина, если код найден.
Функция Содержит(Ошибка, КодОшибки) Экспорт

	Возврат ПоискВЦепочкеОшибки.НайтиПервуюПоКодам(Ошибка, КодОшибки) <> Неопределено;

КонецФункции

// Проверяет наличие ошибки хотя бы с одним из указанных машинных кодов во всей цепочке.
//
// Параметры:
//  Ошибка - ИнформацияОбОшибке - Внешний кадр разбираемой цепочки.
//  КодыОшибок - Строка, Массив из Строка, ФиксированныйМассив из Строка - Искомые машинные коды.
//
// Возвращаемое значение:
//  Булево - Истина, если найден хотя бы один код.
Функция СодержитЛюбойИз(Ошибка, КодыОшибок) Экспорт

	Возврат ПоискВЦепочкеОшибки.НайтиПервуюПоКодам(Ошибка, КодыОшибок) <> Неопределено;

КонецФункции

// Проверяет наличие ошибки из указанной группы во всей цепочке.
//
// Параметры:
//  Ошибка - ИнформацияОбОшибке - Внешний кадр разбираемой цепочки.
//  ГруппаОшибок - Строка - Один или несколько начальных сегментов машинного кода.
//
// Возвращаемое значение:
//  Булево - Истина, если найдена ошибка из группы.
Функция СодержитГруппу(Ошибка, ГруппаОшибок) Экспорт

	Возврат ПоискВЦепочкеОшибки.НайтиПервуюПоГруппе(Ошибка, ГруппаОшибок) <> Неопределено;

КонецФункции

// Возвращает первую ошибку с указанным машинным кодом при обходе от внешнего кадра к причине.
//
// Параметры:
//  Ошибка - ИнформацияОбОшибке - Внешний кадр разбираемой цепочки.
//  КодОшибки - Строка - Искомый машинный код.
//
// Возвращаемое значение:
//  СнимокКадраОшибки, Неопределено - Найденная ошибка или Неопределено, если код отсутствует.
Функция НайтиПервую(Ошибка, КодОшибки) Экспорт

	Кадр = ПоискВЦепочкеОшибки.НайтиПервуюПоКодам(Ошибка, КодОшибки);
	Если Кадр = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Новый СнимокКадраОшибки(Кадр);

КонецФункции

// Возвращает краткое человекочитаемое представление ошибки.
//
// Параметры:
//  Ошибка - ИнформацияОбОшибке - Внешний кадр разбираемой цепочки.
//
// Возвращаемое значение:
//  Строка - Краткое представление ошибки.
Функция КраткоеПредставление(Ошибка) Экспорт

	Возврат Разобрать(Ошибка).КраткоеПредставление();

КонецФункции

// Возвращает подробное пользовательское представление ошибки.
//
// Параметры:
//  Ошибка - ИнформацияОбОшибке - Внешний кадр разбираемой цепочки.
//
// Возвращаемое значение:
//  Строка - Пользовательское представление ошибки.
Функция ПользовательскоеПредставление(Ошибка) Экспорт

	Возврат Разобрать(Ошибка).ПользовательскоеПредставление();

КонецФункции

// Возвращает полный диагностический отчёт со стеком и данными ошибки.
//
// Параметры:
//  Ошибка - ИнформацияОбОшибке - Внешний кадр разбираемой цепочки.
//
// Возвращаемое значение:
//  Строка - Диагностическое представление ошибки.
Функция ДиагностическоеПредставление(Ошибка) Экспорт

	Возврат Разобрать(Ошибка).ДиагностическоеПредставление();

КонецФункции

#КонецОбласти
