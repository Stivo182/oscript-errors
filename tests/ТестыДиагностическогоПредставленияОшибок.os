&Тест
Процедура ТестДолжен_СохранитьПорядокВсехПолейИСтекВнешнегоКонтекста() Экспорт

	// Подготовка
	СтекКонтекста = Новый Массив;
	СтекКонтекста.Добавить("ЗапуститьПриложение:5");
	СтекОшибки = Новый Массив;
	СтекОшибки.Добавить("ЗагрузитьНастройки:42");
	Снимки = Новый Массив;
	Снимки.Добавить(Новый ТестовыйСнимокКадраОшибки(
		Новый Структура(
			"Вид, Сообщение, Данные, ИмяМодуля, НомерСтроки, ИсходнаяСтрока, Стек",
			ВидыКадровОшибок.Контекст(),
			"Запуск" + Символы.ПС + "приложения",
			Новый Структура("Команда", "start"),
			"Приложение.os",
			5,
			"ЗапуститьПриложение();",
			СтекКонтекста
		)
	));
	Снимки.Добавить(Новый ТестовыйСнимокКадраОшибки(
		Новый Структура(
			"Вид, КодОшибки, Сообщение, Данные, Подсказка, ИмяМодуля, НомерСтроки, ИсходнаяСтрока, Стек",
			ВидыКадровОшибок.Ошибка(),
			"config.failed",
			"Не удалось загрузить настройки",
			Новый Структура("Файл", "settings.json"),
			"Проверьте наличие файла",
			"Настройки.os",
			42,
			"ПрочитатьНастройки();" + Символы.ПС + "ОбработатьРезультат();",
			СтекОшибки
		)
	));

	// Действие
	Представление = ФорматированиеПредставленияОшибок.ДиагностическоеПредставление(Снимки, Ложь);

	// Проверка
	Ожидаем.Что(Представление).Равно("config.failed: Не удалось загрузить настройки
	|
	|Контекст:
	|  Запуск
	|  приложения
	|  Данные:
	|    Команда: start
	|  Место: Приложение.os:5
	|
	|Данные:
	|  Файл: settings.json
	|Место: Настройки.os:42
	|
	|Подсказка:
	|  Проверьте наличие файла
	|
	|Стек вызовов:
	|  ЗапуститьПриложение:5");

