#Использовать asserts
#Использовать "../src"

#Область Тесты

&Тест
Процедура ТестДолжен_ПропуститьКорректныеАргументы() Экспорт

	// Действие
	ПроверкаАргументов.ПроверитьТип("Имя", "Значение", Тип("Строка"));
	ПроверкаАргументов.ПроверитьЗаполненность("Имя", "Значение");
	ПроверкаАргументов.ПроверитьДопустимость("Количество", 2 > 1, "быть больше единицы");

	// Проверка
	Ожидаем.Что(Истина).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьОшибкуНеверногоТипаСоСтандартнымСообщением() Экспорт

	// Подготовка
	Ошибка = ОшибкаПриПроверкеТипа("Имя", 42, Тип("Строка"));

	// Действие
	Снимок = Новый СнимокКадраОшибки(Ошибка);

	// Проверка
	Ожидаем.Что(Снимок.ТипОшибки()).Равно("argument.invalid_type");
	Ожидаем.Что(Снимок.Данные().ИмяАргумента).Равно("Имя");
	Ожидаем.Что(Снимок.Данные().ОжидаемыйТип).Равно(Строка(Тип("Строка")));
	Ожидаем.Что(Снимок.Данные().ФактическийТип).Равно(Строка(Тип("Число")));
	Ожидаем.Что(Снимок.Данные().Свойство("ФактическоеЗначение")).ЭтоЛожь();
	Ожидаем.Что(Снимок.Сообщение()).Равно(
		СтандартноеСообщениеНеверногоТипа("Имя", Строка(Тип("Строка")))
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьОшибкуНезаполненногоАргументаСоСтандартнымСообщением() Экспорт

	// Подготовка
	Ошибка = ОшибкаПриПроверкеЗаполненности("Имя", "");

	// Действие
	Снимок = Новый СнимокКадраОшибки(Ошибка);

	// Проверка
	Ожидаем.Что(Снимок.ТипОшибки()).Равно("argument.required");
	Ожидаем.Что(Снимок.Данные().ИмяАргумента).Равно("Имя");
	Ожидаем.Что(Снимок.Данные().Количество()).Равно(1);
	Ожидаем.Что(Снимок.Сообщение()).Равно(СтандартноеСообщениеНезаполненногоАргумента("Имя"));

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьОшибкуНедопустимогоЗначенияИСохранитьСообщение() Экспорт

	// Подготовка
	ОшибкаПоУмолчанию = ОшибкаПриПроверкеДопустимости("Количество", Ложь, "быть больше нуля");
	ОшибкаСПользовательскимСообщением = ОшибкаПриПроверкеДопустимости(
		"Количество",
		Ложь,
		"быть больше нуля",
		"Количество должно быть положительным"
	);

	// Действие
	СнимокПоУмолчанию = Новый СнимокКадраОшибки(ОшибкаПоУмолчанию);
	СнимокСПользовательскимСообщением = Новый СнимокКадраОшибки(ОшибкаСПользовательскимСообщением);

	// Проверка
	Ожидаем.Что(СнимокПоУмолчанию.ТипОшибки()).Равно("argument.invalid_value");
	Ожидаем.Что(СнимокПоУмолчанию.Данные().ИмяАргумента).Равно("Количество");
	Ожидаем.Что(СнимокПоУмолчанию.Данные().Ожидание).Равно("быть больше нуля");
	Ожидаем.Что(СнимокПоУмолчанию.Данные().Количество()).Равно(2);
	Ожидаем.Что(СнимокПоУмолчанию.Сообщение()).Равно(
		СтандартноеСообщениеНедопустимогоЗначения("Количество", "быть больше нуля")
	);
	Ожидаем.Что(СнимокСПользовательскимСообщением.Сообщение()).Равно(
		"Количество должно быть положительным"
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СчитатьЗаполненнымЗначениеБезСтандартнойСемантикиЗаполненности() Экспорт

	// Действие
	ПроверкаАргументов.ПроверитьЗаполненность("Данные", Тип("Строка"));

	// Проверка
	Ожидаем.Что(Истина).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПроверитьСобственныеПараметрыПубличныхПроцедур() Экспорт

	// Подготовка
	ОшибкаИмени = ОшибкаПриПроверкеТипа(42, "Значение", Тип("Строка"));
	ОшибкаПустогоИмени = ОшибкаПриПроверкеЗаполненности("", "Значение");
	ОшибкаОжидаемогоТипа = ОшибкаПриПроверкеТипа("Имя", "Значение", "Строка");
	ОшибкаСообщения = ОшибкаПриПроверкеЗаполненности("Имя", "Значение", 42);
	ОшибкаУсловия = ОшибкаПриПроверкеДопустимости("Имя", "Да", "быть истинным");
	ОшибкаОжидания = ОшибкаПриПроверкеДопустимости("Имя", Истина, "");

	// Действие
	СнимокИмени = Новый СнимокКадраОшибки(ОшибкаИмени);
	СнимокПустогоИмени = Новый СнимокКадраОшибки(ОшибкаПустогоИмени);
	СнимокОжидаемогоТипа = Новый СнимокКадраОшибки(ОшибкаОжидаемогоТипа);
	СнимокСообщения = Новый СнимокКадраОшибки(ОшибкаСообщения);
	СнимокУсловия = Новый СнимокКадраОшибки(ОшибкаУсловия);
	СнимокОжидания = Новый СнимокКадраОшибки(ОшибкаОжидания);

	// Проверка
	Ожидаем.Что(СнимокИмени.ТипОшибки()).Равно("argument.invalid_type");
	Ожидаем.Что(СнимокИмени.Данные().ИмяАргумента).Равно("ИмяАргумента");
	Ожидаем.Что(СнимокПустогоИмени.ТипОшибки()).Равно("argument.required");
	Ожидаем.Что(СнимокПустогоИмени.Данные().ИмяАргумента).Равно("ИмяАргумента");
	Ожидаем.Что(СнимокОжидаемогоТипа.ТипОшибки()).Равно("argument.invalid_type");
	Ожидаем.Что(СнимокОжидаемогоТипа.Данные().ИмяАргумента).Равно("ОжидаемыйТип");
	Ожидаем.Что(СнимокСообщения.ТипОшибки()).Равно("argument.invalid_type");
	Ожидаем.Что(СнимокСообщения.Данные().ИмяАргумента).Равно("Сообщение");
	Ожидаем.Что(СнимокУсловия.ТипОшибки()).Равно("argument.invalid_type");
	Ожидаем.Что(СнимокУсловия.Данные().ИмяАргумента).Равно("Условие");
	Ожидаем.Что(СнимокОжидания.ТипОшибки()).Равно("argument.required");
	Ожидаем.Что(СнимокОжидания.Данные().ИмяАргумента).Равно("Ожидание");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ИсключитьПроверкуАргументовИзМестаИСтека() Экспорт

	// Подготовка
	Ошибка = ОшибкаПриПроверкеТипа("Порт", "8080", Тип("Число"));

	// Действие
	Снимок = Новый СнимокКадраОшибки(Ошибка);
	Стек = Снимок.Стек();

	// Проверка
	Ожидаем.Что(Снимок.ИмяМодуля()).Содержит("ТестыПроверкиАргументов.os");
	Ожидаем.Что(Стек.Количество() > 0).ЭтоИстина();
	Ожидаем.Что(Снимок.ИмяМодуля()).Равно(Стек[0].ИмяМодуля);
	Ожидаем.Что(Снимок.НомерСтроки()).Равно(Стек[0].НомерСтроки);
	Ожидаем.Что(Снимок.ИсходнаяСтрока()).Равно("");
	Ожидаем.Что(Строка(Стек[0])).ЭтоНе().Содержит("ПроверкаАргументов.os");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ИсключитьВнутренниеКадрыПриПроверкеФабрики() Экспорт

	// Подготовка
	Ошибка = ОшибкаПриПроверкеФабрики();

	// Действие
	Снимок = Новый СнимокКадраОшибки(Ошибка);
	Стек = Снимок.Стек();

	// Проверка
	Ожидаем.Что(Снимок.ИмяМодуля()).Содержит("ТестыПроверкиАргументов.os");
	Ожидаем.Что(Стек.Количество() > 0).ЭтоИстина();
	Ожидаем.Что(Строка(Стек[0])).ЭтоНе().Содержит("ПроверкаАргументов.os");
	Ожидаем.Что(Строка(Стек[0])).ЭтоНе().Содержит("ПроверкаКадровОшибок.os");
	Ожидаем.Что(Строка(Стек[0])).ЭтоНе().Содержит("ФабрикаОшибок.os");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ИсключитьПроверкуАргументовИзПодробногоПредставления() Экспорт

	// Подготовка
	Ошибка = ОшибкаПриПроверкеТипа("Порт", "8080", Тип("Число"));

	// Действие
	Представление = (Новый ИсследовательОшибки(Ошибка)).ПодробноеПредставление();

	// Проверка
	Ожидаем.Что(Представление).Содержит("ТестыПроверкиАргументов.os");
	Ожидаем.Что(Представление).ЭтоНе().Содержит("ПроверкаАргументов.os");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОшибкаПриПроверкеТипа(ИмяАргумента, Значение, ОжидаемыйТип, Сообщение = "")

	Попытка
		ПроверкаАргументов.ПроверитьТип(ИмяАргумента, Значение, ОжидаемыйТип, Сообщение);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидалось исключение проверки типа";

КонецФункции

Функция ОшибкаПриПроверкеЗаполненности(ИмяАргумента, Значение, Сообщение = "")

	Попытка
		ПроверкаАргументов.ПроверитьЗаполненность(ИмяАргумента, Значение, Сообщение);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидалось исключение проверки заполненности";

КонецФункции

Функция ОшибкаПриПроверкеДопустимости(ИмяАргумента, Условие, Ожидание, Сообщение = "")

	Попытка
		ПроверкаАргументов.ПроверитьДопустимость(ИмяАргумента, Условие, Ожидание, Сообщение);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидалось исключение проверки допустимости";

КонецФункции

Функция ОшибкаПриПроверкеФабрики()

	Попытка
		ФабрикаОшибок.Создать(42, "Сообщение");
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидалось исключение проверки фабрики";

КонецФункции

Функция СтандартноеСообщениеНеверногоТипа(ИмяАргумента, ОжидаемыйТип)

	Возврат СтрШаблон(
		НСтр("ru = 'Аргумент %1 должен иметь тип %2'; en = 'Argument %1 must be of type %2'"),
		ИмяАргумента,
		ОжидаемыйТип
	);

КонецФункции

Функция СтандартноеСообщениеНезаполненногоАргумента(ИмяАргумента)

	Возврат СтрШаблон(
		НСтр("ru = 'Аргумент %1 должен быть заполнен'; en = 'Argument %1 is required'"),
		ИмяАргумента
	);

КонецФункции

Функция СтандартноеСообщениеНедопустимогоЗначения(ИмяАргумента, Ожидание)

	Возврат СтрШаблон(
		НСтр(
			"ru = 'Аргумент %1 имеет недопустимое значение: ожидается %2';"
			+ "en = 'Argument %1 has an invalid value: expected %2'"
		),
		ИмяАргумента,
		Ожидание
	);

КонецФункции

#КонецОбласти
