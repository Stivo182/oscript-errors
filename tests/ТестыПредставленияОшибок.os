&Тест
Процедура ТестДолжен_ПредставитьНесколькоКонтекстовВФизическомПорядке() Экспорт

	// Подготовка
	Ошибка = ФабрикаОшибок.Создать("core.failed", "Операция завершилась ошибкой");
	Ошибка = ФабрикаОшибок.СКонтекстом(
		Ошибка,
		"Чтение файла",
		Новый Структура("Путь", "settings.json")
	);
	Ошибка = ФабрикаОшибок.СКонтекстом(
		Ошибка,
		"Загрузка настроек",
		Новый Структура("Попытка", 2)
	);

	// Действие
	Краткое = ДиагностикаОшибок.КраткоеПредставление(Ошибка);
	Подробное = ДиагностикаОшибок.ПодробноеПредставление(Ошибка);

	// Проверка
	Ожидаем.Что(Краткое).Равно(
		"core.failed: Загрузка настроек -> Чтение файла -> Операция завершилась ошибкой"
	);
	Ожидаем.Что(Подробное).Равно("core.failed: Операция завершилась ошибкой
	|
	|Контекст:
	|  - Загрузка настроек
	|    Данные:
	|      Попытка: 2
	|  - Чтение файла
	|    Данные:
	|      Путь: settings.json");

КонецПроцедуры

