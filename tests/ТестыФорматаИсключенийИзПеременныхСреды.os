	// Действие
	Ошибка = Новый ПостроительОшибки("config.invalid", "Ошибка конфигурации")
		.Подсказка("Проверьте файл")
		.Построить();

	// Проверка
	Ожидаем.Что(Ошибка.Описание).Равно(
		"config.invalid: Ошибка конфигурации
		|
		|Подсказка:
		|  Проверьте файл"
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПропуститьОтсутствующийРаздел() Экспорт

	// Подготовка
	УстановитьПеременнуюСреды("ONESCRIPT_ERRORS_FORMAT", "sections");
	УстановитьПеременнуюСреды("ONESCRIPT_ERRORS_SECTIONS", "urls,current");

	// Действие
	Ошибка = ФабрикаОшибок.Создать("config.invalid", "Ошибка конфигурации");

	// Проверка
	Ожидаем.Что(Ошибка.Описание).Равно("config.invalid: Ошибка конфигурации");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьСсылкиИЯвныеПредставленияВДиагностическомФормате() Экспорт

	// Подготовка
	УстановитьПеременнуюСреды("ONESCRIPT_ERRORS_FORMAT", "user");
	Причина = ФабрикаОшибок.Создать("storage.read_failed", "Не удалось прочитать файл");
	Данные = Новый Структура("Формат", "JSON");
	Образец = Новый ПостроительОшибки("config.invalid", "Ошибка конфигурации")
		.ПроизвольныеДанные(Данные)
		.Причина(Причина)
		.Построить();
	УстановитьПеременнуюСреды("ONESCRIPT_ERRORS_FORMAT", "diagnostic");

	// Действие
	Ошибка = Новый ПостроительОшибки("config.invalid", "Ошибка конфигурации")
		.ПроизвольныеДанные(Данные)
		.Причина(Причина)
		.Построить();
	РазборОбразца = ДиагностикаОшибок.Разобрать(Образец);
	РазборОшибки = ДиагностикаОшибок.Разобрать(Ошибка);

	// Проверка
	Ожидаем.Что(Ошибка.Параметры.Данные).Равно(Данные);
	Ожидаем.Что(Ошибка.Причина).Равно(Причина);
	Ожидаем.Что(РазборОшибки.КраткоеПредставление()).Равно(РазборОбразца.КраткоеПредставление());
	Ожидаем.Что(РазборОшибки.ПользовательскоеПредставление()).Равно(РазборОбразца.ПользовательскоеПредставление());
	Ожидаем.Что(РазборОшибки.ДиагностическоеПредставление()).Равно(РазборОбразца.ДиагностическоеПредставление());

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПрименитьДиагностическийФорматВФабрикеИПроверкеАргументов() Экспорт

	// Подготовка
	УстановитьПеременнуюСреды("ONESCRIPT_ERRORS_FORMAT", "diagnostic");
	Данные = Новый Структура("Формат", "JSON");

	// Действие
	ОшибкаФабрики = ФабрикаОшибок.Создать("config.invalid", "Ошибка конфигурации", Данные);
	Попытка
		ПроверкаАргументов.ПроверитьТип("Значение", 42, Тип("Строка"));
	Исключение
		ОшибкаПроверки = ИнформацияОбОшибке();
	КонецПопытки;

	// Проверка
	Ожидаем.Что(ОшибкаФабрики.Описание).Содержит("Данные:");
	Ожидаем.Что(ОшибкаПроверки.Описание).Содержит("Данные:");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗаписатьНекорректныйФорматВОтладочныйЛог() Экспорт

	// Подготовка
	_СообщенияЛога = Новый Массив;
	_Лог = Логирование.ПолучитьЛог("oscript.lib.errors");
	_ИсходныйУровеньЛога = _Лог.Уровень();
	_Лог.УстановитьУровень(УровниЛога.Отладка);
	_Лог.ДобавитьСпособВывода(ЭтотОбъект, УровниЛога.Отладка);
	УстановитьПеременнуюСреды("ONESCRIPT_ERRORS_FORMAT", "unknown");

	// Действие
	Ошибка = ФабрикаОшибок.Создать("config.invalid", "Ошибка конфигурации");

	// Проверка
	Ожидаем.Что(Ошибка.Описание).Равно("config.invalid: Ошибка конфигурации");
	Ожидаем.Что(_СообщенияЛога).ИмеетДлину(1);
	Ожидаем.Что(_СообщенияЛога[0]).Содержит("errors.configuration.invalid");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПоказатьОграничениеРазделаСтекаПриСозданииОшибки() Экспорт

	// Подготовка
	УстановитьПеременнуюСреды("ONESCRIPT_ERRORS_FORMAT", "sections");
	УстановитьПеременнуюСреды("ONESCRIPT_ERRORS_SECTIONS", "stack");
	Ошибка = ФабрикаОшибок.Создать("config.invalid", "Ошибка конфигурации");

	// Действие
	Попытка
		ВызватьИсключение Ошибка;
	Исключение
		ПерехваченнаяОшибка = ИнформацияОбОшибке();
	КонецПопытки;
	ДиагностическоеПредставление = ДиагностикаОшибок.Разобрать(ПерехваченнаяОшибка)
		.ДиагностическоеПредставление();

	// Проверка
	Ожидаем.Что(Ошибка.Описание).Равно("");
	Ожидаем.Что(ПерехваченнаяОшибка.Описание).Равно("");
	Ожидаем.Что(ПерехваченнаяОшибка.ПолучитьСтекВызовов().Количество()).Больше(0);
	Ожидаем.Что(ДиагностическоеПредставление).Содержит("Стек вызовов:");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ВосстановитьПеременныеСреды(Формат, Разделы)

	УстановитьПеременнуюСреды("ONESCRIPT_ERRORS_FORMAT", Формат);
	УстановитьПеременнуюСреды("ONESCRIPT_ERRORS_SECTIONS", Разделы);

КонецПроцедуры

// Принимает сообщения тестового способа вывода logos.
Процедура Вывести(Сообщение, УровеньСообщения) Экспорт

	_СообщенияЛога.Добавить(Сообщение);

КонецПроцедуры

// Закрывает тестовый способ вывода logos.
Процедура Закрыть() Экспорт
КонецПроцедуры

#КонецОбласти
