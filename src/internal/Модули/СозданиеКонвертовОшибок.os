#Область СлужебныйПрограммныйИнтерфейс

// Создаёт конверт классифицированной ошибки из предварительно подготовленных полей.
// Вызывающая сторона отвечает за корректность переданных значений.
//
// Параметры:
//  Описание - Строка - Итоговое представление ошибки.
//  КодОшибки - Строка - Стабильный машинный код ошибки.
//  Сообщение - Строка - Человекочитаемое описание ошибки.
//  Данные - Произвольный, Неопределено - Связанные с ошибкой данные.
//  Подсказка - Строка - Подсказка по исправлению ошибки.
//  URL - Строка - Адрес страницы с дополнительной информацией.
//  Причина - ИнформацияОбОшибке, Неопределено - Непосредственная причина ошибки.
//
// Возвращаемое значение:
//  ИнформацияОбОшибке - Новый кадр классифицированной ошибки.
Функция СоздатьОшибку(
	Описание,
	КодОшибки,
	Сообщение,
	Данные = Неопределено,
	Подсказка = "",
	URL = "",
	Причина = Неопределено
) Экспорт

	Поля = НовыеПоляКадра(ВидыКадровОшибок.Ошибка(), КодОшибки, Сообщение);
	Поля.Вставить("Данные", Данные);
	Поля.Вставить("Подсказка", Подсказка);
	Поля.Вставить("URL", URL);
	Поля.Вставить("КодЭффективнойОшибки", КодОшибки);
	Поля.Вставить("СообщениеЭффективнойОшибки", Сообщение);

	Возврат СоздатьКонверт(Описание, Поля, Причина);

КонецФункции

// Создаёт конверт контекста ошибки из предварительно подготовленных полей.
// Вызывающая сторона отвечает за корректность переданных значений.
//
// Параметры:
//  Описание - Строка - Итоговое представление контекста.
//  Сообщение - Строка - Человекочитаемое описание контекста.
//  Причина - ИнформацияОбОшибке - Непосредственная причина ошибки.
//  Данные - Произвольный, Неопределено - Связанные с контекстом данные.
//  КодЭффективнойОшибки - Строка, Неопределено - Эффективный код цепочки ошибок.
//  СообщениеЭффективнойОшибки - Строка - Эффективное сообщение цепочки ошибок.
//
// Возвращаемое значение:
//  ИнформацияОбОшибке - Новый контекстный кадр ошибки.
Функция СоздатьКонтекст(
	Описание,
	Сообщение,
	Причина,
	Данные = Неопределено,
	КодЭффективнойОшибки = Неопределено,
	СообщениеЭффективнойОшибки = ""
) Экспорт

	Поля = НовыеПоляКадра(ВидыКадровОшибок.Контекст(), Неопределено, Сообщение);
	Поля.Вставить("Данные", Данные);
	Поля.Вставить("Подсказка", "");
	Поля.Вставить("URL", "");
	Поля.Вставить("КодЭффективнойОшибки", КодЭффективнойОшибки);
	Поля.Вставить("СообщениеЭффективнойОшибки", СообщениеЭффективнойОшибки);

	Возврат СоздатьКонверт(Описание, Поля, Причина);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НовыеПоляКадра(Вид, КодОшибки, Сообщение)

	Поля = Новый Структура;
	Поля.Вставить("Маркер", ФорматКадраОшибки.МаркерМетаданных());
	Поля.Вставить("ВерсияФормата", ФорматКадраОшибки.ВерсияФормата());
	Поля.Вставить("Вид", Вид);
	Поля.Вставить("КодОшибки", КодОшибки);
	Поля.Вставить("Сообщение", Сообщение);

	Возврат Поля;

КонецФункции

Функция СоздатьКонверт(Описание, Поля, Причина)

	МетаданныеКадра = Новый ФиксированнаяСтруктура(Поля);
	Если Причина = Неопределено Тогда
		Возврат Новый ИнформацияОбОшибке(Описание, МетаданныеКадра);
	КонецЕсли;

	Возврат Новый ИнформацияОбОшибке(Описание, МетаданныеКадра, Причина);

КонецФункции

#КонецОбласти
