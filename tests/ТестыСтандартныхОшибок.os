	Ошибки.Добавить(СтандартныеОшибки.ТребуетсяАутентификация("application.json"));
	Ошибки.Добавить(СтандартныеОшибки.ДоступЗапрещен("application.json"));
	Ошибки.Добавить(СтандартныеОшибки.РесурсНеНайден("application.json"));
	Ошибки.Добавить(СтандартныеОшибки.РесурсУжеСуществует("application.json"));
	Ошибки.Добавить(СтандартныеОшибки.РесурсУжеИспользуется("application.json"));
	Ошибки.Добавить(СтандартныеОшибки.РесурсЗакрыт("application.json"));
	Ошибки.Добавить(СтандартныеОшибки.РесурсИсчерпан("пул"));
	Ошибки.Добавить(СтандартныеОшибки.КвотаРесурсаПревышена("хранилище"));
	Ошибки.Добавить(СтандартныеОшибки.РесурсНеПуст("каталог"));
	Ошибки.Добавить(СтандартныеОшибки.ЗависимостьНедоступна("Сервис оплаты"));
	Ошибки.Добавить(СтандартныеОшибки.СоединениеОтклонено("db.example.org"));
	Ошибки.Добавить(СтандартныеОшибки.СоединениеСброшено("db.example.org"));
	Ошибки.Добавить(СтандартныеОшибки.СоединениеПрервано("db.example.org"));
	Ошибки.Добавить(СтандартныеОшибки.СоединениеНеУстановлено("db.example.org"));
