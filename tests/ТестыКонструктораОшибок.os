		ОшибкаКадра = Новый КонструкторОшибки("http.proxy_error", "Ошибка прокси", ВидыКадровОшибок.Контекст())
			.Причина(Причина)
			.Построить();
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;

	// Проверка
	ПроверитьКонтрактноеИсключение(
		Ошибка,
		"argument.invalid_value",
		"КодОшибки",
		"Неопределено"
	);

КонецПроцедуры

