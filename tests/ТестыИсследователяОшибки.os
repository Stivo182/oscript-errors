#Область Тесты

&Тест
Процедура ТестДолжен_ИсследоватьСмешаннуюЦепочку() Экспорт

	// Подготовка
	Цепочка = СмешаннаяЦепочка();

	// Действие
	Исследователь = Новый ИсследовательОшибки(Цепочка.Ошибка);

	// Проверка
	Ожидаем.Что(Исследователь.Кадры().Количество()).Равно(4);
	Ожидаем.Что(Исследователь.Ошибки().Количество()).Равно(2);
	Ожидаем.Что(Исследователь.Контексты().Количество()).Равно(1);
	Ожидаем.Что(Исследователь.ЭффективнаяОшибка().ИсходнаяОшибка()).Равно(Цепочка.ЭффективнаяОшибка);
	Ожидаем.Что(Исследователь.КодОшибки()).Равно("config.load_failed");
	Ожидаем.Что(Исследователь.Данные()).Равно(Цепочка.ДанныеЭффективнойОшибки);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПройтиВнешниеКадрыДоМеждуИПослеСобственных() Экспорт

	// Подготовка
	ВнешнийКорень = ПомощникТестированияОшибок.ВнешняяОшибка("Внешний корень");
	СобственнаяОшибка = ФабрикаОшибок.Обернуть(
		ВнешнийКорень,
		"service.unavailable",
		"Сервис недоступен"
	);
	ВнешняяСередина = ПомощникТестированияОшибок.ВнешняяОшибка("Служебная обёртка", СобственнаяОшибка);
	Контекст = ФабрикаОшибок.СКонтекстом(ВнешняяСередина, "Вызов сервиса");
	ВнешняяОшибка = ПомощникТестированияОшибок.ВнешняяОшибка("Async", Контекст);

	// Действие
	Исследователь = Новый ИсследовательОшибки(ВнешняяОшибка);

	// Проверка
	Ожидаем.Что(Исследователь.Кадры().Количество()).Равно(5);
	Ожидаем.Что(Исследователь.КодОшибки()).Равно("service.unavailable");
	Ожидаем.Что(Исследователь.Контексты()[0].ИсходнаяОшибка()).Равно(Контекст);
	Ожидаем.Что(Исследователь.КорневаяПричина().ИсходнаяОшибка()).Равно(ВнешнийКорень);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НайтиСобственныйКадрПослеПовторногоВыброса() Экспорт

	// Подготовка
	ИсходнаяОшибка = ФабрикаОшибок.Создать("storage.read_failed", "Ошибка чтения");
	ПовторноВыброшеннаяОшибка = ПомощникТестированияОшибок.ПовторноВыброшеннаяОшибка(ИсходнаяОшибка);

	// Действие
	Исследователь = Новый ИсследовательОшибки(ПовторноВыброшеннаяОшибка);

	// Проверка
	Ожидаем.Что(Исследователь.ЕстьОшибка("storage.read_failed")).Равно(Истина);
	Ожидаем.Что(Исследователь.НайтиОшибку(
		"storage.read_failed"
	).ИсходнаяОшибка()).Равно(ПовторноВыброшеннаяОшибка);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПройтиЧужойИПоврежденныйКонвертыДоСобственнойОшибки() Экспорт

	// Подготовка
	ВнутренняяОшибка = ФабрикаОшибок.Создать("core.failed", "Корневая ошибка");
	Образец = ФабрикаОшибок.Создать("sample.error", "Образец");
	ЧужойМаркер = ПомощникТестированияОшибок.ОшибкаСЧужимМаркером(Образец, ВнутренняяОшибка);
	ПоврежденныйКонверт = ПомощникТестированияОшибок.ОшибкаСПоврежденнымКонвертом(Образец, ЧужойМаркер);

	// Действие
	Исследователь = Новый ИсследовательОшибки(ПоврежденныйКонверт);

	// Проверка
	Ожидаем.Что(Исследователь.Кадры().Количество()).Равно(3);
	Ожидаем.Что(Исследователь.КодОшибки()).Равно("core.failed");
	Ожидаем.Что(Исследователь.ЕстьОшибка("foreign.hidden_error")).Равно(Ложь);
	Ожидаем.Что(Исследователь.Контексты().Количество()).Равно(0);
	Ожидаем.Что(Исследователь.КорневаяПричина().ИсходнаяОшибка()).Равно(ВнутренняяОшибка);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьПервуюПодсказкуВЦепочке() Экспорт

	// Подготовка
	Причина = КонструкторыОшибок.Создать("network.timeout", "Таймаут")
		.Подсказка("Повторите позднее")
		.Построить();
	Ошибка = ФабрикаОшибок.Обернуть(Причина, "service.failed", "Сервис недоступен");

	// Действие
	Исследователь = Новый ИсследовательОшибки(Ошибка);

	// Проверка
	Ожидаем.Что(Исследователь.Подсказка()).Равно("Повторите позднее");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьПервыйURLВЦепочке() Экспорт

	// Подготовка
	Причина = КонструкторыОшибок.Создать("network.timeout", "Таймаут")
		.URL("https://example.org/errors/network-timeout")
		.Построить();
	Ошибка = КонструкторыОшибок.Обернуть(Причина, "service.failed", "Сервис недоступен")
		.URL("https://example.org/errors/service-failed")
		.Построить();

	// Действие
	URL = (Новый ИсследовательОшибки(Ошибка)).URL();

	// Проверка
	Ожидаем.Что(URL).Равно("https://example.org/errors/service-failed");

