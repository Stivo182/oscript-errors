#Использовать errors

Ошибки = Новый Массив;
Ошибки.Добавить(ФабрикаОшибок.ОперацияНедоступна("Синхронизация"));
Ошибки.Добавить(ФабрикаОшибок.РесурсНеНайден("Настройки приложения"));
Ошибки.Добавить(ФабрикаОшибок.ИстеклоВремяОжиданияСоединения("Сервис оплаты"));
Ошибки.Добавить(ФабрикаОшибок.ДанныеПовреждены("Кэш справочника"));
Ошибки.Добавить(ФабрикаОшибок.КодировкаНеПоддерживается("UTF-7"));
Ошибки.Добавить(ФабрикаОшибок.НарушенВнутреннийИнвариант("Состояние задачи согласовано"));

Для Каждого Ошибка Из Ошибки Цикл
	Снимок = Новый СнимокКадраОшибки(Ошибка);
	Сообщить(Снимок.КодОшибки() + ": " + Снимок.Сообщение());
КонецЦикла;
