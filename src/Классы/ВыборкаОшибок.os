#Использовать "../internal"

Перем _Снимки; // Массив из СнимокКадраОшибки
Перем _НормализаторКодовОшибок; // НормализаторКодовОшибок, Неопределено

#Область ОбработчикиСобытий

// Создаёт неизменяемую выборку классифицированных ошибок.
//
// Параметры:
//  Снимки - Массив из СнимокКадраОшибки - Кадры ошибок в физическом порядке.
Процедура ПриСозданииОбъекта(Снимки)

	ПроверкаАргументов.ПроверитьТип(
		"Снимки",
		Снимки,
		Тип("Массив")
	);

	_Снимки = Новый Массив;
	_НормализаторКодовОшибок = Неопределено;

	Для Каждого Снимок Из Снимки Цикл

		ДопустимыйСнимок = ТипЗнч(Снимок) = Тип("СнимокКадраОшибки");
		Если ДопустимыйСнимок Тогда
			ДопустимыйСнимок = Снимок.Вид() = ВидыКадровОшибок.Ошибка();
		КонецЕсли;

		ПроверкаАргументов.ПроверитьДопустимость(
			"Снимки",
			ДопустимыйСнимок,
			"содержать только снимки кадров ошибок"
		);

		_Снимки.Добавить(Снимок);

	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Возвращает все снимки выборки.
//
// Возвращаемое значение:
//  Массив из СнимокКадраОшибки - Независимая копия снимков в физическом порядке.
Функция Снимки() Экспорт

	Возврат КопияМассива(_Снимки);

КонецФункции

// Возвращает первый снимок выборки.
//
// Возвращаемое значение:
//  СнимокКадраОшибки, Неопределено - Первый снимок или Неопределено для пустой выборки.
Функция Первая() Экспорт

	Если _Снимки.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат _Снимки[0];

КонецФункции

// Возвращает последний снимок выборки.
//
// Возвращаемое значение:
//  СнимокКадраОшибки, Неопределено - Последний снимок или Неопределено для пустой выборки.
Функция Последняя() Экспорт

	Если _Снимки.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат _Снимки[_Снимки.ВГраница()];

КонецФункции

// Возвращает количество ошибок в выборке.
//
// Возвращаемое значение:
//  Число - Количество снимков.
Функция Количество() Экспорт

	Возврат _Снимки.Количество();

КонецФункции

// Проверяет наличие ошибок в выборке.
//
// Возвращаемое значение:
//  Булево - Истина, если выборка не пуста.
Функция ЕстьОшибки() Экспорт

	Возврат _Снимки.Количество() > 0;

КонецФункции

// Возвращает коды ошибок с сохранением порядка и повторов.
//
// Возвращаемое значение:
//  Массив из Строка - Коды снимков выборки.
Функция Коды() Экспорт

	Результат = Новый Массив;
	Для Каждого Снимок Из _Снимки Цикл
		Результат.Добавить(Снимок.КодОшибки());
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Возвращает данные ошибок с сохранением позиционного соответствия.
//
// Возвращаемое значение:
//  Массив - Данные снимков выборки.
Функция Данные() Экспорт

	Результат = Новый Массив;
	Для Каждого Снимок Из _Снимки Цикл
		Результат.Добавить(Снимок.Данные());
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Возвращает подсказки ошибок с сохранением позиционного соответствия.
//
// Возвращаемое значение:
//  Массив из Строка - Подсказки снимков выборки.
Функция Подсказки() Экспорт

	Результат = Новый Массив;
	Для Каждого Снимок Из _Снимки Цикл
		Результат.Добавить(Снимок.Подсказка());
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Возвращает URL ошибок с сохранением позиционного соответствия.
//
// Возвращаемое значение:
//  Массив из Строка - URL снимков выборки.
Функция URL() Экспорт

	Результат = Новый Массив;
	Для Каждого Снимок Из _Снимки Цикл
		Результат.Добавить(Снимок.URL());
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Отбирает ошибки с одним из указанных кодов.
//
// Параметры:
//  КодыОшибок - Строка, Массив из Строка, ФиксированныйМассив из Строка - Список кодов.
//
// Возвращаемое значение:
//  ВыборкаОшибок - Новая выборка подходящих ошибок.
Функция Отобрать(КодыОшибок) Экспорт

	ИскомыеКоды = РазобратьКодыОшибок(КодыОшибок);
	Результат = Новый Массив;

	Для Каждого Снимок Из _Снимки Цикл
		Если ИскомыеКоды.Получить(НРег(Снимок.КодОшибки())) = Истина Тогда
			Результат.Добавить(Снимок);
		КонецЕсли;
	КонецЦикла;

	Возврат Новый ВыборкаОшибок(Результат);

КонецФункции

// Отбирает ошибки, машинные коды которых принадлежат группе.
//
// Параметры:
//  ГруппаОшибок - Строка - Один или несколько начальных сегментов машинного кода.
//
// Возвращаемое значение:
//  ВыборкаОшибок - Новая выборка подходящих ошибок.
Функция ОтобратьПоГруппе(ГруппаОшибок) Экспорт

	ПроверкаКадровОшибок.ПроверитьГруппуОшибок(ГруппаОшибок);

	Результат = Новый Массив;

	Для Каждого Снимок Из _Снимки Цикл
		Если Снимок.ПринадлежитГруппе(ГруппаОшибок) Тогда
			Результат.Добавить(Снимок);
		КонецЕсли;
	КонецЦикла;

	Возврат Новый ВыборкаОшибок(Результат);

КонецФункции

// Проверяет наличие ошибки с указанным кодом.
//
// Параметры:
//  КодОшибки - Строка - Искомый машинный код.
//
// Возвращаемое значение:
//  Булево - Истина, если код найден.
Функция Содержит(КодОшибки) Экспорт

	ИскомыйКод = ПолучитьНормализаторКодовОшибок().НормализоватьКод(КодОшибки);
	Для Каждого Снимок Из _Снимки Цикл
		Если НРег(Снимок.КодОшибки()) = ИскомыйКод Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Проверяет наличие ошибки, машинный код которой принадлежит группе.
//
// Параметры:
//  ГруппаОшибок - Строка - Один или несколько начальных сегментов машинного кода.
//
// Возвращаемое значение:
//  Булево - Истина, если найдена ошибка из группы.
Функция СодержитГруппу(ГруппаОшибок) Экспорт

	ПроверкаКадровОшибок.ПроверитьГруппуОшибок(ГруппаОшибок);

	НормализованнаяГруппа = НРег(ГруппаОшибок);
	ПрефиксГруппы = НормализованнаяГруппа + ".";

	Для Каждого Снимок Из _Снимки Цикл
		НормализованныйКод = НРег(Снимок.КодОшибки());
		Если НормализованныйКод = НормализованнаяГруппа
			Или СтрНайти(НормализованныйКод, ПрефиксГруппы) = 1 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Проверяет наличие хотя бы одной ошибки с одним из указанных кодов.
//
// Параметры:
//  КодыОшибок - Строка, Массив из Строка, ФиксированныйМассив из Строка - Список кодов.
//
// Возвращаемое значение:
//  Булево - Истина, если найден хотя бы один указанный код.
Функция СодержитЛюбойИз(КодыОшибок) Экспорт

	ИскомыеКоды = РазобратьКодыОшибок(КодыОшибок);

	Для Каждого Снимок Из _Снимки Цикл
		Если ИскомыеКоды.Получить(НРег(Снимок.КодОшибки())) = Истина Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Группирует ошибки по нормализованному коду.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ - Строка - Код ошибки
//   * Значение - ВыборкаОшибок - Выборка по коду ошибки.
Функция ГруппыПоКоду() Экспорт

	СнимкиПоКоду = Новый Соответствие;

	Для Каждого Снимок Из _Снимки Цикл

		КодОшибки = НРег(Снимок.КодОшибки());
		Группа = СнимкиПоКоду.Получить(КодОшибки);

		Если Группа = Неопределено Тогда
			Группа = Новый Массив;
			СнимкиПоКоду.Вставить(КодОшибки, Группа);
		КонецЕсли;

		Группа.Добавить(Снимок);

	КонецЦикла;

	Результат = Новый Соответствие;
	Для Каждого Элемент Из СнимкиПоКоду Цикл
		Результат.Вставить(Элемент.Ключ, Новый ВыборкаОшибок(Элемент.Значение));
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция РазобратьКодыОшибок(КодыОшибок)

	Возврат ПолучитьНормализаторКодовОшибок().Нормализовать(КодыОшибок);

КонецФункции

Функция ПолучитьНормализаторКодовОшибок()

	Если _НормализаторКодовОшибок = Неопределено Тогда
		_НормализаторКодовОшибок = Новый НормализаторКодовОшибок();
	КонецЕсли;

	Возврат _НормализаторКодовОшибок;

КонецФункции

Функция КопияМассива(ИсходныйМассив)

	Результат = Новый Массив;
	Для Каждого Элемент Из ИсходныйМассив Цикл
		Результат.Добавить(Элемент);
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти
