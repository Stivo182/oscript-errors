&Тест
Процедура ТестДолжен_ОтклонитьПодсказкуУКонтекстногоКадра() Экспорт

	// Действие и Проверка
	Ожидаем.Что(ЭтотОбъект)
		.Метод("ПостроитьКонтекстСПодсказкой")
		.ВыбрасываетИсключение(
			НСтр(
				"ru = 'Подсказка контекстного кадра должна быть пустой';"
				+ "en = 'Context frame hint must be empty'"
			)
		);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьURLУКонтекстногоКадра() Экспорт

	// Действие и Проверка
	Ожидаем.Что(ЭтотОбъект)
		.Метод("ПостроитьКонтекстСURL")
		.ВыбрасываетИсключение(
			НСтр(
				"ru = 'URL контекстного кадра должен быть пустым';"
				+ "en = 'Context frame URL must be empty'"
			)
		);

КонецПроцедуры

&Тест
Процедура ТестДолжен_КлассифицироватьНеподдерживаемыйВидКадра() Экспорт

	// Подготовка
	Ошибка = Неопределено;

	// Действие
	Попытка
		ОшибкаКадра = Новый КонструкторОшибки("http.proxy_error", "Ошибка прокси", "НеизвестныйВид").Построить();
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;

	// Проверка
	ПроверитьКонтрактноеИсключение(
		Ошибка,
		"argument.invalid_value",
		"Вид",
		"быть поддерживаемым видом кадра ошибки"
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_КлассифицироватьКодОшибкиКонтекстногоКадра() Экспорт

	// Подготовка
	Причина = ФабрикаОшибок.Создать("network.unavailable", "Сеть недоступна");
	Ошибка = Неопределено;

	// Действие
	Попытка
		ОшибкаКадра = Новый КонструкторОшибки("http.proxy_error", "Ошибка прокси", ВидыКадровОшибок.Контекст())
			.Причина(Причина)
			.Построить();
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;

	// Проверка
	ПроверитьКонтрактноеИсключение(
		Ошибка,
		"argument.invalid_value",
		"КодОшибки",
		"быть равен Неопределено"
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_КлассифицироватьОтсутствующуюПричинуКонтекстногоКадра() Экспорт

	// Подготовка
	Ошибка = Неопределено;

	// Действие
	Попытка
		ОшибкаКадра = Новый КонструкторОшибки(Неопределено, "Контекст", ВидыКадровОшибок.Контекст()).Построить();
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;

	// Проверка
	ПроверитьКонтрактноеИсключение(Ошибка, "argument.required", "Причина", "");

КонецПроцедуры

&Тест
Процедура ТестДолжен_КлассифицироватьПодсказкуКонтекстногоКадра() Экспорт

	// Подготовка
	Причина = ФабрикаОшибок.Создать("network.unavailable", "Сеть недоступна");
	Ошибка = Неопределено;

	// Действие
	Попытка
		ОшибкаКадра = Новый КонструкторОшибки(Неопределено, "Контекст", ВидыКадровОшибок.Контекст())
			.Подсказка("Проверьте настройки")
			.Причина(Причина)
			.Построить();
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;

	// Проверка
	ПроверитьКонтрактноеИсключение(Ошибка, "argument.invalid_value", "Подсказка", "быть пустой строкой");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПостроитьСПодсказкой(Подсказка) Экспорт

	Возврат Новый КонструкторОшибки("http.proxy_error", "Ошибка прокси")
		.Подсказка(Подсказка)
		.Построить();

КонецФункции

Функция ПостроитьСURL(URL) Экспорт

	Возврат Новый КонструкторОшибки("http.proxy_error", "Ошибка прокси")
		.URL(URL)
		.Построить();

КонецФункции

Процедура ПроверитьКонтрактноеИсключение(Ошибка, ОжидаемыйКодОшибки, ИмяАргумента, Ожидание)

	Если Ошибка = Неопределено Тогда
		ВызватьИсключение "Ожидалось контрактное исключение конструктора";
	КонецЕсли;

	Снимок = Новый СнимокКадраОшибки(Ошибка);
	Ожидаем.Что(Снимок.КодОшибки()).Равно(ОжидаемыйКодОшибки);
	Ожидаем.Что(Снимок.Данные().ИмяАргумента).Равно(ИмяАргумента);

	Если Ожидание <> "" Тогда
		Ожидаем.Что(Снимок.Данные().Ожидание).Равно(Ожидание);
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьОшибкуСмешиванияДанных(Ошибка)

	Если Ошибка = Неопределено Тогда
		ВызватьИсключение "Ожидалась ошибка смешивания режимов данных";
	КонецЕсли;

	Снимок = Новый СнимокКадраОшибки(Ошибка);
	Ожидаем.Что(Снимок.КодОшибки()).Равно("operation.invalid_state");
	Ожидаем.Что(Снимок.Данные().ИмяОперации).Равно("Настройка данных ошибки");
	Ожидаем.Что(Снимок.Сообщение()).Равно("Нельзя смешивать структурированные и произвольные данные ошибки");

КонецПроцедуры

Функция ПостроитьСКодомОшибки(КодОшибки) Экспорт

	Возврат Новый КонструкторОшибки(КодОшибки, "Ошибка прокси").Построить();

КонецФункции

Функция ПостроитьССообщением(Сообщение) Экспорт

	Возврат Новый КонструкторОшибки("http.proxy_error", Сообщение).Построить();

КонецФункции

Функция ПостроитьСПричиной(Причина) Экспорт

	Возврат Новый КонструкторОшибки("http.proxy_error", "Ошибка прокси")
		.Причина(Причина)
		.Построить();

КонецФункции

Функция ПостроитьСВидом(Вид) Экспорт

	Возврат Новый КонструкторОшибки("http.proxy_error", "Ошибка прокси", Вид).Построить();

КонецФункции

Функция ПостроитьКонтекстСТипом() Экспорт

	Причина = ФабрикаОшибок.Создать("network.unavailable", "Сеть недоступна");
	Возврат Новый КонструкторОшибки("http.proxy_error", "Ошибка прокси", ВидыКадровОшибок.Контекст())
		.Причина(Причина)
		.Построить();

КонецФункции

Функция ПостроитьКонтекстБезПричины() Экспорт

	Возврат Новый КонструкторОшибки(Неопределено, "Ошибка прокси", ВидыКадровОшибок.Контекст())
		.Построить();

КонецФункции

Функция ПостроитьКонтекстСПодсказкой() Экспорт

	Причина = ФабрикаОшибок.Создать("network.unavailable", "Сеть недоступна");
	Возврат Новый КонструкторОшибки(Неопределено, "Ошибка прокси", ВидыКадровОшибок.Контекст())
		.Подсказка("Проверьте настройки")
		.Причина(Причина)
		.Построить();

КонецФункции

Функция ПостроитьКонтекстСURL() Экспорт

	Причина = ФабрикаОшибок.Создать("network.unavailable", "Сеть недоступна");
	Возврат Новый КонструкторОшибки(Неопределено, "Ошибка прокси", ВидыКадровОшибок.Контекст())
		.URL("https://example.org/errors/context")
		.Причина(Причина)
		.Построить();

КонецФункции

#КонецОбласти
