&Тест
Процедура ТестДолжен_СформироватьКраткоеПредставлениеПервогоСнимка() Экспорт

	// Подготовка
	Снимки = Новый Массив;
	Снимки.Добавить(Новый ТестовыйСнимокКадраОшибки(
		Новый Структура(
			"Вид, Сообщение",
			ВидыКадровОшибок.Контекст(),
			"Запуск приложения"
		)
	));
	Снимки.Добавить(Новый ТестовыйСнимокКадраОшибки(
		Новый Структура(
			"Вид, КодОшибки, Сообщение",
			ВидыКадровОшибок.Ошибка(),
			"config.load_failed",
			"Не удалось загрузить настройки"
		)
	));

	// Действие
	Представление = ФорматированиеПредставленияОшибок.КраткоеПредставление(Снимки, Снимки[1]);

	// Проверка
	Ожидаем.Что(Представление).Равно(
		"config.load_failed: Запуск приложения -> Не удалось загрузить настройки"
	);

КонецПроцедуры

