#Использовать asserts
#Использовать "../src"

#Область Тесты

&Тест
Процедура ТестДолжен_ВернутьВсеСтандартныеКодыОшибок() Экспорт

	// Подготовка
	ОжидаемыеКоды = ОжидаемыеКоды();

	// Действие
	ФактическиеКоды = СтандартныеКоды();

	// Проверка
	Ожидаем.Что(ФактическиеКоды.Количество()).Равно(ОжидаемыеКоды.Количество());
	Для Индекс = 0 По ОжидаемыеКоды.ВГраница() Цикл
		Ожидаем.Что(ФактическиеКоды[Индекс]).Равно(ОжидаемыеКоды[Индекс]);
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьУникальныеСтандартныеКодыОшибок() Экспорт

	// Подготовка
	Коды = СтандартныеКоды();

	// Действие
	УникальныеКоды = Новый Соответствие;
	Для Каждого Код Из Коды Цикл
		УникальныеКоды.Вставить(Код, Истина);
	КонецЦикла;

	// Проверка
	Ожидаем.Что(УникальныеКоды.Количество()).Равно(Коды.Количество());

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СтандартныеКоды()

	Коды = Новый Массив;
	Коды.Добавить(КодыСтандартныхОшибок.НеверныйТипАргумента());
	Коды.Добавить(КодыСтандартныхОшибок.АргументНеЗаполнен());
	Коды.Добавить(КодыСтандартныхОшибок.НедопустимоеЗначениеАргумента());
	Коды.Добавить(КодыСтандартныхОшибок.АргументВнеДиапазона());
	Коды.Добавить(КодыСтандартныхОшибок.ОперацияОтменена());
	Коды.Добавить(КодыСтандартныхОшибок.ОперацияВНедопустимомСостоянии());
	Коды.Добавить(КодыСтандартныхОшибок.ОперацияНеРеализована());
	Коды.Добавить(КодыСтандартныхОшибок.ОперацияНеПоддерживается());
	Коды.Добавить(КодыСтандартныхОшибок.ИстеклоВремяОжиданияОперации());
	Коды.Добавить(КодыСтандартныхОшибок.ОперацияНедоступна());
	Коды.Добавить(КодыСтандартныхОшибок.КонфликтОперации());
	Коды.Добавить(КодыСтандартныхОшибок.ПревышенаЧастотаОперации());
	Коды.Добавить(КодыСтандартныхОшибок.ТребуетсяАутентификация());
	Коды.Добавить(КодыСтандартныхОшибок.ДоступЗапрещен());
	Коды.Добавить(КодыСтандартныхОшибок.РесурсНеНайден());
	Коды.Добавить(КодыСтандартныхОшибок.РесурсУжеСуществует());
	Коды.Добавить(КодыСтандартныхОшибок.РесурсУжеИспользуется());
	Коды.Добавить(КодыСтандартныхОшибок.РесурсЗакрыт());
	Коды.Добавить(КодыСтандартныхОшибок.РесурсИсчерпан());
	Коды.Добавить(КодыСтандартныхОшибок.КвотаРесурсаПревышена());
	Коды.Добавить(КодыСтандартныхОшибок.РесурсНеПуст());
	Коды.Добавить(КодыСтандартныхОшибок.ЗависимостьНедоступна());
	Коды.Добавить(КодыСтандартныхОшибок.СоединениеОтклонено());
	Коды.Добавить(КодыСтандартныхОшибок.СоединениеСброшено());
	Коды.Добавить(КодыСтандартныхОшибок.СоединениеПрервано());
	Коды.Добавить(КодыСтандартныхОшибок.СоединениеНеУстановлено());
	Коды.Добавить(КодыСтандартныхОшибок.ИстеклоВремяОжиданияСоединения());
	Коды.Добавить(КодыСтандартныхОшибок.СетевоеИмяНеНайдено());
	Коды.Добавить(КодыСтандартныхОшибок.УзелНедоступен());
	Коды.Добавить(КодыСтандартныхОшибок.СетьНедоступна());
	Коды.Добавить(КодыСтандартныхОшибок.НекорректныеДанные());
	Коды.Добавить(КодыСтандартныхОшибок.ДанныеСлишкомБольшие());
	Коды.Добавить(КодыСтандартныхОшибок.ДанныеПовреждены());
	Коды.Добавить(КодыСтандартныхОшибок.ДанныеНеСоответствуютКодировке());
	Коды.Добавить(КодыСтандартныхОшибок.КодировкаНеПоддерживается());
	Коды.Добавить(КодыСтандартныхОшибок.НеизвестнаяКодировка());
	Коды.Добавить(КодыСтандартныхОшибок.НарушенВнутреннийИнвариант());

	Возврат Коды;

КонецФункции

Функция ОжидаемыеКоды()

	Коды = СтрРазделить(
		"argument.invalid_type,argument.required,argument.invalid_value,argument.out_of_range,
		|operation.cancelled,operation.invalid_state,operation.not_implemented,operation.not_supported,
		|operation.timeout,operation.unavailable,operation.conflict,operation.rate_limited,
		|access.unauthenticated,access.denied,resource.not_found,resource.already_exists,
		|resource.already_in_use,resource.closed,resource.exhausted,resource.quota_exceeded,resource.not_empty,
		|dependency.unavailable,connection.refused,connection.reset,connection.aborted,connection.not_connected,
		|connection.timeout,network.name_not_found,network.host_unreachable,network.unreachable,data.invalid,
		|data.too_large,data.corrupt,encoding.invalid,encoding.not_supported,encoding.unknown,
		|internal.invariant_violation",
		",",
		Ложь
	);
	Для Индекс = 0 По Коды.ВГраница() Цикл
		Коды[Индекс] = СокрЛП(Коды[Индекс]);
	КонецЦикла;

	Возврат Коды;

КонецФункции

#КонецОбласти
