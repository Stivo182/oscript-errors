#Область СлужебныйПрограммныйИнтерфейс

// Формирует строки общего стека вызовов и нумерует их, если строк больше одной.
//
// Параметры:
//  Стек - Массив - Представляемый стек вызовов.
//  Отступ - Число - Количество пробелов перед каждой строкой.
//
// Возвращаемое значение:
//  Массив из Строка - Новые строки представления стека вызовов.
Функция СтрокиСтекаВызовов(Стек, Отступ = 0) Экспорт

	Представления = ПредставленияЭлементовСтека(Стек);
	Результат = Новый Массив;
	Нумеровать = Представления.Количество() > 1;

	Для Номер = 0 По Представления.ВГраница() Цикл
		Маркер = "";
		Если Нумеровать Тогда
			Маркер = Строка(Номер + 1) + ": ";
		КонецЕсли;
		ДобавитьЗначениеСМаркером(Результат, Отступ, Маркер, Представления[Номер]);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Формирует полный диагностический отчёт по просмотренным физическим кадрам.
//
// Параметры:
//  Снимки - Массив из СнимокКадраОшибки - Снимки от внешнего кадра к корневому.
//  Усечена - Булево - Признак наличия непросмотренного продолжения цепочки.
//
// Возвращаемое значение:
//  Строка - Полное диагностическое представление.
Функция Сформировать(Снимки, Усечена) Экспорт

	Блоки = Новый Массив;
	Разбор = РазобратьСнимки(Снимки);

	Если Разбор.Группы.Количество() > 0 Тогда
		Блоки.Добавить(БлокГруппы(Разбор.Группы[0], 0, "", 0, Ложь));
	КонецЕсли;

	Если Разбор.Группы.Количество() > 1 Тогда
		Блоки.Добавить(БлокПричин(Разбор.Группы));
	КонецЕсли;

	Если Разбор.Подсказки.Количество() > 0 Тогда
		Блоки.Добавить(БлокИменованногоСписка("Подсказка:", Разбор.Подсказки));
	КонецЕсли;

	Если Разбор.Ссылки.Количество() > 0 Тогда
		Блоки.Добавить(БлокИменованногоСписка("URL:", Разбор.Ссылки));
	КонецЕсли;

	Если Усечена И Разбор.Контексты.Количество() > 0 Тогда
		Блоки.Добавить(БлокКонтекстов(
			"Контекст без просмотренной причины:",
			Разбор.Контексты
		));
	КонецЕсли;

	Если Усечена Тогда
		Блоки.Добавить("Цепочка причин усечена");
	КонецЕсли;

	Если Снимки.Количество() > 0 Тогда
		БлокСтека = БлокСтекаВызовов(Снимки[0].СтекВызовов());
		Если БлокСтека <> "" Тогда
			Блоки.Добавить(БлокСтека);
		КонецЕсли;
	КонецЕсли;

	Возврат СтрСоединить(Блоки, Символы.ПС + Символы.ПС);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция РазобратьСнимки(Снимки)

	Результат = Новый Структура(
		"Группы, Контексты, Подсказки, Ссылки",
		Новый Массив,
		Новый Массив,
		Новый Массив,
		Новый Массив
	);
	Контексты = Новый Массив;

	Для Каждого Снимок Из Снимки Цикл
		Если Не ПустаяСтрока(Снимок.Подсказка()) Тогда
			Результат.Подсказки.Добавить(Снимок.Подсказка());
		КонецЕсли;
		Если Не ПустаяСтрока(Снимок.URL()) Тогда
			Результат.Ссылки.Добавить(Снимок.URL());
		КонецЕсли;

		Если Снимок.Вид() = ВидыКадровОшибок.Контекст() Тогда
			Контексты.Добавить(Снимок);
		Иначе
			Результат.Группы.Добавить(Новый Структура("Снимок, Контексты", Снимок, Контексты));
			Контексты = Новый Массив;
		КонецЕсли;
	КонецЦикла;

	Результат.Контексты = Контексты;

	Возврат Результат;

КонецФункции

Функция БлокГруппы(
	Группа,
	ОтступЗаголовка,
	МаркерНомера,
	ОтступПолей,
	ЭтоПричина
)

	Строки = Новый Массив;
	Снимок = Группа.Снимок;

	ДобавитьЗначениеСМаркером(
		Строки,
		ОтступЗаголовка,
		МаркерНомера + МаркерЗаголовкаГруппы(Снимок),
		Снимок.Сообщение()
	);

	Если Группа.Контексты.Количество() > 0 Тогда
		Если Не ЭтоПричина Тогда
			Строки.Добавить("");
		КонецЕсли;

		Строки.Добавить(Пробелы(ОтступПолей) + "Контекст:");
		МаркерКонтекста = "";
		Если Группа.Контексты.Количество() > 1 Тогда
			МаркерКонтекста = "- ";
		КонецЕсли;

		Для Каждого Контекст Из Группа.Контексты Цикл
			ДобавитьКонтекст(
				Строки,
				Контекст,
				ОтступПолей + 2,
				МаркерКонтекста
			);
		КонецЦикла;
	КонецЕсли;

	Если Не ЭтоПричина И Снимок.Данные() <> Неопределено Тогда
		Строки.Добавить("");
	КонецЕсли;

	ДобавитьДополнительныеПоля(Строки, Снимок, ОтступПолей);

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

Функция БлокПричин(Группы)

	Строки = Новый Массив;
	Строки.Добавить("Причина:");
	КоличествоПричин = Группы.Количество() - 1;

	Для НомерПричины = 1 По Группы.ВГраница() Цикл
		МаркерНомера = "";
		ОтступПолей = 4;
		Если КоличествоПричин > 1 Тогда
			МаркерНомера = Строка(НомерПричины) + ": ";
			ОтступПолей = 2 + СтрДлина(МаркерНомера);
		КонецЕсли;

		Строки.Добавить(БлокГруппы(Группы[НомерПричины], 2, МаркерНомера, ОтступПолей, Истина));
	КонецЦикла;

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

Функция БлокИменованногоСписка(Заголовок, Значения)

	Строки = Новый Массив;
	Строки.Добавить(Заголовок);
	Нумеровать = Значения.Количество() > 1;

	Для Номер = 0 По Значения.ВГраница() Цикл
		Маркер = "";
		Если Нумеровать Тогда
			Маркер = Строка(Номер + 1) + ": ";
		КонецЕсли;
		ДобавитьЗначениеСМаркером(Строки, 2, Маркер, Значения[Номер]);
	КонецЦикла;

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

Функция БлокСтекаВызовов(Стек)

	СтрокиСтека = СтрокиСтекаВызовов(Стек, 2);
	Если СтрокиСтека.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Строки = Новый Массив;
	Строки.Добавить("Стек вызовов:");
	ДобавитьСтроки(Строки, СтрокиСтека);

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

Функция МаркерЗаголовкаГруппы(Снимок)

	Если Снимок.Вид() = ВидыКадровОшибок.Ошибка() Тогда
		Возврат Снимок.КодОшибки() + ": ";
	КонецЕсли;

	Возврат "";

КонецФункции

Процедура ДобавитьКонтекст(Строки, Снимок, Отступ, Маркер)

	ДобавитьЗначениеСМаркером(Строки, Отступ, Маркер, Снимок.Сообщение());
	ДобавитьДополнительныеПоля(
		Строки,
		Снимок,
		Отступ + СтрДлина(Маркер)
	);

КонецПроцедуры

Процедура ДобавитьДополнительныеПоля(Строки, Снимок, Отступ)

	Данные = Снимок.Данные();
	Если Данные <> Неопределено Тогда
		Если ОграниченноеПредставлениеДанныхОшибок.ЭтоПустойКонтейнер(Данные) Тогда
			Маркер = ОграниченноеПредставлениеДанныхОшибок.МаркерПустогоКонтейнера(Данные);
			ДобавитьПоле(Строки, Отступ, "Данные", Маркер);
		Иначе
			Строки.Добавить(Пробелы(Отступ) + "Данные:");
			ДобавитьСтроки(
				Строки,
				ОграниченноеПредставлениеДанныхОшибок.Строки(Данные, Отступ + 2)
			);
		КонецЕсли;
	КонецЕсли;

	ДобавитьМесто(Строки, Снимок, Отступ);

	МестоСоздания = Снимок.МестоСоздания();
	Если Снимок.Вид() = ВидыКадровОшибок.ВнешняяОшибка()
		И МестоСоздания.ИсходнаяСтрока <> "" Тогда
		ДобавитьПоле(Строки, Отступ, "Исходная строка", СокрЛП(МестоСоздания.ИсходнаяСтрока));
	КонецЕсли;

КонецПроцедуры

Функция БлокКонтекстов(Заголовок, Контексты)

	Строки = Новый Массив;
	Строки.Добавить(Заголовок);
	Маркер = "";
	Если Контексты.Количество() > 1 Тогда
		Маркер = "- ";
	КонецЕсли;

	Для Каждого Контекст Из Контексты Цикл
		ДобавитьКонтекст(Строки, Контекст, 2, Маркер);
	КонецЦикла;

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

Процедура ДобавитьМесто(Строки, Снимок, Отступ)

	МестоСоздания = Снимок.МестоСоздания();
	ИмяМодуля = МестоСоздания.ИмяМодуля;
	НомерСтроки = МестоСоздания.НомерСтроки;

	Если ИмяМодуля <> "" И НомерСтроки > 0 Тогда
		ДобавитьПоле(Строки, Отступ, "Место", СтрШаблон("%1:%2", ИмяМодуля, НомерСтроки));
	ИначеЕсли ИмяМодуля <> "" Тогда
		ДобавитьПоле(Строки, Отступ, "Место", ИмяМодуля);
	ИначеЕсли НомерСтроки > 0 Тогда
		ДобавитьПоле(Строки, Отступ, "Строка", Строка(НомерСтроки));
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьПоле(Строки, Отступ, Имя, Значение)

	ДобавитьЗначениеСМаркером(Строки, Отступ, Имя + ": ", Значение);

КонецПроцедуры

Процедура ДобавитьЗначениеСМаркером(Строки, Отступ, Маркер, Значение)

	Префикс = Пробелы(Отступ) + Маркер;
	СтрокиЗначения = СтрокиТекста(Значение);

	Если СтрокиЗначения.Количество() = 0 Тогда
		Строки.Добавить(Префикс + Символ(34) + Символ(34));
		Возврат;
	КонецЕсли;

	Строки.Добавить(Префикс + СтрокиЗначения[0]);
	ОтступПродолжения = Пробелы(СтрДлина(Префикс));

	Для НомерСтроки = 1 По СтрокиЗначения.ВГраница() Цикл
		Строки.Добавить(ОтступПродолжения + СтрокиЗначения[НомерСтроки]);
	КонецЦикла;

КонецПроцедуры

Функция СтрокиТекста(Значение)

	Текст = Строка(Значение);
	Текст = СтрЗаменить(Текст, Символы.ВК + Символы.ПС, Символы.ПС);
	Текст = СтрЗаменить(Текст, Символы.ВК, Символы.ПС);

	Если Текст = "" Тогда
		Возврат Новый Массив;
	КонецЕсли;

	Возврат СтрРазделить(Текст, Символы.ПС, Истина);

КонецФункции

Процедура ДобавитьСтроки(Приемник, Источник)

	Для Каждого Строка Из Источник Цикл
		Приемник.Добавить(Строка);
	КонецЦикла;

КонецПроцедуры

Функция ПредставленияЭлементовСтека(Стек)

	Результат = Новый Массив;
	Для Каждого Элемент Из Стек Цикл
		Результат.Добавить(БезопасноеПредставление(Элемент));
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция БезопасноеПредставление(Значение)

	Попытка
		Возврат Строка(Значение);
	Исключение
		Возврат "<недоступно>";
	КонецПопытки;

КонецФункции

Функция Пробелы(Количество)

	Результат = "";
	Для Счетчик = 1 По Количество Цикл
		Результат = Результат + " ";
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти
