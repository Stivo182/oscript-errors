&Тест
Процедура ТестДолжен_КопироватьПравилаПриДобавлении() Экспорт

	// Подготовка
	Основные = ОсновныеПравила();

	Классификатор = Новый КлассификаторОшибок;
	Классификатор.ДобавитьПравила(Основные);

	Основные.Очистить();

	Правило = ТочноеПравило("custom.original", "Исходная ошибка", "Добавленное сообщение");
	Правила = Новый Массив;
	Правила.Добавить(Правило);

	Классификатор.ДобавитьПравила(Правила);

	Правило.КлассифицируетКак("custom.changed", "Измененная ошибка");

	Причина = ФабрикаОшибок.Создать("custom.original", "Исходное сообщение");
	ОшибкаСДобавленнымКодом = ФабрикаОшибок.Создать(
		"foreign.code",
		"Внешняя ошибка",
		Неопределено,
		Причина
	);

	Классификатор.ДобавитьПоставщикаПравил(Новый ТестовыйПоставщикПравил(Новый Массив));

	// Действие
	ОсновнойРезультат = Классификатор.Классифицировать(ОшибкаССообщением("Основное сообщение"));
	ДобавленныйРезультат = Классификатор.Классифицировать(ОшибкаССообщением("Добавленное сообщение"));
	РезультатСтруктурированногоКода = Классификатор.Классифицировать(ОшибкаСДобавленнымКодом);

	// Проверка
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(ОсновнойРезультат)).Равно("test.main");
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(ДобавленныйРезультат)).Равно("custom.original");
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(РезультатСтруктурированногоКода)).Равно("custom.original");
	Ожидаем.Что(Новый СнимокКадраОшибки(РезультатСтруктурированногоКода).Сообщение())
		.Равно("Исходная ошибка");

КонецПроцедуры

