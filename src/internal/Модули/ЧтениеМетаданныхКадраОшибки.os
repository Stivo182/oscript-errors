#Область СлужебныйПрограммныйИнтерфейс

// Безопасно читает и распознаёт метаданные физического кадра ошибки.
//
// Параметры:
//  Ошибка - ИнформацияОбОшибке - Читаемый физический кадр.
//
// Возвращаемое значение:
//  ФиксированнаяСтруктура, Неопределено - Поддерживаемые исходные метаданные или Неопределено.
Функция Прочитать(Ошибка) Экспорт

	ПроверкаКадровОшибок.ПроверитьОшибку(Ошибка);

	Возврат ПрочитатьПроверенный(Ошибка);

КонецФункции

// Безопасно читает метаданные заранее проверенного физического кадра.
//
// Параметры:
//  Ошибка - ИнформацияОбОшибке - Заранее проверенный физический кадр.
//
// Возвращаемое значение:
//  ФиксированнаяСтруктура, Неопределено - Поддерживаемые исходные метаданные или Неопределено.
Функция ПрочитатьПроверенный(Ошибка) Экспорт

	Попытка
		Параметры = Ошибка.Параметры;
		Если ТипЗнч(Параметры) <> Тип("ФиксированнаяСтруктура")
			Или Не ЭтоПоддерживаемыеМетаданные(Параметры) Тогда
			Возврат Неопределено;
		КонецЕсли;

		Возврат Параметры;
	Исключение
		ЛогированиеОшибок.ЗаписатьПодавленныйСбой(
			"snapshot.read_metadata",
			Ошибка,
			ИнформацияОбОшибке()
		);
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЭтоПоддерживаемыеМетаданные(Параметры)

	Маркер = Неопределено;
	ВерсияФормата = Неопределено;
	Вид = Неопределено;
	КодОшибки = Неопределено;
	Сообщение = "";
	Данные = Неопределено;
	Подсказка = "";
	URL = "";

	ВсеПоляПрисутствуют = Параметры.Свойство("Маркер", Маркер)
		И Параметры.Свойство("ВерсияФормата", ВерсияФормата)
		И Параметры.Свойство("Вид", Вид)
		И Параметры.Свойство("КодОшибки", КодОшибки)
		И Параметры.Свойство("Данные", Данные)
		И Параметры.Свойство("Сообщение", Сообщение);

	Если Не ВсеПоляПрисутствуют
		Или Не ПроверкаКадровОшибок.КорректноеСообщение(Сообщение) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Параметры.Свойство("Подсказка", Подсказка)
		И Не ПроверкаКадровОшибок.КорректнаяПодсказка(Подсказка) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Параметры.Свойство("URL", URL)
		И Не ПроверкаКадровОшибок.КорректныйURL(URL) Тогда
		Возврат Ложь;
	КонецЕсли;

	КорректныйМаркер = ТипЗнч(Маркер) = Тип("Строка")
		И Маркер = ФорматКадраОшибки.МаркерМетаданных();
	КорректнаяВерсия = ТипЗнч(ВерсияФормата) = Тип("Число")
		И ВерсияФормата = ФорматКадраОшибки.ВерсияФормата();

	Если Не КорректныйМаркер Или Не КорректнаяВерсия Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Вид = ВидыКадровОшибок.Ошибка() Тогда
		Возврат ПроверкаКадровОшибок.КорректныйКодОшибки(КодОшибки);
	КонецЕсли;

	Если Вид = ВидыКадровОшибок.Контекст() Тогда
		Возврат КодОшибки = Неопределено;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

#КонецОбласти
