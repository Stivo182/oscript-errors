Перем _Вид;
Перем _КодОшибки;
Перем _Сообщение;
Перем _Данные;
Перем _Подсказка;
Перем _URL;
Перем _МестоСоздания;
Перем _СтекВызовов;

#Область ОбработчикиСобытий

// Создаёт детерминированный снимок кадра для тестирования форматирования.
//
// Параметры:
//  Параметры - Структура - Значения полного интерфейса снимка кадра.
Процедура ПриСозданииОбъекта(Параметры)

	_Вид = ЗначениеСвойства(Параметры, "Вид", "ВнешняяОшибка");
	_КодОшибки = ЗначениеСвойства(Параметры, "КодОшибки", "");
	_Сообщение = ЗначениеСвойства(Параметры, "Сообщение", "");
	_Данные = ЗначениеСвойства(Параметры, "Данные", Неопределено);
	_Подсказка = ЗначениеСвойства(Параметры, "Подсказка", "");
	_URL = ЗначениеСвойства(Параметры, "URL", "");
	МестоСоздания = Новый Структура(
		"ИмяМодуля, НомерСтроки, ИсходнаяСтрока",
		ЗначениеСвойства(Параметры, "ИмяМодуля", ""),
		ЗначениеСвойства(Параметры, "НомерСтроки", 0),
		ЗначениеСвойства(Параметры, "ИсходнаяСтрока", "")
	);
	_МестоСоздания = Новый ФиксированнаяСтруктура(МестоСоздания);
	_СтекВызовов = Новый Массив;
	Для Каждого Элемент Из ЗначениеСвойства(Параметры, "Стек", Новый Массив) Цикл
		_СтекВызовов.Добавить(Элемент);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Возвращает вид кадра.
//
// Возвращаемое значение:
//  Строка - Вид кадра.
Функция Вид() Экспорт

	Возврат _Вид;

КонецФункции

// Возвращает код ошибки.
//
// Возвращаемое значение:
//  Строка - Код ошибки.
Функция КодОшибки() Экспорт

	Возврат _КодОшибки;

КонецФункции

// Возвращает сообщение кадра.
//
// Возвращаемое значение:
//  Строка - Сообщение кадра.
Функция Сообщение() Экспорт

	Возврат _Сообщение;

КонецФункции

// Возвращает данные кадра.
//
// Возвращаемое значение:
//  Произвольный, Неопределено - Данные кадра.
Функция Данные() Экспорт

	Возврат _Данные;

КонецФункции

// Возвращает подсказку кадра.
//
// Возвращаемое значение:
//  Строка - Подсказка кадра.
Функция Подсказка() Экспорт

	Возврат _Подсказка;

КонецФункции

// Возвращает URL документации кадра.
//
// Возвращаемое значение:
//  Строка - URL документации кадра.
Функция URL() Экспорт

	Возврат _URL;

КонецФункции

// Возвращает место создания кадра.
//
// Возвращаемое значение:
//  ФиксированнаяСтруктура - Место создания кадра.
Функция МестоСоздания() Экспорт

	Возврат _МестоСоздания;

КонецФункции

// Возвращает независимую копию стека кадра.
//
// Возвращаемое значение:
//  Массив - Копия стека кадра.
Функция СтекВызовов() Экспорт

	Результат = Новый Массив;
	Для Каждого Элемент Из _СтекВызовов Цикл
		Результат.Добавить(Элемент);
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЗначениеСвойства(Параметры, Имя, ЗначениеПоУмолчанию)

	Результат = Неопределено;
	Если Не Параметры.Свойство(Имя, Результат) Тогда
		Результат = ЗначениеПоУмолчанию;
	КонецЕсли;

	Возврат Результат;

КонецФункции

#КонецОбласти
