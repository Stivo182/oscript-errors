&Тест
Процедура ТестДолжен_СохранитьПодсказкуПриОбертыванииОшибки() Экспорт

	// Подготовка
	Причина = ФабрикаОшибок.Создать("network.unavailable", "Сеть недоступна");

	// Действие
	Ошибка = Новый ПостроительОшибки(
		"http.proxy_error",
		"Ошибка прокси"
	)
		.Причина(Причина)
		.Подсказка("Проверьте настройки прокси")
		.Построить();

	// Проверка
	Снимок = Новый СнимокКадраОшибки(Ошибка);
	Ожидаем.Что(Снимок.Подсказка()).Равно("Проверьте настройки прокси");
	Ожидаем.Что(Ошибка.Причина).Равно(Причина);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьОшибкуНеверногоТипаАргумента() Экспорт

	// Подготовка
	Ошибка = СтандартныеОшибки.НеверныйТипАргумента("Имя", "Строка", 42);

	// Действие
	Снимок = Новый СнимокКадраОшибки(Ошибка);

	// Проверка
	Ожидаем.Что(Снимок.КодОшибки()).Равно("argument.invalid_type");
	Ожидаем.Что(Снимок.Данные().ИмяАргумента).Равно("Имя");
	Ожидаем.Что(Снимок.Данные().ОжидаемыйТип).Равно("Строка");
	Ожидаем.Что(Снимок.Данные().ФактическийТип).Равно(Строка(Тип("Число")));
	Ожидаем.Что(Снимок.Данные().Свойство("ФактическоеЗначение")).ЭтоЛожь();
	Ожидаем.Что(Снимок.Сообщение()).Равно(СтандартноеСообщениеНеверногоТипа("Имя", "Строка"));

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьОшибкуНезаполненногоАргумента() Экспорт

	// Подготовка
	ОшибкаПоУмолчанию = СтандартныеОшибки.АргументНеЗаполнен("Имя");
	ОшибкаСПользовательскимСообщением = СтандартныеОшибки.АргументНеЗаполнен("Имя", "Пользовательское сообщение");

	// Действие
	СнимокПоУмолчанию = Новый СнимокКадраОшибки(ОшибкаПоУмолчанию);
	СнимокСПользовательскимСообщением = Новый СнимокКадраОшибки(ОшибкаСПользовательскимСообщением);

	// Проверка
	Ожидаем.Что(СнимокПоУмолчанию.КодОшибки()).Равно("argument.required");
	Ожидаем.Что(СнимокПоУмолчанию.Данные().ИмяАргумента).Равно("Имя");
	Ожидаем.Что(СнимокПоУмолчанию.Данные().Количество()).Равно(1);
	Ожидаем.Что(СнимокПоУмолчанию.Сообщение()).Равно(СтандартноеСообщениеНезаполненногоАргумента("Имя"));
	Ожидаем.Что(СнимокСПользовательскимСообщением.Сообщение()).Равно("Пользовательское сообщение");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьОшибкуНедопустимогоЗначенияАргумента() Экспорт

	// Подготовка
	Ошибка = СтандартныеОшибки.НедопустимоеЗначениеАргумента("Количество", "быть больше нуля");

	// Действие
	Снимок = Новый СнимокКадраОшибки(Ошибка);

	// Проверка
	Ожидаем.Что(Снимок.КодОшибки()).Равно("argument.invalid_value");
	Ожидаем.Что(Снимок.Данные().ИмяАргумента).Равно("Количество");
	Ожидаем.Что(Снимок.Данные().Ожидание).Равно("быть больше нуля");
	Ожидаем.Что(Снимок.Данные().Количество()).Равно(2);
	Ожидаем.Что(Снимок.Сообщение()).Равно(
		СтандартноеСообщениеНедопустимогоЗначения("Количество", "быть больше нуля")
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьОшибкуАргументаВнеДиапазона() Экспорт

	// Подготовка
	Ошибка = СтандартныеОшибки.АргументВнеДиапазона("Индекс", "от 0 до 9");
	ОшибкаССообщением = СтандартныеОшибки.АргументВнеДиапазона(
		"Индекс",
		"от 0 до 9",
		"Индекс вышел за границы"
	);

	// Действие
	Снимок = Новый СнимокКадраОшибки(Ошибка);
	СнимокССообщением = Новый СнимокКадраОшибки(ОшибкаССообщением);

	// Проверка
	Ожидаем.Что(Снимок.КодОшибки()).Равно("argument.out_of_range");
	Ожидаем.Что(Снимок.Данные().ИмяАргумента).Равно("Индекс");
	Ожидаем.Что(Снимок.Данные().ОжидаемыйДиапазон).Равно("от 0 до 9");
	Ожидаем.Что(Снимок.Данные().Количество()).Равно(2);
	Ожидаем.Что(Снимок.Сообщение()).Равно(
		СтандартноеСообщениеАргументаВнеДиапазона("Индекс", "от 0 до 9")
	);
	Ожидаем.Что(СнимокССообщением.Сообщение()).Равно("Индекс вышел за границы");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("ОперацияОтменена", "operation.cancelled")
&ИсточникЗначение("ОперацияВНедопустимомСостоянии", "operation.invalid_state")
&ИсточникЗначение("ОперацияНеРеализована", "operation.not_implemented")
&ИсточникЗначение("ОперацияНеПоддерживается", "operation.not_supported")
&ИсточникЗначение("ИстеклоВремяОжиданияОперации", "operation.timeout")
&ИсточникЗначение("ОперацияНедоступна", "operation.unavailable")
Процедура ТестДолжен_СоздатьСтандартнуюОшибкуОперации(ИмяФабрики, КодОшибки) Экспорт

	// Подготовка
	ИмяОперации = "Синхронизация";
	ПользовательскоеСообщение = "Пользовательское сообщение";

	// Действие
	Ошибка = СоздатьИнфраструктурнуюОшибку(ИмяФабрики, ИмяОперации);
	ОшибкаССообщением = СоздатьИнфраструктурнуюОшибку(
		ИмяФабрики,
		ИмяОперации,
		"",
		ПользовательскоеСообщение
	);
	Снимок = Новый СнимокКадраОшибки(Ошибка);
	СнимокССообщением = Новый СнимокКадраОшибки(ОшибкаССообщением);

	// Проверка
	Ожидаем.Что(Снимок.КодОшибки()).Равно(КодОшибки);
	Ожидаем.Что(Снимок.Данные().ИмяОперации).Равно(ИмяОперации);
	Ожидаем.Что(Снимок.Данные().Количество()).Равно(1);
	Ожидаем.Что(Снимок.Сообщение()).Равно(
		СтандартноеСообщениеИнфраструктурнойОшибки(ИмяФабрики, ИмяОперации)
	);
	Ожидаем.Что(СнимокССообщением.Сообщение()).Равно(ПользовательскоеСообщение);

КонецПроцедуры

