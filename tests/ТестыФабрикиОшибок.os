&Тест
Процедура ТестДолжен_СохранитьНепосредственнуюПричинуВКонтексте() Экспорт

	// Подготовка
	Причина = ВнешняяОшибка("Исходная ошибка");

	// Действие
	Ошибка = ФабрикаОшибок.СКонтекстом(Причина, "Чтение конфигурации");

	// Проверка
	Ожидаем.Что(ТипЗнч(Ошибка)).Равно(Тип("ИнформацияОбОшибке"));
	Ожидаем.Что(Ошибка.Описание).Равно("Чтение конфигурации");
	Ожидаем.Что(Ошибка.Причина).Равно(Причина);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьНепосредственнуюПричинуПриОбертывании() Экспорт

	// Подготовка
	Причина = ВнешняяОшибка("Исходная ошибка");

	// Действие
	Ошибка = ФабрикаОшибок.Обернуть(Причина, "application.start_failed", "Не удалось запустить приложение");

	// Проверка
	Ожидаем.Что(ТипЗнч(Ошибка)).Равно(Тип("ИнформацияОбОшибке"));
	Ожидаем.Что(Ошибка.Описание).Равно("Не удалось запустить приложение");
	Ожидаем.Что(Ошибка.Причина).Равно(Причина);

КонецПроцедуры

