#Использовать asserts
#Использовать "../src"

#Область СлужебныеПроцедурыИФункции

Функция ВнешняяОшибка(Сообщение)

	Попытка
		ВызватьИсключение Сообщение;
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

КонецФункции

Процедура ПроверитьИсключениеМетода(ИмяМетода, Параметры, ОжидаемоеСообщение)

	Ожидаем.Что(ФабрикаОшибок)
		.Метод(ИмяМетода, Параметры)
		.ВыбрасываетИсключение(ОжидаемоеСообщение);

КонецПроцедуры

#КонецОбласти

#Область Тесты

&ПараметризованныйТест
&ИсточникЗначение("a.b")
&ИсточникЗначение("a1_b2.c3_d4")
Процедура ТестДолжен_ПринятьКорректныйТипОшибки(ПроверяемыйТипОшибки) Экспорт

	// Действие
	Ошибка = ФабрикаОшибок.Создать(ПроверяемыйТипОшибки, "Сообщение");

	// Проверка
	Ожидаем.Что(ТипЗнч(Ошибка)).Равно(Тип("ИнформацияОбОшибке"));

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("")
&ИсточникЗначение("a")
&ИсточникЗначение(".b")
&ИсточникЗначение("a.")
&ИсточникЗначение("a.b.c")
&ИсточникЗначение("A.b")
&ИсточникЗначение("а.b")
&ИсточникЗначение("1a.b")
&ИсточникЗначение("_a.b")
&ИсточникЗначение("a.B")
&ИсточникЗначение("a.б")
&ИсточникЗначение("a.1b")
&ИсточникЗначение("a._b")
&ИсточникЗначение("a-b.c")
&ИсточникЗначение("a.b-c")
&ИсточникЗначение("a b.c")
Процедура ТестДолжен_ОтклонитьНекорректныйФорматТипаОшибки(ПроверяемыйТипОшибки) Экспорт

	// Подготовка
	Параметры = Новый Массив;
	Параметры.Добавить(ПроверяемыйТипОшибки);
	Параметры.Добавить("Сообщение");

	// Действие и Проверка
	ПроверитьИсключениеМетода(
		"Создать",
		Параметры,
		"Тип ошибки имеет неверный формат"
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьНестроковыйТипОшибки() Экспорт

	// Подготовка
	Параметры = Новый Массив;
	Параметры.Добавить(42);
	Параметры.Добавить("Сообщение");

	// Действие и Проверка
	ПроверитьИсключениеМетода(
		"Создать",
		Параметры,
		"Тип ошибки должен быть строкой"
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьНекорректныйТипОшибкиПриОбертывании() Экспорт

	// Подготовка
	Параметры = Новый Массив;
	Параметры.Добавить(ВнешняяОшибка("Исходная ошибка"));
	Параметры.Добавить("Application.StartFailed");
	Параметры.Добавить("Не удалось запустить приложение");

	// Действие и Проверка
	ПроверитьИсключениеМетода(
		"Обернуть",
		Параметры,
		"Тип ошибки имеет неверный формат"
	);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("")
&ИсточникЗначение(42)
Процедура ТестДолжен_ОтклонитьНекорректноеСообщение(Сообщение) Экспорт

	// Подготовка
	Параметры = Новый Массив;
	Параметры.Добавить("fs.file_not_found");
	Параметры.Добавить(Сообщение);

	// Действие и Проверка
	ПроверитьИсключениеМетода(
		"Создать",
		Параметры,
		"Сообщение должно быть непустой строкой"
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьНекорректноеСообщениеКонтекста() Экспорт

	// Подготовка
	Параметры = Новый Массив;
	Параметры.Добавить(ВнешняяОшибка("Исходная ошибка"));
	Параметры.Добавить(Неопределено);

	// Действие и Проверка
	ПроверитьИсключениеМетода(
		"СКонтекстом",
		Параметры,
		"Сообщение должно быть непустой строкой"
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьНекорректноеСообщениеОбертывания() Экспорт

	// Подготовка
	Параметры = Новый Массив;
	Параметры.Добавить(ВнешняяОшибка("Исходная ошибка"));
	Параметры.Добавить("application.start_failed");
	Параметры.Добавить("");

	// Действие и Проверка
	ПроверитьИсключениеМетода(
		"Обернуть",
		Параметры,
		"Сообщение должно быть непустой строкой"
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьНекорректнуюПричинуКонтекста() Экспорт

	// Подготовка
	Параметры = Новый Массив;
	Параметры.Добавить("не ошибка");
	Параметры.Добавить("Контекст операции");

	// Действие и Проверка
	ПроверитьИсключениеМетода(
		"СКонтекстом",
		Параметры,
		"Причина должна иметь тип ИнформацияОбОшибке"
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьНекорректнуюПричинуОбертывания() Экспорт

	// Подготовка
	Параметры = Новый Массив;
	Параметры.Добавить(42);
	Параметры.Добавить("application.start_failed");
	Параметры.Добавить("Не удалось запустить приложение");

	// Действие и Проверка
	ПроверитьИсключениеМетода(
		"Обернуть",
		Параметры,
		"Причина должна иметь тип ИнформацияОбОшибке"
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПредоставитьВидыКадровКакПеречисление() Экспорт

	// Действие и Проверка
	Ожидаем.Что(ВидыКадровОшибок.Ошибка).Равно("Ошибка");
	Ожидаем.Что(ВидыКадровОшибок.Контекст).Равно("Контекст");
	Ожидаем.Что(ВидыКадровОшибок.ВнешняяОшибка).Равно("ВнешняяОшибка");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьИнформациюОбОшибкеБезПричины() Экспорт

	// Действие
	Ошибка = ФабрикаОшибок.Создать(
		"fs.file_not_found",
		"Файл не найден"
	);

	// Проверка
	Ожидаем.Что(ТипЗнч(Ошибка)).Равно(Тип("ИнформацияОбОшибке"));
	Ожидаем.Что(Ошибка.Описание).Равно("Файл не найден");
	Ожидаем.Что(Ошибка.Причина).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьНепосредственнуюПричинуВКонтексте() Экспорт

	// Подготовка
	Причина = ВнешняяОшибка("Исходная ошибка");

	// Действие
	Ошибка = ФабрикаОшибок.СКонтекстом(
		Причина,
		"Чтение конфигурации"
	);

	// Проверка
	Ожидаем.Что(ТипЗнч(Ошибка)).Равно(Тип("ИнформацияОбОшибке"));
	Ожидаем.Что(Ошибка.Описание).Равно("Чтение конфигурации");
	Ожидаем.Что(Ошибка.Причина).Равно(Причина);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьНепосредственнуюПричинуПриОбертывании() Экспорт

	// Подготовка
	Причина = ВнешняяОшибка("Исходная ошибка");

	// Действие
	Ошибка = ФабрикаОшибок.Обернуть(
		Причина,
		"application.start_failed",
		"Не удалось запустить приложение"
	);

	// Проверка
	Ожидаем.Что(ТипЗнч(Ошибка)).Равно(Тип("ИнформацияОбОшибке"));
	Ожидаем.Что(Ошибка.Описание).Равно("Не удалось запустить приложение");
	Ожидаем.Что(Ошибка.Причина).Равно(Причина);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВыброситьИПерехватитьСозданнуюОшибку() Экспорт

	// Действие
	Попытка
		ВызватьИсключение ФабрикаОшибок.Создать(
			"fs.file_not_found",
			"Файл не найден"
		);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;

	// Проверка
	Ожидаем.Что(ТипЗнч(Ошибка)).Равно(Тип("ИнформацияОбОшибке"));
	Ожидаем.Что(Ошибка.Описание).Равно("Файл не найден");

КонецПроцедуры

