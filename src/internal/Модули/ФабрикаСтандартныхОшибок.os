// Создаёт ошибку нарушения внутреннего инварианта.
Функция НарушенВнутреннийИнвариант(Инвариант, Сообщение = "") Экспорт

	Возврат СоздатьОднопараметрическуюОшибку(
		"internal.invariant_violation",
		"Инвариант",
		Инвариант,
		НСтр("ru = 'Нарушен внутренний инвариант: %1'; en = 'Internal invariant violated: %1'"),
		Сообщение
	);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьОднопараметрическуюОшибку(ТипОшибки, ИмяПоля, Значение, ШаблонСообщения, Сообщение)

	Если Сообщение = "" Тогда
		Сообщение = СтрШаблон(ШаблонСообщения, Значение);
	КонецЕсли;

	Возврат СоздатьОшибку(
		ТипОшибки,
		Сообщение,
		Новый Структура(ИмяПоля, Значение)
	);

КонецФункции

Функция СоздатьДвухпараметрическуюОшибку(
	ТипОшибки,
	ИмяПоля1,
	Значение1,
	ИмяПоля2,
	Значение2,
	ШаблонСообщения,
	Сообщение
)

	Если Сообщение = "" Тогда
		Сообщение = СтрШаблон(ШаблонСообщения, Значение1, Значение2);
	КонецЕсли;

	Возврат СоздатьОшибку(
		ТипОшибки,
		Сообщение,
		Новый Структура(ИмяПоля1 + ", " + ИмяПоля2, Значение1, Значение2)
	);

КонецФункции

Функция СоздатьОшибку(ТипОшибки, Сообщение, Данные)

	Описание = СтрШаблон("%1: %2", ТипОшибки, Сообщение);

	Возврат СозданиеКадровОшибок.Создать(
		Описание,
		ВидыКадровОшибок.Ошибка,
		ТипОшибки,
		Сообщение,
		Данные,
		""
	);

КонецФункции

#КонецОбласти
