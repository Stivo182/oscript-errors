#Область Тесты

&Тест
Процедура ТестДолжен_СоздатьИсследователяОшибки() Экспорт

	// Подготовка
	Ошибка = ФабрикаОшибок.Создать("config.invalid", "Ошибка конфигурации");

	// Действие
	Исследователь = ДиагностикаОшибок.Исследовать(Ошибка);

	// Проверка
	Ожидаем.Что(ТипЗнч(Исследователь)).Равно(Тип("ИсследовательОшибки"));
	Ожидаем.Что(Исследователь.КодОшибки()).Равно("config.invalid");

КонецПроцедуры

#КонецОбласти
