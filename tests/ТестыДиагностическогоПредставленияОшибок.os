&Тест
Процедура ТестДолжен_НеОграничиватьТекстовыеПоляДиагностическогоПредставления() Экспорт

	// Подготовка
	ДлиннаяЧасть = "";
	Для Номер = 1 По 300 Цикл
		ДлиннаяЧасть = ДлиннаяЧасть + "я";
	КонецЦикла;
	Снимки = Новый Массив;
	Снимки.Добавить(Новый ТестовыйСнимокКадраОшибки(
		Новый Структура(
			"Вид, Сообщение",
			ВидыКадровОшибок.Контекст(),
			"Контекст-" + ДлиннаяЧасть
		)
	));
	Снимки.Добавить(Новый ТестовыйСнимокКадраОшибки(
		Новый Структура(
			"Вид, КодОшибки, Сообщение, Подсказка, ИсходнаяСтрока",
			ВидыКадровОшибок.Ошибка(),
			"core.failed",
			"Сообщение-" + ДлиннаяЧасть,
			"Подсказка-" + ДлиннаяЧасть,
			"ИсходнаяСтрока-" + ДлиннаяЧасть
		)
	));
	Снимки.Добавить(Новый ТестовыйСнимокКадраОшибки(
		Новый Структура(
			"Вид, Сообщение, ИсходнаяСтрока",
			ВидыКадровОшибок.ВнешняяОшибка(),
			"Внешняя причина",
			"ИсходнаяСтрока-" + ДлиннаяЧасть
		)
	));

	// Действие
	Представление = ФорматированиеПредставленияОшибок.ДиагностическоеПредставление(Снимки, Ложь);

	// Проверка
	Ожидаем.Что(Представление).Содержит("Контекст-" + ДлиннаяЧасть);
	Ожидаем.Что(Представление).Содержит("Сообщение-" + ДлиннаяЧасть);
	Ожидаем.Что(Представление).Содержит("Подсказка-" + ДлиннаяЧасть);
	Ожидаем.Что(Представление).Содержит("ИсходнаяСтрока-" + ДлиннаяЧасть);

