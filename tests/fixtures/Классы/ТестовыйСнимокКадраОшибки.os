Перем _Вид;
Перем _КодОшибки;
Перем _Сообщение;
Перем _Данные;
Перем _Подсказка;
Перем _ИмяМодуля;
Перем _НомерСтроки;
Перем _ИсходнаяСтрока;
Перем _Стек;

#Область ОбработчикиСобытий

// Создаёт детерминированный снимок кадра для тестирования форматирования.
//
// Параметры:
//  Параметры - Структура - Значения полного интерфейса снимка кадра.
Процедура ПриСозданииОбъекта(Параметры)

	_Вид = ЗначениеСвойства(Параметры, "Вид", "ВнешняяОшибка");
	_КодОшибки = ЗначениеСвойства(Параметры, "КодОшибки", "");
	_Сообщение = ЗначениеСвойства(Параметры, "Сообщение", "");
	_Данные = ЗначениеСвойства(Параметры, "Данные", Неопределено);
	_Подсказка = ЗначениеСвойства(Параметры, "Подсказка", "");
	_ИмяМодуля = ЗначениеСвойства(Параметры, "ИмяМодуля", "");
	_НомерСтроки = ЗначениеСвойства(Параметры, "НомерСтроки", 0);
	_ИсходнаяСтрока = ЗначениеСвойства(Параметры, "ИсходнаяСтрока", "");
	_Стек = Новый Массив;
	Для Каждого Элемент Из ЗначениеСвойства(Параметры, "Стек", Новый Массив) Цикл
		_Стек.Добавить(Элемент);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Возвращает вид кадра.
//
// Возвращаемое значение:
//  Строка - Вид кадра.
Функция Вид() Экспорт

	Возврат _Вид;

КонецФункции

// Возвращает код ошибки.
//
// Возвращаемое значение:
//  Строка - Код ошибки.
Функция КодОшибки() Экспорт

	Возврат _КодОшибки;

КонецФункции

// Возвращает сообщение кадра.
//
// Возвращаемое значение:
//  Строка - Сообщение кадра.
Функция Сообщение() Экспорт

	Возврат _Сообщение;

КонецФункции

// Возвращает данные кадра.
//
// Возвращаемое значение:
//  Произвольный, Неопределено - Данные кадра.
Функция Данные() Экспорт

	Возврат _Данные;

КонецФункции

// Возвращает подсказку кадра.
//
// Возвращаемое значение:
//  Строка - Подсказка кадра.
Функция Подсказка() Экспорт

	Возврат _Подсказка;

КонецФункции

// Возвращает имя модуля кадра.
//
// Возвращаемое значение:
//  Строка - Имя модуля кадра.
Функция ИмяМодуля() Экспорт

	Возврат _ИмяМодуля;

КонецФункции

// Возвращает номер строки кадра.
//
// Возвращаемое значение:
//  Число - Номер строки кадра.
Функция НомерСтроки() Экспорт

	Возврат _НомерСтроки;

КонецФункции

// Возвращает исходную строку кадра.
//
// Возвращаемое значение:
//  Строка - Исходная строка кадра.
Функция ИсходнаяСтрока() Экспорт

	Возврат _ИсходнаяСтрока;

КонецФункции

// Возвращает независимую копию стека кадра.
//
// Возвращаемое значение:
//  Массив - Копия стека кадра.
Функция Стек() Экспорт

	Результат = Новый Массив;
	Для Каждого Элемент Из _Стек Цикл
		Результат.Добавить(Элемент);
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЗначениеСвойства(Параметры, Имя, ЗначениеПоУмолчанию)

	Результат = Неопределено;
	Если Не Параметры.Свойство(Имя, Результат) Тогда
		Результат = ЗначениеПоУмолчанию;
	КонецЕсли;

	Возврат Результат;

КонецФункции

#КонецОбласти
