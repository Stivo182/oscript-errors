&ИсточникЗначение("НеизвестнаяКодировка", "Кодировка")
&ИсточникЗначение("НарушенВнутреннийИнвариант", "Инвариант")
Процедура ТестДолжен_ПроверитьОбщиеКонтрактыИнфраструктурнойФабрики(
	ИмяФабрики,
	ИмяПараметра
) Экспорт

	// Подготовка
	КорректноеЗначение = ТестовоеЗначениеПоля(ИмяПараметра);
	ВторойПараметр = ТестовыйВторойПараметрФабрики(ИмяФабрики);

	// Действие
	ОшибкаТипа = ОшибкаИнфраструктурнойФабрики(ИмяФабрики, 42, ВторойПараметр);
	ОшибкаЗаполнения = ОшибкаИнфраструктурнойФабрики(ИмяФабрики, "", ВторойПараметр);
	ОшибкаСообщения = ОшибкаИнфраструктурнойФабрики(
		ИмяФабрики,
		КорректноеЗначение,
		ВторойПараметр,
		42
	);

	// Проверка
	ПроверитьОшибкуКонтракта(ОшибкаТипа, "argument.invalid_type", ИмяПараметра);
	ПроверитьОшибкуКонтракта(ОшибкаЗаполнения, "argument.required", ИмяПараметра);
	ПроверитьОшибкуКонтракта(ОшибкаСообщения, "argument.invalid_type", "Сообщение");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("АргументВнеДиапазона", "ОжидаемыйДиапазон")
&ИсточникЗначение("ДанныеСлишкомБольшие", "Ограничение")
&ИсточникЗначение("НевернаяКодировкаДанных", "Кодировка")
Процедура ТестДолжен_ПроверитьВторойПараметрИнфраструктурнойФабрики(
	ИмяФабрики,
	ИмяПараметра
) Экспорт

