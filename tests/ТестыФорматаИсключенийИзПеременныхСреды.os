#Использовать asserts
#Использовать logos
#Использовать "../src"

Перем _ИсходныйФормат;
Перем _ИсходныеРазделы;
Перем _Лог;
Перем _ИсходныйУровеньЛога;
Перем _СообщенияЛога;

#Область ОбработчикиСобытий

&ПередКаждым
Процедура СохранитьПеременныеСреды() Экспорт

	_ИсходныйФормат = ПолучитьПеременнуюСреды("ONESCRIPT_ERRORS_FORMAT");
	_ИсходныеРазделы = ПолучитьПеременнуюСреды("ONESCRIPT_ERRORS_SECTIONS");
	_Лог = Неопределено;
	_ИсходныйУровеньЛога = Неопределено;
	_СообщенияЛога = Неопределено;

КонецПроцедуры

&ПослеКаждого
Процедура ЗавершитьТест() Экспорт

	ВосстановитьПеременныеСреды(_ИсходныйФормат, _ИсходныеРазделы);
	Если _Лог <> Неопределено Тогда
		_Лог.УдалитьСпособВывода(ЭтотОбъект);
		Если _ИсходныйУровеньЛога <> Неопределено Тогда
			_Лог.УстановитьУровень(_ИсходныйУровеньЛога);
		КонецЕсли;
		Логирование.ЗакрытьЛог(_Лог);
		_Лог = Неопределено;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область Тесты

&Тест
Процедура ТестДолжен_ЗаписатьДиагностическоеПредставлениеВОписание() Экспорт

	// Подготовка
	УстановитьПеременнуюСреды("ONESCRIPT_ERRORS_FORMAT", " DiAgNoStIc ");
	УстановитьПеременнуюСреды("ONESCRIPT_ERRORS_SECTIONS", "unknown");
	Данные = Новый Структура("Формат", "JSON");

	// Действие
	Ошибка = Новый ПостроительОшибки("config.invalid", "Ошибка конфигурации")
		.ПроизвольныеДанные(Данные)
		.Подсказка("Проверьте файл")
		.Построить();

	// Проверка
	Ожидаем.Что(Ошибка.Описание).Равно(
		"config.invalid: Ошибка конфигурации
		|
		|Данные:
		|  Формат: JSON
		|
		|Подсказка:
		|  Проверьте файл"
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗаписатьВыбранныеРазделыВЗаданномПорядке() Экспорт

	// Подготовка
	УстановитьПеременнуюСреды("ONESCRIPT_ERRORS_FORMAT", "user");
	Причина = ФабрикаОшибок.Создать("storage.read_failed", "Не удалось прочитать файл");
	УстановитьПеременнуюСреды("ONESCRIPT_ERRORS_FORMAT", "sections");
	УстановитьПеременнуюСреды(
		"ONESCRIPT_ERRORS_SECTIONS",
		" urls, current, causes "
	);

	// Действие
	Ошибка = Новый ПостроительОшибки("config.load_failed", "Не удалось загрузить конфигурацию")
		.Причина(Причина)
		.Подсказка("Проверьте файл")
		.URL("https://example.org/errors/config-load-failed")
		.Построить();

	// Проверка
	Ожидаем.Что(Ошибка.Описание).Равно(
		"URL:
		|  https://example.org/errors/config-load-failed
		|
		|config.load_failed: Не удалось загрузить конфигурацию
		|
		|Причина:
		|  storage.read_failed: Не удалось прочитать файл"
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВывестиПовторяющиесяРазделыОдинРаз() Экспорт

	// Подготовка
	УстановитьПеременнуюСреды("ONESCRIPT_ERRORS_FORMAT", "sections");
	УстановитьПеременнуюСреды("ONESCRIPT_ERRORS_SECTIONS", "hints,current,hints,,current");

	// Действие
	Ошибка = Новый ПостроительОшибки("config.invalid", "Ошибка конфигурации")
		.Подсказка("Проверьте файл")
		.Построить();

	// Проверка
	Ожидаем.Что(Ошибка.Описание).Равно(
		"Подсказка:
		|  Проверьте файл
		|
		|config.invalid: Ошибка конфигурации"
	);

КонецПроцедуры

&Тест
&Параметры("")
&Параметры(",,,")
&Параметры("unknown")
&Параметры("current,unknown")
Процедура ТестДолжен_ИспользоватьПользовательскийФорматПриНекорректныхРазделах(Разделы) Экспорт

	// Подготовка
	УстановитьПеременнуюСреды("ONESCRIPT_ERRORS_FORMAT", "sections");
	УстановитьПеременнуюСреды("ONESCRIPT_ERRORS_SECTIONS", Разделы);

	// Действие
	Ошибка = Новый ПостроительОшибки("config.invalid", "Ошибка конфигурации")
		.Подсказка("Проверьте файл")
		.Построить();

	// Проверка
	Ожидаем.Что(Ошибка.Описание).Равно(
		"config.invalid: Ошибка конфигурации
		|
		|Подсказка:
		|  Проверьте файл"
	);

КонецПроцедуры

&Тест
&Параметры("")
&Параметры("user")
&Параметры("unknown")
Процедура ТестДолжен_ИспользоватьПользовательскоеПредставлениеДляПользовательскогоФормата(Формат) Экспорт

	// Подготовка
