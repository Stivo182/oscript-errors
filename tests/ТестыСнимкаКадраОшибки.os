&Тест
Процедура ТестДолжен_ОтличитьОшибкуЧтенияПричиныОтЕеОтсутствия() Экспорт

	// Действие
	Результат = ОбходЦепочкиОшибки.ПрочитатьПричину(42);

	// Проверка
	Ожидаем.Что(Результат.Причина).Равно(Неопределено);
	Ожидаем.Что(Результат.Прочитана).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьСнимокСобственногоКадра() Экспорт

	// Подготовка
	Данные = Новый Структура("Путь", "config.json");
	Ошибка = ФабрикаОшибок.Создать("fs.file_not_found", "Файл не найден", Данные);
	Ошибка = ПомощникТестированияОшибок.ПовторноВыброшеннаяОшибка(Ошибка);

	// Действие
	Снимок = Новый СнимокКадраОшибки(Ошибка);

	// Проверка
	Ожидаем.Что(ТипЗнч(Снимок)).Равно(Тип("СнимокКадраОшибки"));
	Ожидаем.Что(Снимок.Вид()).Равно("Ошибка");
	Ожидаем.Что(Снимок.КодОшибки()).Равно("fs.file_not_found");
	Ожидаем.Что(Снимок.Сообщение()).Равно("Файл не найден");
	Ожидаем.Что(Снимок.Данные()).Равно(Данные);

КонецПроцедуры

