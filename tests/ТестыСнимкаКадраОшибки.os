#Область Тесты

&Тест
Процедура ТестДолжен_ОтличитьОшибкуЧтенияПричиныОтЕеОтсутствия() Экспорт

	// Действие
	Результат = ОбходЦепочкиОшибки.ПрочитатьПричину(42);

	// Проверка
	Ожидаем.Что(Результат.Причина).Равно(Неопределено);
	Ожидаем.Что(Результат.Прочитана).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьСнимокСобственногоКадра() Экспорт

	// Подготовка
	Данные = Новый Структура("Путь", "config.json");
	Ошибка = ФабрикаОшибок.Создать("fs.file_not_found", "Файл не найден", Данные);
	Ошибка = ПомощникТестированияОшибок.ПовторноВыброшеннаяОшибка(Ошибка);

	// Действие
	Снимок = Новый СнимокКадраОшибки(Ошибка);

	// Проверка
	Ожидаем.Что(ТипЗнч(Снимок)).Равно(Тип("СнимокКадраОшибки"));
	Ожидаем.Что(Снимок.Вид()).Равно("Ошибка");
	Ожидаем.Что(Снимок.КодОшибки()).Равно("fs.file_not_found");
	Ожидаем.Что(Снимок.Сообщение()).Равно("Файл не найден");
	Ожидаем.Что(Снимок.Данные()).Равно(Данные);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("connection.refused", "connection", Истина)
&ИсточникЗначение("connection.tls.expired", "connection.tls", Истина)
&ИсточникЗначение("connection.refused", "CONNECTION", Истина)
&ИсточникЗначение("connection.refused", "connection.refused", Истина)
&ИсточникЗначение("connectionless.failed", "connection", Ложь)
&ИсточникЗначение("database.connection.refused", "connection", Ложь)
Процедура ТестДолжен_ОпределитьПринадлежностьСнимкаГруппе(
	КодОшибки,
	ГруппаОшибок,
	ОжидаемыйРезультат
) Экспорт

	// Подготовка
	Снимок = Новый СнимокКадраОшибки(ФабрикаОшибок.Создать(КодОшибки, "Ошибка"));

	// Действие
	Результат = Снимок.ПринадлежитГруппе(ГруппаОшибок);

	// Проверка
	Ожидаем.Что(Результат).Равно(ОжидаемыйРезультат);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеОтнестиКонтекстныйКадрКГруппе() Экспорт

	// Подготовка
	Причина = ФабрикаОшибок.Создать("connection.refused", "В соединении отказано");
	Контекст = ФабрикаОшибок.ОбернутьКонтекстом(Причина, "Подключение к серверу");
	Снимок = Новый СнимокКадраОшибки(Контекст);

	// Действие
	Результат = Снимок.ПринадлежитГруппе("connection");

	// Проверка
	Ожидаем.Что(Результат).ЭтоЛожь();

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("")
&ИсточникЗначение(".connection")
&ИсточникЗначение("connection.")
&ИсточникЗначение("connection..tls")
Процедура ТестДолжен_ОтклонитьНекорректныйФорматГруппыОшибок(ГруппаОшибок) Экспорт

	// Подготовка
	Снимок = Новый СнимокКадраОшибки(ФабрикаОшибок.Создать("connection.refused", "Ошибка"));
	Ошибка = Неопределено;

	// Действие
	Попытка
		Снимок.ПринадлежитГруппе(ГруппаОшибок);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;

	// Проверка
	ПроверитьКонтрактноеИсключениеГруппы(
		Ошибка,
		"argument.invalid_value",
		"Ожидание",
		"формату группы ошибок"
	);

КонецПроцедуры

