&Тест
Процедура ТестДолжен_ЛокализоватьЗаголовкиДиагностическогоПредставления() Экспорт

	// Подготовка
	Стек = Новый Массив;
	Стек.Добавить("StartApplication:10");
	Снимки = Новый Массив;
	Снимки.Добавить(Новый ТестовыйСнимокКадраОшибки(
		Новый Структура(
			"Вид, КодОшибки, Сообщение, Данные, Подсказка, ИмяМодуля, НомерСтроки, Стек",
			ВидыКадровОшибок.Ошибка(),
			"application.failed",
			"Operation failed",
			Новый Структура("Attempt", 1),
			"Retry the operation",
			"Application.os",
			10,
			Стек
		)
	));
	Снимки.Добавить(Новый ТестовыйСнимокКадраОшибки(
		Новый Структура("Вид, Сообщение", ВидыКадровОшибок.Контекст(), "Reading settings")
	));
	Снимки.Добавить(Новый ТестовыйСнимокКадраОшибки(
		Новый Структура(
			"Вид, Сообщение, НомерСтроки, ИсходнаяСтрока",
			ВидыКадровОшибок.ВнешняяОшибка(),
			"File not found",
			42,
			"ReadFile();"
		)
	));

	// Действие
	Представление = ФорматированиеПредставленияОшибок.ДиагностическоеПредставление(Снимки, Истина);
	СнимкиНепросмотренногоКонтекста = Новый Массив;
	СнимкиНепросмотренногоКонтекста.Добавить(Новый ТестовыйСнимокКадраОшибки(
		Новый Структура("Вид, Сообщение", ВидыКадровОшибок.Контекст(), "Starting application")
	));
	НепросмотренныйКонтекст = ФорматированиеПредставленияОшибок.ДиагностическоеПредставление(
		СнимкиНепросмотренногоКонтекста,
		Истина
	);

	// Проверка
	ПолноеПредставление = Представление + Символы.ПС + НепросмотренныйКонтекст;
	Для Каждого Заголовок Из ЛокализованныеЗаголовкиДиагностическогоПредставления() Цикл
		Ожидаем.Что(ПолноеПредставление).Содержит(Заголовок);
	КонецЦикла;
	Если ЭтоАнглийскаяЛокаль() Тогда
		ПроверитьОтсутствиеСтрок(ПолноеПредставление, РусскиеЗаголовкиДиагностическогоПредставления());
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Пробелы(Количество)

	Результат = "";
	Для Номер = 1 По Количество Цикл
		Результат = Результат + " ";
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ЛокализованныеЗаголовкиДиагностическогоПредставления()

	Результат = Новый Массив;
	Результат.Добавить(НСтр("ru = 'Причина:'; en = 'Cause:'"));
	Результат.Добавить(НСтр("ru = 'Контекст:'; en = 'Context:'"));
	Результат.Добавить(НСтр("ru = 'Данные:'; en = 'Data:'"));
	Результат.Добавить(НСтр("ru = 'Место:'; en = 'Location:'"));
	Результат.Добавить(НСтр("ru = 'Строка:'; en = 'Line:'"));
	Результат.Добавить(НСтр("ru = 'Исходная строка:'; en = 'Source line:'"));
	Результат.Добавить(НСтр("ru = 'Подсказка:'; en = 'Hint:'"));
	Результат.Добавить(НСтр("ru = 'Стек вызовов:'; en = 'Call stack:'"));
	Результат.Добавить(НСтр("ru = 'Цепочка причин усечена'; en = 'Cause chain truncated'"));
	Результат.Добавить(
		НСтр("ru = 'Контекст без просмотренной причины:'; en = 'Context without an inspected cause:'")
	);

	Возврат Результат;

КонецФункции

Функция РусскиеЗаголовкиДиагностическогоПредставления()

	Результат = Новый Массив;
	Результат.Добавить("Причина:");
	Результат.Добавить("Контекст:");
	Результат.Добавить("Данные:");
	Результат.Добавить("Место:");
	Результат.Добавить("Строка:");
	Результат.Добавить("Исходная строка:");
	Результат.Добавить("Подсказка:");
	Результат.Добавить("Стек вызовов:");
	Результат.Добавить("Цепочка причин усечена");
	Результат.Добавить("Контекст без просмотренной причины:");

	Возврат Результат;

КонецФункции

Функция ЭтоАнглийскаяЛокаль()

	Возврат НСтр("ru = 'ru'; en = 'en'") = "en";

КонецФункции

Процедура ПроверитьОтсутствиеСтрок(Текст, ЗапрещенныеСтроки)

	Для Каждого ЗапрещеннаяСтрока Из ЗапрещенныеСтроки Цикл
		Ожидаем.Что(СтрЧислоВхождений(Текст, ЗапрещеннаяСтрока)).Равно(0);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
