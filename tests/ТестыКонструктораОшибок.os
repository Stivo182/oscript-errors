#Использовать asserts
#Использовать "../src"

#Область Тесты

&Тест
Процедура ТестДолжен_ПостроитьОшибкуЧерезFluentИнтерфейс() Экспорт

	// Подготовка
	ПервыеДанные = Новый Структура("Прокси", "old");
	ИтоговыеДанные = Новый Структура("Прокси", "proxy.example.org");
	Конструктор = Новый КонструкторОшибки("http.proxy_error", "Ошибка прокси");

	// Действие
	РезультатНастройки = Конструктор
		.Данные(ПервыеДанные)
		.Данные(ИтоговыеДанные)
		.Подсказка("Старая подсказка")
		.Подсказка("Проверьте настройки прокси");
	Ошибка = Конструктор.Построить();

	// Проверка
	Снимок = Новый СнимокКадраОшибки(Ошибка);
	Ожидаем.Что(РезультатНастройки).Равно(Конструктор);
	Ожидаем.Что(Снимок.Вид()).Равно(ВидыКадровОшибок.Ошибка);
	Ожидаем.Что(Снимок.Данные()).Равно(ИтоговыеДанные);
	Ожидаем.Что(Снимок.Подсказка()).Равно("Проверьте настройки прокси");
	Ожидаем.Что(Ошибка.Причина).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПостроитьОбернутуюОшибку() Экспорт

	// Подготовка
	Причина = ФабрикаОшибок.Создать("network.unavailable", "Сеть недоступна");
	Конструктор = Новый КонструкторОшибки("http.proxy_error", "Ошибка прокси");

	// Действие
	Ошибка = Конструктор.Причина(Причина).Построить();

	// Проверка
	Ожидаем.Что(Ошибка.Причина).Равно(Причина);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьКонструкторИзФабрики() Экспорт

	// Действие
	Конструктор = ФабрикаОшибок.Конструктор("http.proxy_error", "Ошибка прокси");

	// Проверка
	Ожидаем.Что(ТипЗнч(Конструктор)).Равно(Тип("КонструкторОшибки"));
	Ожидаем.Что(ТипЗнч(Конструктор.Построить())).Равно(Тип("ИнформацияОбОшибке"));

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПроверитьПодсказкуПриПостроении() Экспорт

	// Подготовка
	Параметры = Новый Массив;
	Параметры.Добавить(42);

	// Действие и Проверка
	Ожидаем.Что(ЭтотОбъект)
		.Метод("ПостроитьСПодсказкой", Параметры)
		.ВыбрасываетИсключение("Подсказка должна быть строкой");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПроверитьТипОшибкиПриПостроении() Экспорт

	// Подготовка
	Параметры = Новый Массив;
	Параметры.Добавить("НекорректныйТип");

	// Действие и Проверка
	Ожидаем.Что(ЭтотОбъект)
		.Метод("ПостроитьСТипомОшибки", Параметры)
		.ВыбрасываетИсключение("Тип ошибки имеет неверный формат");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПроверитьСообщениеПриПостроении() Экспорт

	// Подготовка
	Параметры = Новый Массив;
	Параметры.Добавить("");

	// Действие и Проверка
	Ожидаем.Что(ЭтотОбъект)
		.Метод("ПостроитьССообщением", Параметры)
		.ВыбрасываетИсключение("Сообщение должно быть непустой строкой");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПроверитьПричинуПриПостроении() Экспорт

	// Подготовка
	Параметры = Новый Массив;
	Параметры.Добавить(42);

	// Действие и Проверка
	Ожидаем.Что(ЭтотОбъект)
		.Метод("ПостроитьСПричиной", Параметры)
		.ВыбрасываетИсключение("Причина должна иметь тип ИнформацияОбОшибке");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьНеизвестныйВидКадра() Экспорт

	// Подготовка
	Параметры = Новый Массив;
	Параметры.Добавить("НеизвестныйВид");

	// Действие и Проверка
	Ожидаем.Что(ЭтотОбъект)
		.Метод("ПостроитьСВидом", Параметры)
		.ВыбрасываетИсключение("Вид кадра ошибки не поддерживается");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьТипОшибкиУКонтекстногоКадра() Экспорт

	// Действие и Проверка
	Ожидаем.Что(ЭтотОбъект)
		.Метод("ПостроитьКонтекстСТипом")
		.ВыбрасываетИсключение("Тип ошибки контекстного кадра должен быть равен Неопределено");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПотребоватьПричинуДляКонтекстногоКадра() Экспорт

	// Действие и Проверка
	Ожидаем.Что(ЭтотОбъект)
		.Метод("ПостроитьКонтекстБезПричины")
		.ВыбрасываетИсключение("Контекстный кадр должен иметь причину");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПостроитьСПодсказкой(Подсказка) Экспорт

	Возврат Новый КонструкторОшибки("http.proxy_error", "Ошибка прокси")
		.Подсказка(Подсказка)
		.Построить();

КонецФункции

Функция ПостроитьСТипомОшибки(ТипОшибки) Экспорт

	Возврат Новый КонструкторОшибки(ТипОшибки, "Ошибка прокси").Построить();

КонецФункции

Функция ПостроитьССообщением(Сообщение) Экспорт

	Возврат Новый КонструкторОшибки("http.proxy_error", Сообщение).Построить();

КонецФункции

Функция ПостроитьСПричиной(Причина) Экспорт

	Возврат Новый КонструкторОшибки("http.proxy_error", "Ошибка прокси")
		.Причина(Причина)
		.Построить();

КонецФункции

Функция ПостроитьСВидом(Вид) Экспорт

	Возврат Новый КонструкторОшибки("http.proxy_error", "Ошибка прокси", Вид).Построить();

КонецФункции

Функция ПостроитьКонтекстСТипом() Экспорт

	Причина = ФабрикаОшибок.Создать("network.unavailable", "Сеть недоступна");
	Возврат Новый КонструкторОшибки("http.proxy_error", "Ошибка прокси", ВидыКадровОшибок.Контекст)
		.Причина(Причина)
		.Построить();

КонецФункции

Функция ПостроитьКонтекстБезПричины() Экспорт

	Возврат Новый КонструкторОшибки(Неопределено, "Ошибка прокси", ВидыКадровОшибок.Контекст)
		.Построить();

КонецФункции

#КонецОбласти
