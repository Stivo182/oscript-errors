// Демонстрирует поиск всех ошибок выбранных кодов и работу с неизменяемой выборкой.
// Повторы сохраняются, а коды в CSV-фильтре сравниваются без учёта регистра.

#Использовать errors

Причина = ФабрикаОшибок.Создать(
	"database.timeout",
	"Первый таймаут базы данных",
	Новый Структура("Узел", "db-1"),
	"Повторите запрос"
);
Причина = ФабрикаОшибок.Обернуть(
	Причина,
	"network.timeout",
	"Сетевой таймаут"
);
Ошибка = ФабрикаОшибок.Обернуть(
	Причина,
	"database.timeout",
	"Второй таймаут базы данных",
	Новый Структура("Узел", "db-2")
);

Исследователь = Новый ИсследовательОшибки(Ошибка);
Выборка = Исследователь.НайтиОшибки(" DATABASE.TIMEOUT, network.timeout ");

Сообщить("Найдено ошибок: " + Строка(Выборка.Количество()));
Сообщить("Первая: " + Выборка.Первая().Сообщение());
Сообщить("Последняя: " + Выборка.Последняя().Сообщение());

Коды = Выборка.Коды();
Данные = Выборка.Данные();
Подсказки = Выборка.Подсказки();
Для Номер = 0 По Выборка.Количество() - 1 Цикл
	ТекстДанных = "нет";
	Если Данные[Номер] <> Неопределено Тогда
		ТекстДанных = Данные[Номер].Узел;
	КонецЕсли;

	Сообщить(СтрШаблон(
		"- %1; данные: %2; подсказка: %3",
		Коды[Номер],
		ТекстДанных,
		Подсказки[Номер]
	));
КонецЦикла;

Группы = Выборка.ГруппыПоКоду();
Сообщить("Таймаутов базы данных: " + Строка(Группы.Получить("database.timeout").Количество()));
Сообщить("Сетевых таймаутов: " + Строка(Группы.Получить("network.timeout").Количество()));
