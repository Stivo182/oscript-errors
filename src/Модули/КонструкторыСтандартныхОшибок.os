КонецФункции

// Возвращает конструктор для ошибки некорректных данных.
//
// Параметры:
//  ИмяДанных - Строка - Безопасное диагностическое имя данных.
//  Сообщение - Строка - Человекочитаемое описание ошибки.
//
// Возвращаемое значение:
//  КонструкторОшибки - Настроенный конструктор ошибки.
Функция НекорректныеДанные(ИмяДанных, Сообщение = "") Экспорт

	ПроверитьСтандартныйПараметр("ИмяДанных", ИмяДанных, Сообщение);

	Возврат СоздатьОднопараметрическуюОшибку(
		"data.invalid",
		"ИмяДанных",
		ИмяДанных,
		НСтр(
			"ru = 'Данные ''%1'' имеют недопустимый формат или содержимое';"
			+ "en = 'Data ''%1'' has an invalid format or content'"
		),
		Сообщение
	);

КонецФункции

// Возвращает конструктор для ошибки слишком больших данных.
//
// Параметры:
//  ИмяДанных - Строка - Безопасное диагностическое имя данных.
//  Ограничение - Строка - Описание допустимого размера.
//  Сообщение - Строка - Человекочитаемое описание ошибки.
//
// Возвращаемое значение:
//  КонструкторОшибки - Настроенный конструктор ошибки.
Функция ДанныеСлишкомБольшие(ИмяДанных, Ограничение, Сообщение = "") Экспорт

	ПроверитьДваСтандартныхПараметра(
		"ИмяДанных",
		ИмяДанных,
		"Ограничение",
		Ограничение,
		Сообщение
	);

	Возврат СоздатьДвухпараметрическуюОшибку(
		"data.too_large",
		"ИмяДанных",
		ИмяДанных,
		"Ограничение",
		Ограничение,
		НСтр(
			"ru = 'Размер данных ''%1'' превышает допустимый предел: %2';"
			+ "en = 'Data ''%1'' exceeds the allowed size: %2'"
		),
		Сообщение
	);

КонецФункции

// Возвращает конструктор для ошибки повреждённых данных.
//
// Параметры:
//  ИмяДанных - Строка - Безопасное диагностическое имя данных.
//  Сообщение - Строка - Человекочитаемое описание ошибки.
//
// Возвращаемое значение:
