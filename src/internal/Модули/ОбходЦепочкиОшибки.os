Перем _МаксимальноеКоличествоКадров; // Число

#Область СлужебныйПрограммныйИнтерфейс

// Просматривает физическую цепочку ошибки от внешнего кадра к корневому.
// Просмотр ограничен 64 кадрами и терпим к повреждённым причинам.
//
// Параметры:
//  Ошибка - ИнформацияОбОшибке - Внешний кадр просматриваемой цепочки.
//
// Возвращаемое значение:
//  Структура:
//   * Кадры - Массив из ИнформацияОбОшибке - Просмотренные физические кадры;
//   * Усечена - Булево - Признак наличия непросмотренной причины.
Функция Просмотреть(Ошибка) Экспорт

	ПроверкаКадровОшибок.ПроверитьОшибку(Ошибка);

	Результат = Новый Структура("Кадры, Усечена", Новый Массив, Ложь);
	ТекущийКадр = Ошибка;

	Для НомерКадра = 1 По _МаксимальноеКоличествоКадров Цикл
		Результат.Кадры.Добавить(ТекущийКадр);
		ЧтениеПричины = ПрочитатьПричину(ТекущийКадр);

		Если Не ЧтениеПричины.Прочитана Тогда
			Результат.Усечена = Истина;
			Возврат Результат;
		КонецЕсли;

		Если ЧтениеПричины.Причина = Неопределено Тогда
			Возврат Результат;
		КонецЕсли;

		Если НомерКадра = _МаксимальноеКоличествоКадров Тогда
			Результат.Усечена = Истина;
			Возврат Результат;
		КонецЕсли;

		ТекущийКадр = ЧтениеПричины.Причина;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Безопасно читает непосредственную причину кадра.
//
// Параметры:
//  Кадр - Произвольный - Кадр с доступным для чтения свойством Причина.
//
// Возвращаемое значение:
//  Структура:
//   * Причина - ИнформацияОбОшибке, Неопределено - Прочитанная причина;
//   * Прочитана - Булево - Признак успешного чтения свойства Причина.
Функция ПрочитатьПричину(Кадр) Экспорт

	Результат = Новый Структура("Причина, Прочитана", Неопределено, Ложь);

	Попытка
		Причина = Кадр.Причина;
	Исключение
		Возврат Результат;
	КонецПопытки;

	Результат.Прочитана = Истина;
	Если ТипЗнч(Причина) = Тип("ИнформацияОбОшибке") Тогда
		Результат.Причина = Причина;
	КонецЕсли;

	Возврат Результат;

КонецФункции

#КонецОбласти

_МаксимальноеКоличествоКадров = 64;
