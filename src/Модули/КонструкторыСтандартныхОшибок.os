//
// Параметры:
//  Узел - Строка - Безопасное диагностическое имя удалённого узла.
//  Сообщение - Строка - Человекочитаемое описание ошибки.
//
// Возвращаемое значение:
//  КонструкторОшибки - Настроенный конструктор ошибки.
Функция СоединениеОтклонено(Узел, Сообщение = "") Экспорт

	ПроверитьСтандартныйПараметр("Узел", Узел, Сообщение);

	Возврат СоздатьОднопараметрическуюОшибку(
		"connection.refused",
		"Узел",
		Узел,
		НСтр(
			"ru = 'Удаленная сторона отказала в соединении с узлом ''%1''';"
			+ "en = 'Connection to host ''%1'' was refused'"
		),
		Сообщение
	);

КонецФункции

// Возвращает конструктор для ошибки сброшенного соединения.
//
// Параметры:
//  Узел - Строка - Безопасное диагностическое имя удалённого узла.
//  Сообщение - Строка - Человекочитаемое описание ошибки.
//
// Возвращаемое значение:
//  КонструкторОшибки - Настроенный конструктор ошибки.
Функция СоединениеСброшено(Узел, Сообщение = "") Экспорт

	ПроверитьСтандартныйПараметр("Узел", Узел, Сообщение);

	Возврат СоздатьОднопараметрическуюОшибку(
		"connection.reset",
		"Узел",
		Узел,
		НСтр("ru = 'Соединение с узлом ''%1'' было сброшено'; en = 'Connection to host ''%1'' was reset'"),
		Сообщение
	);

КонецФункции

