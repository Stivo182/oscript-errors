// Демонстрирует запросы к сохранённым снимкам полной цепочки ошибки.
// Исследователь один раз просматривает цепочку и повторно использует результат.

#Использовать errors

Причина = ФабрикаОшибок.Создать(
	"fs.file_not_found",
	"Файл настроек не найден",
	Новый Структура("Путь", "application.json")
);
Ошибка = ФабрикаОшибок.Обернуть(
	Причина,
	"config.load_failed",
	"Не удалось загрузить настройки"
);
Ошибка = ФабрикаОшибок.СКонтекстом(Ошибка, "Запуск приложения");

Исследователь = Новый ИсследовательОшибки(Ошибка);

Сообщить("Кадров: " + Строка(Исследователь.Кадры().Количество()));
Сообщить("Ошибок: " + Строка(Исследователь.Ошибки().Количество()));
Сообщить("Контекстов: " + Строка(Исследователь.Контексты().Количество()));
Сообщить("Эффективный тип: " + Исследователь.ЭффективнаяОшибка().ТипОшибки());

Корень = Исследователь.КорневаяПричина();
Если Корень <> Неопределено Тогда
	Сообщить("Корневой тип: " + Корень.ТипОшибки());
КонецЕсли;

Сообщить("Физическая цепочка:");
Для Каждого Снимок Из Исследователь.Кадры() Цикл
	Сообщить(СтрШаблон("- %1: %2", Снимок.Вид(), Снимок.Сообщение()));
КонецЦикла;
