#Область Тесты

&Тест
Процедура ТестДолжен_ВернутьСтруктурныйСнимокСмешаннойЦепочки() Экспорт

	// Подготовка
	Цепочка = СмешаннаяЦепочка();

	// Действие
	Снимок = ДиагностикаОшибок.ВСтруктуру(Цепочка.Ошибка);

	// Проверка
	ПроверитьПоляСнимка(Снимок);
	Ожидаем.Что(Снимок.ТипОшибки).Равно("config.load_failed");
	Ожидаем.Что(Снимок.Усечена).Равно(Ложь);
	Ожидаем.Что(Снимок.СнимкиКадров.Количество()).Равно(4);
	Ожидаем.Что(ТипЗнч(Снимок.СнимкиКадров[0])).Равно(Тип("СнимокКадраОшибки"));
	Ожидаем.Что(Снимок.СнимкиКадров[0].Вид()).Равно("Контекст");
	Ожидаем.Что(Снимок.СнимкиКадров[1].Вид()).Равно("Ошибка");
	Ожидаем.Что(Снимок.СнимкиКадров[2].Вид()).Равно("ВнешняяОшибка");
	Ожидаем.Что(Снимок.СнимкиКадров[3].Вид()).Равно("Ошибка");
	Ожидаем.Что(Снимок.СнимкиКадров[0].ТипОшибки()).Равно("");
	Ожидаем.Что(Снимок.СнимкиКадров[1].ТипОшибки()).Равно("config.load_failed");
	Ожидаем.Что(Снимок.СнимкиКадров[2].ТипОшибки()).Равно("");
	Ожидаем.Что(Снимок.СнимкиКадров[3].ТипОшибки()).Равно("fs.file_not_found");
	Ожидаем.Что(Снимок.СнимкиКадров[0].Данные()).Равно(Цепочка.ДанныеКонтекста);
	Ожидаем.Что(Снимок.СнимкиКадров[1].Данные()).Равно(Цепочка.ДанныеЭффективнойОшибки);
	Ожидаем.Что(Снимок.СнимкиКадров[2].Данные()).Равно(Неопределено);
	Ожидаем.Что(Снимок.СнимкиКадров[3].Данные()).Равно(Цепочка.ДанныеВнутреннейОшибки);
	Ожидаем.Что(Снимок.СнимкиКадров[2].Сообщение()).Равно("Ошибка JSON-парсера");

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеПереноситьЧужиеПараметрыВДанные() Экспорт

	// Подготовка
	ВнешняяОшибка = ПомощникТестированияОшибок.ВнешняяОшибка("Внешняя ошибка");
	ВнешняяОшибка = ПомощникТестированияОшибок.ПовторноВыброшеннаяОшибка(ВнешняяОшибка);

	// Действие
	Снимок = ДиагностикаОшибок.ВСтруктуру(ВнешняяОшибка);

	// Проверка
	Ожидаем.Что(Снимок.ТипОшибки).Равно(Неопределено);
	Ожидаем.Что(Снимок.СнимкиКадров[0].Вид()).Равно("ВнешняяОшибка");
	Ожидаем.Что(Снимок.СнимкиКадров[0].Данные()).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СчитатьПоврежденныеИЧужиеМетаданныеВнешними() Экспорт

	// Подготовка
	ВнутренняяОшибка = ФабрикаОшибок.Создать("core.failed", "Корневая ошибка");
	ВнутренняяОшибка = ПомощникТестированияОшибок.ПовторноВыброшеннаяОшибка(ВнутренняяОшибка);
	Образец = ФабрикаОшибок.Создать("sample.error", "Образец");
	ЧужойМаркер = ПомощникТестированияОшибок.ОшибкаСЧужимМаркером(Образец, ВнутренняяОшибка);
	ЧужойМаркер = ПомощникТестированияОшибок.ПовторноВыброшеннаяОшибка(ЧужойМаркер);
	ПоврежденныйКонверт = ПомощникТестированияОшибок.ОшибкаСПоврежденнымКонвертом(Образец, ЧужойМаркер);
	ПоврежденныйКонверт = ПомощникТестированияОшибок.ПовторноВыброшеннаяОшибка(ПоврежденныйКонверт);

	// Действие
	Снимок = ДиагностикаОшибок.ВСтруктуру(ПоврежденныйКонверт);

	// Проверка
	Ожидаем.Что(Снимок.СнимкиКадров.Количество()).Равно(3);
	Ожидаем.Что(Снимок.СнимкиКадров[0].Вид()).Равно("ВнешняяОшибка");
	Ожидаем.Что(Снимок.СнимкиКадров[1].Вид()).Равно("ВнешняяОшибка");
	Ожидаем.Что(Снимок.СнимкиКадров[0].Данные()).Равно(Неопределено);
	Ожидаем.Что(Снимок.СнимкиКадров[1].Данные()).Равно(Неопределено);
	Ожидаем.Что(Снимок.СнимкиКадров[2].ТипОшибки()).Равно("core.failed");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьНовыеМассивыКадровИСтеков() Экспорт

	// Подготовка
	Ошибка = ФабрикаОшибок.Создать("core.failed", "Ошибка");
	Ошибка = ПомощникТестированияОшибок.ПовторноВыброшеннаяОшибка(Ошибка);
	ПервыйСнимок = ДиагностикаОшибок.ВСтруктуру(Ошибка);
	ВторойСнимок = ДиагностикаОшибок.ВСтруктуру(Ошибка);
	ИсходныйРазмерСтека = ПервыйСнимок.СнимкиКадров[0].Стек().Количество();

	// Действие
	ПервыйСнимок.СнимкиКадров.Добавить(Новый Структура);
	ПервыйСтек = ПервыйСнимок.СнимкиКадров[0].Стек();
	ПервыйСтек.Добавить("Проверочный элемент");

	// Проверка
	Ожидаем.Что(ВторойСнимок.СнимкиКадров.Количество()).Равно(1);
	Ожидаем.Что(ВторойСнимок.СнимкиКадров[0].Стек().Количество()).Равно(ИсходныйРазмерСтека);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СвязатьПоложениеИСтекСКаждымФизическимКадром() Экспорт

	// Подготовка
	Цепочка = ПомощникТестированияОшибок.ЦепочкаСРазнымиМестамиСоздания();

	// Действие
	Снимок = ДиагностикаОшибок.ВСтруктуру(Цепочка.Ошибка);

	// Проверка
	ПроверитьМестоположениеКадра(Снимок.СнимкиКадров[0], Цепочка.ВнешнийКадр);
	ПроверитьМестоположениеКадра(Снимок.СнимкиКадров[1], Цепочка.ВнутреннийКадр);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОграничитьСнимокШестьюдесятьюЧетырьмяКадрами() Экспорт

	// Подготовка
	ЦепочкаИз64Кадров = ДлиннаяВыброшеннаяЦепочка(64);
	ЦепочкаИз65Кадров = ДлиннаяВыброшеннаяЦепочка(65);

	// Действие
	Снимок64 = ДиагностикаОшибок.ВСтруктуру(ЦепочкаИз64Кадров.Ошибка);
	Снимок65 = ДиагностикаОшибок.ВСтруктуру(ЦепочкаИз65Кадров.Ошибка);

	// Проверка
	Ожидаем.Что(Снимок64.СнимкиКадров.Количество()).Равно(64);
	Ожидаем.Что(Снимок64.Усечена).Равно(Ложь);
	Ожидаем.Что(Снимок65.СнимкиКадров.Количество()).Равно(64);
	Ожидаем.Что(Снимок65.Усечена).Равно(Истина);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьНеверныйТипАргументаСнимка() Экспорт

	// Подготовка
	Параметры = Новый Массив;
	Параметры.Добавить("не ошибка");

	// Действие и Проверка
	Ожидаем.Что(ДиагностикаОшибок)
		.Метод("ВСтруктуру", Параметры)
		.ВыбрасываетИсключение("Ошибка должна иметь тип ИнформацияОбОшибке");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СмешаннаяЦепочка()

	ДанныеВнутреннейОшибки = Новый Структура("Путь", "config.json");
	ВнутренняяОшибка = ФабрикаОшибок.Создать("fs.file_not_found", "Файл не найден", ДанныеВнутреннейОшибки);
	ВнутренняяОшибка = ПомощникТестированияОшибок.ПовторноВыброшеннаяОшибка(ВнутренняяОшибка);
	ВнешняяОшибка = ПомощникТестированияОшибок.ВнешняяОшибка("Ошибка JSON-парсера", ВнутренняяОшибка);
	ВнешняяОшибка = ПомощникТестированияОшибок.ПовторноВыброшеннаяОшибка(ВнешняяОшибка);
	ДанныеЭффективнойОшибки = Новый Структура("Формат", "JSON");
	ЭффективнаяОшибка = ФабрикаОшибок.Обернуть(
		ВнешняяОшибка,
		"config.load_failed",
		"Не удалось загрузить конфигурацию",
		ДанныеЭффективнойОшибки
	);
	ЭффективнаяОшибка = ПомощникТестированияОшибок.ПовторноВыброшеннаяОшибка(ЭффективнаяОшибка);
	ДанныеКонтекста = Новый Структура("Операция", "Загрузка");
	Контекст = ФабрикаОшибок.СКонтекстом(ЭффективнаяОшибка, "Загрузка конфигурации", ДанныеКонтекста);
	Контекст = ПомощникТестированияОшибок.ПовторноВыброшеннаяОшибка(Контекст);

	Возврат Новый Структура(
		"Ошибка, ДанныеКонтекста, ДанныеЭффективнойОшибки, ДанныеВнутреннейОшибки",
		Контекст,
		ДанныеКонтекста,
		ДанныеЭффективнойОшибки,
		ДанныеВнутреннейОшибки
	);

КонецФункции

Функция ДлиннаяВыброшеннаяЦепочка(Длина)

	Корень = ПомощникТестированияОшибок.ВнешняяОшибка("Внешний кадр 1");
	Ошибка = ПомощникТестированияОшибок.ПовторноВыброшеннаяОшибка(Корень);

	Для НомерКадра = 2 По Длина Цикл
		Ошибка = ПомощникТестированияОшибок.ВнешняяОшибка(
			СтрШаблон("Внешний кадр %1", НомерКадра),
			Ошибка
		);
		Ошибка = ПомощникТестированияОшибок.ПовторноВыброшеннаяОшибка(Ошибка);
	КонецЦикла;

	Возврат Новый Структура("Ошибка", Ошибка);

КонецФункции

Процедура ПроверитьПоляСнимка(Снимок)

	Ожидаем.Что(Снимок.Количество()).Равно(3);
	Ожидаем.Что(Снимок.Свойство("ТипОшибки")).Равно(Истина);
	Ожидаем.Что(Снимок.Свойство("Усечена")).Равно(Истина);
	Ожидаем.Что(Снимок.Свойство("СнимкиКадров")).Равно(Истина);
	Ожидаем.Что(Снимок.Свойство("Кадры")).Равно(Ложь);
	Ожидаем.Что(Снимок.Свойство("Версия")).Равно(Ложь);

КонецПроцедуры

Процедура ПроверитьМестоположениеКадра(СнимокКадра, ИсходныйКадр)

	Ожидаем.Что(СнимокКадра.ИмяМодуля()).Равно(ИсходныйКадр.ИмяМодуля);
	Ожидаем.Что(СнимокКадра.НомерСтроки()).Равно(ИсходныйКадр.НомерСтроки);
	Ожидаем.Что(СнимокКадра.ИсходнаяСтрока()).Равно(ИсходныйКадр.ИсходнаяСтрока);
	Ожидаем.Что(СнимокКадра.Стек().Количество()).Равно(ИсходныйКадр.ПолучитьСтекВызовов().Количество());

КонецПроцедуры

#КонецОбласти
