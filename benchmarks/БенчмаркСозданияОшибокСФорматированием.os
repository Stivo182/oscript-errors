#Использовать "../src"

&Параметры("user", "diagnostic", "sections")
Перем ФорматПредставления Экспорт; // Строка

Перем _ИсходныйФормат; // Строка
Перем _ИсходныеРазделы; // Строка
Перем _Данные; // Структура
Перем _Результат; // ИнформацияОбОшибке

#Область ОбработчикиСобытий

// Создаёт бенчмарк влияния формата описания на создание ошибки.
&КоличествоИтераций(20)
&КоличествоПрогревочныхИтераций(6)
&МинимальноеВремяИтерации(250)
&МониторингПамяти
Процедура ПриСозданииОбъекта()

	_ИсходныйФормат = ПолучитьПеременнуюСреды("ONESCRIPT_ERRORS_FORMAT");
	_ИсходныеРазделы = ПолучитьПеременнуюСреды("ONESCRIPT_ERRORS_SECTIONS");

КонецПроцедуры

// Подготавливает формат и данные до начала измерения кейса.
//
// Параметры:
//  Контекст - Структура - Контекст выполняемого кейса бенчмарка.
&ПередКаждымКейсом
Процедура ПодготовитьФормат(Контекст) Экспорт

	_Данные = Новый Структура("Операция, Ресурс", "Загрузка", "config.json");
	УстановитьПеременнуюСреды("ONESCRIPT_ERRORS_FORMAT", ФорматПредставления);

	Если ФорматПредставления = "sections" Тогда
		УстановитьПеременнуюСреды("ONESCRIPT_ERRORS_SECTIONS", "current,causes");
	Иначе
		УстановитьПеременнуюСреды("ONESCRIPT_ERRORS_SECTIONS", "");
	КонецЕсли;

КонецПроцедуры

// Восстанавливает исходное окружение после измерения кейса.
//
// Параметры:
//  Контекст - Структура - Контекст завершённого кейса бенчмарка.
&ПослеКаждогоКейса
Процедура ВосстановитьФормат(Контекст) Экспорт

	УстановитьПеременнуюСреды("ONESCRIPT_ERRORS_FORMAT", _ИсходныйФормат);
	УстановитьПеременнуюСреды("ONESCRIPT_ERRORS_SECTIONS", _ИсходныеРазделы);

КонецПроцедуры

#КонецОбласти

#Область Бенчмарки

// Измеряет создание ошибки с выбранным форматом описания.
&Бенчмарк
Процедура СоздатьОшибкуСФорматированием() Экспорт

	_Результат = ФабрикаОшибок.Создать("benchmark.failed", "Ошибка операции", _Данные);

КонецПроцедуры

#КонецОбласти
