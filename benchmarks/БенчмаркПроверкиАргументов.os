#Использовать "../src"

Перем _ДопустимыеТипы; // ФиксированныйМассив из Тип
Перем _ДопустимыеЗначения; // ФиксированныйМассив из Строка
Перем _Значение; // Произвольный
Перем _РезультатОшибки; // ИнформацияОбОшибке, Неопределено

#Область ОбработчикиСобытий

// Создаёт бенчмарк успешных проверок аргументов.
&МониторингПамяти
&КоличествоИтераций(5)
&КоличествоПрогревочныхИтераций(3)
&МинимальноеВремяИтерации(100)
Процедура ПриСозданииОбъекта()

	Типы = Новый Массив;
	Типы.Добавить(Тип("Строка"));
	Типы.Добавить(Тип("Массив"));
	Типы.Добавить(Тип("ФиксированныйМассив"));

	_ДопустимыеТипы = Новый ФиксированныйМассив(Типы);
	_ДопустимыеЗначения = Новый ФиксированныйМассив(СтрРазделить("Ошибка,Контекст", ",", Ложь));
	_Значение = Новый ФиксированныйМассив(Новый Массив);

КонецПроцедуры

#КонецОбласти

#Область Бенчмарки

// Измеряет проверку одного типа.
&Бенчмарк(Наименование = "Один тип")
&Категория("Успешная проверка")
Процедура ПроверитьОдинТип() Экспорт

	ПроверкаАргументов.ПроверитьТип("Значение", "текст", Тип("Строка"));

КонецПроцедуры

// Измеряет проверку типа по фиксированному набору.
&Бенчмарк(Наименование = "Набор типов")
&Категория("Успешная проверка")
Процедура ПроверитьНаборТипов() Экспорт

	ПроверкаАргументов.ПроверитьТип("Значение", _Значение, _ДопустимыеТипы);

КонецПроцедуры

// Измеряет проверку заполненной строки.
&Бенчмарк(Наименование = "Заполненная строка")
&Категория("Успешная проверка")
Процедура ПроверитьЗаполненнуюСтроку() Экспорт

	ПроверкаАргументов.ПроверитьЗаполненность("Значение", "текст");

КонецПроцедуры

// Измеряет проверку заполненного массива.
&Бенчмарк(Наименование = "Заполненный массив")
&Категория("Успешная проверка")
Процедура ПроверитьЗаполненныйМассив() Экспорт

	ПроверкаАргументов.ПроверитьЗаполненность("Значение", _ДопустимыеТипы);

КонецПроцедуры

// Измеряет проверку числового значения внутри диапазона.
&Бенчмарк(Наименование = "Числовой диапазон")
&Категория("Успешная проверка")
Процедура ПроверитьЧисловойДиапазон() Экспорт

	ПроверкаАргументов.ПроверитьДиапазон("Значение", 5, 1, 10);

КонецПроцедуры

// Измеряет успешную проверку допустимости.
&Бенчмарк(Наименование = "Допустимость")
&Категория("Успешная проверка")
Процедура ПроверитьДопустимость() Экспорт

	ПроверкаАргументов.ПроверитьДопустимость("Значение", Истина, "быть допустимым");

КонецПроцедуры

// Измеряет успешную проверку равенства.
&Бенчмарк(Наименование = "Равенство")
&Категория("Успешная проверка")
Процедура ПроверитьРавенство() Экспорт

	ПроверкаАргументов.ПроверитьРавенство("Значение", 1, 1);

КонецПроцедуры

// Измеряет успешную проверку значения из набора.
&Бенчмарк(Наименование = "Значение из набора")
&Категория("Успешная проверка")
Процедура ПроверитьЗначениеИзНабора() Экспорт

	ПроверкаАргументов.ПроверитьДопустимоеЗначение("Значение", "Ошибка", _ДопустимыеЗначения);

КонецПроцедуры

// Измеряет создание ошибки неверного типа.
&Бенчмарк(Наименование = "Ошибка неверного типа")
&Категория("Ошибочная проверка")
Процедура СоздатьОшибкуНеверногоТипа() Экспорт

	Попытка
		ПроверкаАргументов.ПроверитьТип("Значение", 1, Тип("Строка"));
	Исключение
		_РезультатОшибки = ИнформацияОбОшибке();
	КонецПопытки;

КонецПроцедуры

#КонецОбласти
