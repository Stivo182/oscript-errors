Процедура ТестДолжен_ОтобратьОшибкиПоКодуБезУчетаРегистра() Экспорт

	// Подготовка
	Снимки = Новый Массив;
	Снимки.Добавить(СнимокОшибки("Database.Timeout", "Первый таймаут"));
