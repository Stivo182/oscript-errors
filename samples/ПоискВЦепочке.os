// Демонстрирует проверку и поиск типа во вложенной цепочке ошибок.
// Сценарий извлекает данные и подсказку найденной причины.

#Использовать errors

Причина = ФабрикаОшибок.Создать(
	"database.timeout",
	"База данных не ответила вовремя",
	Новый Структура("ТаймаутСек", 30),
	"Повторите запрос позднее"
);
Причина = ФабрикаОшибок.СКонтекстом(Причина, "Чтение списка заказов");
Ошибка = ФабрикаОшибок.Обернуть(Причина, "orders.load_failed", "Не удалось получить список заказов");

НайденнаяПричина = ДиагностикаОшибок.НайтиОшибку(Ошибка, "database.timeout");
ДанныеПричины = ДиагностикаОшибок.Данные(НайденнаяПричина);

Сообщить("Эффективный тип: " + ДиагностикаОшибок.ТипОшибки(Ошибка));
Сообщить("Есть database.timeout: " + Строка(ДиагностикаОшибок.ЭтоОшибка(Ошибка, "database.timeout")));
Сообщить(СтрШаблон("Таймаут: %1 сек", ДанныеПричины.ТаймаутСек));
Сообщить("Подсказка: " + ДиагностикаОшибок.Подсказка(НайденнаяПричина));
