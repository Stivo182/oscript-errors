&Тест
Процедура ТестДолжен_СоздатьНезависимыйСнимокСтруктурированныхДанных() Экспорт

	// Подготовка
	Конструктор = Новый КонструкторОшибки("http.proxy_error", "Ошибка прокси")
		.Данные("Прокси", "old.example.org");

	// Действие
	ПерваяОшибка = Конструктор.Построить();
	Конструктор.Данные("Прокси", "proxy.example.org");
	ВтораяОшибка = Конструктор.Построить();

	// Проверка
	ПервыеДанные = (Новый СнимокКадраОшибки(ПерваяОшибка)).Данные();
	ВторыеДанные = (Новый СнимокКадраОшибки(ВтораяОшибка)).Данные();
	Ожидаем.Что(ПервыеДанные.Прокси).Равно("old.example.org");
	Ожидаем.Что(ВторыеДанные.Прокси).Равно("proxy.example.org");

КонецПроцедуры

