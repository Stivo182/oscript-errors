Перем _РегулярноеВыражениеТипаОшибки; // РегулярноеВыражение

#Область СлужебныйПрограммныйИнтерфейс

// Проверяет корректность машинного типа ошибки.
//
// Параметры:
//  Значение - Произвольный - Проверяемое значение.
//
// Возвращаемое значение:
//  Булево - Истина, если значение является корректным типом ошибки.
Функция КорректныйТипОшибки(Значение) Экспорт

	Возврат ТипЗнч(Значение) = Тип("Строка")
		И РегулярноеВыражениеТипаОшибки().Совпадает(Значение);

КонецФункции

// Проверяет корректность сообщения ошибки.
//
// Параметры:
//  Значение - Произвольный - Проверяемое значение.
//
// Возвращаемое значение:
//  Булево - Истина, если значение является непустой строкой.
Функция КорректноеСообщение(Значение) Экспорт

	Возврат ТипЗнч(Значение) = Тип("Строка") И Не ПустаяСтрока(Значение);

КонецФункции

// Проверяет корректность подсказки ошибки.
//
// Параметры:
//  Значение - Произвольный - Проверяемое значение.
//
// Возвращаемое значение:
//  Булево - Истина, если значение является строкой.
Функция КорректнаяПодсказка(Значение) Экспорт

	Возврат ТипЗнч(Значение) = Тип("Строка");

КонецФункции

// Проверяет корректность причины ошибки.
//
// Параметры:
//  Значение - Произвольный - Проверяемое значение.
//
// Возвращаемое значение:
//  Булево - Истина, если значение является информацией об ошибке или Неопределено.
Функция КорректнаяПричина(Значение) Экспорт

	Возврат Значение = Неопределено Или ТипЗнч(Значение) = Тип("ИнформацияОбОшибке");

КонецФункции

// Проверяет машинный тип ошибки и выбрасывает исключение при нарушении контракта.
//
// Параметры:
//  Значение - Произвольный - Проверяемое значение.
Процедура ПроверитьТипОшибки(Значение) Экспорт

	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		ВызватьИсключение "Тип ошибки должен быть строкой";
	КонецЕсли;

	Если Не КорректныйТипОшибки(Значение) Тогда
		ВызватьИсключение "Тип ошибки имеет неверный формат";
	КонецЕсли;

КонецПроцедуры

// Проверяет сообщение ошибки и выбрасывает исключение при нарушении контракта.
//
// Параметры:
//  Значение - Произвольный - Проверяемое значение.
Процедура ПроверитьСообщение(Значение) Экспорт

	Если Не КорректноеСообщение(Значение) Тогда
		ВызватьИсключение "Сообщение должно быть непустой строкой";
	КонецЕсли;

КонецПроцедуры

// Проверяет подсказку ошибки и выбрасывает исключение при нарушении контракта.
//
// Параметры:
//  Значение - Произвольный - Проверяемое значение.
Процедура ПроверитьПодсказку(Значение) Экспорт

	Если Не КорректнаяПодсказка(Значение) Тогда
		ВызватьИсключение "Подсказка должна быть строкой";
	КонецЕсли;

КонецПроцедуры

// Проверяет причину ошибки и выбрасывает исключение при нарушении контракта.
//
// Параметры:
//  Значение - Произвольный - Проверяемое значение.
Процедура ПроверитьПричину(Значение) Экспорт

	Если Не КорректнаяПричина(Значение) Тогда
		ВызватьИсключение "Причина должна иметь тип ИнформацияОбОшибке";
	КонецЕсли;

КонецПроцедуры

// Проверяет входной объект ошибки.
//
// Параметры:
//  Значение - Произвольный - Проверяемое значение.
Процедура ПроверитьОшибку(Значение) Экспорт

	Если ТипЗнч(Значение) <> Тип("ИнформацияОбОшибке") Тогда
		ВызватьИсключение "Ошибка должна иметь тип ИнформацияОбОшибке";
	КонецЕсли;

КонецПроцедуры

// Проверяет вид и согласованность связанных полей кадра ошибки.
//
// Параметры:
//  Вид - Строка - Вид кадра ошибки.
//  ТипОшибки - Строка, Неопределено - Машинный тип ошибки.
//  Причина - ИнформацияОбОшибке, Неопределено - Непосредственная причина.
Процедура ПроверитьВидКадра(Вид, ТипОшибки, Причина) Экспорт

	Если Вид = ВидыКадровОшибок.Ошибка Тогда
		ПроверитьТипОшибки(ТипОшибки);
		Возврат;
	КонецЕсли;

	Если Вид <> ВидыКадровОшибок.Контекст Тогда
		ВызватьИсключение "Вид кадра ошибки не поддерживается";
	КонецЕсли;

	Если ТипОшибки <> Неопределено Тогда
		ВызватьИсключение "Тип ошибки контекстного кадра должен быть равен Неопределено";
	КонецЕсли;

	Если Причина = Неопределено Тогда
		ВызватьИсключение "Контекстный кадр должен иметь причину";
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция РегулярноеВыражениеТипаОшибки()

	Если _РегулярноеВыражениеТипаОшибки = Неопределено Тогда
		_РегулярноеВыражениеТипаОшибки = Новый РегулярноеВыражение(
			"\A[a-zA-Zа-яА-ЯёЁ][a-zA-Zа-яА-ЯёЁ0-9_]*"
			+ "(\.[a-zA-Zа-яА-ЯёЁ][a-zA-Zа-яА-ЯёЁ0-9_]*)+\z"
		);
		_РегулярноеВыражениеТипаОшибки.ИгнорироватьРегистр = Истина;
		_РегулярноеВыражениеТипаОшибки.Многострочный = Ложь;
	КонецЕсли;

	Возврат _РегулярноеВыражениеТипаОшибки;

КонецФункции

#КонецОбласти
