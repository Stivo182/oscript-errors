&Тест
Процедура ТестДолжен_НайтиОшибкиПоВыбраннымКодам() Экспорт

	// Подготовка
	Корень = ФабрикаОшибок.Создать("database.timeout", "Первый таймаут");
	Повтор = ФабрикаОшибок.Обернуть(Корень, "database.timeout", "Второй таймаут");
	ОшибкаСети = ФабрикаОшибок.Обернуть(Повтор, "network.timeout", "Сетевой таймаут");
	Исследователь = Новый ИсследовательОшибки(ОшибкаСети);

	// Действие
	Выборка = Исследователь.НайтиОшибки(" DATABASE.TIMEOUT, network.timeout, database.timeout ");

	// Проверка
	Ожидаем.Что(Исследователь.ЕстьОшибка("DATABASE.TIMEOUT")).Равно(Истина);
	Ожидаем.Что(Исследователь.НайтиОшибку("database.timeout").ИсходнаяОшибка()).Равно(Повтор);
	Ожидаем.Что(Выборка.Количество()).Равно(3);
	Ожидаем.Что(Выборка.Первая().ИсходнаяОшибка()).Равно(ОшибкаСети);
	Ожидаем.Что(Выборка.Последняя().ИсходнаяОшибка()).Равно(Корень);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НайтиОшибкиПоМассивуКодов() Экспорт

	// Подготовка
	Корень = ФабрикаОшибок.Создать("database.timeout", "Первый таймаут");
	Повтор = ФабрикаОшибок.Обернуть(Корень, "database.timeout", "Второй таймаут");
	ОшибкаСети = ФабрикаОшибок.Обернуть(Повтор, "network.timeout", "Сетевой таймаут");
	Исследователь = Новый ИсследовательОшибки(ОшибкаСети);
	Коды = Новый Массив;
	Коды.Добавить("DATABASE.TIMEOUT");

	// Действие
	Выборка = Исследователь.НайтиОшибки(Коды);

	// Проверка
	Ожидаем.Что(Выборка.Количество()).Равно(2);
	Ожидаем.Что(Выборка.Первая().ИсходнаяОшибка()).Равно(Повтор);
	Ожидаем.Что(Выборка.Последняя().ИсходнаяОшибка()).Равно(Корень);

КонецПроцедуры

