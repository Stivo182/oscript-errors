#Использовать asserts
#Использовать "../src"

#Область Тесты

&Тест
Процедура ТестДолжен_ВернутьГотовуюСтандартнуюОшибку() Экспорт

	// Действие
	Ошибка = СтандартныеОшибки.РесурсНеНайден("config.json");

	// Проверка
	Ожидаем.Что(ТипЗнч(Ошибка)).Равно(Тип("ИнформацияОбОшибке"));
	Снимок = Новый СнимокКадраОшибки(Ошибка);
	Ожидаем.Что(Снимок.КодОшибки()).Равно("resource.not_found");
	Ожидаем.Что(Снимок.Данные().ИмяРесурса).Равно("config.json");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОбогатитьПостроительСтандартнойОшибки() Экспорт

	// Действие
	Ошибка = ПостроителиСтандартныхОшибок.РесурсНеНайден("config.json")
		.Данные("Каталог", "settings")
		.Подсказка("Проверьте путь к файлу")
		.URL("https://example.org/errors/resource.not_found")
		.Построить();

	// Проверка
	Снимок = Новый СнимокКадраОшибки(Ошибка);
	Ожидаем.Что(Снимок.Данные().ИмяРесурса).Равно("config.json");
	Ожидаем.Что(Снимок.Данные().Каталог).Равно("settings");
	Ожидаем.Что(Снимок.Подсказка()).Равно("Проверьте путь к файлу");
	Ожидаем.Что(Снимок.URL()).Равно("https://example.org/errors/resource.not_found");

КонецПроцедуры


