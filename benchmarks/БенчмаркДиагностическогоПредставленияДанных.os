#Использовать "../src"

&Параметры(20, 100, 1000)
Перем КоличествоЭлементов Экспорт; // Число

Перем _Ошибка; // ИнформацияОбОшибке
Перем _Результат; // Строка

#Область ОбработчикиСобытий

// Создаёт бенчмарк диагностического представления больших пользовательских данных.
&МониторингПамяти
&КоличествоИтераций(5)
&КоличествоПрогревочныхИтераций(3)
&МинимальноеВремяИтерации(100)
Процедура ПриСозданииОбъекта()
КонецПроцедуры

// Подготавливает ошибку с соответствием заданного размера.
//
// Параметры:
//  Контекст - Структура - Контекст выполняемого кейса бенчмарка.
&ПередКаждымКейсом
Процедура ПодготовитьОшибку(Контекст) Экспорт

	Данные = Новый Соответствие;

	Для Индекс = 1 По КоличествоЭлементов Цикл
		Номер = КоличествоЭлементов - Индекс + 1;
		Ключ = "Ключ" + Прав("0000" + Строка(Номер), 4);
		Данные.Вставить(Ключ, Новый Структура("Номер, Состояние", Номер, "Подготовлено"));
	КонецЦикла;

	_Ошибка = ФабрикаОшибок.Создать("benchmark.failed", "Ошибка обработки данных", Данные);

КонецПроцедуры

#КонецОбласти

#Область Бенчмарки

// Измеряет публичное формирование диагностического представления больших данных.
&Бенчмарк
Процедура СформироватьДиагностическоеПредставление() Экспорт

	_Результат = ДиагностикаОшибок.ДиагностическоеПредставление(_Ошибка);

КонецПроцедуры

#КонецОбласти
