#Область Тесты

&Тест
Процедура ТестДолжен_СоздатьКонструкторБезПараметров() Экспорт

	// Действие
	Конструктор = Новый КонструкторОшибки();

	// Проверка
	Ожидаем.Что(ТипЗнч(Конструктор)).Равно(Тип("КонструкторОшибки"));

КонецПроцедуры

&Тест
Процедура ТестДолжен_УстановитьТипОшибки() Экспорт

	// Подготовка
	Конструктор = Новый КонструкторОшибки("http.old_error", "Ошибка прокси");

	// Действие
	РезультатНастройки = Конструктор.ТипОшибки("http.proxy_error");
	Ошибка = Конструктор.Построить();

	// Проверка
	Снимок = Новый СнимокКадраОшибки(Ошибка);
	Ожидаем.Что(РезультатНастройки).Равно(Конструктор);
	Ожидаем.Что(Снимок.ТипОшибки()).Равно("http.proxy_error");

КонецПроцедуры

&Тест
Процедура ТестДолжен_УстановитьСообщение() Экспорт

	// Подготовка
	Конструктор = Новый КонструкторОшибки("http.proxy_error", "Старое сообщение");

	// Действие
	РезультатНастройки = Конструктор.Сообщение("Ошибка прокси");
	Ошибка = Конструктор.Построить();

	// Проверка
	Снимок = Новый СнимокКадраОшибки(Ошибка);
	Ожидаем.Что(РезультатНастройки).Равно(Конструктор);
	Ожидаем.Что(Снимок.Сообщение()).Равно("Ошибка прокси");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПостроитьОшибкуЧерезFluentИнтерфейс() Экспорт

	// Подготовка
	ПервыеДанные = Новый Структура("Прокси", "old");
	ИтоговыеДанные = Новый Структура("Прокси", "proxy.example.org");
	Конструктор = Новый КонструкторОшибки("http.proxy_error", "Ошибка прокси");

	// Действие
	РезультатНастройки = Конструктор
		.Данные(ПервыеДанные)
		.Данные(ИтоговыеДанные)
		.Подсказка("Старая подсказка")
		.Подсказка("Проверьте настройки прокси");
	Ошибка = Конструктор.Построить();

	// Проверка
	Снимок = Новый СнимокКадраОшибки(Ошибка);
	Ожидаем.Что(РезультатНастройки).Равно(Конструктор);
	Ожидаем.Что(Снимок.Вид()).Равно(ВидыКадровОшибок.Ошибка);
	Ожидаем.Что(Снимок.Данные()).Равно(ИтоговыеДанные);
	Ожидаем.Что(Снимок.Подсказка()).Равно("Проверьте настройки прокси");
	Ожидаем.Что(Ошибка.Причина).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПостроитьОбернутуюОшибку() Экспорт

	// Подготовка
	Причина = ФабрикаОшибок.Создать("network.unavailable", "Сеть недоступна");
	Конструктор = Новый КонструкторОшибки("http.proxy_error", "Ошибка прокси");

	// Действие
	Ошибка = Конструктор.Причина(Причина).Построить();

	// Проверка
	Ожидаем.Что(Ошибка.Причина).Равно(Причина);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьКонструкторИзФабрики() Экспорт

	// Действие
	Конструктор = ФабрикаОшибок.Конструктор("http.proxy_error", "Ошибка прокси");

	// Проверка
	Ожидаем.Что(ТипЗнч(Конструктор)).Равно(Тип("КонструкторОшибки"));
	Ожидаем.Что(ТипЗнч(Конструктор.Построить())).Равно(Тип("ИнформацияОбОшибке"));

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПроверитьПодсказкуПриПостроении() Экспорт

	// Подготовка
	Параметры = Новый Массив;
	Параметры.Добавить(42);

	// Действие и Проверка
	Ожидаем.Что(ЭтотОбъект)
		.Метод("ПостроитьСПодсказкой", Параметры)
		.ВыбрасываетИсключение(
			НСтр("ru = 'Подсказка должна быть строкой'; en = 'Hint must be a string'")
		);

КонецПроцедуры

