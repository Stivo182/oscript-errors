Перем _ПроверяющийКадрыОшибок; // ПроверяющийКадрыОшибок
Перем _ОписаниеФорматаКадраОшибки; // ОписаниеФорматаКадраОшибки
Перем _РегистраторСбоев; // РегистраторСбоевБиблиотекиОшибок

#Область ОбработчикиСобытий

// Создает читатель метаданных кадра ошибки.
//
// Параметры:
//  ПроверяющийКадрыОшибок - ПроверяющийКадрыОшибок - Проверяющий полей кадра.
//  ОписаниеФорматаКадраОшибки - ОписаниеФорматаКадраОшибки - Описание формата метаданных.
//  РегистраторСбоев - РегистраторСбоевБиблиотекиОшибок - Регистратор подавленных сбоев.
Процедура ПриСозданииОбъекта(ПроверяющийКадрыОшибок, ОписаниеФорматаКадраОшибки, РегистраторСбоев)

	_ПроверяющийКадрыОшибок = ПроверяющийКадрыОшибок;
	_ОписаниеФорматаКадраОшибки = ОписаниеФорматаКадраОшибки;
	_РегистраторСбоев = РегистраторСбоев;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Безопасно читает метаданные физического кадра без повторной проверки типа.
//
// Параметры:
//  Ошибка - ИнформацияОбОшибке - Читаемый физический кадр.
//
// Возвращаемое значение:
//  ФиксированнаяСтруктура, Неопределено - Поддерживаемые исходные метаданные или Неопределено.
Функция ПрочитатьМетаданные(Ошибка) Экспорт

	Попытка
		Параметры = Ошибка.Параметры;
		Если ТипЗнч(Параметры) <> Тип("ФиксированнаяСтруктура")
			Или Не ЭтоПоддерживаемыеМетаданные(Параметры) Тогда
			Возврат Неопределено;
		КонецЕсли;

		Возврат Параметры;
	Исключение
		_РегистраторСбоев.ЗаписатьПодавленныйСбой(
			"snapshot.read_metadata",
			Ошибка,
			ИнформацияОбОшибке()
		);
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЭтоПоддерживаемыеМетаданные(Параметры)

	Попытка
		Маркер = Параметры.Маркер;
		ВерсияФормата = Параметры.ВерсияФормата;
		Вид = Параметры.Вид;
		КодОшибки = Параметры.КодОшибки;
		Сообщение = Параметры.Сообщение;
		Данные = Параметры.Данные;
	Исключение
		Возврат Ложь;
	КонецПопытки;

	Подсказка = "";
	URL = "";

	Если Не _ПроверяющийКадрыОшибок.КорректноеСообщение(Сообщение) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Параметры.Свойство("Подсказка", Подсказка)
		И Не _ПроверяющийКадрыОшибок.КорректнаяПодсказка(Подсказка) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Параметры.Свойство("URL", URL)
		И Не _ПроверяющийКадрыОшибок.КорректныйURL(URL) Тогда
		Возврат Ложь;
	КонецЕсли;

	КорректныйМаркер = ТипЗнч(Маркер) = Тип("Строка")
		И Маркер = _ОписаниеФорматаКадраОшибки.МаркерМетаданных();
	КорректнаяВерсия = ТипЗнч(ВерсияФормата) = Тип("Число")
		И ВерсияФормата = _ОписаниеФорматаКадраОшибки.ВерсияФормата();

	Если Не КорректныйМаркер Или Не КорректнаяВерсия Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Вид = ВидыКадровОшибок.Ошибка() Тогда
		Возврат _ПроверяющийКадрыОшибок.КорректныйКодОшибки(КодОшибки);
	КонецЕсли;

	Если Вид = ВидыКадровОшибок.Контекст() Тогда
		Возврат КодОшибки = Неопределено;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

#КонецОбласти
