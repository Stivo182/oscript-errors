#Использовать "../internal"

Перем _ТипОшибки; // Строка
Перем _Сообщение; // Строка
Перем _Вид; // Строка
Перем _Данные; // Произвольный, Неопределено
Перем _Подсказка; // Строка
Перем _Причина; // ИнформацияОбОшибке, Неопределено
Перем _РегулярноеВыражениеТипаОшибки; // РегулярноеВыражение

#Область ОбработчикиСобытий

// Создаёт fluent-конструктор кадра ошибки.
//
// Параметры:
//  ТипОшибки - Строка, Неопределено - Стабильный машинный тип ошибки;
//      для кадра контекста должен быть равен Неопределено.
//  Сообщение - Строка - Человекочитаемое описание ошибки.
//  Вид - Строка, Неопределено - Внутренний вид создаваемого кадра.
//      По умолчанию ВидыКадровОшибок.Ошибка.
Процедура ПриСозданииОбъекта(ТипОшибки, Сообщение, Вид = Неопределено)

	_ТипОшибки = ТипОшибки;
	_Сообщение = Сообщение;
	_Вид = Вид;
	_Данные = Неопределено;
	_Подсказка = "";
	_Причина = Неопределено;

	Если _Вид = Неопределено Тогда
		_Вид = ВидыКадровОшибок.Ошибка;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Устанавливает пользовательские данные ошибки.
//
// Параметры:
//  Значение - Произвольный - Связанные с ошибкой данные.
//
// Возвращаемое значение:
//  КонструкторОшибки - Этот конструктор.
Функция Данные(Значение) Экспорт

	_Данные = Значение;
	Возврат ЭтотОбъект;

КонецФункции

// Устанавливает подсказку по исправлению ошибки.
//
// Параметры:
//  Значение - Строка - Подсказка по исправлению ошибки.
//
// Возвращаемое значение:
//  КонструкторОшибки - Этот конструктор.
Функция Подсказка(Значение) Экспорт

	_Подсказка = Значение;
	Возврат ЭтотОбъект;

КонецФункции

// Устанавливает непосредственную причину ошибки.
//
// Параметры:
//  Значение - ИнформацияОбОшибке, Неопределено - Непосредственная причина.
//
// Возвращаемое значение:
//  КонструкторОшибки - Этот конструктор.
Функция Причина(Значение) Экспорт

	_Причина = Значение;
	Возврат ЭтотОбъект;

КонецФункции

// Создаёт настроенный кадр ошибки.
//
// Возвращаемое значение:
//  ИнформацияОбОшибке - Новый кадр ошибки.
Функция Построить() Экспорт

	ПроверитьВидКадра();
	ПроверитьСообщение();
	ПроверитьПодсказку();
	ПроверитьПричину();

	Поля = Новый Структура;
	Поля.Вставить("Маркер", ВнутреннееУстройствоОшибок.МаркерМетаданныхКадра());
	Поля.Вставить("Вид", _Вид);
	Поля.Вставить("ТипОшибки", _ТипОшибки);
	Поля.Вставить("Данные", _Данные);
	Поля.Вставить("Подсказка", _Подсказка);

	МетаданныеКадра = Новый ФиксированнаяСтруктура(Поля);

	Если _Причина = Неопределено Тогда
		Возврат Новый ИнформацияОбОшибке(_Сообщение, МетаданныеКадра);
	КонецЕсли;

	Возврат Новый ИнформацияОбОшибке(_Сообщение, МетаданныеКадра, _Причина);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьВидКадра()

	Если _Вид = ВидыКадровОшибок.Ошибка Тогда
		ПроверитьТипОшибки();
		Возврат;
	КонецЕсли;

	Если _Вид <> ВидыКадровОшибок.Контекст Тогда
		ВызватьИсключение "Вид кадра ошибки не поддерживается";
	КонецЕсли;

	Если _ТипОшибки <> Неопределено Тогда
		ВызватьИсключение "Тип ошибки контекстного кадра должен быть равен Неопределено";
	КонецЕсли;

	Если _Причина = Неопределено Тогда
		ВызватьИсключение "Контекстный кадр должен иметь причину";
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьТипОшибки()

	Если ТипЗнч(_ТипОшибки) <> Тип("Строка") Тогда
		ВызватьИсключение "Тип ошибки должен быть строкой";
	КонецЕсли;

	Если Не РегулярноеВыражениеТипаОшибки().Совпадает(_ТипОшибки) Тогда
		ВызватьИсключение "Тип ошибки имеет неверный формат";
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьСообщение()

	Если ТипЗнч(_Сообщение) <> Тип("Строка") Или ПустаяСтрока(_Сообщение) Тогда
		ВызватьИсключение "Сообщение должно быть непустой строкой";
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьПодсказку()

	Если ТипЗнч(_Подсказка) <> Тип("Строка") Тогда
		ВызватьИсключение "Подсказка должна быть строкой";
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьПричину()

	Если _Причина <> Неопределено И ТипЗнч(_Причина) <> Тип("ИнформацияОбОшибке") Тогда
		ВызватьИсключение "Причина должна иметь тип ИнформацияОбОшибке";
	КонецЕсли;

КонецПроцедуры

Функция РегулярноеВыражениеТипаОшибки()

	Если _РегулярноеВыражениеТипаОшибки = Неопределено Тогда
		_РегулярноеВыражениеТипаОшибки = Новый РегулярноеВыражение("\A[a-z][a-z0-9_]*\.[a-z][a-z0-9_]*\z");
		_РегулярноеВыражениеТипаОшибки.ИгнорироватьРегистр = Ложь;
		_РегулярноеВыражениеТипаОшибки.Многострочный = Ложь;
	КонецЕсли;

	Возврат _РегулярноеВыражениеТипаОшибки;

КонецФункции

#КонецОбласти
