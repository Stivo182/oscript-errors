#Использовать "../internal"

#Область ПрограммныйИнтерфейс

// Проверяет тип аргумента и выбрасывает ошибку при нарушении контракта.
//
// Параметры:
//  ИмяАргумента - Строка - Имя проверяемого аргумента.
//  Значение - Произвольный - Проверяемое значение.
//  ОжидаемыйТип - Тип - Ожидаемый тип значения.
//  Сообщение - Строка - Необязательное описание ошибки.
Процедура ПроверитьТип(ИмяАргумента, Значение, ОжидаемыйТип, Сообщение = "") Экспорт

	ПроверитьИмяАргумента(ИмяАргумента);
	ПроверитьТипПараметра("ОжидаемыйТип", ОжидаемыйТип, Тип("Тип"));
	ПроверитьСообщение(Сообщение);

	Если ТипЗнч(Значение) <> ОжидаемыйТип Тогда
		ВызватьИсключение СозданиеОшибокКонтрактов.НеверныйТипАргумента(
			ИмяАргумента,
			Строка(ОжидаемыйТип),
			Значение,
			Сообщение
		);
	КонецЕсли;

КонецПроцедуры

// Проверяет заполненность аргумента и выбрасывает ошибку при нарушении контракта.
//
// Параметры:
//  ИмяАргумента - Строка - Имя проверяемого аргумента.
//  Значение - Произвольный - Проверяемое значение.
//  Сообщение - Строка - Необязательное описание ошибки.
Процедура ПроверитьЗаполненность(ИмяАргумента, Значение, Сообщение = "") Экспорт

	ПроверитьИмяАргумента(ИмяАргумента);
	ПроверитьСообщение(Сообщение);

	Если Не ЗаполненоИлиНеПоддерживается(Значение) Тогда
		ВызватьИсключение СозданиеОшибокКонтрактов.АргументНеЗаполнен(ИмяАргумента, Сообщение);
	КонецЕсли;

КонецПроцедуры

// Проверяет допустимость аргумента и выбрасывает ошибку при нарушении контракта.
//
// Параметры:
//  ИмяАргумента - Строка - Имя проверяемого аргумента.
//  Условие - Булево - Результат проверки допустимости.
//  Ожидание - Строка - Описание допустимого значения или ограничения.
//  Сообщение - Строка - Необязательное описание ошибки.
Процедура ПроверитьДопустимость(ИмяАргумента, Условие, Ожидание, Сообщение = "") Экспорт

	ПроверитьИмяАргумента(ИмяАргумента);
	ПроверитьТипПараметра("Условие", Условие, Тип("Булево"));
	ПроверитьНепустуюСтроку("Ожидание", Ожидание);
	ПроверитьСообщение(Сообщение);

	Если Не Условие Тогда
		ВызватьИсключение СозданиеОшибокКонтрактов.НедопустимоеЗначениеАргумента(
			ИмяАргумента,
			Ожидание,
			Сообщение
		);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьИмяАргумента(Значение)

	ПроверитьНепустуюСтроку("ИмяАргумента", Значение);

КонецПроцедуры

Процедура ПроверитьСообщение(Значение)

	ПроверитьТипПараметра("Сообщение", Значение, Тип("Строка"));

КонецПроцедуры

Процедура ПроверитьНепустуюСтроку(ИмяПараметра, Значение)

	ПроверитьТипПараметра(ИмяПараметра, Значение, Тип("Строка"));

	Если ПустаяСтрока(Значение) Тогда
		ВызватьИсключение СозданиеОшибокКонтрактов.АргументНеЗаполнен(ИмяПараметра);
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьТипПараметра(ИмяПараметра, Значение, ОжидаемыйТип)

	Если ТипЗнч(Значение) <> ОжидаемыйТип Тогда
		ВызватьИсключение СозданиеОшибокКонтрактов.НеверныйТипАргумента(
			ИмяПараметра,
			Строка(ОжидаемыйТип),
			Значение
		);
	КонецЕсли;

КонецПроцедуры

Функция ЗаполненоИлиНеПоддерживается(Значение)

	Попытка
		Возврат ЗначениеЗаполнено(Значение);
	Исключение
		Возврат Истина;
	КонецПопытки;

КонецФункции

#КонецОбласти
