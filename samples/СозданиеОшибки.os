// Демонстрирует создание, выбрасывание и исследование классифицированной ошибки.
// Фабрика возвращает ИнформацияОбОшибке, которую можно передать в ВызватьИсключение напрямую.

#Использовать errors

Ошибка = ФабрикаОшибок.Создать(
	"storage.quota_exceeded",
	"Недостаточно места в хранилище",
	Новый Структура("ТребуетсяМБ,ДоступноМБ", 800, 250),
	"Освободите место или увеличьте квоту"
);

Попытка
	ВызватьИсключение Ошибка;
Исключение
	Исследователь = Новый ИсследовательОшибки(ИнформацияОбОшибке());
	Данные = Исследователь.Данные();

	Сообщить("Тип: " + Исследователь.ТипОшибки());
	Сообщить(СтрШаблон("Требуется %1 МБ, доступно %2 МБ", Данные.ТребуетсяМБ, Данные.ДоступноМБ));
	Сообщить("Подсказка: " + Исследователь.Подсказка());
КонецПопытки;
