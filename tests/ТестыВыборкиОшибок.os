&Тест
Процедура ТестДолжен_ОтобратьОшибкиПоСпискуКодов() Экспорт

	// Подготовка
	Снимки = Новый Массив;
	Снимки.Добавить(СнимокОшибки("database.timeout", "Таймаут базы"));
	Снимки.Добавить(СнимокОшибки("network.timeout", "Сетевой таймаут"));
	Снимки.Добавить(СнимокОшибки("resource.not_found", "Ресурс не найден"));
	Выборка = Новый ВыборкаОшибок(Снимки);

	// Действие
	Таймауты = Выборка.Отобрать(" NETWORK.TIMEOUT, database.timeout, network.timeout ");

	// Проверка
	Ожидаем.Что(Таймауты.Количество()).Равно(2);
	Ожидаем.Что(Таймауты.Первая()).Равно(Снимки[0]);
	Ожидаем.Что(Таймауты.Последняя()).Равно(Снимки[1]);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПроверитьНаличиеОдногоИзКодов() Экспорт

	// Подготовка
	Снимки = Новый Массив;
	Снимки.Добавить(СнимокОшибки("database.timeout", "Таймаут базы"));
	Выборка = Новый ВыборкаОшибок(Снимки);

	// Действие и Проверка
	Ожидаем.Что(Выборка.СодержитЛюбойИз("network.timeout, DATABASE.TIMEOUT")).ЭтоИстина();
	Ожидаем.Что(Выборка.СодержитЛюбойИз("network.timeout, resource.not_found")).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_РаботатьСФиксированнымМассивомКодов() Экспорт

	// Подготовка
	Снимки = Новый Массив;
	Снимки.Добавить(СнимокОшибки("database.timeout", "Таймаут базы"));
	Снимки.Добавить(СнимокОшибки("network.timeout", "Сетевой таймаут"));
	Выборка = Новый ВыборкаОшибок(Снимки);
	Коды = Новый Массив;
	Коды.Добавить("DATABASE.TIMEOUT");
	Коды.Добавить("resource.not_found");
	ФиксированныеКоды = Новый ФиксированныйМассив(Коды);

	// Действие
	Найденные = Выборка.Отобрать(ФиксированныеКоды);

	// Проверка
	Ожидаем.Что(Найденные.Количество()).Равно(1);
	Ожидаем.Что(Найденные.Первая()).Равно(Снимки[0]);
	Ожидаем.Что(Выборка.СодержитЛюбойИз(ФиксированныеКоды)).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьПустуюВыборкуДляОтсутствующегоКода() Экспорт

	// Подготовка
	Снимки = Новый Массив;
	Снимки.Добавить(СнимокОшибки("database.timeout", "Таймаут базы"));
	Выборка = Новый ВыборкаОшибок(Снимки);

