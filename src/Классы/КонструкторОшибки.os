#Использовать "../internal"

Перем _ТипОшибки; // Строка
Перем _Сообщение; // Строка
Перем _Вид; // Строка
Перем _Данные; // Произвольный, Неопределено
Перем _Подсказка; // Строка
Перем _Причина; // ИнформацияОбОшибке, Неопределено

#Область ОбработчикиСобытий

// Создаёт fluent-конструктор кадра ошибки.
//
// Параметры:
//  ТипОшибки - Строка, Неопределено - Стабильный машинный тип ошибки;
//      для кадра контекста должен быть равен Неопределено.
//  Сообщение - Строка - Человекочитаемое описание ошибки.
//  Вид - Строка, Неопределено - Внутренний вид создаваемого кадра.
//      По умолчанию ВидыКадровОшибок.Ошибка.
Процедура ПриСозданииОбъекта(ТипОшибки = Неопределено, Сообщение = "", Вид = Неопределено)

	_ТипОшибки = ТипОшибки;
	_Сообщение = Сообщение;
	_Вид = Вид;
	_Данные = Неопределено;
	_Подсказка = "";
	_Причина = Неопределено;

	Если _Вид = Неопределено Тогда
		_Вид = ВидыКадровОшибок.Ошибка;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Устанавливает стабильный машинный тип ошибки.
//
// Параметры:
//  Значение - Строка, Неопределено - Стабильный машинный тип ошибки.
//
// Возвращаемое значение:
//  КонструкторОшибки - Этот конструктор.
Функция ТипОшибки(Значение) Экспорт

	_ТипОшибки = Значение;
	Возврат ЭтотОбъект;

КонецФункции

// Устанавливает человекочитаемое описание ошибки.
//
// Параметры:
//  Значение - Строка - Человекочитаемое описание ошибки.
//
// Возвращаемое значение:
//  КонструкторОшибки - Этот конструктор.
Функция Сообщение(Значение) Экспорт

	_Сообщение = Значение;
	Возврат ЭтотОбъект;

КонецФункции

// Устанавливает пользовательские данные ошибки.
//
// Параметры:
//  Значение - Произвольный - Связанные с ошибкой данные.
//
// Возвращаемое значение:
//  КонструкторОшибки - Этот конструктор.
Функция Данные(Значение) Экспорт

	_Данные = Значение;
	Возврат ЭтотОбъект;

КонецФункции

// Устанавливает подсказку по исправлению ошибки.
//
// Параметры:
//  Значение - Строка - Подсказка по исправлению ошибки.
//
// Возвращаемое значение:
//  КонструкторОшибки - Этот конструктор.
Функция Подсказка(Значение) Экспорт

	_Подсказка = Значение;
	Возврат ЭтотОбъект;

КонецФункции

// Устанавливает непосредственную причину ошибки.
//
// Параметры:
//  Значение - ИнформацияОбОшибке, Неопределено - Непосредственная причина.
//
// Возвращаемое значение:
//  КонструкторОшибки - Этот конструктор.
Функция Причина(Значение) Экспорт

	_Причина = Значение;
	Возврат ЭтотОбъект;

КонецФункции

// Создаёт настроенный кадр ошибки.
//
// Возвращаемое значение:
//  ИнформацияОбОшибке - Новый кадр ошибки.
Функция Построить() Экспорт

	ПроверкаКадровОшибок.ПроверитьВидКадра(_Вид, _ТипОшибки, _Причина);
	ПроверкаКадровОшибок.ПроверитьСообщение(_Сообщение);
	ПроверкаКадровОшибок.ПроверитьПодсказку(_Подсказка);
	ПроверкаКадровОшибок.ПроверитьПричину(_Причина);

	Поля = Новый Структура;
	Поля.Вставить("Маркер", ВнутреннееУстройствоОшибок.МаркерМетаданныхКадра());
	Поля.Вставить("Вид", _Вид);
	Поля.Вставить("ТипОшибки", _ТипОшибки);
	Поля.Вставить("Данные", _Данные);
	Поля.Вставить("Подсказка", _Подсказка);

	МетаданныеКадра = Новый ФиксированнаяСтруктура(Поля);

	Если _Причина = Неопределено Тогда
		Возврат Новый ИнформацияОбОшибке(_Сообщение, МетаданныеКадра);
	КонецЕсли;

	Возврат Новый ИнформацияОбОшибке(_Сообщение, МетаданныеКадра, _Причина);

КонецФункции

#КонецОбласти
