Процедура ТестДолжен_СохранитьПользовательскиеСообщенияСтандартныхФабрик() Экспорт

	// Подготовка
	ОшибкаНеверногоТипа = СтандартныеОшибки.НеверныйТипАргумента("Имя", "Строка", 42, "Неверный тип");
	ОшибкаНедопустимогоЗначения = СтандартныеОшибки.НедопустимоеЗначениеАргумента(
		"Количество",
		"быть больше нуля",
		"Недопустимое количество"
	);

	// Действие
	СнимокНеверногоТипа = Новый СнимокКадраОшибки(ОшибкаНеверногоТипа);
	СнимокНедопустимогоЗначения = Новый СнимокКадраОшибки(ОшибкаНедопустимогоЗначения);

	// Проверка
	Ожидаем.Что(СнимокНеверногоТипа.Сообщение()).Равно("Неверный тип");
	Ожидаем.Что(СнимокНедопустимогоЗначения.Сообщение()).Равно("Недопустимое количество");
	Ожидаем.Что(ОшибкаНеверногоТипа.Описание).Содержит("argument.invalid_type: Неверный тип");
	Ожидаем.Что(ОшибкаНеверногоТипа.Описание).ЭтоНе().Содержит("Данные:");
	Ожидаем.Что(ОшибкаНедопустимогоЗначения.Описание).Содержит(
		"argument.invalid_value: Недопустимое количество"
	);
	Ожидаем.Что(ОшибкаНедопустимогоЗначения.Описание).ЭтоНе().Содержит("Данные:");

КонецПроцедуры

&ПараметризованныйТест
