&Тест
Процедура ТестДолжен_ВыровнятьПоляМногострочнойНумерованнойПричины() Экспорт

	// Подготовка
	Снимки = Новый Массив;
	Снимки.Добавить(Новый ТестовыйСнимокКадраОшибки(
		Новый Структура("Сообщение", "Ошибка запуска")
	));
	Снимки.Добавить(Новый ТестовыйСнимокКадраОшибки(
		Новый Структура(
			"Вид, КодОшибки, Сообщение, Данные, Подсказка",
			ВидыКадровОшибок.Ошибка(),
			"core.failed",
			"Первая строка" + Символы.ПС + "Вторая строка",
			Новый Структура("Описание", "Первая" + Символы.ПС + "Вторая"),
			"Первый шаг" + Символы.ПС + "Второй шаг"
		)
	));
	Снимки.Добавить(Новый ТестовыйСнимокКадраОшибки(
		Новый Структура("Сообщение", "Низкоуровневая ошибка")
	));

	// Действие
	Представление = ФорматированиеПредставленияОшибок.ДиагностическоеПредставление(Снимки, Ложь);

	// Проверка
	Ожидаем.Что(Представление).Содержит(
		"  1: core.failed: Первая строка" + Символы.ПС
			+ Пробелы(25) + "Вторая строка" + Символы.ПС
			+ "     Данные:" + Символы.ПС
			+ "       Описание: Первая" + Символы.ПС
			+ Пробелы(17) + "Вторая"
	);
	Ожидаем.Что(Представление).Содержит(
		"Подсказка:" + Символы.ПС
			+ "  Первый шаг" + Символы.ПС
			+ "  Второй шаг"
	);

