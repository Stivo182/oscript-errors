&Тест
Процедура ТестДолжен_ОтнестиКонтекстКСледующейНумерованнойПричине() Экспорт

	// Подготовка
	Снимки = Новый Массив;
	Снимки.Добавить(Новый ТестовыйСнимокКадраОшибки(
		Новый Структура("Сообщение", "Не удалось выполнить операцию")
	));
	Снимки.Добавить(Новый ТестовыйСнимокКадраОшибки(
		Новый Структура(
			"Вид, Сообщение, Данные",
			ВидыКадровОшибок.Контекст,
			"Выполнение запроса",
			Новый Структура("Попытка", 2)
		)
	));
	Снимки.Добавить(Новый ТестовыйСнимокКадраОшибки(
		Новый Структура(
			"Вид, ТипОшибки, Сообщение",
			ВидыКадровОшибок.Ошибка,
			"service.failed",
			"Сервис вернул ошибку"
		)
	));
	Снимки.Добавить(Новый ТестовыйСнимокКадраОшибки(
		Новый Структура("Сообщение", "Соединение разорвано")
	));

	// Действие
	Представление = ФорматированиеПредставленияОшибок.ПодробноеПредставление(Снимки, Ложь);

	// Проверка
	Ожидаем.Что(Представление).Равно("Не удалось выполнить операцию
	|
	|Причина:
	|  1: service.failed: Сервис вернул ошибку
	|     Контекст:
	|       Выполнение запроса
	|       Данные:
	|         Попытка: 2
	|  2: Соединение разорвано");

