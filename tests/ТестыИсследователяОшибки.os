#Область Тесты

&Тест
Процедура ТестДолжен_ИсследоватьСмешаннуюЦепочку() Экспорт

	// Подготовка
	Цепочка = СмешаннаяЦепочка();

	// Действие
	Исследователь = Новый ИсследовательОшибки(Цепочка.Ошибка);

	// Проверка
	Ожидаем.Что(Исследователь.Кадры().Количество()).Равно(4);
	Ожидаем.Что(Исследователь.Ошибки().Количество()).Равно(2);
	Ожидаем.Что(Исследователь.Контексты().Количество()).Равно(1);
	Ожидаем.Что(Исследователь.ЭффективнаяОшибка().ИсходнаяОшибка()).Равно(Цепочка.ЭффективнаяОшибка);
	Ожидаем.Что(Исследователь.ТипОшибки()).Равно("config.load_failed");
	Ожидаем.Что(Исследователь.Данные()).Равно(Цепочка.ДанныеЭффективнойОшибки);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПройтиВнешниеКадрыДоМеждуИПослеСобственных() Экспорт

	// Подготовка
	ВнешнийКорень = ПомощникТестированияОшибок.ВнешняяОшибка("Внешний корень");
	СобственнаяОшибка = ФабрикаОшибок.Обернуть(
		ВнешнийКорень,
		"service.unavailable",
		"Сервис недоступен"
	);
	ВнешняяСередина = ПомощникТестированияОшибок.ВнешняяОшибка("Служебная обёртка", СобственнаяОшибка);
	Контекст = ФабрикаОшибок.СКонтекстом(ВнешняяСередина, "Вызов сервиса");
	ВнешняяОшибка = ПомощникТестированияОшибок.ВнешняяОшибка("Async", Контекст);

	// Действие
	Исследователь = Новый ИсследовательОшибки(ВнешняяОшибка);

	// Проверка
	Ожидаем.Что(Исследователь.Кадры().Количество()).Равно(5);
	Ожидаем.Что(Исследователь.ТипОшибки()).Равно("service.unavailable");
	Ожидаем.Что(Исследователь.Контексты()[0].ИсходнаяОшибка()).Равно(Контекст);
	Ожидаем.Что(Исследователь.КорневаяПричина().ИсходнаяОшибка()).Равно(ВнешнийКорень);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НайтиСобственныйКадрПослеПовторногоВыброса() Экспорт

	// Подготовка
	ИсходнаяОшибка = ФабрикаОшибок.Создать("storage.read_failed", "Ошибка чтения");
	ПовторноВыброшеннаяОшибка = ПомощникТестированияОшибок.ПовторноВыброшеннаяОшибка(ИсходнаяОшибка);

	// Действие
	Исследователь = Новый ИсследовательОшибки(ПовторноВыброшеннаяОшибка);

	// Проверка
	Ожидаем.Что(Исследователь.ЕстьОшибка("storage.read_failed")).Равно(Истина);
	Ожидаем.Что(Исследователь.НайтиОшибку(
		"storage.read_failed"
	).ИсходнаяОшибка()).Равно(ПовторноВыброшеннаяОшибка);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПройтиЧужойИПоврежденныйКонвертыДоСобственнойОшибки() Экспорт

	// Подготовка
	ВнутренняяОшибка = ФабрикаОшибок.Создать("core.failed", "Корневая ошибка");
	Образец = ФабрикаОшибок.Создать("sample.error", "Образец");
	ЧужойМаркер = ПомощникТестированияОшибок.ОшибкаСЧужимМаркером(Образец, ВнутренняяОшибка);
	ПоврежденныйКонверт = ПомощникТестированияОшибок.ОшибкаСПоврежденнымКонвертом(Образец, ЧужойМаркер);

	// Действие
	Исследователь = Новый ИсследовательОшибки(ПоврежденныйКонверт);

	// Проверка
	Ожидаем.Что(Исследователь.Кадры().Количество()).Равно(3);
	Ожидаем.Что(Исследователь.ТипОшибки()).Равно("core.failed");
	Ожидаем.Что(Исследователь.ЕстьОшибка("foreign.hidden_error")).Равно(Ложь);
	Ожидаем.Что(Исследователь.Контексты().Количество()).Равно(0);
	Ожидаем.Что(Исследователь.КорневаяПричина().ИсходнаяОшибка()).Равно(ВнутренняяОшибка);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьПервуюПодсказкуВЦепочке() Экспорт

	// Подготовка
	Причина = ФабрикаОшибок.Создать("network.timeout", "Таймаут", Неопределено, "Повторите позднее");
	Ошибка = ФабрикаОшибок.Обернуть(Причина, "service.failed", "Сервис недоступен");

	// Действие
	Исследователь = Новый ИсследовательОшибки(Ошибка);

	// Проверка
	Ожидаем.Что(Исследователь.Подсказка()).Равно("Повторите позднее");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьПустыеСвойстваДляВнешнейОшибки() Экспорт

	// Подготовка
	Ошибка = ПомощникТестированияОшибок.ВнешняяОшибка("Внешняя ошибка");

	// Действие
	Исследователь = Новый ИсследовательОшибки(Ошибка);

	// Проверка
	Ожидаем.Что(Исследователь.ЭффективнаяОшибка()).Равно(Неопределено);
	Ожидаем.Что(Исследователь.ТипОшибки()).Равно(Неопределено);
	Ожидаем.Что(Исследователь.Данные()).Равно(Неопределено);
	Ожидаем.Что(Исследователь.Подсказка()).Равно("");
	Ожидаем.Что(Исследователь.Ошибки().ЕстьОшибки()).Равно(Ложь);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗащититьМассивыИсследованияОтИзменения() Экспорт

	// Подготовка
	Причина = ФабрикаОшибок.Создать("core.failed", "Ошибка");
	Ошибка = ФабрикаОшибок.СКонтекстом(Причина, "Контекст");
	Исследователь = Новый ИсследовательОшибки(Ошибка);

	// Действие
	Исследователь.Кадры().Очистить();
	Исследователь.Контексты().Очистить();

	// Проверка
	Ожидаем.Что(Исследователь.Кадры().Количество()).Равно(2);
	Ожидаем.Что(Исследователь.Контексты().Количество()).Равно(1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазличитьКореньИПоследнийКадрУсеченнойЦепочки() Экспорт

	// Подготовка
	Цепочка64 = ПомощникТестированияОшибок.ДлиннаяЦепочка(64);
	Цепочка65 = ПомощникТестированияОшибок.ДлиннаяЦепочка(65);

	// Действие
	Исследователь64 = Новый ИсследовательОшибки(Цепочка64.Ошибка);
	Исследователь65 = Новый ИсследовательОшибки(Цепочка65.Ошибка);

	// Проверка
	Ожидаем.Что(Исследователь64.ЦепочкаУсечена()).Равно(Ложь);
	Ожидаем.Что(Исследователь64.КорневаяПричина().ИсходнаяОшибка()).Равно(Цепочка64.Корень);
	Ожидаем.Что(Исследователь65.ЦепочкаУсечена()).Равно(Истина);
	Ожидаем.Что(Исследователь65.КорневаяПричина()).Равно(Неопределено);
	Ожидаем.Что(Исследователь65.ПоследнийКадр() <> Неопределено).Равно(Истина);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НайтиОшибкиВыбранныхТипов() Экспорт

	// Подготовка
	Корень = ФабрикаОшибок.Создать("database.timeout", "Первый таймаут");
	Повтор = ФабрикаОшибок.Обернуть(Корень, "database.timeout", "Второй таймаут");
	ОшибкаСети = ФабрикаОшибок.Обернуть(Повтор, "network.timeout", "Сетевой таймаут");
	Исследователь = Новый ИсследовательОшибки(ОшибкаСети);

	// Действие
	Выборка = Исследователь.НайтиОшибки(" DATABASE.TIMEOUT, network.timeout, database.timeout ");

	// Проверка
	Ожидаем.Что(Исследователь.ЕстьОшибка("DATABASE.TIMEOUT")).Равно(Истина);
	Ожидаем.Что(Исследователь.НайтиОшибку("database.timeout").ИсходнаяОшибка()).Равно(Повтор);
	Ожидаем.Что(Выборка.Количество()).Равно(3);
	Ожидаем.Что(Выборка.Первая().ИсходнаяОшибка()).Равно(ОшибкаСети);
	Ожидаем.Что(Выборка.Последняя().ИсходнаяОшибка()).Равно(Корень);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьНекорректныйФильтрОшибок() Экспорт

	// Подготовка
	Исследователь = Новый ИсследовательОшибки(ФабрикаОшибок.Создать("core.failed", "Ошибка"));
	НекорректныеФильтры = Новый Массив;
	НекорректныеФильтры.Добавить("");
	НекорректныеФильтры.Добавить("database.timeout,");
	НекорректныеФильтры.Добавить(",database.timeout");
	НекорректныеФильтры.Добавить("database.timeout, ,network.timeout");
	НекорректныеФильтры.Добавить("Core.Not-Failed");

	// Действие и Проверка
	Для Каждого Фильтр Из НекорректныеФильтры Цикл
		Параметры = Новый Массив;
		Параметры.Добавить(Фильтр);
		Ожидаем.Что(Исследователь)
			.Метод("НайтиОшибки", Параметры)
			.ВыбрасываетИсключение("Тип ошибки имеет неверный формат");
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьПустуюВыборкуЕслиТипНеНайден() Экспорт

	// Подготовка
	Исследователь = Новый ИсследовательОшибки(ФабрикаОшибок.Создать("core.failed", "Ошибка"));

	// Действие
	Выборка = Исследователь.НайтиОшибки("storage.unavailable");

	// Проверка
	Ожидаем.Что(Выборка.ЕстьОшибки()).Равно(Ложь);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьПредставленияИзСохраненныхСнимков() Экспорт

	// Подготовка
	Цепочка = СмешаннаяЦепочка();
	Исследователь = Новый ИсследовательОшибки(Цепочка.Ошибка);

	// Действие
	Краткое = Исследователь.КраткоеПредставление();
	Подробное = Исследователь.ПодробноеПредставление();

	// Проверка
	Ожидаем.Что(Краткое).Равно(
		"config.load_failed: Загрузка конфигурации -> Не удалось загрузить конфигурацию"
	);
	Ожидаем.Что(Подробное).Содержит("config.load_failed: Не удалось загрузить конфигурацию");
	Ожидаем.Что(Подробное).Содержит("fs.file_not_found: Файл не найден");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СмешаннаяЦепочка()

	ДанныеПричины = Новый Структура("Путь", "config.json");
	Причина = ФабрикаОшибок.Создать("fs.file_not_found", "Файл не найден", ДанныеПричины);
	ВнешняяОшибка = ПомощникТестированияОшибок.ВнешняяОшибка("Некорректный JSON", Причина);
	ДанныеЭффективнойОшибки = Новый Структура("Формат", "JSON");
	ЭффективнаяОшибка = ФабрикаОшибок.Обернуть(
		ВнешняяОшибка,
		"config.load_failed",
		"Не удалось загрузить конфигурацию",
		ДанныеЭффективнойОшибки
	);
	Контекст = ФабрикаОшибок.СКонтекстом(ЭффективнаяОшибка, "Загрузка конфигурации");

	Возврат Новый Структура(
		"Ошибка, ЭффективнаяОшибка, ДанныеЭффективнойОшибки",
		Контекст,
		ЭффективнаяОшибка,
		ДанныеЭффективнойОшибки
	);

КонецФункции

#КонецОбласти
